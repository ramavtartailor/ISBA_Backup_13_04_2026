<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prior_Act__c</fullName>
    <description>Years between expiration date and prior acts date (rounding at .5)</description>
    <externalId>false</externalId>
    <formula>CEILING((Policy__r.Expiration_Date__c -  Prior_Act_Date__c ) / 365.0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Prior Acts Interval (years)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
