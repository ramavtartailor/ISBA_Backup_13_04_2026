<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Policy_Series_Age_years__c</fullName>
    <description>Years from policy series inception to expiration date (rounding up at .5)</description>
    <externalId>false</externalId>
    <formula>CEILING((Expiration_Date__c - Policy_Series_Effective_Date__c) / 365.0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Policy Series Age (years)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
