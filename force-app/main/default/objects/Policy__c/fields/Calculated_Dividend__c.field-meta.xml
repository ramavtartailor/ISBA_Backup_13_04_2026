<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Calculated_Dividend__c</fullName>
    <description>Determines which portion of policy to calculate dividend on</description>
    <externalId>false</externalId>
    <formula>IF( (Policy_Effective_Year__c = TEXT(Current_Dividend_Year__c)) , Effective_Year_Dividend__c , Dividend_Expiration_Year_Earned__c )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>xxx-Calculated Dividend</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
