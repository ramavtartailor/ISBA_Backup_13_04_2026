<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Policy_Dividend__c</fullName>
    <description>Value to be used for policy dividend credit when binding
Effective Year Dividend + Previous Policy Expiration Year Dividend</description>
    <externalId>false</externalId>
    <formula>IF (!Dividend_Eligible__c || Effective_Date__c &lt; DATE(2023,1,1),
	0,
	IF (Previous_Policy__r.Dividend_Correction__c &gt; 0,
		ROUND(Previous_Policy__r.Dividend_Correction__c, 0),
		ROUND(ISBAM_policy_dividend__c, 0)
	)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Calculated Policy Dividend</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
