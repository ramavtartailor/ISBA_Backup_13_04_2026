<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Dividend_Expiration_Year_Earned__c</fullName>
    <description>Dividend_Net_Written__c *  Expiration_Year_Percentage__c * 0.1</description>
    <externalId>false</externalId>
    <formula>if (Expiration_Year_Percentage__c &gt; 1,
  1,
  Dividend_Net_Written__c *  Expiration_Year_Percentage__c * 0.1
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Expiration Year Dividend</label>
