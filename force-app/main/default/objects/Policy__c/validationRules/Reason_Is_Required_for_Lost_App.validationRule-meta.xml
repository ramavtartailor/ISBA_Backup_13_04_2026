<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reason_Is_Required_for_Lost_App</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c,&apos;Rejected&apos;),OR(ISPICKVAL(Lost_Reason__c,&quot;&quot;),ISPICKVAL(Lost_Reason__c,&quot;-&quot;)))</errorConditionFormula>
    <errorMessage>Lost Reason is required when status is set to Lost.</errorMessage>
</ValidationRule>
