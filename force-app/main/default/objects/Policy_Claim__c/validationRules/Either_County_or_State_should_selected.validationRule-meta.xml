<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Either_County_or_State_should_selected</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISBLANK(GEO_Factor__c),
    ISBLANK(State__c)
)</errorConditionFormula>
    <errorMessage>Either Venue or State needs to be selected.</errorMessage>
</ValidationRule>
