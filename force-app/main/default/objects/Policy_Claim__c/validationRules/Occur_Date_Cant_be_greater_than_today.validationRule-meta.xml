<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Occur_Date_Cant_be_greater_than_today</fullName>
    <active>true</active>
    <errorConditionFormula>Occur_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Occur_Date__c</errorDisplayField>
    <errorMessage>&apos;Occurrence Date&apos; should not be Greater than today.</errorMessage>
</ValidationRule>
