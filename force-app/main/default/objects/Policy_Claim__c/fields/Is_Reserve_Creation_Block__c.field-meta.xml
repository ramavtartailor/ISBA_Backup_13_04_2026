<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Reserve_Creation_Block__c</fullName>
    <formula>OR(
Not(Policy__r.Active__c)
,

   OR(ISPICKVAL(File_Type__c, &apos;ARDC Complaint&apos;) ,
      ISPICKVAL(File_Type__c, &apos;Memo&apos;)
      )

)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Reserve Creation Block</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
