<apex:component controller="EndorsementDocuments_Ctrl">
    <apex:stylesheet value="{!$Resource.PolicyDocumentsCSS}" />
    <apex:attribute name="recordIdParam" description="" type="String" assignTo="{!recordId}" />
    <p class="heading"> 
        Death,Total And Permanent Disability, Or U.S Active Duty Military Service Exclusion
    </p>
    <br/>
    <br/>
    <p class="normalParagraph">
        It is agreed<span class="normalBoldParagraph"> that VIII. DEATH, TOTAL AND PERMANENT DISABILITY, OR U.S ACTIVE DUTY MILITARY SERVICE </span>is deleted.
    </p>
    <br/>
    <br/>
