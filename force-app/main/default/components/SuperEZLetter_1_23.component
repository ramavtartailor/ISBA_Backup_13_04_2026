<apex:component controller="RegularRenewalDoc_Ctrl">
    <apex:attribute name="recordIdParam" description="" type="String" assignTo="{!recordId}" />
    
    
    
    <head>
  <style>
      @page {
      		font-family: Arial Unicode MS;
      		font-size: 15px;
      		margin-top: 10cm !important;
      		padding-top: 10cm !important;
            size: portrait;
            margin-left: 0.8cm;
            margin-right: 0.8cm;
      		margin-bottom: 1cm !important;
      }
            .colorMaroon{
                color: #89001a;
            }
            .colorRed{
                color: #e64542;
            }
            .colorGray{
                color: #212121;
            }
            .colorDarkGray{
                color: #424242;
            }
            .fontCss{
                font-size:14px;
            }
            .fontCssSmall{
                font-size:13px;
            }
            div.footer {
                display: block;
                padding: 5px;
                position: running(footer);               
            }
            .pagenumber:before {
                content: counter(page);            
            }
      
            
      		.pc { 
      			color: #89001b;
      			font-weight: bold;
      		}
      		.c { text-align: center; }
    		.u { }
      		.b { font-weight: bold; }
    		
            .div_pad {
            	padding-top: 5px;
                padding-bottom: 5px;
        	}
      
            .table_border { border-collapse: collapse; width: 100%; }
            .table_border, .table_border th, .table_border td { border: 2px solid #ededed; }
            .table_spacing td {
              padding-left: 7px;
              padding-top: 3px;
              padding-bottom: 3px;
            }
      
      		#discipline_table_questions th, #discipline_table_questions td {
      			border: 0px solid white;
      			padding: 2px;
       		}
      
            .table_title { 
        		background-color: #89001b;
        		color: white;
        		font-weight: bold;
      			font-size: 14px;
      			padding-top: 3px !important;
                padding-bottom: 3px !important;
    		}
            
            .sc_header {
            	background-color: #B7BBB6;
                color: black;
            }
            .sc_header th {
      			font-weight: bold;
      			padding-top: 5px !important;
                padding-bottom: 5px !important;
                font-weight: normal !important;
            }
      
      		
      		.table_head tr th {
                text-align: center;
            }
      
            #quote_table {
                font-size: 12px;
            }
            #quote_table td {
      			padding: 6px;
            }
            #quote_table td:nth-child(1) {
              text-align: center;
            }
            
            #lawyer_table td {
      			padding: 6px;
            }
      
            #discipline_table {
        		font-size: 12px;
       		}
      
      		.fs-12px {
      			font-size: 12px;
      		}
      
      		.pad6 td {
      			padding: 6px;
      		}
      
      		.th_pad th {
              padding-top: 8px;
              padding-bottom: 8px;
            }
      
      		.question_table td {
              padding: 5px;
              padding-right: 10px !important;
            }
	        
            .cb {
                height: 9px;
      			width: 9px;
      			border: 1px solid black;
      			float: left;
                margin-top: 2px;
      			margin-right: 4px;
            }
            .cb_yes {
                padding-right: 15px;    
		        float: left;
            }
            .yn_pad {
      			padding-left: 15px !important;
      		}
      
		    tr.page-break  { display: block; page-break-before: always; }
      
      		.no_td_border {
      			border-left: 0px solid white !important;
      			border-top: 0px; solid white !important;
      			border-right: 0px solid white !important;
      			border-bottom: 0px solid white !important;
      		}
      
  </style>
  </head>
  
    <body style="font-weight: normal; ">
    

      <div class="footer" style="width:100%">
          <table style="display:none;" width="100%">
              <tr>
                  <td width="20%">
                      
                  </td>
                  <td width="30%" style="text-align:right;">
                      Page&nbsp;<b><span class="pagenumber" /></b>&nbsp;of&nbsp;<b><span class="pagecount" /></b>
                  </td>
                  <td width="50%" style="text-align:right;">
                      
                  </td>
              </tr>
          </table>
         
      </div>
  	
    
    <!---HEADER------------------------------------------------------------>
    
    
        
      <div style="">
          <c:Application_Header />    
      </div>
    
      <div style="padding: 20px; font-weight: normal;">
            
        <c:RenewalLetterAddress recordIdParam="{!policy.Id}" />
        
        <br/><br/>
        
        
        <p style="font-weight: bold;">
            Dear {!policy.Firm_Contact__r.FirstName} {!policy.Firm_Contact__r.LastName},
        </p>
          
        <p style="text-align: justify; font-weight:normal;">
            We are grateful for the continued trust you place in ISBA Mutual Insurance for your professional liability coverage. As the expiration date of your
            current policy approaches on <apex:outputText value=" {0,date,M/d/yyyy}"> 
                <apex:param value="{!policy.Previous_Policy__r.Expiration_Date__c}" /> 
            </apex:outputText>, enclosed please find the Renewal Quote Application and Acceptance Form.  Please refer to the Terms and Conditions page for 
            steps necessary to renew your policy. 
        </p>
          
		<p style="{!if(policy.ISBAM_policy_dividend__c>0,'','display: none;')}">
            Additionally, we are delighted to announce that ISBA Mutual Insurance declared a dividend last year.  Upon renewing your policy, a dividend
            credit of <apex:outputText value=" ${0, number,###,###,###,###}"><apex:param value="{!(policy.ISBAM_policy_dividend__c)}" /></apex:outputText>
            will be applied to your {!policy.Policy_Effective_Year__c} policy premium.  
        </p>
          
    	<p style="{!if(policy.ISBAM_policy_dividend__c>0,'','display: none;')}">
            Alternatively, should you support the legal community, you can donate your dividend, in whole or part, to the Illinois Bar Foundation (IBF).
            An election form for this purpose is included in the attachments.
            <br/>
			We value our continued partnership with your firm and are here to assist should you have any questions or need further clarification.   
        </p>
          
        <div style="padding-top: 40px; {!if(policy.Underwriter_User__r.FirstName!=null,'','display:none;')}">
            Respectfully,
            <br/><br/>
            <span style="font-weight: bold;">{!policy.Underwriter_User__r.FirstName}&nbsp;{!policy.Underwriter_User__r.LastName}</span>
            <br/>{!policy.Underwriter_User__r.Title}
            <br/>{!policy.Underwriter_User__r.Phone}
            <br/>Fax: (312) 379-2049<br/>
        </div>
        
      </div>
    </body>
</apex:component>