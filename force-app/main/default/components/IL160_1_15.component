<apex:component controller="EndorsementDocuments_Ctrl">
    <apex:stylesheet value="{!$Resource.PolicyDocumentsCSS}" />
    <apex:attribute name="recordIdParam" description="" type="String" assignTo="{!recordId}" />
    <p class="heading"> 
        Contractual Liability Exclusion Endorsement
    </p>
    <p class="normalParagraph">
        It is agreed that the Policy is amended to exclude any<span class="normalBoldParagraph"> CLAIM </span>for which the<span class="normalBoldParagraph"> INSURED </span>is obligated to pay<span class="normalBoldParagraph"> CLAIM EXPENSES </span>or to pay<span class="normalBoldParagraph"> DAMAGES </span>by reason of the assumption of liability or agreement to hold harmless in a written contract or agreement.
    </p>
    <br/>
    <br/>
    <p class="normalParagraph">
        All other terms, conditions, limitations and exclusions of the Policy to which this endorsement is attached remain unchanged.
    </p>
    <table border="0" cellspacing="0" cellpadding="0" style="width:30%;margin-top:495px;" align="right">
        <tr>
            <td class="tableDataLeft">
                <apex:image url="{!$Resource.Authorised_Signature }" width="150" height="50"/>
                <br/>
                Authorized Representative
            </td>
        </tr>
    </table>
</apex:component>