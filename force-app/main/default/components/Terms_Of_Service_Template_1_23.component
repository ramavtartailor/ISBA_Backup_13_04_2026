<apex:component controller="Terms_Of_Service_Template_Ctrl">
    <apex:stylesheet value="{!$Resource.PolicyDocumentsCSS}" />
    <apex:attribute name="recordIdParam" description="" type="String" assignTo="{!recordId}" />
        
    <p class="heading">
        zTERMS &amp; CONDITIONS
    </p>
    <!-- <p class="normalParagraph">It is a program requirement that all Lawyers insured by ISBA Mutual Insurance Company must be current members of the Illinois State Bar Association (ISBA).  To renew your ISBA membership, please visit: <a href="www.ISBA.org/membership/join">www.ISBA.org/membership/join</a>.
    </p>     -->
    <p class="b normalParagraph">
        IN ORDER TO BIND COVERAGE, WE MUST FIRST RECEIVE THE FOLLOWING:
    </p>
    <p class="normalParagraph">
        <apex:outputText value="{!policy.Terms_Conditions__c}" escape="false"/>
    </p>
    <br />
    <br />
 	<p  class="normalParagraph">
        Premium payment instructions and invoice will be sent to the Firm by email from our Accounting Department AFTER your Policy has been bound.  The instructions on how to manage your premium payment online will be included in this email from accounting@isbamutual.com.
		<br /><br />
        <span class="b">As a reminder, Coverage is not bound until appropriate premiums have been received by ISBA Mutual Insurance Company.</span>
        <br /><br />
        Any questions, please contact me:
    </p>



 
    <br />
    <br />
    
    <p  class="normalParagraph">
        Sincerely,<br /><br />
        <apex:outputPanel rendered="{! NOT(policy.Application_Type__c == 'New Business')}">
            {!policy.Underwriter_User__r.FirstName}&nbsp;{!policy.Underwriter_User__r.LastName}<br/>
            {!policy.Underwriter_User__r.Title}<br />
            Email: {!policy.Underwriter_User__r.Email}<br />
            Phone: {!policy.Underwriter_User__r.Phone}<br />
        </apex:outputPanel>
        <apex:outputPanel rendered="{! AND(policy.Application_Type__c == 'New Business',policy.Sales_User__c != null)}">
            {!policy.Sales_User__r.FirstName}&nbsp;{!policy.Sales_User__r.LastName}
            {!policy.Sales_User__r.Title}<br />
            Phone: {!policy.Sales_User__r.Phone}<br />
            Email: {!policy.Sales_User__r.Email}<br />
        </apex:outputPanel>
        <apex:outputPanel rendered="{! AND(policy.Application_Type__c == 'New Business',policy.Sales_User__c == null)}">
            {!policy.Underwriter_User__r.FirstName}&nbsp;{!policy.Underwriter_User__r.LastName}
            {!policy.Underwriter_User__r.Title}<br />
            Email: {!policy.Underwriter_User__r.Email}<br />
            Phone: {!policy.Underwriter_User__r.Phone}<br />
        </apex:outputPanel>
    	Fax: (312) 379-2049<br />
    </p>
    

    <br />
    
</apex:component>