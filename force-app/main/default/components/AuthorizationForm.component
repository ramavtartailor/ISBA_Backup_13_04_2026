                    Email <span class="normalBoldParagraph" style="text-decoration: underline;">{!policy.Firm_Contact__r.Email}</span>
                </p>
            </td>
        </tr>
    </table>
    
    <br/>
    <br/>
    
    <table style="width:100%;border:1px solid #000;" border="0" cellspacing="0" cellpadding="0">
        <tr>
            <td class="tableDataLeft" style="width:60%;">
                <p class="normalParagraph">
                    Card Type:
                    <input type="checkbox" class="cc_cb"></input>&nbsp;&nbsp;MasterCard
                    <input type="checkbox" class="cc_cb"></input>&nbsp;&nbsp;VISA
                    <input type="checkbox" class="cc_cb"></input>&nbsp;&nbsp;Discover
                    <input type="checkbox" class="cc_cb"></input>&nbsp;&nbsp;AMEX
                            
                </p>
            </td>
        </tr>
        <tr>
            <td class="tableDataLeft" style="width:60%;">
                <p class="normalParagraph">
                    Cardholder Name (as shown on card): ____________________________________________________
                </p>
            </td>
        </tr>
        <tr>
            <td class="tableDataLeft" style="width:60%;">
                <p class="normalParagraph">
                    Card Number: _______________________________________________________________________
                </p>
            </td>
        </tr>
        <tr>
            <td class="tableDataLeft" style="width:60%;">
                <p class="normalParagraph">
                    Expiration Date (mm/yy): _______________________________________________________________
                </p>
            </td>
        </tr>
        <tr>
            <td class="tableDataLeft" style="width:60%;">
                <p class="normalParagraph">
                    CVV Number*: _______________________________________________________________________
                    <div style="padding: 3px; padding-left: 100px; font-color: gray; font-size: 8pt;">
                        *MC, Visa and Discover; 3-digit number found on back of card.  AMEX; 4-digit number found on front of card.
                    </div>
                </p>
            </td>
        </tr>
        <tr>
            <td class="tableDataLeft" style="width:60%;">
                <p class="normalParagraph">
