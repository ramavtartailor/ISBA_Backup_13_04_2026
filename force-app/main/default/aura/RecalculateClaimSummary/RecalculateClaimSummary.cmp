<aura:component implements="force:lightningQuickActionWithoutHeader,force:hasRecordId,force:hasSObjectName"  access="global" controller="QuickClaimController">
	<aura:attribute name="recordId" type="Id"/>	
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="spinner" type="boolean" default="FALSE"/>
</aura:component>