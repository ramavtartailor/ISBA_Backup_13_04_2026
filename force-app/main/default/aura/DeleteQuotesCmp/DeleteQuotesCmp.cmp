<aura:component controller="DeleteQuotesCtrl" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction" access="global" >
	<aura:attribute name="quoteIds" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="showSpinner" type="Boolean" default="true" />
    <aura:attribute name="showError" type="Boolean" default="false" />
    <aura:attribute name="showSuccess" type="Boolean" default="false" />
    <aura:attribute name="disabled" type="Boolean" default="true" />
    <aura:attribute name="message" type="String" default="" />

    <aura:if isTrue="{!v.showError}">
        <div aura:id="toastId" class="slds-is-relative slds-notify_container">
            <div class="slds-notify slds-notify_toast slds-theme_error">
                <lightning:icon iconName="utility:error" variant="inverse" alternativeText="Error" title="Error" />
                <div class="dflexfo normalText" style="width: 100%; padding-left: .5rem;">
                    <div style="font-size: larger;">
                        Error!
                    </div>
                    <div class="">
                        <div class="">{!v.message}</div>
                    </div>
                </div>
                <div class="toastCloseBut" onclick="{!c.closeToastHandle}">
                    <lightning:icon style="cursor: pointer;" iconName="utility:close" variant="inverse" size="x-small" alternativeText="close" title="Close" />
                </div>
            </div>
        </div>
    </aura:if>

    <aura:if isTrue="{!v.showSuccess}">
        <div aura:id="toastId" class="slds-is-relative slds-notify_container">
            <div class="slds-notify slds-notify_toast slds-theme_success">
                <lightning:icon iconName="utility:success" variant="inverse" alternativeText="Error" title="Error"/>
                <div class="dflexfo normalText" style="width: 100%; padding-left: .5rem;">
                    <div style="font-size: larger;">
                        Success!
                    </div>
                    <div class="">
                        <div class="">{!v.message}</div>
                    </div>
                </div>
                <div class="toastCloseBut" onclick="{!c.closeToastHandle}">
                    <lightning:icon style="cursor: pointer;" iconName="utility:close" variant="inverse" size="x-small" alternativeText="close" title="Close" />
                </div>
            </div>
        </div>
    </aura:if>
    
    
    <aura:if isTrue="{!v.showSpinner}">
        <lightning:spinner alternativeText="Loading" size="medium" />
    </aura:if>


    <section role="dialog" tabindex="-1" aria-modal="true" aria-labelledby="modal-heading-01"
        class="slds-modal slds-fade-in-open">
        <div class="slds-modal__container">
            <div class="slds-modal__header">
                <h1 id="modal-heading-01" class="slds-modal__title slds-hyphenate" tabindex="-1">Delete Quotes</h1>
            </div>
            <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                <div style="display: flex; Justify-content: center; gap: .5rem;">
                    <b>Are you sure you want to delete the selected quotes?</b>
                </div>
            </div>
            <div class="slds-modal__footer">
                <lightning:button label="No" onclick="{!c.handleClose}" />
                <lightning:button variant="brand" label="Yes" onclick="{!c.handleSave}" disabled="{!v.disabled}" />
            </div>
        </div>
    </section>
    <div class="slds-backdrop slds-backdrop_open" role="presentation"></div>
    
</aura:component>