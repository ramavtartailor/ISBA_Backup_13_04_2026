                                                            <div class="newPoints dflex gap">
                                                                <div class="head dflexfo" style="font-weight: bold;">
                                                                    Date
                                                                </div>
                                                                <div class="value dflexfo" style="font-weight: bold;">
                                                                    Installment
                                                                </div>
                                                                <aura:if isTrue="{!v.isCC}">
                                                                    <div class="value dflexfo"
                                                                         style="font-weight: bold;">
                                                                        Service Fee
                                                                    </div>
                                                                    <div class="value dflexfo"
                                                                         style="font-weight: bold;">
                                                                        Total
                                                                    </div>
                                                                </aura:if>
                                                            </div>
                                                        </div>
                                                        <div class="leftBorder dflexcol smallGap">
                                                            <aura:if
                                                                     isTrue="{!v.policywrap.futurePaymentSchedules.length > 0}">
                                                                <aura:iteration
                                                                                items="{!v.policywrap.futurePaymentSchedules}"
                                                                                var="item">
                                                                    <div class="newItemBox">
                                                                        <div class="leftLine"></div>
                                                                        <div class="newPoints dflex gap">
                                                                            <div class="head dflexfo"
                                                                                 style="font-weight: bold;">
                                                                                {!item.dateStr}
                                                                            </div>
                                                                            <div class="value dflexfo"
                                                                                 style="font-style: italic;">
                                                                                <lightning:formattedNumber
                                                                                                           maximumFractionDigits="2"
                                                                                                           value="{!item.amount}"
                                                                                                           style="currency"
                                                                                                           currencyCode="USD" />
                                                                            </div>
                                                                            <aura:if isTrue="{!v.isCC}">
                                                                                <div class="value dflexfo"
                                                                                     style="font-style: italic;">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="2"
                                                                                                               value="{!(item.amount * v.policywrap.ccFeeRate)/100}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                                <div class="value dflexfo"
                                                                                     style="font-style: italic;">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="2"
                                                                                                               value="{!((item.amount * v.policywrap.ccFeeRate)/100) + item.amount}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                            </aura:if>
                                                                        </div>
                                                                    </div>
                                                                </aura:iteration>
                                                                <aura:set attribute="else">
                                                                    <div class="normalText textCenter">
                                                                        No Payment Schedule.
                                                                    </div>
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                        <!--/div-->
                                                    </aura:if>
                                                    
