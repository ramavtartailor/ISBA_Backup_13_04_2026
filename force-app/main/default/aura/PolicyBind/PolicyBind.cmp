                                                    <aura:if isTrue="{!v.policywrap.paymentScheduleVar == 'Month'}">
                                                        <!--div class="detailsBox dflexcol gap" style="flex:3;"-->
                                                        <aura:if
                                                                 isTrue="{!v.policywrap.duePaymentSchedules.length > 0}">
