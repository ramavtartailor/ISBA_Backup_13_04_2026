                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                                <div class="value dflexfo"
                                                                                     style="font-style: italic;">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="2"
                                                                                                               value="{!((item.amount * v.policywrap.ccFeeRate)/100) + item.amount}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                            </aura:if>
                                                                        </div>
                                                                    </div>
                                                                </aura:iteration>
