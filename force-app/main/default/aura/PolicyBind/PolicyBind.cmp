                                                                                <div data-que="Q1New2" onclick="{!c.handleScaleInputNew}" class="dflexcolcen dflexfo scaleItems" Style="border-right: 1px solid #e7e7e7;color: orange;" data-val="2">2</div>
                                                                                <div data-que="Q1New2" onclick="{!c.handleScaleInputNew}" class="dflexcolcen dflexfo scaleItems" Style="border-right: 1px solid #e7e7e7;color: #c1c125;" data-val="3">3</div>
                                                                                <div data-que="Q1New2" onclick="{!c.handleScaleInputNew}" class="dflexcolcen dflexfo scaleItems" Style="border-right: 1px solid #e7e7e7;color: #5fce5f;" data-val="4">4</div>
                                                                                <div data-que="Q1New2" onclick="{!c.handleScaleInputNew}" class="dflexcolcen dflexfo scaleItems"  data-val="5" style="color: green;">5</div>
                                                                            </div>
