                                                    <aura:if isTrue="{!v.policywrap.totalAmountDue > 0}">
                                                        &amp; Pay
                                                        <aura:set attribute="else">
                                                            &amp; Save
                                                        </aura:set>
                                                    </aura:if>
                                                </div>
                                                <div class="dflex gap rs_stepButton">
                                                    <div class="myButton negativeButt re_dflexfo" data-to="2"
                                                         data-buttype="back" data-from="none"
                                                         onclick="{!c.changeStepHandle}">
                                                        Back
                                                    </div>
                                                    <div class="myButton positiveBut re_dflexfo" data-type="payBut"
                                                         aura:id="payBut" onclick="{!c.savedItemClickHandle}"
                                                         data-from="homeScreen">
                                                        Confirm
                                                        <aura:if isTrue="{!v.policywrap.totalAmountDue > 0}">
                                                            &amp; Pay
                                                            <aura:set attribute="else">
                                                                &amp; Save
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <aura:set attribute="else">
                                <div class="rightPanel overflowHidden dflexcol largeGap">
                                    <div class="stepData largeGap activeStepData" style="padding: 0 !important;height: 100%;"
                                         aura:id="stepDataId" data-dataid="3">
                                        
                                        <div style="display:none;" class="dflex largeGap">
                                            <div aura:id="payment-type" data-type="Full"
                                                 onclick="{!c.paymentScheduleHandle}"
                                                 class="isActiveSpan itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                Full Payment
                                            </div>
                                            <div aura:id="payment-type" data-type="Quarter"
                                                 onclick="{!c.paymentScheduleHandle}"
                                                 class="itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                Quarterly Payments
                                            </div>
                                            <div aura:id="payment-type" data-type="Month"
                                                 onclick="{!c.paymentScheduleHandle}"
                                                 class="itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                Monthly Payments
                                            </div>
                                        </div>
                                        
                                        
                                        <div class="dflexfo dflexcol bgColorRadius overflowHidden">
                                            <div style="display:none; padding: 20px;"
                                                 class="borderBox largeMargin contentBox">
                                                <lightning:radioGroup class="radio_payment_schedule"
                                                                      name="radioGroupRequired" label="Select Payment Schedule:"
                                                                      options="{!v.paymentTypeOptions}" type="radio"
                                                                      value="{!v.paymentOption}"
                                                                      onchange="{! c.handlePaymentOptionChange }" />
                                            </div>
                                            
                                            
                                            <!-- MAIN PAYMENT SCREEN -->
                                            
                                            <div
                                                 class="borderBox largeMargin contentBox dflex dflexfo gap scrollableDiv mediumPadding">
                                                <div class="detailsBox dflexcol gap" style="flex:3;">
                                                    <aura:if isTrue="{!!v.policywrap.isBillingFrequencyFullOnly}">
                                                        <div style="padding-left: 20px; padding-top: 10px;">
                                                            
                                                            <p class="leftSection normalTextWithNormalHeadingBold"
                                                               style="font-size: 1.3em; font-weight: bold; color: black;">
                                                                PAYMENT OPTIONS:
                                                            </p>
                                                            <br />
                                                            
                                                            <div class="zslds-grid zslds-wrap" style="font-size: 16px;">
                                                                <ui:inputRadio text="Full" name="payment-type-radio"
                                                                               label="" change="{!c.handlePaymentTypeChange}" />
                                                                &nbsp;&nbsp;Full Payment
                                                                <br />
                                                                <ui:inputRadio text="Quarter" name="payment-type-radio"
                                                                               label="" change="{!c.handlePaymentTypeChange}" />
                                                                &nbsp;&nbsp;Quarterly Payments
                                                                <br />
                                                                <ui:inputRadio text="Month" name="payment-type-radio"
                                                                               label="" change="{!c.handlePaymentTypeChange}" />
                                                                &nbsp;&nbsp;Monthly Payments
                                                            </div>
                                                            
                                                            <!--aura:if isTrue="{!v.policywrap.enablePaymentDate}">
                                                        <p style="padding-top: 40px; font-size: 16px; width: 100%">
                                                            Payment Date:&nbsp;&nbsp;
                                                            <lightning:input type="date" name="input1" aura:id="paymentDate" class="ltngInput"
                                                                             value="{!v.policywrap.firstInstallmentDate}"
                                                                             variant="label-hidden"
                                                                             onchange="{!c.handleChangeDueDate}" dateStyle="short"/>
                                                            <span class="paymtDateMsg" style="{!v.paymtDateMsgStyle}">
                                                                (must be between today and {!v.policywrap.effectiveDateStr})
                                                            </span>
                                                        </p>
                                                    </aura:if-->
                                                            
                                                            <br />
                                                            
                                                            
                                                        </div>
                                                    </aura:if>
                                                    <p class="leftSection normalTextWithNormalHeadingBold"
                                                       style="margin-top: 40px; width: 100%; background-color: lightblue; font-size: 1.3em; font-weight: bold; color: black;">
                                                        <table>
                                                            <tr>
                                                                <td>TOTAL DUE TODAY:&nbsp;&nbsp;</td>
                                                                <td align="right">
                                                                    <aura:if isTrue="{!v.isCC}">
                                                                        <lightning:formattedNumber
                                                                                                   maximumFractionDigits="2"
                                                                                                   value="{!((v.policywrap.totalAmountDue * (100 + v.policywrap.ccFeeRate))/100)}"
                                                                                                   style="currency" currencyCode="USD" />
                                                                        <aura:set attribute="else">
                                                                            <lightning:formattedNumber
                                                                                                       maximumFractionDigits="2"
                                                                                                       value="{!v.policywrap.totalAmountDue}"
                                                                                                       style="currency"
                                                                                                       currencyCode="USD" />
                                                                        </aura:set>
                                                                    </aura:if>
                                                                    <!--lightning:formattedNumber maximumFractionDigits="2"
                                                                                                             value="{!v.policywrap.totalAmountDue}" style="currency"
                                                                                                             currencyCode="USD" /-->
                                                                </td>
                                                            </tr>
                                                            
                                                        </table>
                                                    </p>
                                                    <aura:if isTrue="{!!v.policywrap.isPolicy}">
                                                        <div style="margin-top: 1rem;" class="myButton negativeButt re_dflexfo" data-watermark="Yes"
                                                             onclick="{!c.downloadEndorsementPdf}">
                                                            View PDF Endorsement
                                                        </div>
                                                    </aura:if>
                                                    
                                                    <div
                                                         style="margin-top: 25px; border-top: 1px solid #e5e5e5; padding-top: 25px;">
                                                    </div>
                                                    <div class="zslds-grid zslds-wrap"
                                                         style="font-size: 16px; padding-left: 20px;">
                                                        
                                                        
                                                        <p class="leftSection normalTextWithNormalHeadingBold"
                                                           style="padding-top: 10px; font-weight: bold; color: black;">
                                                            PAYMENT METHOD:
                                                        </p>
                                                        <div style="color: gray; font-size: 0.8em;" class="secline">* a
                                                            {!v.policywrap.ccFeeRate}% service
                                                            fee will be added to Credit Card transactions</div>
                                                        <br />
                                                        <aura:if isTrue="{!v.savedCardList.length}">
                                                            <aura:iteration items="{!v.savedCardList}" var="item"
                                                                            indexVar="index">
                                                                <!-- <ui:inputRadio  aura:id="picklistPaymentMethod"  name="paymentMethodRadioGroup" label="" value="{!OR(item.isDefault == true, item.isSetToPay == true)}"
                                                            change="{!c.picklistPaymentMethodChange}" />  &nbsp;&nbsp;
                                                            --><!-- <option selected="{!OR(item.isDefault == true, item.isSetToPay == true)}" value="{!item.paymentMethod.Id}"> -->
                                                                <aura:if
                                                                         isTrue="{!OR(item.isDefault == true, item.isSetToPay == true)}">
                                                                    <input type="radio" aura:id="picklistPaymentMethod"
                                                                           name="paymentMethodRadioGroup"
                                                                           data-id="{!item.paymentMethod.Id}"
                                                                           checked="checked"
                                                                           onchange="{!c.picklistPaymentMethodChange}" />
                                                                    <aura:set attribute="else">
                                                                        <input type="radio"
                                                                               aura:id="picklistPaymentMethod"
                                                                               name="paymentMethodRadioGroup"
                                                                               data-id="{!item.paymentMethod.Id}"
                                                                               onchange="{!c.picklistPaymentMethodChange}" />
                                                                    </aura:set>
                                                                </aura:if>
                                                                
                                                                <aura:if isTrue="{!item.cardTypeVar == 'amex'}">
                                                                    AMEX
                                                                </aura:if>
                                                                <aura:if isTrue="{!item.cardTypeVar == 'disc'}">
                                                                    DISC
                                                                </aura:if>
                                                                <aura:if isTrue="{!item.cardTypeVar == 'mc'}">
                                                                    MC
                                                                </aura:if>
                                                                <aura:if isTrue="{!item.cardTypeVar == 'visa'}">
                                                                    VISA
                                                                </aura:if>
                                                                ending in
                                                                {!item.paymentMethod.Last_4_Account_Number__c}
                                                                <!--AcctSeed__Account_Number__c-->
                                                                <br />
                                                            </aura:iteration>
                                                        </aura:if>
                                                        
                                                        <aura:if isTrue="{!v.savedEcheckList.length}">
                                                            <aura:iteration items="{!v.savedEcheckList}" var="item"
                                                                            indexVar="index">
                                                                <!--<ui:inputRadio aura:id="picklistPaymentMethod"  name="paymentMethodRadioGroup" label="" value="{!item.isDefault == true}"
                                                            change="{!c.picklistPaymentMethodChange}" />  &nbsp;&nbsp;
                                                            --><!-- <option selected="{!OR(item.isDefault == true, item.isSetToPay == true)}" value="{!item.paymentMethod.Id}"> -->
                                                                <aura:if
