<aura:component
                implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction"
                access="global" controller="PaymentGatewayClass">
    <aura:html tag="style">
        .hideHelp .slds-form-element__help {
        display:none !important;
        }
    </aura:html>
    <ltng:require scripts="{!$Resource.jQueryV3_7}" />
    <aura:attribute name="termsAndConditionAccepted" type="Boolean" default='false' />
    <aura:attribute name="recordId" type="String" default='' />
    <aura:attribute name="emailRegex" type="String"
                    default="^[a-zA-Z0-9]+([._%+-][a-zA-Z0-9]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*\.[a-zA-Z]{2,}$" />
    <aura:attribute name="lastTime" type="String" default="" />
    <aura:attribute name="ipAddress" type="String" />
    <aura:attribute name="userSession" type="String" />
    <aura:attribute name="authenticatedPaymentMethod" type="List[]" />
    <aura:attribute name="isErrorFound" type="Boolean" default="false" />
    <aura:attribute name="isCC" type="Boolean" default="false" />
    <aura:attribute name="isInternalUser" type="Boolean" default="false" />
    <aura:attribute name="showPayMethodError" type="Boolean" default="false" />
    <aura:attribute name="policywrap" type="object" description="policy wrapper" />
    
    <aura:attribute name="formFactor" type="String" default="{!$Browser.formFactor}" />
    
    <aura:attribute name="donationType" type="String" />
    <aura:attribute name="isAnyQuoteSelected" type="Boolean" default="false" />
    
    
    <aura:attribute name="toastList" type="Object[]" description="This is for show toast messages" />
    <aura:registerEvent name="submitEvent" type="c:creditCardHostedPayEvent" />
    <aura:registerEvent name="errorEvent" type="c:creditCardHostedPayEvent" />
    <aura:handler name="submitEvent" event="c:creditCardHostedPayEvent" action="{!c.handleSubmitEvent}" />
    <aura:registerEvent name="backEvent" type="c:creditCardHostedPayEvent" />
    <aura:handler name="backEvent" event="c:creditCardHostedPayEvent" action="{!c.backToSavedScreenHandle}" />
    <aura:attribute name="paymentMethodData" type="Object" />
    
    <aura:attribute name="ISBAM_survey" type="ISBAM_Survey__c" />
    
    <aura:attribute name="showScreenLoading" type="boolean" default="true" description="it is loading screen" />
    <aura:attribute name="isDataLoadSuccess" type="boolean" default="false"
                    description="Is data will load successfully" />
    
    <!-- IL 107 fields -->
    <aura:attribute name="is_IL_107" type="boolean" default="false" description="IL 107 Endorsement flag" />
    <!--Use policywrap.endorsement.Coverage_Term__c	--> <!-- String:  Coverage_Term__c -->
    <!--Use policywrap.endorsement.Endorsement_Effective_Date__c  --> <!-- String:  Endorsement_Effective_Date__c -->
    
    
    <aura:attribute name="isHeaderFooterModal" type="boolean" default="false"
                    description="modal having header and footer" />
    <!-- <aura:attribute name="isWithoutHeaderFooterModal" type="boolean" default="true"
                    description="modal without having header and footer" /> -->
    <aura:attribute name="backToHomeScreen" type="boolean" default="false" />
    <aura:attribute name="isNextButtonDisabled" type="boolean" default="false" />
    
    <aura:attribute name="isSavedScreen" type="boolean" default="false"
                    description="saved card and echeck list screens" />
    <aura:attribute name="isAddScreen" type="boolean" default="false"
                    description="particular card or echeck details screen" />
    
    <aura:attribute name="currentActiveTab" type="string" default="tab-2"
                    description="Id of current Active tab in Credit and Echeck tabs" />
    
    <aura:attribute name="leftUpperFieldList" type="Object[]" description="Left Upper section fields list and values" />
    
    <aura:attribute name="isPayButDisable" type="boolean" default="false" />
    
    
    <!-- display Card Attributes -->
    <aura:attribute name="cardFirstFour" type="string" default='----' />
    <aura:attribute name="cardSecondFour" type="string" default='----' />
    <aura:attribute name="cardThirdFour" type="string" default='----' />
    <aura:attribute name="cardFourthFour" type="string" default='----' />
    <aura:attribute name="cardHolderName" type="String" default="Name on Card" />
    <aura:attribute name="cardExpiryMonth" type="String" default="--" />
    <aura:attribute name="cardExpiryYear" type="String" default="----" />
    <aura:attribute name="cardCvv" type="String" default="XXX" />
    <aura:attribute name="numberOfCardCvv" type="String" default="3" />
    <aura:attribute name="cardType" type="string" default="none" />
    
    <aura:attribute name="fieldDisabled" type="boolean" default="false" />
    
    <aura:attribute name="cardExpiryMonthList" type="Object[]" />
    <aura:attribute name="cardExpiryYearList" type="Object[]" />
    
    <aura:attribute name="savedCardList" type="Object[]" description="list of all saved cards" />
    <aura:attribute name="savedEcheckList" type="Object[]" description="list of all saved echeck" />
    <!-- Input field type for Card Number and CVV-->
    <aura:attribute name="dataType" type="String" default="number" />
    <aura:attribute name="dataTypeCvv" type="String" default="number" />
    
    <aura:attribute name="savedItemClick" type="boolean" default="false"
                    description="open saved card or echeck details" />
    <aura:attribute name="disableFields" type="boolean" default="false"
                    description="disable and Enable Security code and Date fields on Bind and Pay." />
    
    <aura:attribute name="isAddPaymentMethod" type="boolean" default="false"
                    description="if user click on addpayment button on home screen to hide invoice detail during add payment method" />
    
    
    <aura:attribute name="isConfirmationDelete" type="boolean" default="false" />
    <aura:attribute name="isConfirmDisabled" type="boolean" default="false" />
    <!-- Payment Status Screen in Modal -->
    <aura:attribute name="isPaymentSuccess" type="boolean" default="false" />
    <aura:attribute name="isPolicySuccess" type="boolean" default="false" />
    <aura:attribute name="isPaymentAndPolicyStatus" type="boolean" default="false" />
    <aura:attribute name="isPaymentError" type="boolean" default="false" />
    <aura:attribute name="paymentErrorMessageOnScreen" type="String" />
    <aura:attribute name="policyErrorMessageOnScreen" type="String" />
    
    
    <aura:attribute name="paymentMessageOnLoad" type="String" />
    
    <aura:attribute name="hidStepTwo" type="boolean" default="{!v.policywrap.policyDividend > 0}"
                    description="Hide Step two based on policyDivident" />
    
    <aura:attribute name="ibfContributionList" type="Object[]" description="IBF Contribution picklist values" />
    <aura:attribute name="ibfTargetList" type="Object[]" description="IBF target picklist values" />
    <aura:attribute name="TermsAndConditionWrapper" type="object" description="Endorsement Record List" />
    <!-- <aura:attribute name="EndorsementWrapperList" type="object[]" description="Endorsement Record List" /> -->
    <aura:attribute name="showIbfDependentFields" type="boolean" default="false"
                    description="Show if IBF Contribution value is Yes" />
    <aura:attribute name="showIbfTargetDependentField" type="boolean" default="false"
                    description="Show if IBF target == appellate district " />
    
    <aura:attribute name="tempselectedDate" type="Date" />
    <aura:attribute name="isDueDateValid" type="boolean" default="true" />
    <aura:attribute name="paymtDateMsgStyle" type="String" default="" />
    
    <aura:attribute name="Physical_Check" type="Boolean" default="false" />
    <aura:attribute name="hasError" type="Boolean" default="false" />
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <aura:handler name="change" value="{!v.isDataLoadSuccess}" action="{!c.isDataLoadSuccessHandle}" />
    <aura:handler name="change" value="{!v.isAddScreen}" action="{!c.savedAddScreenChangeHandle}" />
    <aura:handler name="change" value="{!v.isSavedScreen}" action="{!c.savedAddScreenChangeHandle}" />
    <!-- <aura:handler name="change" value="{!v.isHeaderFooterModal}" action="{!c.onChangeHeaderFooterModalHandle}" /> -->
    
    <aura:attribute name="updatedPermium" type="Decimal" />
    
    
    <aura:attribute name="paymentTypeOptions" type="List" default="[
                                                                   {'label': 'Full Payment', 'value': 'Full'},
                                                                   {'label': 'Quarterly Payments', 'value': 'Quarter'},
                                                                   {'label': 'Monthly Payments', 'value': 'Month'}
                                                                   ]" />
    <aura:attribute name="paymentOption" type="String" default="Full" />
    <!-- Toast  -->
    <div aura:id="toastId" class="toast smallPadding">
        <div class="dflex gap dflexac dflexfo smallPadding">
            <aura:if isTrue="{!v.toastList[0].type == 'suc'}">
                <lightning:icon iconName="action:approval" size="x-small" alternativeText="Success" title="Success" />
                <aura:set attribute="else">
                    <lightning:icon iconName="action:close" size="x-small" alternativeText="Error" title="Error" />
                </aura:set>
            </aura:if>
            <div class="dflexfo normalText">
                <div class="erroToast">
                    <aura:iteration items="{!v.toastList}" var="item">
                        <aura:if isTrue="{!item.type == 'suc'}">
                            <div class="successToastMessage">{!item.message}</div>
                            <aura:set attribute="else">
                                <div class="errorToastMessage">{!item.message}</div>
                            </aura:set>
                        </aura:if>
                    </aura:iteration>
                </div>
            </div>
            <div class="toastCloseBut" onclick="{!c.closeToastHandle}">
                <lightning:icon iconName="utility:close" size="x-small" alternativeText="close" title="Close" />
            </div>
        </div>
    </div>
    <!-- spinner -->
    <div aura:id="spinnerId" class="fullScreenSpinner">
        <div class="opposites">
            <div class="opposites bl"></div>
            <div class="opposites tr"></div>
            <div class="opposites br"></div>
            <div class="opposites tl"></div>
        </div>
    </div>
    
    <!-- popup -->
    <div class="popup" aura:id="popupID">
        <div class="popupModal dflexcol">
            <aura:if isTrue="{!v.isHeaderFooterModal}">
                <div class="popupHeader dflex gap dflexac dflexjspace mediumPadding">
                    <aura:if isTrue="{!v.isSavedScreen}">
                        <div class="mainHeading">
                            Select Card / eCheck
                        </div>
                    </aura:if>
                    <aura:if isTrue="{!v.isAddScreen}">
                        <aura:if isTrue="{!v.isAddPaymentMethod}">
                            <div class="mainHeading">
                                Confirm Payment
                            </div>
                            <aura:set attribute="else">
                                <div class="mainHeading">
                                    Enter Details
                                </div>
                            </aura:set>
                        </aura:if>
                    </aura:if>
                    <div class="popupCloseButton" onclick="{!c.closemodalHandle}">
                        <lightning:icon iconName="utility:close" size="x-small" alternativeText="close" title="Close" />
                    </div>
                </div>
                <div class="popupContainer dflexfo dflex">
                    <!-- Saved Cards and Echeck List Screen -->
                    <aura:if isTrue="{!v.isSavedScreen}">
                        <div class="dflexfo dflexcol gap overflowHidden popupContainerInner">
                            <div class="dflexfo dflexcol borderBox cardSection">
                                <div class="savedHeader normalHeading" style="border-top-right-radius: 0.4rem; border-top-left-radius: 0.4rem;">Saved eCheck</div>
                                <aura:if isTrue="{!v.savedEcheckList.length}">
                                    <div class="cardSliderBox dflexfo savedScrollable scrollbar-x dflex dflexac gap">
                                        <aura:iteration items="{!v.savedEcheckList}" var="item" indexVar="index">
                                            <!-- Card Starts from here -->
                                            <div class="displayCard-saved dflexcol dflexjspace mediumPadding deleteParent"
                                                 data-from="savedList" data-recordid="{!index}" data-recordtype="check">
                                                <!--onclick="{!c.savedItemClickHandle}"-->
                                                <aura:if isTrue="{!!item.isPendingDelete}">
                                                    <div class="deleteButtonDiv" title="Delete"
                                                         onclick="{!c.deleteSavedItemHandle}" data-recordid="{!index}"
                                                         data-recordtype="eCheck">
                                                        <lightning:icon iconName="utility:delete" size="x-small"
                                                                        alternativeText="delete" title="delete" />
                                                    </div>
                                                </aura:if>
                                                
                                                <div class="cardHolderName">
                                                    Routing number :
                                                </div>
                                                <div class="cardNumber-saved">
                                                    {!item.routingNumber}
                                                    <!-- Tushar Goyal -->
                                                </div>
                                                <div class="cardHolderName">
                                                    Account number :
                                                </div>
                                                <div class="cardNumber-saved">
                                                    {!item.accountHolderName}
                                                </div>
                                            </div>
                                        </aura:iteration>
                                    </div>
                                    <aura:set attribute="else">
                                        <div class="cardSliderBox dflexfo dflexcen dflex dflexac gap">
                                            No Saved E-Checks.
                                        </div>
                                    </aura:set>
                                </aura:if>
                            </div>
                            <div class="dflexfo dflexcol borderBox cardSection">
                                <div class="savedHeader normalHeading" style="width: 52.25rem; border-top-right-radius: 0.4rem; border-top-left-radius: 0.4rem;">Saved Cards</div>
                                <aura:if isTrue="{!v.savedCardList.length}">
                                    <div class="cardSliderBox dflexfo savedScrollable scrollbar-x dflex dflexac gap">
                                        <aura:iteration items="{!v.savedCardList}" var="item" indexVar="index">
                                            <!-- Card Starts from here -->
                                            <div class="displayCard-saved dflexcol dflexjspace mediumPadding deleteParent"
                                                 data-from="savedList" data-recordid="{!index}"
                                                 data-recordtype="creditCard">
                                                <!--
            onclick="{!c.savedItemClickHandle}" "from above div" -->
                                                <aura:if isTrue="{!!item.isPendingDelete}">
                                                    <div class="deleteButtonDiv" title="Delete"
                                                         onclick="{!c.deleteSavedItemHandle}" data-recordid="{!index}"
                                                         data-recordtype="creditCard">
                                                        <lightning:icon iconName="utility:delete" size="x-small"
                                                                        alternativeText="delete" title="delete" />
                                                    </div>
                                                </aura:if>
                                                <div class="dflex dflexjspace rs_orderTwo">
                                                    <div class="expiryValue">
                                                        {!item.expireMonth}/{!item.expireYear}
                                                    </div>
                                                    <aura:if isTrue="{!item.isDefault}">
                                                        <div class="defaultMethod normalText">
                                                            Default
                                                        </div>
                                                    </aura:if>
                                                    <aura:if isTrue="{!item.isPendingDelete}">
                                                        <div class="pendingDelete normalText">
                                                            Pending Delete
                                                        </div>
                                                    </aura:if>
                                                </div>
                                                <div class="cardHolderName rs_orderOne">
                                                    {!item.nameOnCard}
                                                    <!-- Tushar Goyal -->
                                                </div>
                                                <div class="dflex dflexjspace rs_orderThree">
                                                    <div class="cardNumber-saved">
                                                        {!item.cardNumber}
                                                    </div>
                                                    <div class="cardTypeImage">
                                                        <aura:if isTrue="{!item.cardTypeVar.cardType == 'none'}">
                                                            <aura:set attribute="else">
                                                                <img alt="cardTypeImage" class="cardTypeImage"
                                                                     src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/CardType/' + item.cardTypeVar +'.png'}" />
                                                                <aura:if
                                                                         isTrue="{!AND(AND(item.cardTypeVar != 'visa' , item.cardTypeVar != 'amex') , AND(item.cardTypeVar != 'mc' , item.cardTypeVar != 'disc'))}">
                                                                    In Valid
                                                                </aura:if>
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                            </div>
                                        </aura:iteration>
                                    </div>
                                    <aura:set attribute="else">
                                        <div class="cardSliderBox dflexfo dflexcen scrollbar-x dflex dflexac gap">
                                            No Saved Cards.
                                        </div>
                                    </aura:set>
                                </aura:if>
                            </div>
                            
                        </div>
                    </aura:if>
                    <!-- Add new Cards and Echeck Screen -->
                    <aura:if isTrue="{!v.isAddScreen}">
                        <div class="dflexfo tabs dflexcol borderBox">
                            <aura:if isTrue="{!AND(NOT(v.isAddPaymentMethod), NOT(v.savedItemClick))}">
                                <div class="tabHeader dflex">
                                    <div aura:id="tab-2" id="tab-2" data-tabvalue="check" onclick="{!c.tabSwitchHandle}"
                                         class="tabHeading normalHeading dflexfo activeTab" style="border-top-left-radius: 0.4rem;">
                                        eCheck/ACH
                                    </div>
                                    <div aura:id="tab-1" id="tab-1" data-tabvalue="creditCard"
                                         onclick="{!c.tabSwitchHandle}" class="tabHeading normalHeading dflexfo " style="border-top-right-radius: 0.4rem;">
                                        Credit Card
                                    </div>
                                    
                                </div>
                            </aura:if>
                            <div class="tabContainer dflex hoverScrollableDivOnHover scrollableDiv">
                                <div aura:id="tab-1-data" class="tabData dflexfo dflex gap ">
                                    
                                    <aura:if isTrue="{!!v.isAddPaymentMethod}">
                                        <div class="iframeWidth" style = "position:relative;">
                                            <div class="dflexcol gap inputFieldSection dflexfo">
                                                <iframe class="addCard DisplayDesktop" src="/apex/PaymentGatewayFiservHostedVfp?showDummyCard=Yes" frameborder="0"></iframe>
                                                <iframe class="addCard DisplayMobile" src="/apex/PaymentGatewayFiservHostedVfp?showDummyCard=No" frameborder="0"></iframe>
                                                
                                            </div>
                                            
                                            
                                            <div class="dflexcol gap DisPlayNone" style = "position:absolute;top:5rem;right:0;">
                                                <div class="dflexfo displayCardDiv dflexcen" style="width: 22rem;">
                                                    <!-- Card Starts from here -->
                                                    <div class="displayCard">
                                                        <!-- front side of card -->
                                                        <div aura:id="card-front"
                                                             class="card__side displayCardInner-front dflexcol mediumPadding">
                                                            <div class="imageRow dflex dflexjspace dflexfo">
                                                                <div class="chipImage">
                                                                    <img alt="chipImage" class="chip"
                                                                         src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/CardChip.png'}" />
                                                                </div>
                                                                <div class="wifiImage">
                                                                    <img alt="wifiImage" class="wifi"
                                                                         src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/wifiWhiteTwo.png'}" />
                                                                </div>
                                                            </div>
                                                            <div class="cardNumberRow dflexfo dflex dflexae dflexjspace">
                                                                <div class="cardNumberInd">
                                                                    XXXX
                                                                </div>
                                                                <div class="cardNumberInd">
                                                                    XXXX
                                                                </div>
                                                                <div class="cardNumberInd">
                                                                    XXXX
                                                                </div>
                                                                <div class="cardNumberInd">
                                                                    XXXX
                                                                </div>
                                                            </div>
                                                            <div class="expiryDateRow dflexcen smallGap dflexfo">
                                                                <div class="expiryTitle">VALID THRU</div>
                                                                <div class="expiryValue">
                                                                    MM/YYYY
                                                                </div>
                                                            </div>
                                                            <div class="cardHolderNameRow dflex dflexjspace dflexae">
                                                                <div class="cardHolderName">
                                                                    Card Holder Name
                                                                </div>
                                                                
                                                            </div>
                                                        </div>
                                                        <!-- back side of card -->
                                                        <div aura:id="card-back"
                                                             class="card__side displayCardInner-back dflexcol">
                                                            <div class="stripRow"></div>
                                                            <div class="cvvRow dflex ">
                                                                <div class="signatureLine dflexfo"></div>
                                                                <div class="cvv dflexcen">CVV</div>
                                                            </div>
                                                            <div class="dummyTextRow ">
                                                                
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </aura:if>
                                    <!-- <aura:if isTrue="{!!v.isAddPaymentMethod}">-->
                                    <!--<div class="dflexcol gap inputFieldSection dflexfo">
                                            <!- <div class="dflex gap">
                                                            <div class="inputField dflexfo">
                                                                <div class="label">First Name</div>
                                                                <input type="text" value="{!v.policywrap.firstName}"
                                                                    onblur="{!c.fieldEmptyHandle}" id="cardFirstName" name="First Name"
                                                                    required="true" />
                                                            </div>
                                                            <div class="inputField dflexfo">
                                                                <div class="label">Last Name</div>
                                                                <input type="text" value="{!v.policywrap.lastName}"
                                                                    onblur="{!c.fieldEmptyHandle}" id="cardLastName" name="Last Name"
                                                                    required="true" />
                                                            </div>
                                                        </div> ->
                                            <div class="inputField rs_col">
                                                <div class="label">Card Type</div>
                                                <select name="Card Type" value="{!v.policywrap.cardTypeVar}"
                                                    disabled="{!v.savedItemClick}" onchange="{!c.cardTypeHandle}"
                                                    id="cardType">
                                                    <option selected="{!v.policywrap.cardTypeVar == 'none'}"
                                                        value="none">
                                                        Please select</option>
                                                    <option selected="{!v.policywrap.cardTypeVar == 'amex'}"
                                                        value="amex">
                                                        American Express</option>
                                                    <option selected="{!v.policywrap.cardTypeVar == 'disc'}"
                                                        value="disc">
                                                        disc Card</option>
                                                    <option selected="{!v.policywrap.cardTypeVar == 'MasterCard'}"
                                                        value="MasterCard">
                                                        Mastercard</option>
                                                    <option selected="{!v.policywrap.cardTypeVar == 'visa'}"
                                                        value="visa">
                                                        Visa</option>
                                                </select>
                                                <div style="padding-left: 10px; color: gray; font-size: 0.9em;"
                                                    class="secline">* a
                                                    {!v.policywrap.ccFeeRate}% service fee will be added to Credit Card transactions</div>
                                            </div>
                                            <div class="dflex gap rs_col">
                                                <div class="inputField dflexfo">
                                                    <div class="label">Card Number</div>
                                                    <input disabled="{!v.savedItemClick}" type="{!v.dataType}"
                                                        value="{!v.policywrap.cardNumber}"
                                                        onkeyup="{!c.keyUpCardNumberHandle}"
                                                        onblur="{!c.cardNumberHandle}" id="cardNumber"
                                                        name="Card Number" />
                                                </div>
                                                <div class="inputField dflexfo">
                                                    <div class="label">Security Code</div>
                                                    <input type="{!v.dataTypeCvv}"
                                                        value="{!v.policywrap.verificationNumber}"
                                                        disabled="{!v.disableFields}" onkeyup="{!c.keyUpCvvHandle}"
                                                        onfocus="{!c.cvvFocusInHandle}"
                                                        onfocusout="{!c.cvvFocusOutHandle}" onblur="{!c.cvvValidHandle}"
                                                        id="cardCVV" name="Security Code" />
                                                </div>
                                            </div>
                                            <div class="dflex gap rs_col">
                                                <div class="inputField dflexfo">
                                                    <div class="label">Expiration Month</div>
                                                    <select name="Expiry Date" onchange="{!c.expiryChangeHandle}"
                                                        disabled="{!v.disableFields}" id="cardExpiryMonth"
                                                        value="{!v.policywrap.expireMonth}">
                                                        <aura:iteration items="{!v.cardExpiryMonthList}" var="item">
                                                            <aura:if isTrue="{!item.label == v.policywrap.expireMonth}">
                                                                <option selected="true" value="{!item.label}">
                                                                    {!item.value}
                                                                </option>
                                                                <aura:set attribute="else">
                                                                    <option value="{!item.label}">{!item.value}</option>
                                                                </aura:set>
                                                            </aura:if>
                                                        </aura:iteration>
                                                    </select>
                                                </div>
                                                <div class="inputField dflexfo">
                                                    <div class="label">Expiration Year</div>
                                                    <select name="Expiry Date" value="{!v.policywrap.expireYear}"
                                                        disabled="{!v.disableFields}" onchange="{!c.expiryChangeHandle}"
                                                        id="cardExpiryYear">
                                                        <aura:iteration items="{!v.cardExpiryYearList}" var="item">
                                                            <aura:if isTrue="{!item.label == v.policywrap.expireYear}">
                                                                <option selected="true" value="{!item.label}">
                                                                    {!item.value}
                                                                </option>
                                                                <aura:set attribute="else">
                                                                    <option value="{!item.label}">{!item.value}</option>
                                                                </aura:set>
                                                            </aura:if>
                                                        </aura:iteration>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="inputField">
                                                <div class="label">Name on Card</div>
                                                <input disabled="{!v.savedItemClick}" type="text"
                                                    value="{!v.policywrap.nameOnCard}"
                                                    onkeyup="{!c.keyUpCardHolderNameHandle}"
                                                    onblur="{!c.fieldEmptyHandle}" id="cardNameOnCard"
                                                    name="Name On Card" />
                                            </div>
                                        </div>-->
                                    <!--<iframe class="addCard" src="/apex/PaymentGatewayFiservHostedVfp" frameborder="0"></iframe>
                                    </aura:if>-->
                                    <aura:if isTrue="{!v.isAddPaymentMethod}">
                                        <div class="dflexfo dflexcol gap mediumPadding">
                                            
                                            <aura:if isTrue="{!!v.Physical_Check}">
                                                <div class="dflexfo displayCardDiv dflexcen" style="width: 22rem;">
                                                    <!-- Card Starts from here -->
                                                    <div class="displayCard">
                                                        <!-- front side of card -->
                                                        <div aura:id="card-front"
                                                             class="card__side displayCardInner-front dflexcol mediumPadding">
                                                            <div class="imageRow dflex dflexjspace dflexfo">
                                                                <div class="chipImage">
                                                                    <img alt="chipImage" class="chip"
                                                                         src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/CardChip.png'}" />
                                                                </div>
                                                                <div class="wifiImage">
                                                                    <img alt="wifiImage" class="wifi"
                                                                         src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/wifiWhiteTwo.png'}" />
                                                                </div>
                                                            </div>
                                                            <div class="cardNumberRow dflexfo dflex dflexae dflexjspace">
                                                                <div class="cardNumberInd">
                                                                    {!v.cardFirstFour}
                                                                </div>
                                                                <div class="cardNumberInd">
                                                                    {!v.cardSecondFour}
                                                                </div>
                                                                <div class="cardNumberInd">
                                                                    {!v.cardThirdFour}
                                                                </div>
                                                                <div class="cardNumberInd">
                                                                    {!v.cardFourthFour}
                                                                </div>
                                                            </div>
                                                            <div class="expiryDateRow dflexcen smallGap dflexfo">
                                                                <div class="expiryTitle">VALID THRU</div>
                                                                <div class="expiryValue">
                                                                    {!v.cardExpiryMonth}/{!v.cardExpiryYear}
                                                                </div>
                                                            </div>
                                                            <div class="cardHolderNameRow dflex dflexjspace dflexae">
                                                                <div class="cardHolderName">
                                                                    {!v.cardHolderName}
                                                                </div>
                                                                <div class="cardTypeImage">
                                                                    <aura:if isTrue="{!v.cardType == 'none'}">
                                                                        ---
                                                                        <aura:set attribute="else">
                                                                            <aura:if
                                                                                     isTrue="{!AND(AND(v.cardType != 'visa' , v.cardType != 'amex') , AND(v.cardType != 'mc' , v.cardType != 'disc'))}">
                                                                                Invalid
                                                                                <aura:set attribute="else">
                                                                                    <img alt="cardTypeImage"
                                                                                         class="cardTypeImage"
                                                                                         src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/CardType/' + v.cardType +'.png'}" />
                                                                                </aura:set>
                                                                            </aura:if>
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <!-- back side of card -->
                                                        <div aura:id="card-back"
                                                             class="card__side displayCardInner-back dflexcol">
                                                            <div class="stripRow"></div>
                                                            <div class="cvvRow dflex ">
                                                                <div class="signatureLine dflexfo"></div>
                                                                <div class="cvv dflexcen">{!v.cardCvv}</div>
                                                            </div>
                                                            <div class="dummyTextRow ">
                                                                
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </aura:if>
                                            <aura:if isTrue="{!v.isAddPaymentMethod}">
                                                <div class="transactionDetails borderBox mediumPadding">
                                                    <div class="detailLine dflex dflexjspace">
                                                        <div class="head">Policy #:</div>
                                                        <div class="value">
                                                            <aura:if isTrue="{!v.policywrap.invoiceId != null}">
                                                                {!v.policywrap.invoiceId}
                                                                <aura:set attribute="else">
                                                                    ---
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                    <div class="detailLine dflex dflexjspace">
                                                        <div class="head">Effective Date</div>
                                                        <div class="value">
                                                            <aura:if isTrue="{!v.policywrap.effectiveDateStr != null}">
                                                                {!v.policywrap.effectiveDateStr}
                                                                <aura:set attribute="else">
                                                                    
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                    <div class="detailLine dflex dflexjspace">
                                                        <div class="head">Premium</div>
                                                        <div class="value">
                                                            <aura:if isTrue="{!v.policywrap.premium != null}">
                                                                <lightning:formattedNumber maximumFractionDigits="0"
                                                                                           value="{!v.policywrap.premium}" style="currency"
                                                                                           currencyCode="USD" />
                                                                <aura:set attribute="else">
                                                                    ---
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                </div>
                                                <aura:if
                                                         isTrue="{!AND(v.policywrap.totalAmountDue != null, v.policywrap.totalAmountDue > 0)}">
                                                    <div class="totalAmount dflex dflexjspace mediumPadding dflexac">
                                                        <div class="normalText">Total due today:</div>
                                                        <div class="normalHeading">
                                                            <aura:if isTrue="{!v.policywrap.totalAmountDue != null}">
                                                                <aura:if isTrue="{!v.isCC}">
                                                                    <lightning:formattedNumber maximumFractionDigits="2"
                                                                                               value="{!((v.policywrap.totalAmountDue * (100 + v.policywrap.ccFeeRate))/100)}"
                                                                                               style="currency" currencyCode="USD" />
                                                                    <aura:set attribute="else">
                                                                        <lightning:formattedNumber maximumFractionDigits="2"
                                                                                                   value="{!v.policywrap.totalAmountDue}"
                                                                                                   style="currency" currencyCode="USD" />
                                                                    </aura:set>
                                                                </aura:if>
                                                                <!--lightning:formattedNumber maximumFractionDigits="2"
                                                                                       value="{!v.policywrap.totalAmountDue}" style="currency"
                                                                                       currencyCode="USD" /-->
                                                                <aura:set attribute="else">
                                                                    ---
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                    <aura:set attribute="else">
                                                        <div class="totalAmount dflexcol dflexjspace mediumPadding dflexac">
                                                            <div class="dflex dflexjspace dflexac" style="width: 100%;">
                                                                <div class="normalText">Next Payment Date:</div>
                                                                <div class="normalHeading">
                                                                    {!v.policywrap.firstInstallmentDateString}
                                                                </div>
                                                            </div>
                                                            <div class="dflex dflexjspace dflexac" style="width: 100%;">
                                                                <div class="normalText">Next Payment Amount:</div>
                                                                <div class="normalHeading">
                                                                    <aura:if isTrue="{!v.isCC}">
                                                                        <lightning:formattedNumber maximumFractionDigits="2"
                                                                                                   value="{! (v.policywrap.firstInstallment* v.policywrap.ccFeeRate/100) + v.policywrap.firstInstallment}"
                                                                                                   style="currency" currencyCode="USD" />
                                                                        <aura:set attribute="else">
                                                                            <lightning:formattedNumber
                                                                                                       maximumFractionDigits="2"
                                                                                                       value="{!v.policywrap.firstInstallment}"
                                                                                                       style="currency" currencyCode="USD" />
                                                                        </aura:set>
                                                                    </aura:if>
                                                                    <!--lightning:formattedNumber maximumFractionDigits="2"
                                                                                           value="{!v.policywrap.firstInstallment}" style="currency"
                                                                                           currencyCode="USD" /-->
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </aura:set>
                                                </aura:if>
                                                <div class="inputField paddingBottom">
                                                    <div class="label">Send confirmation email</div>
                                                    <input type="text" value="{!v.policywrap.confirmationEmail}"
                                                           onblur="{!c.securityMailHandle}" id="cardSendConfirmationEmail"
                                                           name="Confirmation Email" />
                                                </div>
                                            </aura:if>
                                            
                                            <div class="autoPayCheckBox dflexcen smallGap borderBox" style="display: none;">
                                                <input type="checkbox" checked="{!v.policywrap.isAutoPay}"
                                                       name="creditcardAutoPay" id="creditcardAutoPay" />
                                                Set as Default
                                            </div>
                                        </div> 
                                    </aura:if>
                                </div>
                                <div aura:id="tab-2-data" class="tabData dflexfo dflexcol gap activeTabData">
                                    <div class="dflex mediumPadding">
                                        <aura:if isTrue="{!!v.isAddPaymentMethod}">
                                            <div class="dflexcol gap inputFieldSection dflexfo">
                                                <!-- <div class="dflex gap">
                                                                <div class="inputField dflexfo">
                                                                    <div class="label">First Name</div>
                                                                    <input type="text" value="{!v.policywrap.firstName}"
                                                                        onblur="{!c.fieldEmptyHandle}" id="checkFirstName"
                                                                        name="First Name" />
                                                                </div>
                                                                <div class="inputField dflexfo">
                                                                    <div class="label">Last Name</div>
                                                                    <input type="text" value="{!v.policywrap.lastName}"
                                                                        onblur="{!c.fieldEmptyHandle}" id="checkLastName"
                                                                        name="Last Name" />
                                                                </div>
                                                            </div> -->
                                                <div class="dflex gap rs_col res_gap">
                                                    <div class="inputField dflexfo">
                                                        <div class="label">Routing Number</div>
                                                        <input disabled="{!v.savedItemClick}" type="text"
                                                               value="{!v.policywrap.routingNumber}"
                                                               onblur="{!c.routingNumberHandle}" id="checkRoutingNumber"
                                                               name="Routing Number" />
                                                    </div>
                                                    <div class="inputField dflexfo">
                                                        <div class="label">Account Number</div>
                                                        <input disabled="{!v.savedItemClick}" type="text"
                                                               value="{!v.policywrap.accountNumber}"
                                                               onblur="{!c.accountNumberHandle}" id="checkAccountNumber"
                                                               name="Account Number" />
                                                    </div>
                                                </div>
                                                <div class="inputField">
                                                    <div class="label">Account Type</div>
                                                    <select disabled="{!v.savedItemClick}" name="Account Type"
                                                            value="{!v.policywrap.accountType}"
                                                            onchange="{!c.accountTypeHandle}" id="checkAccountType">
                                                        <option selected="{!v.policywrap.accountType == 'none'}"
                                                                value="none">
                                                            Please select</option>
                                                        <option selected="{!v.policywrap.accountType == 'checking'}"
                                                                value="checking">Checking</option>
                                                        <option selected="{!v.policywrap.accountType == 'savings'}"
                                                                value="savings">Savings</option>
                                                    </select>
                                                </div>
                                                <div class="inputField">
                                                    <div class="label">Account Holder Name</div>
                                                    <input disabled="{!v.savedItemClick}" type="text"
                                                           value="{!v.policywrap.accountHolderName}"
                                                           onblur="{!c.fieldEmptyHandle}" id="checkAccountHolderName"
                                                           name="Account Holder Name" />
                                                </div>
                                            </div>
                                        </aura:if>
                                        <div class="dflexfo dflexcol gap DisPlayNone">
                                            <aura:if isTrue="{!!v.isAddPaymentMethod}">
                                                <div class="dflexfo displayCardDiv dflexcen" style="width: 22rem;">
                                                    <div class="displayEcheckSample">
                                                        <img alt="echeckSampleImage" class="echeckSampleImage"
                                                             src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/eCheckDetailsSampleImage.png'}" />
                                                    </div>
                                                </div>
                                            </aura:if>
                                            <aura:if isTrue="{!v.isAddPaymentMethod}">
                                                <div class="transactionDetails borderBox mediumPadding">
                                                    <div class="detailLine dflex dflexjspace">
                                                        <div class="head">Account Number</div>
                                                        <div class="value">
                                                            <aura:if isTrue="{!v.policywrap.accountNumber != null}">
                                                                {!v.policywrap.accountNumber}
                                                                <aura:set attribute="else">
                                                                    ---
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                    <div class="detailLine dflex dflexjspace">
                                                        <div class="head">Account Holder Name</div>
                                                        <div class="value">
                                                            <aura:if isTrue="{!v.policywrap.accountHolderName != null}">
                                                                {!v.policywrap.accountHolderName}
                                                                <aura:set attribute="else">
                                                                    --
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                    <div class="detailLine dflex dflexjspace">
                                                        <div class="head">Account Type</div>
                                                        <div class="value">
                                                            <aura:if isTrue="{!v.policywrap.accountType != null}">
                                                                {!v.policywrap.accountType}
                                                                <aura:set attribute="else">
                                                                    ---
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="transactionDetails borderBox mediumPadding">
                                                    <div class="detailLine dflex dflexjspace">
                                                        <div class="head">Policy #:</div>
                                                        <div class="value">
                                                            <aura:if isTrue="{!v.policywrap.invoiceId != null}">
                                                                {!v.policywrap.invoiceId}
                                                                <aura:set attribute="else">
                                                                    ---
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                    <div class="detailLine dflex dflexjspace">
                                                        <div class="head">Effective Date</div>
                                                        <div class="value">
                                                            <aura:if isTrue="{!v.policywrap.effectiveDateStr != null}">
                                                                {!v.policywrap.effectiveDateStr}
                                                                <aura:set attribute="else">
                                                                    --
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                    <div class="detailLine dflex dflexjspace">
                                                        <div class="head">Premium</div>
                                                        <div class="value">
                                                            <aura:if isTrue="{!v.policywrap.premium != null}">
                                                                <lightning:formattedNumber maximumFractionDigits="0"
                                                                                           value="{!v.policywrap.premium}" style="currency"
                                                                                           currencyCode="USD" />
                                                                <aura:set attribute="else">
                                                                    ---
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <aura:if
                                                         isTrue="{!AND(v.policywrap.totalAmountDue != null, v.policywrap.totalAmountDue > 0)}">
                                                    <div class="totalAmount dflex dflexjspace mediumPadding dflexac">
                                                        <div class="normalText">Total due today:</div>
                                                        <div class="normalHeading">
                                                            <aura:if isTrue="{!v.policywrap.totalAmountDue != null}">
                                                                <aura:if isTrue="{!v.isCC}">
                                                                    <lightning:formattedNumber maximumFractionDigits="2"
                                                                                               value="{! (v.policywrap.totalAmountDue* v.policywrap.ccFeeRate/100) + v.policywrap.totalAmountDue}"
                                                                                               style="currency" currencyCode="USD" />
                                                                    <aura:set attribute="else">
                                                                        <lightning:formattedNumber maximumFractionDigits="2"
                                                                                                   value="{!v.policywrap.totalAmountDue}"
                                                                                                   style="currency" currencyCode="USD" />
                                                                    </aura:set>
                                                                </aura:if>
                                                                
                                                                <!--lightning:formattedNumber maximumFractionDigits="2"
                                                                                           value="{!v.policywrap.totalAmountDue}" style="currency"
                                                                                           currencyCode="USD" /-->
                                                                
                                                                <aura:set attribute="else">
                                                                    ---
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                    <aura:set attribute="else">
                                                        <div class="totalAmount dflexcol dflexjspace mediumPadding dflexac">
                                                            <div class="dflex dflexjspace dflexac" style="width: 100%;">
                                                                <div class="normalText">Next Payment Date:</div>
                                                                <div class="normalHeading">
                                                                    {!v.policywrap.firstInstallmentDateString}
                                                                </div>
                                                            </div>
                                                            <div class="dflex dflexjspace dflexac" style="width: 100%;">
                                                                <div class="normalText">Next Payment Amount:</div>
                                                                <div class="normalHeading">
                                                                    <aura:if isTrue="{!v.isCC}">
                                                                        <lightning:formattedNumber maximumFractionDigits="2"
                                                                                                   value="{! (v.policywrap.firstInstallment* v.policywrap.ccFeeRate/100) + v.policywrap.firstInstallment}"
                                                                                                   style="currency" currencyCode="USD" />
                                                                        <aura:set attribute="else">
                                                                            <lightning:formattedNumber
                                                                                                       maximumFractionDigits="2"
                                                                                                       value="{!v.policywrap.firstInstallment}"
                                                                                                       style="currency" currencyCode="USD" />
                                                                        </aura:set>
                                                                    </aura:if>
                                                                    <!--lightning:formattedNumber maximumFractionDigits="2"
                                                                                               value="{!v.policywrap.firstInstallment}" style="currency"
                                                                                               currencyCode="USD" /-->
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </aura:set>
                                                </aura:if>
                                                
                                                <div class="inputField paddingBottom">
                                                    <div class="label">Send confirmation email</div>
                                                    <input type="text" value="{!v.policywrap.confirmationEmail}"
                                                           onblur="{!c.securityMailHandle}" id="checkSendConfirmationEmail"
                                                           name="Confirmation Email" />
                                                </div>
                                            </aura:if>
                                            
                                            <div class="autoPayCheckBox dflexcen smallGap borderBox" style="display: none;">
                                                <input type="checkbox" checked="{!v.policywrap.isAutoPay}"
                                                       name="echeckAutoPay" id="echeckAutoPay" />
                                                Set as Default
                                            </div>
                                        </div>
                                    </div>
                                    <aura:if isTrue="{!AND(v.isAddScreen ,AND(NOT(v.isSavedScreen), NOT(v.isAddPaymentMethod)))}">   
                                        <div class="popupFooter mediumPadding dflex dflexac dflexjspace gap">
                                            <div class="modalButton negativeBut " onclick="{!c.backToSavedScreenHandle}">
                                                Back
                                            </div>
                                            <div class="modalButton negativeBut" data-type="save"
                                                 onclick="{!c.updateSavePayHandle}">
                                                Save<!-- Card / eCheck-->
                                            </div>
                                        </div>
                                    </aura:if>
                                </div>
                            </div>
                        </div>
                    </aura:if>
                </div>
                <aura:if isTrue="{!!AND(v.isAddScreen ,AND(NOT(v.isSavedScreen), NOT(v.isAddPaymentMethod)))}">                    
                    <div class="popupFooter mediumPadding dflex dflexac dflexjspace gap">
                        <!-- Saved Cards and Echeck List Screen Footer -->
                        <aura:if isTrue="{!v.isSavedScreen}">
                            <div class="modalButton negativeBut " onclick="{!c.closemodalHandle}">
                                Cancel
                            </div>
                            
                            <div class="modalButton positiveBut" data-from="modal" onclick="{!c.addPaymentMethodHandle}">
                                Add Payment Method
                            </div>
                        </aura:if>
                        <!-- Add new Cards and Echeck Screen Footer -->
                        <aura:if isTrue="{!v.isAddScreen}">
                            <div class="dflex gap">
                                <aura:if isTrue="{!v.isAddPaymentMethod}">
                                    <aura:if isTrue="{!v.disableFields}">
                                        <div class="modalButton negativeBut " onclick="{!c.backToSavedScreenHandle}">
                                            Back
                                        </div>
                                        <aura:set attribute="else">
                                            <div class="modalButton negativeBut " onclick="{!c.handleCancelOnPay}">
                                                Cancel
                                            </div>
                                        </aura:set>
                                    </aura:if>
                                    
                                    <!-- <div class="modalButton positiveBut" data-from="modal" onclick="{!c.handleEditOnPay}">
                                                Edit
                                            </div> -->
                                    <aura:set attribute="else">
                                        <div class="modalButton negativeBut " onclick="{!c.backToSavedScreenHandle}">
                                            Back
                                        </div>
                                    </aura:set>
                                </aura:if>
                            </div>
                            
                            <div class="totalAmountInModal dflex dflexjspace mediumPadding dflexac">
                                <div class="normalText">Total:</div>
                                <div class="normalHeading">
                                    <aura:if isTrue="{!v.policywrap.balanceDue != null}">
                                        <lightning:formattedNumber maximumFractionDigits="0"
                                                                   value="{!v.policywrap.totalAmountDue}" style="currency" currencyCode="USD" />
                                        <aura:set attribute="else">
                                            ---
                                        </aura:set>
                                    </aura:if>
                                </div>
                            </div>
                            <div class="dflex gap">
                                <aura:if isTrue="{!v.isAddPaymentMethod}">
                                    <aura:if isTrue="{!v.isConfirmDisabled}">
                                        <div class="modalButton disableBut negativeBut" data-type="pay">
                                            Confirm
                                        </div>
                                        <aura:set attribute="else">
                                            <div class="modalButton positiveBut" data-type="pay"
                                                 onclick="{!c.proceedToPaymentHandle}">
                                                Confirm
                                            </div>
                                        </aura:set>
                                    </aura:if>
                                    
                                    <aura:set attribute="else">
                                        <aura:if isTrue="{!v.savedItemClick}">
                                            <div class="modalButton negativeBut" data-type="update"
                                                 onclick="{!c.updateSavePayHandle}">
                                                Update Card / eCheck
                                            </div>
                                            <div class="modalButton negativeBut" data-type="setToPay"
                                                 onclick="{!c.updateSavePayHandle}">
                                                Set to Pay
                                            </div>
                                            <aura:set attribute="else">
                                                <div class="modalButton negativeBut" data-type="save"
                                                     onclick="{!c.updateSavePayHandle}">
                                                    Save<!-- Card / eCheck-->
                                                </div>
                                            </aura:set>
                                        </aura:if>
                                    </aura:set>
                                </aura:if>
                            </div>
                        </aura:if>
                    </div>
                </aura:if>
                
            </aura:if>
            <!-- <aura:if isTrue="{!v.isWithoutHeaderFooterModal}"> -->
            
            <aura:if isTrue="{!v.showPayMethodError}">
                <div class="popupContainer dflexfo dflex">
                    <div class="dflexfo smallPopupModalTwo dflexcol gap mediumPadding">
                        <div class="mainHeading mediumPadding textCenter" style="width: 40rem;">No Payment Method
                            Selected.</div>
                    </div>
                    
                </div>
                <div class="popupFooter mediumPadding dflex dflexje gap">
                    <div data-buttype="OK" class="modalButton negativeBut" Style="font-weight: 600;"
                         onclick="{!c.closePayMethodErrorModal}">
                        OK
                    </div>
                </div>
            </aura:if>
            
            <!-- Payment Error Screen -->
            <aura:if isTrue="{!v.isPaymentError}">
                <div class="dflexfo smallPopupModal dflexcol gap">
                    <div class="imageBox textCenter dflexcen">
                        <img alt="paymentStatusImage" class="errorImage"
                             src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/ErrorImage.png'}" />
                    </div>
                    <div class="paymentStatus normalHeading textCenter">Status: Payment Unsuccessful </div>
                    <div class="paymentMessage textCenter normalText">
                        Error: {!v.paymentErrorMessageOnScreen}.
                    </div>
                </div>
                <div class="dflex gap">
                    <div class="modalButton dflexfo negativeBut" onclick="{!c.pageReloadHandle}">
                        Cancel
                    </div>
                </div>
            </aura:if>
            <aura:if isTrue="{!v.isConfirmationDelete}">
                <div class="popup" aura:id="popupSmallID">
                    <div class="popupModal smallPopupModalThree dflexcol">
                        <div class="dflexfo smallPopupModalTwo dflexcol gap mediumPadding">
                            <div class="normalText textCenter">Are you sure?</div>
                        </div>
                        <div class="dflex gap mediumPadding dflexjc popupFooter">
                            <div data-buttype="no" class="modalButton negativeBut"
                                 onclick="{!c.confirmationModalButton}">
                                No
                            </div>
                            <div data-buttype="yes" class="modalButton positiveBut"
                                 onclick="{!c.confirmationModalButton}">
                                Yes
                            </div>
                        </div>
                    </div>
                </div>
            </aura:if>
            <!-- </aura:if> -->
        </div>
    </div>
    
    <div class="wholePage dflexcol">
        <div class="container scrollableDiv dflexfo dflex largeGap" aura:id="wholePageContainer">
            <aura:if isTrue="{!v.showScreenLoading}">
                Loading...
                <aura:set attribute="else">
                    <aura:if isTrue="{!AND(v.isDataLoadSuccess, NOT(v.isPaymentAndPolicyStatus))}">
                        <div class="dflexfo leftNewPanel dflexcol gap">
                            <div class="zzzheader dflexcol dflexcen gap">
                                <div class="mainHeading">
                                    <img alt="logo"
                                         src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/ISBALogo.png'}" />
                                    
                                </div>
                                <div style="display:none;" class="">
                                    <div class="vert_seperator"></div>
                                    
                                    <div style="display: none;" class="detailLine dflex dflexjspace">
                                        <div class="normalText">
                                            Policy Contact:
                                            <div style="padding-left: 0px; padding-top: 10px;">
                                                {!v.policywrap.underwriterName}<br />
                                                <a style="color: green; font-weight: bold;"
                                                   href="{!'mailto:' + !v.policywrap.underwriterEmail}">{!v.policywrap.underwriterEmail}</a><br />
                                                <a style="color: green; font-weight: bold;"
