                                                        </aura:if>
                                                        
                                                        <aura:set attribute="else">
                                                            ---
                                                        </aura:set>
                                                    </aura:if>
                                                </div>
                                            </div>
                                        </aura:if>
                                        
                                        
                                        <div class="detailLine dflex dflexjspace"
                                             style="display:none; background-color: #ededed; padding-top: 10px; padding-bottom: 10px; border-top: 1px solid gray; border-bottom: 1px solid gray; margin-bottom: 15px;">
                                            <div class="head">Amount Due:</div>
                                            <div style="color: black; font-weight: bold !important;" class="value">
                                                <aura:if
                                                         isTrue="{!AND(v.policywrap.premium != null, v.updatedPermium > 0)}">
                                                    <lightning:formattedNumber maximumFractionDigits="0"
                                                                               value="{!v.policywrap.premium - v.updatedPermium}"
                                                                               class="updated_premium" style="currency" currencyCode="USD" />
                                                    
                                                    <aura:set attribute="else">
                                                        <aura:if isTrue="{!v.policywrap.premium != null}">
                                                            <lightning:formattedNumber maximumFractionDigits="0"
                                                                                       value="{!v.policywrap.premium}" class="updated_premium"
                                                                                       style="currency" currencyCode="USD" />
                                                            <aura:set attribute="else">
                                                                ---
                                                            </aura:set>
                                                        </aura:if>
                                                    </aura:set>
                                                </aura:if>
                                            </div>
                                        </div>
                                    </aura:if>
                                </div>
                                
                                
                                
                                <div style="display:none;" class="leftBottom dflexcol largeGap dflexfo dflexjc">
                                    <div class="verticalDetailLine  dflexcol">
                                        <div class="head ztextCenter normalHeading">Billing Address:</div>
                                        <div class="value ztextCenter normalText rs_textRight">
                                            <aura:if
                                                     isTrue="{!AND(v.policywrap.firmName == '', v.policywrap.firmName == '', v.policywrap.billingStreet == null, v.policywrap.billingCity == '',v.policywrap.billingState == '',v.policywrap.billingPostal == '' )}">
                                                ---
                                                <aura:set attribute="else">
                                                    <b>{!v.policywrap.firmName}</b>
                                                    <br />{!v.policywrap.billingStreet}
                                                    <br />{!v.policywrap.billingCity},
                                                    {!v.policywrap.billingState}&nbsp;&nbsp;{!v.policywrap.billingPostal}
                                                </aura:set>
                                            </aura:if>
                                        </div>
                                    </div>
                                    <div class="vert_seperator"></div>
                                    <div class="leftBottom dflexcol largeGap dflexfo zdflexjc">
                                        <aura:if
                                                 isTrue="{!v.policywrap.accRecord.AcctSeed__Billing_Contact__r.Email != null}">
                                            <div class="verticalDetailLine  dflexcol">
                                                <div class="head ztextCenter normalHeading">Billing Contact Email:
                                                </div>
                                                <div class="value ztextCenter normalText">
                                                    {!v.policywrap.accRecord.AcctSeed__Billing_Contact__r.Email}
                                                </div>
                                            </div>
                                        </aura:if>
                                        <aura:if
                                                 isTrue="{!v.policywrap.accRecord.Recent_Policy_Lookup__r.Firm_Contact__r.Email != null}">
                                            <div class="verticalDetailLine dflexcol">
                                                <div class="head ztextCenter normalHeading">Policy Contact Email:
                                                </div>
                                                <div class="value ztextCenter normalText">
                                                    {!v.policywrap.accRecord.Recent_Policy_Lookup__r.Firm_Contact__r.Email}
                                                </div>
                                            </div>
                                        </aura:if>
                                        
                                    </div>
                                    <!-- <div class="verticalDetailLine  dflexcol">
                                                    <div class="head textCenter normalHeading">Description:</div>
                                                    <div class="value textCenter normalText">
                                                        <aura:if isTrue="{!v.policywrap.description != null}">
                                                            {!v.policywrap.description}
                                                            <aura:set attribute="else">
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div> -->
                                </div>
                            </div>
                        </div>
                        <aura:if isTrue="{!v.policywrap.isPolicy}">
                            <div class="rightPanel overflowHidden dflexcol largeGap">
                                <div class="stepsDiv dflex gap scrollableDiv">
                                    <div class="step dflex dflexft gap activeStep" aura:id="stepId" data-step="0">
                                        1.<div class="stepMainDot" aura:id="stepMainDotId">
                                        <div class="stepSecDot" aura:id="stepSecDotId"></div>
                                        </div>
                                        <div class="stepPartition"></div>
                                        <div class="stepName">Quote Option(s)</div>
                                    </div>
                                    <div class="dottedLine dflexfo" aura:id="stepDottedLine"></div>
                                    <div class="step dflex dflexft gap" aura:id="stepId" data-step="1">
                                        2.<div class="stepMainDot" aura:id="stepMainDotId">
                                        <div class="stepSecDot" aura:id="stepSecDotId"></div>
                                        </div>
                                        <div class="stepPartition"></div>
                                        <div class="stepName">Quote Information</div>
                                    </div>
                                    <aura:if isTrue="{!v.hidStepTwo}">
                                        <div class="dottedLine dflexfo" aura:id="stepDottedLine"></div>
                                        <div class="step dflex dflexft gap" aura:id="stepId" data-step="2">
                                            3.<div class="stepMainDot" aura:id="stepMainDotId">
                                            <div class="stepSecDot" aura:id="stepSecDotId"></div>
                                            </div>
                                            <div class="stepPartition"></div>
                                            <div class="stepName">IBF Contribution</div>
                                        </div>
                                    </aura:if>
                                    
                                    <div class="dottedLine dflexfo" aura:id="stepDottedLine"></div>
                                    <div class="step dflex dflexft gap" aura:id="stepId" data-step="3">
                                        <aura:if isTrue="{!v.hidStepTwo}">
                                            4.
                                            <aura:Set attribute="else">
                                                3.
                                            </aura:Set>
                                        </aura:if>
                                        <div class="stepMainDot" aura:id="stepMainDotId">
                                            <div class="stepSecDot" aura:id="stepSecDotId"></div>
                                        </div>
                                        <div class="stepPartition"></div>
                                        <div class="stepName">Payment Information</div>
                                    </div>
                                </div>
                                <div class="stepDataDiv dflex dflexfo overflowHidden">
                                    <div class="stepData activeStepData bgColorRadius overflowHidden"
                                         aura:id="stepDataId" data-dataid="0">
                                        <div aura:id="scrollabarDiv" id="scrollabarDiv"
                                             class="dflexcol gap scrollableDiv dflexfo zborderBox rs_overUnset largeMargin contentBox rs_ov">
                                            
                                            Please review your quote option(s) below. If more than one option is
                                            provided,
                                            please confirm your selection.
                                            <br />
                                            
                                            <div class="dflexcol smallGap  rs_largeGap">
                                                
                                                <div class="rs_tableView  quotesTable">
                                                    <table class="myTableTwo">
                                                        <tr>
                                                            <td style="color: #880019; font-size: 1.5em; font-weight: bold;"
                                                                class="normalTextWithNormalHeadingBold">Quotes:</td>
                                                            <td style="text-align: right;">
                                                                <div style="color: black; font-weight: bold;"
                                                                     class="normalTextWithNormalHeadingBold">Payment
                                                                    Options:</div>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                    <table class="myTableTwo">
                                                        <tr class="tableHeadRow">
                                                            <th class="tableHeadCell">&nbsp;</th>
                                                            <th style="display:none;" class="tableHeadCell">
                                                                Effective Date
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="ztextCenter">Limit of Liability</div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="amountField">Deductible</div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="amountField">Premium</div>
                                                            </th>
                                                            <aura:if
                                                                     isTrue="{!AND(v.policywrap.totalCLECredit != null, v.policywrap.totalCLECredit > 0 )}">
                                                                <th class="tableHeadCell">
                                                                    <div class="amountField">CLE<br />Credit</div>
                                                                </th>
                                                            </aura:if>
                                                            <aura:if
                                                                     isTrue="{!AND(v.policywrap.roundedDividend != null, v.policywrap.roundedDividend > 0 )}">
                                                                <th class="tableHeadCell">
                                                                    <div class="amountField">Dividend<br />Credit</div>
                                                                </th>
                                                            </aura:if>
                                                            <aura:if isTrue="{!v.showIbfDependentFields}">
                                                                <th class="tableHeadCell">
                                                                    <div class="amountField">IBF<br />Donation</div>
                                                                </th>
                                                            </aura:if>
                                                            <aura:if isTrue="{!v.updatedPermium > 0}">
                                                                <aura:if
                                                                         isTrue="{!v.policywrap.isBillingFrequencyFullOnly}">
                                                                    <th class="tableHeadCell">
                                                                        <div class="amountField">Amount Due</div>
                                                                    </th>
                                                                    <aura:set attribute="else">
                                                                        <th>&nbsp;&nbsp;</th>
                                                                        <th class="tableHeadCell"
                                                                            style="margin-left: 30px; text-align: center; border: 1px solid black; ">
                                                                            <div class="amountField">Monthly</div>
                                                                        </th>
                                                                        <th class="tableHeadCell"
                                                                            style="text-align: center; border: 1px solid black; ">
                                                                            <div class="amountField">Quarterly</div>
                                                                        </th>
                                                                        <th class="tableHeadCell"
                                                                            style="text-align: center; border: 1px solid black; ">
                                                                            <div class="amountField">Full</div>
                                                                        </th>
                                                                    </aura:set>
                                                                </aura:if>
                                                                <aura:set attribute="else">
                                                                    <aura:if
                                                                             isTrue="{!!v.policywrap.isBillingFrequencyFullOnly}">
                                                                        <th>&nbsp;&nbsp;</th>
                                                                        <th class="tableHeadCell"
                                                                            style="margin-left: 30px; text-align: center; border: 1px solid black; ">
                                                                            <div class="amountField">Monthly</div>
                                                                        </th>
                                                                        <th class="tableHeadCell"
                                                                            style="text-align: center; border: 1px solid black; ">
                                                                            <div class="amountField">Quarterly</div>
                                                                        </th>
                                                                        <th class="tableHeadCell"
                                                                            style="text-align: center; border: 1px solid black; ">
                                                                            <div class="amountField">Full</div>
                                                                        </th>
                                                                    </aura:if>
                                                                </aura:set>
                                                            </aura:if>
                                                        </tr>
                                                        <aura:iteration items="{!v.policywrap.policyQuotes}" var="item"
                                                                        indexVar="index">
                                                            <tr>
                                                                <td valign="middle" class="tableDataCell">
                                                                    <div class="">
                                                                        <input type="checkbox" data-index="{!index}"
                                                                               data-itemid="{!item.Id}"
                                                                               id="selectedListViewRow"
                                                                               onclick="{!c.selectQuote}"
                                                                               checked="{!item.Final_Quote__c}" />
                                                                    </div>
                                                                </td>
                                                                <td style="display:none;" valign="middle"
                                                                    class="tableDataCell">
                                                                    {!v.policywrap.effectiveDateStr}
                                                                </td>
                                                                <td style="text-align: zcenter;" class="tableHeadCell">
                                                                    {!item.Limits__c}
                                                                </td>
                                                                <td style="text-align: right;" class="tableHeadCell">
                                                                    ${!item.Deductibles_Formula__c}
                                                                </td>
                                                                <td style="text-align: right;" align="right"
                                                                    valign="middle" class="tableDataCell ">
                                                                    <div style="font-weight: bold;" class="amountField">
                                                                        <lightning:formattedNumber
                                                                                                   maximumFractionDigits="0"
                                                                                                   value="{!item.Quote_Final_Premium__c}"
                                                                                                   style="currency" currencyCode="USD" />
                                                                    </div>
                                                                </td>
                                                                <aura:if
                                                                         isTrue="{!AND(v.policywrap.totalCLECredit != null, v.policywrap.totalCLECredit > 0 )}">
                                                                    <td style="text-align: right;" align="right"
                                                                        valign="middle" class="tableDataCell ">
                                                                        <div style="" class="amountField">
                                                                            -
                                                                            <lightning:formattedNumber
                                                                                                       maximumFractionDigits="0"
                                                                                                       value="{!v.policywrap.totalCLECredit}"
                                                                                                       style="currency" currencyCode="USD" />
                                                                        </div>
                                                                    </td>
                                                                </aura:if>
                                                                <aura:if
                                                                         isTrue="{!AND(v.policywrap.roundedDividend != null, v.policywrap.roundedDividend > 0 )}">
                                                                    <td style="text-align: right;" align="right"
                                                                        valign="middle" class="tableDataCell ">
                                                                        <div style="" class="amountField">
                                                                            -
                                                                            <lightning:formattedNumber
                                                                                                       maximumFractionDigits="0"
                                                                                                       value="{!v.policywrap.roundedDividend}"
                                                                                                       style="currency" currencyCode="USD" />
                                                                        </div>
                                                                    </td>
                                                                </aura:if>
                                                                <aura:if isTrue="{!v.showIbfDependentFields}">
                                                                    <td style="text-align: right;" align="right"
                                                                        valign="middle" class="tableDataCell ">
                                                                        <div style="" class="amountField">
                                                                            <aura:if
                                                                                     isTrue="{!AND(v.policywrap.roundedDividend != null, v.policywrap.roundedDividend > 0 )}">
                                                                                <aura:if
                                                                                         isTrue="{!AND(v.policywrap.policy.IBF_Custom_Amount__c!= null, v.policywrap.policy.IBF_Custom_Amount__c>0)}">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="0"
                                                                                                               value="{!v.policywrap.policy.IBF_Custom_Amount__c}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                    <aura:set attribute="else">
                                                                                        <lightning:formattedNumber
                                                                                                                   maximumFractionDigits="0"
                                                                                                                   value="{!v.policywrap.roundedDividend}"
                                                                                                                   style="currency"
                                                                                                                   currencyCode="USD" />
                                                                                    </aura:set>
                                                                                </aura:if>
                                                                            </aura:if>
                                                                        </div>
                                                                    </td>
                                                                </aura:if>
                                                                
                                                                <aura:if isTrue="{!v.updatedPermium > 0}">
                                                                    <aura:if
                                                                             isTrue="{!v.policywrap.isBillingFrequencyFullOnly}">
                                                                        <td style="text-align: right;" align="right"
                                                                            valign="middle" class="tableDataCell ">
                                                                            <div style="font-weight: bold;"
                                                                                 class="amountField">
                                                                                <lightning:formattedNumber
                                                                                                           maximumFractionDigits="0"
                                                                                                           value="{!item.Quote_Final_Premium__c - v.updatedPermium}"
                                                                                                           style="currency"
                                                                                                           currencyCode="USD" />
                                                                            </div>
                                                                        </td>
                                                                        <aura:set attribute="else">
                                                                            <td>&nbsp;&nbsp;</td>
                                                                            <td style="text-align: right;" align="right"
                                                                                valign="middle" class="tableDataCell ">
                                                                                <div style="font-weight: normal;"
                                                                                     class="amountField">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="2"
                                                                                                               value="{!(item.Quote_Final_Premium__c - v.updatedPermium) / 12}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                            </td>
                                                                            <td style="text-align: right;" align="right"
                                                                                valign="middle" class="tableDataCell ">
                                                                                <div style="font-weight: normal;"
                                                                                     class="amountField">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="2"
                                                                                                               value="{!(item.Quote_Final_Premium__c - v.updatedPermium) / 4}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                            </td>
                                                                            <td style="text-align: right;" align="right"
                                                                                valign="middle" class="tableDataCell ">
                                                                                <div style="font-weight: bold;"
                                                                                     class="amountField">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="0"
                                                                                                               value="{!item.Quote_Final_Premium__c - v.updatedPermium}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                            </td>
                                                                        </aura:set>
                                                                    </aura:if>
                                                                    <aura:set attribute="else">
                                                                        <aura:if
                                                                                 isTrue="{!!v.policywrap.isBillingFrequencyFullOnly}">
                                                                            <td>&nbsp;&nbsp;</td>
                                                                            <td style="text-align: right;" align="right"
                                                                                valign="middle" class="tableDataCell ">
                                                                                <div style="font-weight: normal;"
                                                                                     class="amountField">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="2"
                                                                                                               value="{!(item.Quote_Final_Premium__c) / 12}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                            </td>
                                                                            <td style="text-align: right;" align="right"
                                                                                valign="middle" class="tableDataCell ">
                                                                                <div style="font-weight: normal;"
                                                                                     class="amountField">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="2"
                                                                                                               value="{!(item.Quote_Final_Premium__c) / 4}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                            </td>
                                                                            <td style="text-align: right;" align="right"
                                                                                valign="middle" class="tableDataCell ">
                                                                                <div style="font-weight: bold;"
                                                                                     class="amountField">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="0"
                                                                                                               value="{!item.Quote_Final_Premium__c}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                            </td>
                                                                        </aura:if>
                                                                    </aura:set>
                                                                </aura:if>
                                                            </tr>
                                                        </aura:iteration>
                                                    </table>
                                                </div>
                                                <div class="rs_ListView dflexfo largeGap ">
                                                    <aura:iteration items="{!v.policywrap.policyQuotes}" var="item"
                                                                    indexVar="index">
                                                        <div class="listViewBox dflexcol dflexac">
                                                            <div class="box dflexcol">
                                                                <div class="boxCheckbox">
                                                                    <input type="checkbox" data-index="{!index}"
                                                                           data-itemid="{!item.Id}"
                                                                           id="selectedListViewRow"
                                                                           onclick="{!c.selectQuote}"
                                                                           checked="{!item.Final_Quote__c}" />
                                                                </div>
                                                                <div class="">
                                                                    <table>
                                                                        <tr class="tableHeadRow">
                                                                            <td class="tableDataCell">Effective Date
                                                                            </td>
                                                                            <td class="tableDataCell textRight">
                                                                                {!v.policywrap.effectiveDateStr}
                                                                            </td>
                                                                        </tr>
                                                                        <tr class="tableHeadRow">
                                                                            <td class="tableDataCell">Limits</td>
                                                                            <td class="tableDataCell textRight">
                                                                                {!item.Limits__c}
                                                                            </td>
                                                                        </tr>
                                                                        <tr class="tableHeadRow">
                                                                            <td class="tableDataCell">Deductible</td>
                                                                            <td class="tableDataCell textRight">
                                                                                ${!item.Deductibles_Formula__c}
                                                                            </td>
                                                                        </tr>
                                                                        <tr class="tableHeadRow">
                                                                            <td class="tableDataCell">Premium</td>
                                                                            <td class="tableDataCell textRight">
                                                                                <div style="font-weight: bold;"
                                                                                     class="amountField">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="0"
                                                                                                               value="{!item.Quote_Final_Premium__c}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </aura:iteration>
                                                </div>
                                            </div>
                                            <div class="dflexcol smallGap" style="padding-top: 20px;">
                                                <div><span style="color: #880019; font-size: 1.5em; font-weight: bold;"
                                                           class="normalTextWithNormalHeadingBold">List of Lawyers Included
                                                    in
                                                    Quote</span>&nbsp;&nbsp;(Please update email address if not
                                                    correct):</div>
                                                <div
                                                     class="rs_tableView horizontalMedPadding policyLawyers scrollableDiv">
                                                    <table class="myTableTwo">
                                                        <tr class="tableHeadRow">
                                                            <th class="tableHeadCell"
                                                                style="width:10%; white-space: nowrap;">
                                                                Name
                                                            </th>
                                                            <th class="tableHeadCell"
                                                                style="width:5%; white-space: nowrap;">
                                                                ARDC #
                                                            </th>
                                                            <!-- <th class="tableHeadCell" style="display:none;">
                                                                ISBA #
                                                            </th> -->
                                                            <!-- <th class="tableHeadCell" style="display:none;">
                                                                Prior Act Date
                                                            </th> -->
                                                            <!-- <th class="tableHeadCell" style="display:none;">
                                                                Step
                                                            </th> -->
                                                            <th class="tableHeadCell"
                                                                style="width:20%; white-space: nowrap;">
                                                                Business Email
                                                            </th>
                                                            <th class="tableHeadCell"
                                                                style="width:20%; white-space: nowrap;">
                                                                Personal Email
                                                            </th>
                                                            <th class="tableHeadCell"
                                                                style="width:10%; white-space: nowrap;">
                                                                Cell Phone #
                                                            </th>
                                                            <th class="tableHeadCell"
                                                                style="width:20%; white-space: nowrap;">
                                                                Birthdate
                                                            </th>
                                                        </tr>
                                                        <aura:iteration items="{!v.policywrap.policyLawyers}" var="item"
                                                                        indexVar="index">
                                                            <tr>
                                                                <td style="font-weight: bold; white-space: nowrap;"
                                                                    valign="middle" class="tableDataCell">
                                                                    {!item.Lawyer__r.Name}
                                                                </td>
                                                                <td style="" valign="middle" class="tableDataCell">
                                                                    {!item.ARDC_Number__c}
                                                                </td>
                                                                <!-- <td valign="middle" class="tableDataCell" style="display:none;">
                                                                    {!item.ISBA_Number__c}
                                                                </td>
                                                                <td valign="middle" align="right" class="tableDataCell" style="display:none;">
                                                                    <lightning:formattedDateTime
                                                                        value="{!item.Prior_Act_Date__c}" year="numeric"
                                                                        month="2-digit" day="2-digit" />
                                                                </td>
                                                                <td valign="middle" class="tableDataCell" style="display:none;">
                                                                    {!item.Step__c}
                                                                </td>
                                                                 -->
                                                                <td valign="middle" class="tableDataCell">
                                                                    <div class="inputField">
                                                                        <input type="text" data-row="Email"
                                                                               data-index="{!index}" data-id="lawyerEmail"
                                                                               data-req='true'
                                                                               placeholder="business email (required)"
                                                                               value="{!item.Lawyer__r.Contact__r.Email}"
                                                                               aura:id="lawyerEmail" name="Email address"
                                                                               onfocus="{!c.handleFocusEmail}"
                                                                               onblur="{!c.handleBlurEmail}" />
                                                                    </div>
                                                                </td>
                                                                <td valign="middle" class="tableDataCell">
                                                                    <div class="inputField">
                                                                        <input type="text" data-row="Personal_Email__c"
                                                                               data-id="lawyerPersonalEmail"
                                                                               data-index="{!index}" data-req='false'
                                                                               value="{!item.Lawyer__r.Contact__r.Personal_Email__c}"
                                                                               aura:id="lawyerPersonalEmail"
                                                                               name="Email address"
                                                                               onfocus="{!c.handleFocusEmail}"
                                                                               onblur="{!c.handleBlurEmail}" />
                                                                        <!-- onchange="{!c.handleLawyerFieldChange}" -->
                                                                    </div>
                                                                </td>
                                                                <td valign="middle" class="tableDataCell">
                                                                    <div class="inputField">
                                                                        <input aura:id="lawyerPhoneNumber" type="text"
                                                                               data-row="Phone" data-index="{!index}"
                                                                               value="{!item.formatedPhone}"
                                                                               id="lawyerPhone" name="Phone number"
                                                                               onfocus="{!c.handleFocusPhone}"
                                                                               onblur="{!c.handleBlurPhone}" />
