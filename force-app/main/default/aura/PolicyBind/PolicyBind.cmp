                                                                                        size="x-small"
                                                                                        alternativeText="{! 'Must be between today and '+ v.policywrap.effectiveDateStr}"
                                                                                        title="{! 'Must be between today and '+ v.policywrap.effectiveDateStr}" />
                                                                    </p>
                                                                </div>
                                                                <div>
                                                                    <lightning:input type="date" name="input1"
