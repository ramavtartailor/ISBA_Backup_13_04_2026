                                            <div aura:id="scrollabarDiv" id="scrollabarDiv"
                                                 class="zdflex zgap scrollableDiv dflexfo borderBox largeMargin contentBox mediumPadding zresponsiveBox">
                                                
                                                <div style="max-width: 400px;"
                                                     class="smallPadding zdflexcol zgap zmaxWidthCol zdflexfo">
                                                    <p style="font-size: 1.3em; font-weight: bold; color: black;">
                                                        JOIN THE ISBA MUTUAL GIVING CIRCLE
                                                    </p>
                                                    <div style="padding-top: 15px;" class="inputField ">
                                                        <div class="label">IBF Contribution?</div>
                                                        <select name="IBF contribution"
                                                                value="{!v.policywrap.policy.IBF_Contribtuion__c}"
                                                                onchange="{!c.changeIBFValues}" id="ibfContribution">
                                                            <aura:iteration items="{!v.ibfContributionList}" var="item">
                                                                <aura:if
                                                                         isTrue="{!item.value == v.policywrap.policy.IBF_Contribtuion__c}">
                                                                    <option selected="true" value="{!item.value}">
                                                                        {!item.key}
                                                                    </option>
                                                                    <aura:set attribute="else">
                                                                        <option value="{!item.value}">{!item.key}
                                                                        </option>
                                                                    </aura:set>
                                                                </aura:if>
                                                            </aura:iteration>
                                                        </select>
                                                    </div>
                                                    
                                                    <aura:if isTrue="{!v.showIbfDependentFields}">
                                                        <div class="dflex largeGap" style="padding-top: 2px;">
                                                            <div class="inputField dflexfo">
                                                                <div style="padding-top: 15px;" class="label">Donation
                                                                    Amount</div>
                                                                <!-- <input disabled="true" type="number"
                                                                            value="{!v.policywrap.roundedDividend}"
                                                                            id="ibfContributionPercent"
                                                                            name="IBF Contribution percent" required="true"
                                                                            style="currency" /> -->
                                                                <select name="Donation Amount" value="{!v.donationType}"
                                                                        onchange="{!c.changeIBFValues}"
                                                                        id="ibfContributionDonationAmount">
                                                                    <option selected="{!v.donationType == 'Full'}"
                                                                            value="Full">
                                                                        Full
                                                                    </option>
                                                                    <option selected="{!v.donationType == 'Partial'}"
                                                                            value="Partial">
                                                                        Partial
                                                                    </option>
                                                                </select>
                                                            </div>
                                                            <aura:if isTrue="{!v.donationType == 'Partial'}">
                                                                <div class="inputField dflexfo">
                                                                    <div style="padding-top: 15px;" class="label">Custom
                                                                        Amount</div>
                                                                    <input type="number"
                                                                           value="{!v.policywrap.policy.IBF_Custom_Amount__c}"
                                                                           onblur="{!c.changeIBFValues}"
                                                                           id="ibfContributionCustomAmount"
                                                                           name="IBF Contribution Custom Amount"
                                                                           required="true" />
                                                                </div>
                                                                <aura:set attribute="else">
                                                                    <div class="inputField dflexfo">
                                                                        <div style="padding-top: 15px;" class="label">
                                                                            100%
                                                                        </div>
                                                                        <input disabled="true" type="number" step="0"
                                                                               value="{!v.policywrap.roundedDividend}"
                                                                               id="ibfContributionPercent"
                                                                               onblur="{!c.changeIBFValues}"
                                                                               name="IBF Contribution percent"
                                                                               required="true" style="currency" />
                                                                    </div>
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                        <div class="dflexcol gap">
                                                            <aura:if isTrue="{!v.showIbfDependentFields}">
                                                                <div class="inputField">
                                                                    <div style="padding-top: 15px;" class="label">
                                                                        IBF Target
                                                                    </div>
                                                                    <select name="IBF Target" required="true"
                                                                            value="{!v.policywrap.policy.IBF_Target__c}"
                                                                            onchange="{!c.changeIBFValues}" id="ibfTarget">
                                                                        <aura:if
                                                                                 isTrue="{!!v.policywrap.policy.IBF_Target__c}">
                                                                            <option value="" disabled="true"
                                                                                    selected="true">
                                                                                Please select donation target...
                                                                            </option>
                                                                            <aura:set attribute="else">
                                                                                <option value="" disabled="true">
                                                                                    Please select donation target...
                                                                                </option>
                                                                            </aura:set>
                                                                        </aura:if>
                                                                        <aura:iteration items="{!v.ibfTargetList}"
                                                                                        var="item">
                                                                            <aura:if
                                                                                     isTrue="{!item.value == v.policywrap.policy.IBF_Target__c}">
                                                                                <option selected="true"
                                                                                        value="{!item.value}">
                                                                                    {!item.key}
                                                                                </option>
                                                                                <aura:set attribute="else">
                                                                                    <option value="{!item.value}">
                                                                                        {!item.key}
                                                                                    </option>
                                                                                </aura:set>
                                                                            </aura:if>
                                                                        </aura:iteration>
                                                                    </select>
                                                                </div>
                                                                <aura:if isTrue="{!v.showIbfTargetDependentField}">
                                                                    <div class="inputField">
                                                                        <div class="label">Specify District(s)</div>
                                                                        <input type="text"
                                                                               value="{!v.policywrap.policy.IBF_Appellate_District__c}"
                                                                               onblur="{!c.changeIBFValues}"
                                                                               id="ibfSpecificDistrict"
                                                                               name="Specify District" required="true" />
                                                                    </div>
                                                                </aura:if>
                                                            </aura:if>
                                                        </div>
                                                        <div class="dflex largeGap">
                                                            
                                                        </div>
                                                    </aura:if>
                                                </div>
                                                
                                                <div style="padding-top: 60px; font-size: 1.1em;"
                                                     class="smallPadding zdflexcol zsmallGap zdflexfo">
                                                    <p class="textJus"
                                                       style="font-size: 1.3em; font-weight: bold; color: black;">
                                                        SUPPORT THE ILLINOIS BAR FOUNDATION
                                                    </p>
                                                    <br />
                                                    <p class="textJus">
                                                        Consider joining the <b style="color: #89001B;">ISBA Mutual
                                                        Giving
                                                        Circle</b> by donating all or part of
                                                        your {!v.policywrap.effectiveDateYear - 1} ISBA Mutual Dividend
                                                        of
                                                        <b>${!v.policywrap.roundedDividend}</b>
                                                        to the <b>ILLINOIS BAR FOUNDATION</b>.
                                                    </p>
                                                    <br />
                                                    <p class="textJus">
                                                        The vision of the ILLINOIS BAR FOUNDATION is to be a statewide
                                                        leader in
                                                        assisting lawyers in crisis and advancing equal justice. Your
                                                        generous
                                                        contribution will help close the gap in the civil justice system
                                                        by
                                                        providing funding for civil legal aid programs throughout the
                                                        state
                                                        of
                                                        Illinois and will also help provide financial aid to lawyers who
                                                        are
                                                        no
                                                        longer able to support themselves and their families due to age,
                                                        illness or
                                                        injury.
                                                    </p>
                                                    <br />
                                                    <p class="textJus">
                                                        Firms and individuals who join the <b
                                                                                              style="color: #89001B;">ISBA
                                                        Mutual Giving Circle</b> receive:
                                                    </p>
                                                    <p style="padding-top:10px; padding-left: 30px;">
                                                        <ul style="list-style: disc;">
                                                            <li class="textJus">Recognition on the ISBA’s Illinois Lawyer
                                                                Now
                                                                blog</li>
                                                            <li class="textJus">A certificate of recognition</li>
                                                        </ul>
                                                    </p>
                                                    <br />
                                                    <p
                                                       style="text-align: center; font-size: 1.1em; font-weight: bold; color: black;">
                                                        The 100% Club</p>
                                                    <p class="textJus">
                                                        Firms and individuals who donate their entire dividend join the
                                                        exclusive
                                                        ranks of the 100% Club, which includes the following additional
                                                        benefits:
                                                    </p>
                                                    <p style="padding-top:10px; padding-left: 30px;">
                                                        <ul style="list-style: disc;">
                                                            <li class="textJus">Quarterly recognition in the Illinois Bar
                                                                Journal</li>
                                                            <li class="textJus">Recognition at the ISBA Annual Meeting
                                                            </li>
                                                        </ul>
                                                    </p>
                                                </div>
                                            </div>
                                            
                                            
                                            <div class="stepsButton dflex dflexjspace gap responsiveBox dflexac">
                                                <div class="myButton negativeButt re_dflexfo rs_hideStepButton"
                                                     data-to="1" data-buttype="back" data-from="none"
                                                     onclick="{!c.changeStepHandle}">
                                                    Back
                                                </div>
                                                
                                                <div class="rs_footerText">
                                                    <table style="width: 100%;" border="0" class="lol_table">
                                                        <tr>
                                                            <td colspan="3">Your ISBA Mutual Policy Contact:</td>
                                                        </tr>
                                                        <tr>
                                                            <td><b>{!v.policywrap.underwriterName}</b></td>
                                                            <td>
                                                                <a style="font-size: 1.1em; font-weight: bold;"
                                                                   href="{!'mailto:' + !v.policywrap.underwriterEmail}">{!v.policywrap.underwriterEmail}
                                                                </a>
                                                            </td>
                                                            <td>
                                                                <a style="font-size: 1.1em; font-weight: bold;"
                                                                   href="{!'tel:' + !v.policywrap.underwriterPhone}">{!v.policywrap.underwriterPhone}
                                                                </a>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="3"
                                                                style="font-size: 16px; font-weight: bold; color: #880019">
                                                                As a reminder, coverage is not in force until premium is
                                                                received by ISBA Mutual Insurance Company.
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                                <aura:if isTrue="{!v.isNextButtonDisabled}">
                                                    <div class="myButton negativeButt re_dflexfo rs_hideStepButton disableBut"
                                                         data-to="3" data-buttype="next" data-from="ibfContribution">
                                                        Next
                                                    </div>
                                                    <aura:set attribute="else">
                                                        <div class="myButton negativeButt re_dflexfo rs_hideStepButton"
                                                             data-to="3" data-buttype="next" data-from="ibfContribution"
                                                             onclick="{!c.changeStepHandle}">
                                                            Next
                                                        </div>
                                                    </aura:set>
                                                </aura:if>
                                                <!--div class="myButton negativeButt re_dflexfo rs_hideStepButton" data-to="3"
                                                 data-buttype="next" data-from="ibfContribution"
                                                 onclick="{!c.changeStepHandle}">
                                                Next
                                            </div-->
                                                
                                                <div class="rs_stepButton dflex gap rs_orderTwo">
                                                    <div class="myButton negativeButt re_dflexfo rs_orderTwo"
                                                         data-to="1" data-buttype="back" data-from="none"
                                                         onclick="{!c.changeStepHandle}">
                                                        Back
                                                    </div>
                                                    <aura:if isTrue="{!v.isNextButtonDisabled}">
                                                        <div class="myButton negativeButt re_dflexfo rs_orderThree disableBut"
                                                             data-to="3" data-buttype="next" data-from="ibfContribution">
                                                            Next
                                                        </div>
                                                        <aura:set attribute="else">
                                                            <div class="myButton negativeButt re_dflexfo rs_orderThree"
                                                                 data-to="3" data-buttype="next"
                                                                 data-from="ibfContribution"
                                                                 onclick="{!c.changeStepHandle}">
                                                                Next
                                                            </div>
                                                        </aura:set>
                                                    </aura:if>
                                                    <!--div class="myButton negativeButt re_dflexfo rs_orderThree" data-to="3"
                                                     data-buttype="next" data-from="ibfContribution"
                                                     onclick="{!c.changeStepHandle}">
                                                    Next
                                                </div-->
                                                </div>
                                            </div>
                                        </div>
                                    </aura:if>
                                    
                                    <div class="stepData " aura:id="stepDataId" data-dataid="3">
                                        <div style="display:none;" class="dflex largeGap">
                                            <div aura:id="payment-type" data-type="Full"
                                                 onclick="{!c.paymentScheduleHandle}"
                                                 class="isActiveSpan itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                Full Payment
                                            </div>
                                            <div aura:id="payment-type" data-type="Quarter"
                                                 onclick="{!c.paymentScheduleHandle}"
                                                 class="itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                Quarterly Payments
                                            </div>
                                            <div aura:id="payment-type" data-type="Month"
                                                 onclick="{!c.paymentScheduleHandle}"
                                                 class="itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                Monthly Payments
                                            </div>
                                        </div>
                                        
                                        
                                        <div class="dflexfo dflexcol bgColorRadius overflowHidden">
                                            <div style="display:none; padding: 20px;"
                                                 class="borderBox largeMargin contentBox">
                                                <lightning:radioGroup class="radio_payment_schedule"
                                                                      name="radioGroupRequired" label="Select Payment Schedule:"
                                                                      options="{!v.paymentTypeOptions}" type="radio"
                                                                      value="{!v.paymentOption}"
                                                                      onchange="{! c.handlePaymentOptionChange }" />
                                            </div>
                                            
                                            
                                            <!-- MAIN PAYMENT SCREEN -->
                                            
                                            <div aura:id="scrollabarDiv" id="scrollabarDiv"
                                                 class="borderBox largeMargin contentBox dflexcol dflexfo gap scrollableDiv mediumPadding rs_dflexcol">
                                                <div class="dflex">
                                                    <div class="detailsBox dflexcol gap" style="flex:3;">
                                                        <aura:if isTrue="{!!v.policywrap.isBillingFrequencyFullOnly}">
                                                            <div style="">
                                                                <!-- padding-left: 20px; padding-top: 10px; -->
                                                                <p class="leftSection normalTextWithNormalHeadingBold"
                                                                   style="font-size: 1.3em; font-weight: bold; color: black;">
                                                                    PAYMENT OPTIONS:
                                                                </p>
                                                                <br />
                                                                
                                                                <div class="zslds-grid zslds-wrap resInputs"
                                                                     style="font-size: 16px;">
                                                                    <ui:inputRadio text="Full" name="payment-type-radio"
                                                                                   label=""
                                                                                   change="{!c.handlePaymentTypeChange}" />
                                                                    &nbsp;&nbsp;Full Payment
                                                                    <br />
                                                                    <ui:inputRadio text="Quarter"
                                                                                   name="payment-type-radio" label=""
                                                                                   change="{!c.handlePaymentTypeChange}" />
                                                                    &nbsp;&nbsp;Quarterly Payments
                                                                    <br />
                                                                    <ui:inputRadio text="Month"
                                                                                   name="payment-type-radio" label=""
                                                                                   change="{!c.handlePaymentTypeChange}" />
                                                                    &nbsp;&nbsp;Monthly Payments
                                                                </div>
                                                                
                                                                <div class="dflexac dflexfo" style="font-size: 16px;">
                                                                    <aura:if isTrue="{!v.policywrap.enablePaymentDate}">
                                                                        <div class="dflexcol absoluteError"
                                                                             style="gap: 0.5rem; padding: 1rem 0;">
                                                                            <div class="dflex dflexac">
                                                                                <p>
                                                                                    Payment Date
                                                                                    <lightning:icon
                                                                                                    iconName="utility:info_alt"
                                                                                                    size="x-small"
                                                                                                    alternativeText="{! 'Must be between today and '+ v.policywrap.effectiveDateStr}"
                                                                                                    title="{! 'Must be between today and '+ v.policywrap.effectiveDateStr}" />
                                                                                </p>
                                                                            </div>
                                                                            <div>
                                                                                <lightning:input type="date"
                                                                                                 name="input1" aura:id="paymentDate"
                                                                                                 class="ltngInput"
                                                                                                 value="{!v.policywrap.firstInstallmentDate}"
                                                                                                 variant="label-hidden"
                                                                                                 onchange="{!c.handleChangeDueDate}"
                                                                                                 dateStyle="short" />
                                                                            </div>
                                                                        </div>
                                                                    </aura:if>
                                                                </div>
                                                                <!--aura:if isTrue="{!v.policywrap.enablePaymentDate}">
                                                        <p style="padding-top: 40px; font-size: 16px; width: 100%">
                                                            Payment Date:&nbsp;&nbsp;
                                                            <lightning:input type="date" name="input1" aura:id="paymentDate" class="ltngInput"
                                                                             value="{!v.policywrap.firstInstallmentDate}"
                                                                             variant="label-hidden"
                                                                             onchange="{!c.handleChangeDueDate}" dateStyle="short"/>
                                                            <span class="paymtDateMsg" style="{!v.paymtDateMsgStyle}">
                                                                (must be between today and {!v.policywrap.effectiveDateStr})
                                                            </span>
                                                        </p>
                                                    </aura:if-->
                                                                
                                                                <br />
                                                            </div>
                                                        </aura:if>
                                                        
                                                        <aura:if isTrue="{!!v.policywrap.isBillingFrequencyFullOnly}">
                                                            <p class="leftSection normalTextWithNormalHeadingBold"
                                                               style=" width: 100%; background-color: lightblue; font-size: 1.3em; font-weight: bold; color: black;">
                                                                <!-- margin-top: 40px; -->
                                                                <table>
                                                                    <tr>
                                                                        <td>TOTAL DUE TODAY:&nbsp;&nbsp;</td>
                                                                        <td align="right">
                                                                            <aura:if isTrue="{!v.isCC}">
                                                                                <lightning:formattedNumber
                                                                                                           maximumFractionDigits="2"
                                                                                                           value="{!((v.policywrap.totalAmountDue * (100 + v.policywrap.ccFeeRate))/100)}"
                                                                                                           style="currency"
                                                                                                           currencyCode="USD" />
                                                                                <aura:set attribute="else">
                                                                                    <lightning:formattedNumber
                                                                                                               maximumFractionDigits="2"
                                                                                                               value="{!v.policywrap.totalAmountDue}"
                                                                                                               style="currency"
                                                                                                               currencyCode="USD" />
                                                                                </aura:set>
                                                                            </aura:if>
                                                                            <!--lightning:formattedNumber maximumFractionDigits="2"
                                                                                                             value="{!v.policywrap.totalAmountDue}" style="currency"
                                                                                                             currencyCode="USD" /-->
                                                                        </td>
                                                                    </tr>
                                                                    
                                                                </table>
                                                                
                                                            </p>
                                                            
                                                            <aura:if isTrue="{!v.policywrap.isPolicy}">
                                                                <div class="res_border"
                                                                     style="margin-top: 25px; border-top: 1px solid #e5e5e5; padding-top: 25px;">
                                                                </div>
                                                            </aura:if>
                                                        </aura:if>
                                                        
                                                        <aura:if isTrue="{!!v.policywrap.isPolicy}">
                                                            <div style="margin-top: 1rem;" class="myButton negativeButt re_dflexfo" data-watermark="Yes" 
                                                                 onclick="{!c.downloadEndorsementPdf}">
                                                                View PDF Endorsement
                                                            </div>  
                                                            <div class="res_border"
                                                                 style="margin-top: 25px; border-top: 1px solid #e5e5e5; padding-top: 25px;">
                                                            </div>
                                                        </aura:if>
                                                        
                                                        <div class="zslds-grid zslds-wrap" style="font-size: 16px;">
                                                            <!-- padding-left: 20px; -->
                                                            <p class="leftSection normalTextWithNormalHeadingBold"
                                                               style="padding-top: 10px; font-weight: bold; color: black;">
                                                                PAYMENT METHOD:
                                                            </p>
                                                            <div style="color: gray; font-size: 0.8em;" class="secline">
                                                                * a {!v.policywrap.ccFeeRate}%
                                                                service
                                                                fee
                                                                will be added to Credit Card transactions</div>
                                                            <aura:if isTrue="{!v.savedCardList.length}">
                                                                <aura:iteration items="{!v.savedCardList}" var="item"
                                                                                indexVar="index">
                                                                    <!-- <ui:inputRadio  aura:id="picklistPaymentMethod"  name="paymentMethodRadioGroup" label="" value="{!OR(item.isDefault == true, item.isSetToPay == true)}"
                                                            change="{!c.picklistPaymentMethodChange}" />  &nbsp;&nbsp;
                                                            --><!-- <option selected="{!OR(item.isDefault == true, item.isSetToPay == true)}" value="{!item.paymentMethod.Id}"> -->
                                                                    <aura:if isTrue="{!item.isPendingDelete}">
                                                                        <input class="resInputs" type="radio"
                                                                               aura:id="picklistPaymentMethod"
                                                                               name="paymentMethodRadioGroup"
                                                                               data-id="{!item.paymentMethod.Id}"
                                                                               disabled="true"
                                                                               onchange="{!c.picklistPaymentMethodChange}" />
                                                                        <aura:set attribute="else">
                                                                            <aura:if isTrue="{!OR(item.isDefault == true, item.isSetToPay == true)}">
                                                                                <input class="resInputs" type="radio"
                                                                                       aura:id="picklistPaymentMethod"
                                                                                       name="paymentMethodRadioGroup"
                                                                                       data-id="{!item.paymentMethod.Id}"
                                                                                       checked="checked"
                                                                                       onchange="{!c.picklistPaymentMethodChange}" />
                                                                                <aura:set attribute="else">
                                                                                    <input class="resInputs" type="radio"
                                                                                           aura:id="picklistPaymentMethod"
                                                                                           name="paymentMethodRadioGroup"
                                                                                           data-id="{!item.paymentMethod.Id}"
                                                                                           onchange="{!c.picklistPaymentMethodChange}" />
                                                                                </aura:set>
                                                                            </aura:if>
                                                                        </aura:set>
                                                                    </aura:if>
                                                                    <aura:if isTrue="{!item.cardTypeVar == 'amex'}">
                                                                        AMEX
                                                                    </aura:if>
                                                                    <aura:if isTrue="{!item.cardTypeVar == 'disc'}">
                                                                        DISC
                                                                    </aura:if>
                                                                    <aura:if
                                                                             isTrue="{!item.cardTypeVar == 'mc'}">
                                                                        MC
                                                                    </aura:if>
                                                                    <aura:if isTrue="{!item.cardTypeVar == 'visa'}">
                                                                        VISA
                                                                    </aura:if>
                                                                    ending in
                                                                    {!item.paymentMethod.Last_4_Account_Number__c}
                                                                    <aura:if isTrue="{!item.isPendingDelete}">
                                                                        (Pending Delete)
                                                                    </aura:if>
                                                                    <!--AcctSeed__Account_Number__c-->
                                                                    <br />
                                                                </aura:iteration>
                                                            </aura:if>
                                                            <br />
                                                            
                                                            <aura:if isTrue="{!v.savedEcheckList.length}">
                                                                <aura:iteration items="{!v.savedEcheckList}" var="item"
                                                                                indexVar="index">
                                                                    <!--<ui:inputRadio aura:id="picklistPaymentMethod"  name="paymentMethodRadioGroup" label="" value="{!item.isDefault == true}"
                                                            change="{!c.picklistPaymentMethodChange}" />  &nbsp;&nbsp;
                                                            --><!-- <option selected="{!OR(item.isDefault == true, item.isSetToPay == true)}" value="{!item.paymentMethod.Id}"> -->
                                                                    <aura:if isTrue="{!item.isPendingDelete}">
                                                                        
                                                                        <input type="radio"
                                                                               aura:id="picklistPaymentMethod"
                                                                               name="paymentMethodRadioGroup"
                                                                               data-id="{!item.paymentMethod.Id}"
                                                                               disabled="true"
                                                                               onchange="{!c.picklistPaymentMethodChange}" />
                                                                        <aura:set attribute="else">
                                                                            
                                                                            <aura:if isTrue="{!OR(item.isDefault == true, item.isSetToPay == true)}">
                                                                                <input type="radio"
                                                                                       aura:id="picklistPaymentMethod"
                                                                                       name="paymentMethodRadioGroup"
                                                                                       data-id="{!item.paymentMethod.Id}"
                                                                                       checked="checked"
                                                                                       onchange="{!c.picklistPaymentMethodChange}" />
                                                                                <aura:set attribute="else">
                                                                                    <input type="radio"
                                                                                           aura:id="picklistPaymentMethod"
                                                                                           name="paymentMethodRadioGroup"
                                                                                           data-id="{!item.paymentMethod.Id}"
                                                                                           onchange="{!c.picklistPaymentMethodChange}" />
                                                                                </aura:set>
                                                                            </aura:if>
                                                                        </aura:set>
                                                                    </aura:if>
                                                                    <!--input type="radio" aura:id="picklistPaymentMethod" name="paymentMethodRadioGroup" data-id="{!item.paymentMethod.Id}" checked="{!OR(item.isDefault == true, item.isSetToPay == true)}" onchange="{!c.picklistPaymentMethodChange}" /-->
                                                                    eCheck ending in
                                                                    {!item.paymentMethod.Last_4_Account_Number__c}
                                                                    <aura:if isTrue="{!item.isPendingDelete}">
                                                                        (Pending Delete)
                                                                    </aura:if>
                                                                    <!--AcctSeed__Account_Number__c-->
                                                                    <br />
                                                                </aura:iteration>
                                                            </aura:if>
                                                            <aura:if isTrue="{!v.isInternalUser}">
                                                                <div class="normalText">
                                                                    <input type="radio" aura:id="picklistPaymentMethod"
                                                                           name="paymentMethodRadioGroup"
                                                                           data-id="Physical_Check"
                                                                           onchange="{!c.picklistPaymentMethodChange}" />
                                                                    Physical Check
                                                                    
                                                                </div>
                                                            </aura:if>
                                                        </div>
                                                        <div class="dflex" style="">
                                                            <!-- padding-top: 15px; padding-left: 1rem; -->
                                                            <aura:if
