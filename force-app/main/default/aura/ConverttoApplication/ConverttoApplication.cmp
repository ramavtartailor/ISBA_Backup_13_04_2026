<aura:component implements="force:lightningQuickAction,force:hasRecordId,force:appHostable" controller="ConverttoApplicationLtng">
	<aura:attribute name="msg" type="String" />
    <aura:attribute name="objPolicy" type="Policy__c" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <div aura:id="confirmBox" class="hide">
        Are you sure you want to convert the policy back to application?<br/>
        <ui:button press="{!c.convertToApplication}" label="Yes"/>
        <ui:button press="{!c.hideConfirmBox}" label="No"/>
    </div>
    
    <div aura:id="errorMsg" class="hide">
    	<p><br/><br/><b>{!v.msg}</b></p> 
        <ui:button press="{!c.hideConfirmBox}" label="Back"/>
    </div>
</aura:component>