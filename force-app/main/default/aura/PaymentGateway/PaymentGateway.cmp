<aura:component
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction"
    access="global" controller="PaymentGatewayClass">

    <aura:html tag="style">
        label{
        color: #4d4747 !important;
        font-size: .75rem;
        }
    </aura:html>

    <!-- getting from vfpage -->
    <aura:attribute name="recordId" type="String" default='' />
    <aura:attribute name="sfInternalId" type="String" />
    <aura:attribute name="lastTime" type="String" default="FirstTime" />
    <aura:attribute name="ipAddress" type="String" />
    <aura:attribute name="userSession" type="String" />

    <aura:attribute name="isPay" type="string" default="false" />
    <aura:attribute name="isModifySchedules" type="string" default="false" />
    <aura:attribute name="isModifyPaymentMethod" type="string" default="false" />
    <aura:attribute name="isPayTemp" type="boolean" default="false" />
    <aura:attribute name="isModifySchedulesTemp" type="boolean" default="false" />
    <aura:attribute name="isModifyPaymentMethodTemp" type="boolean" default="false" />

    <!-- wrapper  -->
    <aura:attribute name="isCC" type="boolean" default="false" />
    <aura:attribute name="isBillingExpended" type="boolean" default="false" />
    <aura:attribute name="ShowBillingPs" type="boolean" default="false" />
    <aura:attribute name="BillingPaymentSchedules" type="List" default="[]" />
    <aura:attribute name="payWrapper" type="object" />
    <aura:attribute name="oldPaymentSchedule" type="List" default="[]" />
    <aura:attribute name="oldPaymentScheduleFields" type="List" default="[]" />
    <aura:attribute name="isPaymentLoad" type="boolean" default="false" />
    <aura:attribute name="paymentType" type="string" />
    <aura:attribute name="savedCardList" type="Object[]" />
    <aura:attribute name="savedEcheckList" type="Object[]" />
    <aura:attribute name="showPayMethodError" type="Boolean" default="false" />
    <aura:attribute name="tempEffectiveDate" type="Date" />
    <aura:attribute name="tempLastTime" type="String" />
    <aura:attribute name="wrapperLoad" type="boolean" default="false" />
    <aura:attribute name="billingTabActive" type="boolean" default="false" />
    <aura:attribute name="policyTabActive" type="boolean" default="false" />
    <aura:attribute name="endorsementTabActive" type="boolean" default="true" />
    <aura:attribute name="selectedMethod" type="String" />
    <aura:attribute name="contactRoleList" type="Object[]" />
    <aura:attribute name="policyLawyers" type="Object[]" />
    <aura:attribute name="endorsementEffectiveDate" type="Date" />
    <aura:attribute name="showDeleteLawyerModal" type="Boolean" default="false" />
    <aura:attribute name="showCancelPolicyModal" type="Boolean" default="false" />
    <aura:attribute name="showAddLawyerModal" type="Boolean" default="false" />
    <aura:attribute name="showErrorModal" type="Boolean" default="false" />
    <aura:attribute name="policyIndex" type="Integer" />
    <aura:attribute name="contactRole" type="String" />
    <!--aura:attribute name="endorsement" type="Object"/-->

    <aura:attribute name="lastItemClicked" type="String" />

    <!-- Input field type for Card Number and CVV-->
    <aura:attribute name="dataType" type="String" default="number" />
    <aura:attribute name="dataTypeCvv" type="String" default="number" />
    <aura:attribute name="checkValidCVV" type="boolean" default="false" />
    <aura:attribute name="checkValidCardNumber" type="boolean" default="false" />

    <aura:attribute name="firstInstallmentDate" type="string" />

    <!-- for mobile Responsive -->
    <aura:attribute name="isMobile" type="boolean" default="false" />
    <aura:attribute name="rs_showPayButton" type="boolean" default="false" />
    <aura:attribute name="rs_isPaymentPaid" type="boolean" default="false" />
    <aura:attribute name="rs_selectedBillId" type="string" />
    <aura:attribute name="rs_selectedBillpdfLink" type="string" />
    <aura:attribute name="pendingPolicyEndorsCount" type="Integer" default="0" />
    <aura:attribute name="pendingbillingCount" type="Integer" default="0" />

    <!-- Change Payment method type -->
    <aura:attribute name="isEditable" type="boolean" default="false" />
    <aura:attribute name="isPaymentFirstTime" type="boolean" default="true" />

    <!-- for enter email screen  -->
    <aura:attribute name="isAccount" type="boolean" default="false" />
    <aura:attribute name="backToHomeScreen" type="boolean" default="false" />

    <aura:attribute name="isEnterEmail" type="boolean" default="false" />
    <aura:attribute name="emailmessage" type="String" />
    <aura:attribute name="isDisabledSendEmailbut" type="boolean" default="true" />

    <!-- Payment Message  -->
    <aura:attribute name="paymentMessageOnLoad" type="string" />
    <!-- Add Card and Echeck Screen in modal -->
    <aura:attribute name="isAddScreen" type="boolean" default="false" />
    <!-- Savd Card and Echeck Screen in modal -->
    <aura:attribute name="isSavedScreen" type="boolean" default="false" />
    <!-- Modal having header and footer -->
    <aura:attribute name="isHeaderFooterModal" type="boolean" default="false" />
    <!-- Modal without having header and footer -->
    <aura:attribute name="isWithoutHeaderFooterModal" type="boolean" default="true" />


    <aura:attribute name="isConfirmationDelete" type="boolean" default="false" />
    <aura:attribute name="confirmDeleteType" type="string" default="" />
    <aura:attribute name="confirmDeleteIndex" type="string" default="" />

    <aura:attribute name="isAddPaymentMethod" type="boolean" default="false" />
    <aura:attribute name="isUpdatePaymentMethod" type="boolean" default="false" />
    <aura:attribute name="isPayButDisable" type="boolean" default="false" />

    <!-- Payment Status Screen in Modal -->
    <aura:attribute name="isPaymentSuccess" type="boolean" default="false" />
    <aura:attribute name="isPaymentError" type="boolean" default="false" />
    <aura:attribute name="paymentErrorMessageOnScreen" type="String" />

    <!-- This attribute have the id of current Active tab in Credit and Echeck tabs -->
    <aura:attribute name="currentActiveTab" type="string" default="tab-2" />

    <aura:attribute name="fieldDisabled" type="boolean" default="false" />
    <aura:attribute name="savedClick" type="boolean" default="false" />
    <!-- <aura:attribute name="showInvoiceDetails" type="boolean" default="true" /> -->
    <aura:attribute name="disableFields" type="boolean" default="false"
        description="disable and Enable Security code and Date fields on Bind and Pay." />

    <aura:attribute name="setPaymentMethod" type="string" default="" />
	<aura:registerEvent name="submitEvent" type="c:creditCardHostedPayEvent" />
    <aura:registerEvent name="errorEvent" type="c:creditCardHostedPayEvent" />
    <aura:handler name="submitEvent" event="c:creditCardHostedPayEvent" action="{!c.handleSubmitEvent}" />
    <aura:registerEvent name="backEvent" type="c:creditCardHostedPayEvent" />
    <aura:handler name="backEvent" event="c:creditCardHostedPayEvent" action="{!c.backToSavedBut}" />
    <aura:attribute name="paymentMethodData" type="Object" />

    <!-- Card Attributes -->
    <aura:attribute name="cardFirstFour" type="string" default='----' />
    <aura:attribute name="cardSecondFour" type="string" default='----' />
    <aura:attribute name="cardThirdFour" type="string" default='----' />
    <aura:attribute name="cardFourthFour" type="string" default='----' />
    <aura:attribute name="cardHolderName" type="String" default="Name on Card" />
    <aura:attribute name="cardExpiryMonth" type="String" default="--" />
    <aura:attribute name="cardExpiryMonthList" type="Object[]" />
    <aura:attribute name="cardExpiryYear" type="String" default="----" />
    <aura:attribute name="cardExpiryYearList" type="Object[]" />
    <aura:attribute name="cardCvv" type="String" default="XXX" />
    <aura:attribute name="numberOfCardCvv" type="String" default="3" />
    <aura:attribute name="cardType" type="string" default="none" />
    <aura:attribute name="isAutoPay" type="boolean" default="true" />

    <!-- timer -->
    <aura:attribute name="timmerInfo" type="Object" description="" default="" />
    <aura:attribute name="isTimeOut" type="Boolean" description="" default="false" />
    <aura:attribute name="timmerStarted" type="Boolean" description="" default="false" />
    <aura:attribute name="timeAfterTimerStarted" type="Integer" description="" default="00" />
    <aura:attribute name="minutes" type="Integer" description="" default="" />
    <aura:attribute name="seconds" type="Integer" description="" default="00" />
    <aura:handler name="change" value="{!v.timeAfterTimerStarted}" action="{!c.StartTimmer}" />
    <aura:handler name="change" value="{!v.timmerStarted}" action="{!c.StartTimmer}" />
    <!-- Toast -->
    <aura:attribute name="paymentToastMessage" type="List" default="[]" />
    <aura:attribute name="isToastPaymentError" type="boolean" default="false" />
    <aura:attribute name="isToastPaymentSuccess" type="boolean" default="false" />
    <aura:attribute name="isLink" type="boolean" default="false" />

    <aura:attribute name="isDueDateValid" type="boolean" default="false" />
    <aura:attribute name="tempselectedDate" type="Date" />

    <!-- <aura:handler name="change" value="{!v.payWrapper.firstInstallmentDate}" action="{!c.handleChangeDueDate}" /> -->

    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <aura:handler name="change" value="{!v.isPaymentLoad}" action="{!c.getSavedPaymentMethodsListHandle}" />

    <!-- Spinner Starts -->
    <div aura:id="fullScreenSpinnerId" class="fullScreenSpinner">
        <div class="opposites">
            <div class="opposites bl"></div>
            <div class="opposites tr"></div>
            <div class="opposites br"></div>
            <div class="opposites tl"></div>
        </div>
    </div> <!-- Spinner Ends -->

    <!-- Toast Starts -->
    <div aura:id="toastId" class="toast dflex smallPadding">
        <div class="dflex gap dflexac dflexfo smallPadding">
            <aura:if isTrue="{!v.isToastPaymentError}">
                <lightning:icon iconName="action:close" size="x-small" alternativeText="close" title="Close" />
                <div class="dflexfo normalText">
                    <div class="erroToast">
                        <aura:iteration items="{!v.paymentToastMessage}" var="item">
                            <div class="errorToastMessage">{!item}</div>
                        </aura:iteration>
                    </div>
                </div>
                <div class="toastCloseBut" onclick="{!c.closeToastBut}">
                    <lightning:icon iconName="utility:close" size="x-small" alternativeText="close" title="Close" />
                </div>
            </aura:if>
            <aura:if isTrue="{!v.isToastPaymentSuccess}">
                <lightning:icon iconName="action:close" size="x-small" alternativeText="close" title="Close" />
                <div class="dflexfo normalText">
                    <div class="successToast">
                        <aura:iteration items="{!v.paymentToastMessage}" var="item">
                            <aura:if isTrue="{!v.isLink}">
                                <a href="{!item}"> Go to link</a>
                                <aura:set attribute="else">
                                    <div class="successToastMessage">{!item}</div>
                                </aura:set>
                            </aura:if>
                        </aura:iteration>
                    </div>
                </div>
                <div class="toastCloseBut" onclick="{!c.closeToastBut}">
                    <lightning:icon iconName="utility:close" size="x-small" alternativeText="close" title="Close" />
                </div>
            </aura:if>

        </div>
    </div>
    <!-- Toast Ends -->
    <!-- Popup Starts -->
    <div class="popup" aura:id="popupID">
        <div class="popupModal dflexcol">
            <aura:if isTrue="{!v.showErrorModal}">
                <div class="popupContainer dflexfo dflex">
                    <div style="text-align: center;" class="normalText">
                        <div class="mediumPadding">
                            Effective date cannot be more than 30 days in the past. Please contact your Underwriter.
                        </div>
                        <!--div>
                            {!v.payWrapper.policy.Underwriter_User__r.Title}
                        </div-->
                        <div>
                            {!v.payWrapper.policy.Underwriter_User__r.Name}
                        </div>
                        <div>
                            {!v.payWrapper.policy.Underwriter_User__r.Email}
                        </div>
                        <div>
                            {!v.payWrapper.policy.Underwriter_User__r.Phone}
                        </div>
                    </div>
                </div>
                <div class="dflex dflexje gap popupFooter smallPadding normalText">
                    <div class="modalButton negativeBut" onclick="{!c.closePopUpBut}">
                        Close
                    </div>
                </div>
            </aura:if>

            <aura:if isTrue="{!v.isHeaderFooterModal}">
                <div class="popupHeader dflex gap dflexac dflexjspace mediumPadding">
                    <aura:if isTrue="{!v.isSavedScreen}">
                        <div class="mainHeading">
                            Select Card / eCheck
                        </div>
                    </aura:if>
                    <aura:if isTrue="{!v.isAddScreen}">
                        <aura:if isTrue="{!v.isAddPaymentMethod}">
                            <div class="mainHeading">
                                Confirm Payment
                            </div>
                            <aura:set attribute="else">
                                <div class="mainHeading">
                                    Enter Details
                                </div>
                            </aura:set>
                        </aura:if>
                    </aura:if>

                    <aura:if isTrue="{!v.showDeleteLawyerModal}">
                        <div class="mainHeading">
                            Remove Lawyer
                        </div>
                    </aura:if>
                    <aura:if isTrue="{!v.showAddLawyerModal}">
                        <div class="mainHeading">
                            Add Lawyer
                        </div>
                    </aura:if>
                    <aura:if isTrue="{!v.showCancelPolicyModal}">
                        <div class="mainHeading">
                            Cancel Policy
                        </div>
                    </aura:if>
                    <aura:if isTrue="{!v.ShowBillingPs}">
                        <div class="mainHeading">
                            Payment Schedules
                        </div>
                    </aura:if>
                    <div class="popupCloseButton modalClose" onclick="{!c.closePopUpBut}">
                        <lightning:icon iconName="utility:close" size="x-small" alternativeText="close" title="Close" />
                    </div>

                </div>
                <div class="popupContainer dflexfo dflex">
                    <!-- Saved Cards and Echeck List Screen -->
                    <aura:if isTrue="{!v.isSavedScreen}">
                        <div class="dflexfo dflexcol gap overflowHidden">
                            <div class="dflexfo dflexcol borderBox cardSection">
                                <div class="savedHeader normalHeading" style="border-top-right-radius: 0.6rem; border-top-left-radius: 0.6rem;">Saved eCheck</div><!--style="width: 52.25rem;"-->
                                <aura:if isTrue="{!v.savedEcheckList.length}">
                                    <div class="cardSliderBox dflexfo savedScrollable scrollbar-x dflex dflexac gap">
                                        <aura:iteration items="{!v.savedEcheckList}" var="item" indexVar="index">
                                            <!-- Card Starts from here -->
                                            <div class="displayCard-saved dflexcol dflexjspace mediumPadding deleteParent"
                                                data-recordid="{!index}" data-recordtype="eCheck">
                                                <!--  onclick="{!c.savedItemClick}" -->
                                                <div class="deleteButtonDiv" title="Delete"
                                                    onclick="{!c.deleteSavedItem}" data-recordid="{!index}"
                                                    data-recordtype="eCheck">
                                                    <lightning:icon iconName="utility:delete" size="x-small"
                                                        alternativeText="delete" title="delete" />
                                                </div>
                                                <div class="cardHolderName">
                                                    Routing number :
                                                </div>
                                                <div class="cardNumber-saved">
                                                    {!item.routingNumber}
                                                    <!-- Tushar Goyal -->
                                                </div>
                                                <div class="cardHolderName">
                                                    Account number :
                                                </div>
                                                <div class="cardNumber-saved">
                                                    {!item.accountHolderName}
                                                </div>
                                            </div>
                                        </aura:iteration>
                                    </div>
                                    <aura:set attribute="else">
                                        <div class="cardSliderBox dflexfo dflexcen dflex dflexac gap">
                                            No Saved E-Checks.
                                        </div>
                                    </aura:set>
                                </aura:if>
                            </div>
                            <div class="dflexfo dflexcol borderBox cardSection">
                                <div class="savedHeader normalHeading" style="border-top-right-radius: 0.6rem; border-top-left-radius: 0.6rem;">Saved Cards</div><!--style="width: 52.25rem;"-->
                                <aura:if isTrue="{!v.savedCardList.length}">
                                    <div class="cardSliderBox dflexfo savedScrollable scrollbar-x dflex dflexac gap">
                                        <aura:iteration items="{!v.savedCardList}" var="item" indexVar="index">
                                            <!-- Card Starts from here -->
                                            <div class="displayCard-saved dflexcol dflexjspace mediumPadding deleteParent"
                                                data-recordid="{!index}" data-recordtype="creditCard">
                                                <!--  
                                                    onclick="{!c.savedItemClick}" -->
                                                <div class="deleteButtonDiv" title="Delete"
                                                    onclick="{!c.deleteSavedItem}" data-recordid="{!index}"
                                                    data-recordtype="creditCard">
                                                    <lightning:icon iconName="utility:delete" size="x-small"
                                                        alternativeText="delete" title="delete" />
                                                </div>
                                                <div class="dflex dflexjspace rs_orderTwo">
                                                    <div class="expiryValue">
                                                        {!item.expireMonth}/{!item.expireYear}
                                                    </div>
                                                    <div class="cardTypeImage">
                                                        <aura:if isTrue="{!item.cardTypeVar.cardType == 'none'}">
                                                            <aura:set attribute="else">
                                                                <img alt="cardTypeImage" class="cardTypeImage"
                                                                    src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/CardType/' + item.cardTypeVar +'.png'}" />
                                                                <aura:if
                                                                    isTrue="{!AND(AND(item.cardTypeVar != 'visa' , item.cardTypeVar != 'amex') , AND(item.cardTypeVar != 'mc' , item.cardTypeVar != 'disc'))}">
                                                                    In Valid
                                                                </aura:if>
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                                <div class="cardHolderName rs_orderOne">
                                                    {!item.nameOnCard}
                                                    <!-- Tushar Goyal -->
                                                </div>
                                                <div class="dflex dflexjspace rs_orderThree">
                                                    <div class="cardNumber-saved">
                                                        {!item.cardNumber}
                                                    </div>
                                                    <aura:if isTrue="{!item.isDefault}">
                                                        <div class="defaultMethod normalText">
                                                            Default
                                                        </div>
                                                    </aura:if>
                                                </div>
                                            </div>
                                        </aura:iteration>
                                    </div>
                                    <aura:set attribute="else">
                                        <div class="cardSliderBox dflexfo dflexcen scrollbar-x dflex dflexac gap">
                                            No Saved Cards.
                                        </div>
                                    </aura:set>
                                </aura:if>
                            </div>

                        </div>
                    </aura:if>
                    <!-- Add new Cards and Echeck Screen -->
                    <aura:if isTrue="{!v.isAddScreen}">
                        <div class="dflexfo tabs dflexcol borderBox">
                            <aura:if isTrue="{!AND(NOT(v.isAddPaymentMethod), NOT(v.savedClick))}">
                                <div class="tabHeader dflex">
                                    <div aura:id="tab-2" id="tab-2" data-tabvalue="check" onclick="{!c.tabClick}"
                                        class="tabHeading normalHeading dflexfo activeTab" style="border-top-left-radius: 0.6rem;">
                                        eCheck/ACH
                                    </div>
                                    <div aura:id="tab-1" id="tab-1" data-tabvalue="creditCard" onclick="{!c.tabClick}"
                                        class="tabHeading normalHeading dflexfo" style="border-top-right-radius: 0.6rem;">
                                        Credit Card
                                    </div>
                                </div>
                            </aura:if>
                            <div style="margin: auto 0;"
                                class="tabContainer dflex hoverScrollableDivOnHover hoverScrollableDiv">
                                <div aura:id="tab-2-data" class="tabData dflexfo dflexcol gap activeTabData">
                                    <div class="dflex mediumPadding">
                                        <aura:if isTrue="{!!v.isAddPaymentMethod}">
                                            <div class="dflexcol gap inputFieldSection dflexfo">
                                                <!-- <aura:if isTrue="{!v.isAddPaymentMethod}"> -->
                                                <!-- <div class="dflex gap">
                                                    <div class="inputField dflexfo">
                                                        <div class="label">First Name</div>
                                                        <input type="text" value="{!v.payWrapper.firstName}"
                                                            onblur="{!c.isCheckFirstNameValid}" id="checkFirstName"
                                                            name="First Name" />
                                                    </div>
                                                    <div class="inputField dflexfo">
                                                        <div class="label">Last Name</div>
                                                        <input type="text" value="{!v.payWrapper.lastName}"
                                                            onblur="{!c.isCheckLastNameValid}" id="checkLastName"
                                                            name="Last Name" />
                                                    </div>
                                                </div> -->
                                                <!-- </aura:if> -->
                                                <div class="dflex gap rs_col">
                                                    <div class="inputField dflexfo">
                                                        <div class="label">Routing Number</div>
                                                        <input disabled="{!v.fieldDisabled}" type="text"
                                                            value="{!v.payWrapper.routingNumber}"
                                                            onblur="{!c.isCheckRoutingNumberValid}" id="checkRoutingNumber"
                                                            name="Routing Number" />
                                                    </div>
                                                    <div class="inputField dflexfo">
                                                        <div class="label">Account Number</div>
                                                        <input disabled="{!v.fieldDisabled}" type="text"
                                                            value="{!v.payWrapper.accountNumber}"
                                                            onblur="{!c.isCheckAccountNumberValid}" id="checkAccountNumber"
                                                            name="Account Number" />
                                                    </div>
                                                </div>
                                                <div class="inputField">
                                                    <div class="label">Account Type</div>
                                                    <select disabled="{!v.fieldDisabled}" name="Account Type"
                                                        value="{!v.payWrapper.accountType}"
                                                        onchange="{!c.isCheckAccountType}" id="checkAccountType">
                                                        <option selected="{!v.payWrapper.accountType == 'none'}"
                                                            value="none">
                                                            Please select</option>
                                                        <option selected="{!v.payWrapper.accountType == 'checking'}"
                                                            value="checking">Checking</option>
                                                        <option selected="{!v.payWrapper.accountType == 'savings'}"
                                                            value="savings">Savings</option>
                                                    </select>
                                                </div>
                                                <div class="inputField">
                                                    <div class="label">Account Holder Name</div>
                                                    <input disabled="{!v.fieldDisabled}" type="text"
                                                        value="{!v.payWrapper.accountHolderName}"
                                                        onblur="{!c.isCheckAccountHolderNameValid}"
                                                        id="checkAccountHolderName" name="Account Holder Name" />
                                                </div>
                                            </div>
                                        </aura:if>
                                        <div class="dflexfo dflexcol gap DisPlayNone">
                                        <aura:if isTrue="{!!v.isAddPaymentMethod}">
                                            <div class="dflexfo displayCardDiv dflexcen" style="width: 22rem;">
                                                <div class="displayEcheckSample">
                                                    <img alt="echeckSampleImage" class="echeckSampleImage"
                                                        src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/eCheckDetailsSampleImage.png'}" />
                                                </div>
                                            </div>
                                        </aura:if>
                                        <aura:if isTrue="{!v.isAddPaymentMethod}">
                                            <div class="transactionDetails borderBox mediumPadding">
                                                <div class="detailLine dflex dflexjspace">
                                                    <div class="head">Account Number</div>
                                                    <div class="value">
                                                        <aura:if isTrue="{!v.payWrapper.accountNumber != null}">
                                                            {!v.payWrapper.accountNumber}
                                                            <aura:set attribute="else">
                                                                ---
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                                <div class="detailLine dflex dflexjspace">
                                                    <div class="head">Account Holder Name</div>
                                                    <div class="value">
                                                        <aura:if isTrue="{!v.payWrapper.accountHolderName != null}">
                                                            {!v.payWrapper.accountHolderName}
                                                            <aura:set attribute="else">
                                                                --
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                                <div class="detailLine dflex dflexjspace">
                                                    <div class="head">Account Type</div>
                                                    <div class="value">
                                                        <aura:if isTrue="{!v.payWrapper.accountType != null}">
                                                            {!v.payWrapper.accountType}
                                                            <aura:set attribute="else">
                                                                ---
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="transactionDetails borderBox mediumPadding">
                                                <div class="detailLine dflex dflexjspace">
                                                    <div class="head">Invoice #:</div>
                                                    <div class="value">
                                                        <aura:if isTrue="{!v.payWrapper.invoiceId != null}">
                                                            {!v.payWrapper.invoiceId}
                                                            <aura:set attribute="else">
                                                                ---
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                                <div class="detailLine dflex dflexjspace">
                                                    <div class="head">Due Date</div>
                                                    <div class="value">
                                                        <aura:if isTrue="{!v.payWrapper.dueDateStr != null}">
                                                            {!v.payWrapper.dueDateStr}
                                                            <aura:set attribute="else">
                                                                ---
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                                <div class="detailLine dflex dflexjspace">
                                                    <div class="head">Invoice Amount</div>
                                                    <div class="value">
                                                        <aura:if isTrue="{!v.payWrapper.balanceDue != null}">

                                                            <lightning:formattedNumber
                                                                value="{!v.payWrapper.balanceDue}" style="currency"
                                                                currencyCode="USD" />
