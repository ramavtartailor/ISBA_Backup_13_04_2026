                                                                <lightning:formattedNumber maximumFractionDigits="2"
                                                                                           value="{! (v.payWrapper.firstInstallment* v.payWrapper.ccFeeRate/100) + v.payWrapper.firstInstallment}"
                                                                                           style="currency" currencyCode="USD" />
