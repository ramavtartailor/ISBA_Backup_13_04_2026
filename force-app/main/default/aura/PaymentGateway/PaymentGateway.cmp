                                                                {!v.payWrapper.accRecord.AcctSeed__Billing_Contact__r.Email}
                                                            </div>
                                                        </div>
                                                    </aura:if>
                                                    <aura:if
                                                        isTrue="{!v.payWrapper.accRecord.Recent_Policy_Lookup__r.Firm_Contact__r.Email != null}">
