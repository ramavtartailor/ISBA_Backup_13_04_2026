                                                                ---
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                            </div>
                                            <aura:if isTrue="{!AND(v.payWrapper.totalAmountDue != null, v.payWrapper.totalAmountDue > 0)}">
