                                                                </aura:if>
                                                                <aura:set attribute="else">
                                                                    ----
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                    <div class="detailLine dflex dflexjspace" style="margin-bottom: 20px;">
