                                                                <aura:if isTrue="{!v.payWrapper.description != ''}">
                                                                    {!v.payWrapper.description}
                                                                    <aura:set attribute="else">
                                                                        ----
                                                                    </aura:set>
                                                                </aura:if>
                                                                <aura:set attribute="else">
                                                                    ----
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div>
                                                    <div class="resHead head ztextCenter normalHeading"
                                                        style="margin-top: 15px; padding: 2px 0px 2px 4px; background-color: #f4f4f6;">
                                                        Named Insured:</div>
                                                    <div class="leftBottom dflexcol smallGap dflexfo dflexjc">
                                                        <div class="verticalDetailLine  dflexcol smallPadding">
                                                            <!-- <div class="head ztextCenter normalHeading">Bill To:</div> -->
                                                            <div class="value ztextCenter normalText">
                                                                <aura:if isTrue="{!v.wrapperLoad}">
                                                                    <b>{!v.payWrapper.firmName}</b><br />
                                                                    {!v.payWrapper.billingStreet}<br />
                                                                    {!v.payWrapper.billingCity},
                                                                    {!v.payWrapper.billingState}
                                                                    &nbsp;
                                                                    {!v.payWrapper.billingPostal}
                                                                    <aura:set attribute="else">
                                                                        ----
                                                                    </aura:set>
                                                                </aura:if>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- <div class="vert_seperator"></div> -->
                                                <div class="leftBottom dflexcol smallGap dflexfo zdflexjc">
                                                    <aura:if
                                                        isTrue="{!and(v.wrapperLoad, or(v.payWrapper.accRecord.AcctSeed__Billing_Contact__r.Email != null, v.payWrapper.accRecord.Recent_Policy_Lookup__r.Firm_Contact__r.Email != null))}">
                                                        <div class="head ztextCenter normalHeading"
                                                            style="margin-top: 15px; padding: 2px 0px 2px 4px; background-color: #f4f4f6;">
                                                            Billing/Policy
                                                            Contact Details:
                                                        </div>
                                                        <aura:if
                                                            isTrue="{!v.payWrapper.billing.AcctSeed__Customer__r.AcctSeed__Billing_Contact__r != null}">
                                                            <div class="verticalDetailLine  dflexcol smallPadding">
                                                                <div class="head ztextCenter normalHeading">Billing
                                                                    Contact
                                                                    Email:
                                                                </div>
                                                                <div class="value ztextCenter normalText">
                                                                    {!v.payWrapper.billing.AcctSeed__Customer__r.AcctSeed__Billing_Contact__r.Email}
                                                                </div>
                                                            </div>
                                                        </aura:if>
                                                        <aura:if
                                                            isTrue="{!v.payWrapper.billing.Policy__r.Firm_Contact__r.Email != null}">
                                                            <div class="verticalDetailLine dflexcol smallPadding">
                                                                <div class="head ztextCenter normalHeading">Policy
                                                                    Contact
                                                                    Email:
                                                                </div>
                                                                <div class="value ztextCenter normalText">
                                                                    {!v.payWrapper.billing.Policy__r.Firm_Contact__r.Email}
                                                                </div>
                                                            </div>
                                                        </aura:if>
                                                    </aura:if>
                                                </div>
                                            </div>
                                        </aura:set>
                                    </aura:if>
                                </div>
                                <div class="rightPanel  dflexcol largeGap"> <!--scrollableDiv-->
                                    <aura:if isTrue="{!v.isAccount}">
                                        <div class="rightTopPanel dflex largeGap ">
                                            <div aura:id="list-type" data-id="Applications"
                                                onclick="{!c.listTypeHandle}"
                                                class="isActiveSpan itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                APPLICATION / POLICY ({!v.pendingPolicyEndorsCount})
                                            </div>
                                            <div aura:id="list-type" data-id="Billing" onclick="{!c.listTypeHandle}"
                                                class="itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                BILLINGS ({!v.pendingbillingCount})
                                            </div>
                                            <!--div aura:id="list-type" data-id="Policy" onclick="{!c.listTypeHandle}"
                                        class="itemBox normalHeading mediumPadding dflexcen dflexfo">
                                        Policy
                                    </div-->
                                        </div>
                                        <div class="dflexfo tabContainer" style="height: 80%;">
                                            <aura:if isTrue="{!v.endorsementTabActive}">
                                                <div class="dflexcol" style="height: 100%;">
                                                    <div
                                                        class="rs_tableView rightBottomPanel dflexfo largePadding gap scrollableDiv">
                                                        <table class="myTable">
                                                            <tr>
                                                                <td colspan="5" style="font-size: 1rem;"><b>Pending
                                                                        Applications</b></td>
                                                            </tr>
                                                            <tr class="tableHeadRow">
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Action</div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Policy #</div>
