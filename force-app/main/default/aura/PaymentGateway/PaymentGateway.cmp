                </div>
                <div class="login-content dflexfo">
                    <div class="innerContent">
                        <div class="dflexcol gap mediumPadding">
                            <div class="normalHeading">Portal Login:</div>
                            <div class="inputField dflexfo">
                                <div class="label">Enter firm contact email address to receive an access link.</div>
                                <input type="text" value="" onkeyup="{!c.checkEmailValid}" id="emailAddress"
                                    name="Email Address" placeholder="" />
                                <div class="emailmessage">{!v.emailmessage}</div>
                            </div>
                        </div>
                        <div class="dflex gap mediumPadding dflexjc login-content-footer ">
                            <div aura:id="getLinkBut" type="submit" class="modalButton successBut disableBut"
                                onclick="{!c.getLink}">
                                Get Link
                            </div>
                        </div>
                    </div>
                </div>
                <!-- <div class="login-footer">
                    Footer text. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
