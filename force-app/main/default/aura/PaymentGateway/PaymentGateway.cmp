                                                        <aura:if isTrue="{!v.payWrapper.totalAmountDue != null}">
                                                            <lightning:formattedNumber maximumFractionDigits="2"
                                                                    value="{!((v.payWrapper.totalAmountDue * (100 + v.payWrapper.ccFeeRate))/100)}"
                                                                    style="currency" currencyCode="USD" />
