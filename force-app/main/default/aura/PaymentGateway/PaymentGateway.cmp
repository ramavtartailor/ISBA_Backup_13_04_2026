                                                                            class="tableHeadCell">
                                                                            <div class="amountField">
                                                                                <lightning:formattedNumber
                                                                                    value="{!item.Premium__c}"
                                                                                    style="currency"
                                                                                    currencyCode="USD" />
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                </aura:iteration>
                                                                <aura:set attribute="else">
                                                                    <tr>
                                                                        <td colspan="6" valign="middle"
                                                                            style="text-align: center;"
                                                                            class="tableDataCell">
                                                                            No pending applications were found.
                                                                        </td>
                                                                    </tr>
                                                                </aura:set>
                                                            </aura:if>
                                                        </table>
                                                        <table class="myTable">
                                                            <tr>
                                                                <td colspan="5" style="font-size: 1rem;"><b>Pending
                                                                        Endorsements</b></td>
                                                            </tr>
                                                            <tr class="tableHeadRow">
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Action</div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Name</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}" data-field="Name"
                                                                            data-id="Endorsement" data-type="String">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Lawyer</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}"
                                                                            data-field="Lawyer_Name__c"
                                                                            data-id="Endorsement" data-type="String">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Status</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}"
                                                                            data-field="Event_Status__c"
                                                                            data-id="Endorsement" data-type="String">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Effective Date</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}"
                                                                            data-field="Endorsement_Effective_Date__c"
                                                                            data-id="Endorsement" data-type="Date">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Policy #</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}"
                                                                            data-field="Policy__r.Name"
                                                                            data-id="Endorsement" data-type="String">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="amountField dflexje dflex gap">
                                                                        <div>Premium</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}"
                                                                            data-field="Premium__c"
                                                                            data-id="Endorsement" data-type="Decimal">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                            </tr>
                                                            <aura:if
                                                                isTrue="{!v.payWrapper.policyEndorsements.length > 0}">
                                                                <aura:iteration
                                                                    items="{!v.payWrapper.policyEndorsements}"
                                                                    var="item" indexVar="idx">
                                                                    <tr>
                                                                        <td valign="middle" class="tableDataCell head">
                                                                            <div class="dflexcol smallGap">
                                                                                <aura:if
                                                                                    isTrue="{!AND(OR(item.Endorsement_Number__c == 'IL 107', item.Endorsement_Number__c == 'IL 152'), NOT(item.Event_Status__c=='Submitted'))}">
                                                                                    <a href="{!item.Application_Form_Link__c}"
                                                                                        target="_blank">[Click to
                                                                                        continue]</a>
                                                                                </aura:if>
                                                                            </div>
                                                                        </td>
                                                                        <td valign="middle" class="tableDataCell head">
                                                                            <div class="dflexcol smallGap">
                                                                                {!item.Name}
                                                                            </div>
                                                                        </td>
                                                                        <td valign="middle" class="tableDataCell">
                                                                            {!item.Lawyer_Name__c}
                                                                        </td>
                                                                        <td valign="middle" class="tableDataCell">
                                                                            {!item.Event_Status__c}
                                                                        </td>
                                                                        <td valign="middle" class="tableDataCell">
                                                                            <ui:outputDate
                                                                                value="{!item.Endorsement_Effective_Date__c}"
                                                                                format="MM/DD/YYYY" />
                                                                        </td>
                                                                        <td valign="middle" class="tableDataCell">
                                                                            {!item.Policy__r.Name}
                                                                        </td>
                                                                        <td style="text-align: right;"
                                                                            class="tableHeadCell">
                                                                            <div class="amountField">
                                                                                <lightning:formattedNumber
                                                                                    value="{!item.Premium__c}"
                                                                                    style="currency"
                                                                                    currencyCode="USD" />
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                </aura:iteration>
                                                                <aura:set attribute="else">
                                                                    <tr>
                                                                        <td colspan="7" valign="middle"
                                                                            style="text-align: center;"
                                                                            class="tableDataCell">
                                                                            No pending endorsements were found.
                                                                        </td>
                                                                    </tr>
                                                                </aura:set>
                                                            </aura:if>
                                                        </table>
                                                        <table class="myTable">
                                                            <tr>
                                                                <td colspan="6" style="font-size: 1rem;"><b>Active
                                                                        Policy</b>
                                                                </td>
                                                            </tr>
                                                            <tr class="tableHeadRow">
                                                                <th class="tableHeadCell">

                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Policy #</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}"
                                                                            data-field="Policy_Number__c"
                                                                            data-id="Policy" data-type="String">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Effective Date</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}"
                                                                            data-field="Effective_Date__c"
                                                                            data-id="Policy" data-type="Date">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Expiration Date</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}"
                                                                            data-field="Expiration_Date__c"
                                                                            data-id="Policy" data-type="Date">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="dflex gap">
                                                                        <div>Cancel Date</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}"
                                                                            data-field="Cancel_Date__c" data-id="Policy"
                                                                            data-type="Date">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                                <th class="tableHeadCell">
                                                                    <div class="amountField dflexje dflex gap">
                                                                        <div>Premium</div>
                                                                        <div class="dflexcol dflexcolcen"
                                                                            onclick="{!c.handleSort}"
                                                                            data-field="Premium__c" data-id="Policy"
                                                                            data-type="Decimal">
                                                                            <lightning:icon iconName="utility:sort"
                                                                                alternativeText="Sort"
                                                                                size="xx-small" />
                                                                        </div>
                                                                    </div>
                                                                </th>
                                                            </tr>
                                                            <aura:iteration items="{!v.payWrapper.policies}" var="item"
                                                                indexVar="idx">
                                                                <tr>
                                                                    <td valign="middle" class="tableDataCell head">
                                                                        <aura:if isTrue="{!item.cvList.length > 0}">
                                                                            <aura:if isTrue="{!item.isExpended}">
                                                                                <div onclick="{!c.handleShrink}"
                                                                                    data-index="{!idx}" data-row="Policy">
                                                                                    <lightning:icon
                                                                                        iconName="utility:down"
                                                                                        alternativeText="Shrink"
                                                                                        size="x-small"
                                                                                        title="xx-small size" />
                                                                                </div>
                                                                                <aura:set attribute="else">
                                                                                    <div onclick="{!c.handleExpand}"
                                                                                        data-index="{!idx}" data-row="Policy">
                                                                                        <lightning:icon
                                                                                            iconName="utility:right"
                                                                                            alternativeText="Expand"
                                                                                            size="x-small"
                                                                                            title="xx-small size" />
                                                                                    </div>
                                                                                </aura:set>
                                                                            </aura:if>
                                                                        </aura:if>
                                                                    </td>
                                                                    <td valign="middle" class="tableDataCell head">
                                                                        <div class="dflexcol smallGap">
                                                                            {!item.policy.Name}
                                                                        </div>
                                                                    </td>
                                                                    <td valign="middle" class="tableDataCell">
                                                                        <ui:outputDate
                                                                            value="{!item.policy.Effective_Date__c}"
                                                                            format="MM/DD/YYYY" />
                                                                    </td>
                                                                    <td valign="middle" class="tableDataCell">
                                                                        <ui:outputDate
                                                                            value="{!item.policy.Expiration_Date__c}"
                                                                            format="MM/DD/YYYY" />
                                                                    </td>
                                                                    <td valign="middle" class="tableDataCell">
                                                                        <ui:outputDate
                                                                            value="{!item.policy.Cancel_Date__c}"
                                                                            format="MM/DD/YYYY" />
                                                                    </td>
                                                                    <td style="text-align: right;"
                                                                        class="tableHeadCell">
                                                                        <div class="amountField">
                                                                            <lightning:formattedNumber
                                                                                value="{!item.policy.Premium__c}"
                                                                                style="currency" currencyCode="USD" />
                                                                        </div>
                                                                    </td>
                                                                </tr>

                                                                <aura:if isTrue="{!item.isExpended}">
                                                                    <tr>
                                                                        <td>
                                                                            <h1></h1><!-- Documents -->
                                                                        </td>
                                                                        <td colSpan="5">
                                                                            <div
                                                                                style="display: flex; justify-content: right; gap: 1rem;">
                                                                                <div class="lawyerButt"
                                                                                    data-index="{!idx}"
                                                                                    onclick="{!c.handleAddLawyer}">
                                                                                    Add Lawyer
                                                                                </div>
                                                                                <div class="lawyerButt"
                                                                                    data-index="{!idx}"
                                                                                    onclick="{!c.handleDeleteLawyer}">
                                                                                    Remove Laywer
                                                                                </div>
                                                                                <!--div class="lawyerButt"
                                                                                    data-index="{!idx}"
                                                                                    onclick="{!c.handleCancelPolicy}">
                                                                                    Cancel Policy
                                                                                </div-->
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td colSpan="6">
                                                                            <div>
                                                                                <table>
                                                                                    <thead>
                                                                                        <tr>
                                                                                            <th class="dflex gap">
                                                                                                <aura:if isTrue="{!item.isCVListExpended}">
                                                                                                    <div onclick="{!c.handleShrink}"
                                                                                                         data-index="{!idx}" data-row="cvList">
                                                                                                        <lightning:icon
                                                                                                                        iconName="utility:down"
                                                                                                                        alternativeText="Shrink"
                                                                                                                        size="x-small"
                                                                                                                        title="xx-small size" />
                                                                                                    </div>
                                                                                                    <aura:set attribute="else">
                                                                                                        <div onclick="{!c.handleExpand}"
                                                                                                             data-index="{!idx}" data-row="cvList">
                                                                                                            <lightning:icon
                                                                                                                            iconName="utility:right"
                                                                                                                            alternativeText="Expand"
                                                                                                                            size="x-small"
                                                                                                                            title="xx-small size" />
                                                                                                        </div>
                                                                                                    </aura:set>
                                                                                                </aura:if>
                                                                                                Policy Documents
                                                                                            </th>
                                                                                            <th>
                                                                                                Document Type
                                                                                            </th>
                                                                                            <th>

                                                                                            </th>
                                                                                            <!--th>
                                                                                        
                                                                                    </th-->
                                                                                        </tr>
                                                                                    </thead>
                                                                                    <aura:if isTrue="{!item.isCVListExpended}">
                                                                                        <tbody>
                                                                                            <aura:if
                                                                                                     isTrue="{!item.cvList.length > 0}">
                                                                                                <aura:iteration
                                                                                                                items="{!item.cvList}"
                                                                                                                var="cv"
                                                                                                                indexVar="indx">
                                                                                                    <tr class="cvrow" onclick="{!c.previewFile}" data-index="{!idx}" data-row="{!indx}">
                                                                                                        <td>
                                                                                                            <div>
                                                                                                                {!cv.name}
                                                                                                            </div>
                                                                                                        </td>
                                                                                                        <td>
                                                                                                            <div>
                                                                                                                {!cv.cvObj.Document_Type__c}
                                                                                                            </div>
                                                                                                        </td>
                                                                                                        <td
                                                                                                            class="dflexcol dflexae">
                                                                                                            <div class="pdfIconImageParent"> <!--onclick="{!c.previewFile}" data-index="{!idx}" data-row="{!indx}"-->
                                                                                                                <!--lightning:icon iconName="utility:preview" alternativeText="Preview" size="small" title="small size" /-->
                                                                                                                <img alt="paymentStatusImage"
                                                                                                                     class="pdfIconImage"
                                                                                                                     src="{!$Resource.pdfIcon}" />
                                                                                                            </div>
                                                                                                        </td>
                                                                                                        <!--td>
                                                                                                    <div onclick="{!c.downloadFile}" data-index="{!idx}" data-id="{!cv.ContentDocumentId}" data-row="{!indx}">
                                                                                                        <lightning:icon iconName="utility:download" alternativeText="Download" size="small" title="small size" />
                                                                                                    </div>
                                                                                                </td-->
                                                                                                    </tr>
                                                                                                </aura:iteration>
                                                                                                <aura:set attribute="else">
                                                                                                    <tr>
                                                                                                        <td colSpan="3"
                                                                                                            class="textCenter">
                                                                                                            Documents not
                                                                                                            found.
                                                                                                        </td>
                                                                                                    </tr>
                                                                                                </aura:set>
                                                                                            </aura:if>
                                                                                        </tbody>
                                                                                    </aura:if>
                                                                                </table>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                </aura:if>
                                                            </aura:iteration>
                                                        </table>
                                                    </div>
                                                    <div class="rs_ListView rightBottomPanel dflexfo gap scrollableDiv">
                                                        <div class="dflexcol" style="gap:1rem;">
                                                            <div class="" style="font-size: 1rem;">
                                                                <b>Pending Applications</b>
                                                            </div>
                                                            <aura:if isTrue="{!v.payWrapper.applications.length > 0}">
                                                                <aura:iteration items="{!v.payWrapper.applications}"
                                                                    var="item" indexVar="idx">
                                                                    <div class="listViewBox dflexcol dflexac">
                                                                        <div class="box dflexcol">
                                                                            <div class="pathLine">
                                                                                <img alt="pathLine" class="pathLineImg"
                                                                                    src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/Line.png'}" />
                                                                            </div>
                                                                            <div
                                                                                class="headerRow dflex dflexjspace mediumPadding">
                                                                                <div class="head">{!item.Name}
                                                                                </div>
                                                                                <aura:if
                                                                                    isTrue="{!OR(item.Renewal_Type__c == 'Online Invoice',item.Renewal_Type__c == 'Regular Renewal')}">
                                                                                    <div class="dflexje">
                                                                                        <aura:if
                                                                                            isTrue="{!item.Renewal_Type__c == 'Online Invoice'}">
                                                                                            <a href="{!item.Application_Form_Link__c}"
                                                                                                target="_blank">[Click
                                                                                                to
                                                                                                continue]</a>
                                                                                        </aura:if>
                                                                                        <aura:if
                                                                                            isTrue="{!item.Renewal_Type__c == 'Regular Renewal'}">
                                                                                            <a href="{!item.Customer_Application__r.Form_Link__c}"
                                                                                                target="_blank">[Click
                                                                                                to
                                                                                                continue]</a>
                                                                                        </aura:if>
                                                                                        <aura:set attribute="else">
                                                                                            N/A
                                                                                        </aura:set>
                                                                                    </div>
                                                                                </aura:if>
                                                                            </div>
                                                                            <div class="amountRow dflex">
                                                                                <div class="amountCol dflexfo">
                                                                                    <div class="val">Effective Date
                                                                                    </div>
                                                                                    <div class="head">
                                                                                        <ui:outputDate
                                                                                            value="{!item.Effective_Date__c}"
                                                                                            format="MM/DD/YYYY" />
                                                                                    </div>
                                                                                </div>
                                                                                <div class="hori_seperator"></div>
                                                                                <div class="amountCol dflexfo">
                                                                                    <div class="val">Expiration Date
                                                                                    </div>
                                                                                    <div class="head">
                                                                                        <ui:outputDate
                                                                                            value="{!item.Expiration_Date__c}"
                                                                                            format="MM/DD/YYYY" />
                                                                                    </div>
                                                                                </div>
                                                                                <div class="hori_seperator"></div>
                                                                                <div class="amountCol dflexfo">
                                                                                    <div class="val">Cancel Date</div>
                                                                                    <div class="head">
                                                                                        <ui:outputDate
                                                                                            value="{!item.Cancel_Date__c}"
                                                                                            format="MM/DD/YYYY" />
                                                                                    </div>
                                                                                </div>
                                                                                <div class="hori_seperator"></div>
                                                                                <div class="amountCol dflexfo">
                                                                                    <div class="val">Premium</div>
                                                                                    <div class="head">
                                                                                        <lightning:formattedNumber
                                                                                            value="{!item.Premium__c}"
                                                                                            style="currency"
                                                                                            currencyCode="USD" />
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </aura:iteration>
                                                            </aura:if>
                                                        </div>
                                                        <div class="dflexcol" style="gap:1.5rem;margin: 1.5rem 0 0 0;">
                                                            <div class="" style="font-size: 1rem;">
                                                                <b>Pending Endorsements</b>
                                                            </div>
                                                            <aura:if
                                                                isTrue="{!v.payWrapper.policyEndorsements.length > 0}">
                                                                <aura:iteration
                                                                    items="{!v.payWrapper.policyEndorsements}"
                                                                    var="item" indexVar="idx">
                                                                    <div class="listViewBox dflexcol dflexac">
                                                                        <div class="box dflexcol">
                                                                            <div class="pathLine">
                                                                                <img alt="pathLine" class="pathLineImg"
                                                                                    src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/Line.png'}" />
                                                                            </div>
                                                                            <div
                                                                                class="headerRow dflex dflexjspace mediumPadding">
                                                                                <div class="head">
                                                                                    {!item.Policy__r.Name}
                                                                                    <aura:if
                                                                                        isTrue="{!NOT(item.Event_Status__c=='Submitted')}">
                                                                                        <div class="rs_SmallText">
                                                                                            <a href="{!item.Application_Form_Link__c}"
                                                                                                target="_blank">{!item.Name}</a>
                                                                                        </div>
                                                                                        <aura:set attribute="else">
                                                                                            <div class="rs_SmallText">
                                                                                                {!item.Name}
                                                                                            </div>
                                                                                        </aura:set>
                                                                                    </aura:if>
                                                                                </div>
                                                                            </div>
                                                                            <div class="amountRow dflex">
                                                                                <div class="amountCol dflexfo">
                                                                                    <div class="val">Effective Date
                                                                                    </div>
                                                                                    <div class="head">
                                                                                        <ui:outputDate
                                                                                            value="{!item.Endorsement_Effective_Date__c}"
                                                                                            format="MM/DD/YYYY" />
                                                                                    </div>
                                                                                </div>
                                                                                <div class="hori_seperator"></div>
                                                                                <div class="amountCol dflexfo">
                                                                                    <div class="val">Premium</div>
                                                                                    <div class="head">
                                                                                        <span>
                                                                                            <lightning:formattedNumber
                                                                                                value="{!item.Premium__c}"
                                                                                                style="currency"
                                                                                                currencyCode="USD" />
                                                                                        </span>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </aura:iteration>
                                                                 <aura:set attribute="else">
                                                                    <div class="box dflexcol" style="text-align: center;">
                                                                            No pending endorsements were found.
                                                                    </div>
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                        <div class="dflexcol" style="gap:1.5rem;margin: 1.5rem 0 0 0;">
                                                            <div class="" style="font-size: 1rem;">
                                                                <b>Active Policy</b>
                                                            </div>
                                                            <aura:iteration items="{!v.payWrapper.policies}" var="item"
                                                                indexVar="idx">
                                                                <div class="listViewBox dflexcol dflexac">
                                                                    <div class="box dflexcol">
                                                                        <div class="pathLine">
                                                                            <img alt="pathLine" class="pathLineImg"
                                                                                src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/Line.png'}" />
                                                                        </div>
                                                                        <div
                                                                            class="headerRow dflex dflexjspace mediumPadding">
                                                                            <div class="head">{!item.policy.Name}
                                                                            </div>
                                                                            <div class="dflexje">
                                                                                <div
                                                                                     >
                                                                                    <div class="lawyerMbButt"
                                                                                         data-index="{!idx}"
                                                                                         onclick="{!c.handleAddLawyer}">
                                                                                        Add Lawyer
                                                                                    </div>
                                                                                    <div class="lawyerMbButt"
                                                                                         data-index="{!idx}"
                                                                                         onclick="{!c.handleDeleteLawyer}">
                                                                                        Remove Laywer
                                                                                    </div>
                                                                                    
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="amountRow dflex">
                                                                            <div class="amountCol dflexfo">
                                                                                <div class="val">Effective Date</div>
                                                                                <div class="head">
                                                                                    <ui:outputDate
                                                                                        value="{!item.policy.Effective_Date__c}"
                                                                                        format="MM/DD/YYYY" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="hori_seperator"></div>
                                                                            <div class="amountCol dflexfo">
                                                                                <div class="val">Expiration Date</div>
                                                                                <div class="head">
                                                                                    <ui:outputDate
                                                                                        value="{!item.policy.Expiration_Date__c}"
                                                                                        format="MM/DD/YYYY" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="hori_seperator"></div>
                                                                            <div class="amountCol dflexfo">
                                                                                <div class="val">Cancel Date</div>
                                                                                <div class="head">
                                                                                    <ui:outputDate
                                                                                        value="{!item.policy.Cancel_Date__c}"
                                                                                        format="MM/DD/YYYY" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="hori_seperator"></div>
                                                                                <div class="amountCol dflexfo">
                                                                                    <div class="val">Premium</div>
                                                                                    <div class="head">
                                                                                        <lightning:formattedNumber
                                                                                            value="{!item.policy.Premium__c}"
                                                                                            style="currency"
                                                                                            currencyCode="USD" />
                                                                                    </div>
                                                                                </div>
                                                                        </div>

                                                                        <div class="{!'hiddenDetails ' + (item.isExpended ? '' : 'showHiddenDetails')}" data-index="{!idx}"
                                                                            aura:id="hiddenDetailsApplication">
                                                                            <div class="vert_seperator"></div>
                                                                            
                                                                          
                                                                            <table style = "width:95% !important;">
                                                                                <tr class="tableHeadRow">
                                                                                    <td class="tableDataCell">Policy
                                                                                        Document </td>
                                                                                    <td class="tableDataCell">
                                                                                        Document Type
                                                                                    </td>
                                                                                    <td class="tableDataCell"> </td>

                                                                                </tr>
                                                                                <aura:if
                                                                                    isTrue="{!item.cvList.length > 0}">
                                                                                    <aura:iteration
                                                                                        items="{!item.cvList}" var="cv"
                                                                                        indexVar="indx">
                                                                                        <tr class="tableHeadRow">
                                                                                            <td class="tableDataCell">
                                                                                                {!cv.name}</td>
                                                                                            <td
                                                                                                class="tableDataCell ">
                                                                                                {!cv.cvObj.Document_Type__c}
                                                                                            </td>
                                                                                            <td
                                                                                                class="tableDataCell textRight">
                                                                                                <div onclick="{!c.previewFile}"
                                                                                                    class="pdfIconImageParent"
                                                                                                    data-index="{!idx}"
                                                                                                    data-row="{!indx}">
                                                                                                    <!--lightning:icon iconName="utility:preview" alternativeText="Preview" size="small" title="small size" /-->
                                                                                                    <img alt="paymentStatusImage"
                                                                                                        class="pdfIconImage"
                                                                                                        src="{!$Resource.pdfIcon}" />
                                                                                                </div>
                                                                                            </td>
                                                                                        </tr>
                                                                                    </aura:iteration>
                                                                                </aura:if>
                                                                            </table>
                                                                        </div>
                                                                    </div>
                                                                    <aura:if isTrue="{!item.isExpended}">
                                                                        <div class="expandButton"
                                                                            onclick="{!c.rs_expandApplicationRow}"
                                                                            data-index="{!idx}">
                                                                            <lightning:icon iconName="utility:chevrondown"
                                                                                size="x-small"
                                                                                alternativeText="contract"
                                                                                title="contract" />
                                                                        </div>
                                                                        <aura:set attribute="else">
                                                                            <div class="expandButton"
                                                                                onclick="{!c.rs_expandApplicationRow}"
                                                                                data-index="{!idx}">
                                                                                <lightning:icon
                                                                                    iconName="utility:chevronup"
                                                                                    size="x-small"
                                                                                    alternativeText="expand"
                                                                                    title="expand" />
                                                                            </div>
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </div>
                                                            </aura:iteration>
                                                        </div>
                                                    </div>
                                                </div>
                                            </aura:if>
                                            <aura:if isTrue="{!v.billingTabActive}">
                                                <div class="rs_tableView rightBottomPanel dflexfo largePadding gap scrollableDiv"
                                                    style="height: 100%;padding-top:1rem;justify-content: start !important;">
                                                    <table class="myTable">
                                                        <tr class="tableHeadRow">
                                                            <th class="tableHeadCell" style="background: none; font-size: 1.5rem; padding: 0.1rem;" colspan="9">
                                                                Current
                                                            </th>
                                                        </tr>
                                                        <tr class="tableHeadRow">
                                                            <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>Billing #</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}" data-field="Name"
                                                                        data-id="Billing" data-type="String">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>Invoice Date</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}"
                                                                        data-field="AcctSeed__Date__c" data-id="Billing"
                                                                        data-type="Date">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <!-- <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>Due Date</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}"
                                                                        data-field="AcctSeed__Due_Date2__c"
                                                                        data-id="Billing" data-type="Date">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th> -->
                                                            <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>Payment Frequency</div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>Payment Type</div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>Ending In...</div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="amountField dflexje dflex gap">
                                                                    <div>Total</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}"
                                                                        data-field="AcctSeed__Total__c"
                                                                        data-id="Billing" data-type="Decimal">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="amountField dflexje dflex gap">
                                                                    <div>Received</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}"
                                                                        data-field="AcctSeed__Received_Amount__c"
                                                                        data-id="Billing" data-type="Decimal">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="amountField dflexje dflex gap">
                                                                    <div>Balance</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}"
                                                                        data-field="AcctSeed__Balance__c"
                                                                        data-id="Billing" data-type="Decimal">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell buttonCol"></th>
                                                        </tr>
                                                        <aura:iteration items="{!v.payWrapper.billings}" var="item" indexVar="indexVr">
                                                            <aura:if isTrue="{!item.bill.AcctSeed__Balance__c > 0}">
                                                            	<tr>
                                                                <td valign="middle" class="tableDataCell head">
                                                                    <div class="dflexcol smallGap">
                                                                        {!item.bill.Name}
                                                                        <div class="smallText">
                                                                            {!item.bill.Billing_Description__c}
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td valign="middle" class="tableDataCell">
                                                                    <ui:outputDate
                                                                        value="{!item.bill.AcctSeed__Date__c}"
                                                                        format="MM/DD/YYYY" /><!--{!item.invoiceDate}-->
                                                                </td>
                                                                <!-- <td valign="middle" class="tableDataCell">
                                                                    <ui:outputDate
                                                                        value="{!item.bill.AcctSeed__Due_Date2__c}"
                                                                        format="MM/DD/YYYY" />
                                                                </td> -->
                                                                <td class="tableHeadCell">
                                                                    <a onclick="{!c.showPaymentSchedules}" data-index="{!indexVr}" >{!item.bill.Payment_Frequency__c}</a>
                                                                </td>
                                                                <td class="tableHeadCell">

                                                                    <aura:if
                                                                        isTrue="{!item.bill.Payment_Method__r.Type__c != null}">
                                                                        <aura:if
                                                                            isTrue="{!item.bill.Payment_Method__r.Type__c == 'Credit_Card'}">
                                                                            Credit Card
                                                                            <aura:set attribute="else">
                                                                                E-Check
                                                                            </aura:set>
                                                                        </aura:if>
                                                                    </aura:if>
                                                                    <!-- {!item.bill.Payment_Method__r.Type__c} -->
                                                                    <!-- {!item.bill.Payment_Method__r.Type__c != null} -->
                                                                </td>
                                                                <td style="text-align: right;" class="tableHeadCell">
                                                                    <!--{!item.bill.Payment_Method__r.AcctSeed__Account_Number__c}-->
                                                                    {!item.bill.Payment_Method__r.AcctSeed__Last_Four_Digits__c}
                                                                </td>
                                                                <td style="text-align: right;" class="tableHeadCell">
                                                                    <div class="amountField">
                                                                        <lightning:formattedNumber
                                                                            value="{!item.bill.AcctSeed__Total__c}"
                                                                            style="currency" currencyCode="USD" />
                                                                    </div>
                                                                </td>
                                                                <td style="text-align: right;" class="tableHeadCell">
                                                                    <div class="amountField">
                                                                        <lightning:formattedNumber
                                                                            value="{!item.bill.AcctSeed__Received_Amount__c}"
                                                                            style="currency" currencyCode="USD" />
                                                                    </div>
                                                                </td>
                                                                <td style="text-align: right;" align="right"
                                                                    valign="middle" class="ztableDataCell ">
                                                                    <div class="amountField">
                                                                        <lightning:formattedNumber
                                                                            value="{!item.bill.AcctSeed__Balance__c}"
                                                                            style="currency" currencyCode="USD" />
                                                                    </div>
                                                                </td>
                                                                <td valign="middle" class="tableDataCell actionCol">
                                                                    <div class="dflex smallGap buttonSection dflexjc">
                                                                        <aura:if
                                                                            isTrue="{!item.bill.AcctSeed__Balance__c == 0}">
                                                                            <div class="normalText billStatusText">
                                                                                Payment
                                                                                schedule is
                                                                                completed.
                                                                            </div>
                                                                            <aura:set attribute="else">
                                                                                <aura:if isTrue="{!item.bill.Payment_Schedules__r.length > 0}">
                                                                                    <aura:if isTrue="{!item.bill.Payment_Method__r.Type__c == null}">
                                                                                        <div class=" dflexfo listButton positiveBut payButt"
                                                                                             data-buttype="isPay"
                                                                                             data-billid="{!item.bill.Id}"
                                                                                             onclick="{!c.proceedToBilling}">
                                                                                            Update
                                                                                        </div>
                                                                                        <aura:set attribute="else">
                                                                                            <div class="dflexfo  listButton positiveBut modiPayButt"
                                                                                                 data-buttype="isModifyPayment"
                                                                                                 data-billid="{!item.bill.Id}"
                                                                                                 onclick="{!c.proceedToBilling}">
                                                                                                <!-- Modify Payment -->
                                                                                                Update
                                                                                            </div>
                                                                                        </aura:set>
                                                                                    </aura:if>
                                                                                    <aura:set attribute="else">
                                                                                        <div class="dflexfo  listButton positiveBut payButt"
                                                                                            data-buttype="isPay"
                                                                                            data-billid="{!item.bill.Id}"
                                                                                            onclick="{!c.proceedToBilling}">
                                                                                            <!-- Modify Payment -->
                                                                                            Pay
                                                                                        </div>
                                                                                    </aura:set>
                                                                                </aura:if>
                                                                            </aura:set>
                                                                        </aura:if>
                                                                        <div class="popupCloseButton pdfIconImageParent dflexcen"
                                                                            style="padding: 0;"
                                                                            onclick="{!c.printBillingHandle}"
                                                                            data-from="deskview"
                                                                            data-pdflink="{!item.pdfUrl}">
                                                                            <img alt="paymentStatusImage"
                                                                                class="pdfIconImage"
                                                                                src="{!$Resource.pdfIcon}" />

                                                                            <!-- <lightning:icon iconName="utility:pdf_ext"
                                                                        size="x-small" alternativeText="PDF"
                                                                        title="PDF" /> -->
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            </aura:if>
                                                        </aura:iteration>
                                                    </table>
                                                    <table class="myTable">
                                                        <tr class="tableHeadRow">
                                                            <th class="tableHeadCell" style="background: none; font-size: 1.5rem; padding: 0.1rem;" colspan="9">
                                                                Previous
                                                            </th>
                                                        </tr>
                                                        <tr class="tableHeadRow">
                                                            <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>
                                                                        <aura:if isTrue="{!v.isBillingExpended}">
                                                                            <div onclick="{!c.handleShrinkBilling}"
                                                                                 data-index="{!idx}" data-row="cvList">
                                                                                <lightning:icon
                                                                                                iconName="utility:down"
                                                                                                alternativeText="Shrink"
                                                                                                size="x-small"
                                                                                                title="xx-small size" />
                                                                            </div>
                                                                            <aura:set attribute="else">
                                                                                <div onclick="{!c.handleExpandBilling}"
                                                                                     data-index="{!idx}" data-row="cvList">
                                                                                    <lightning:icon
                                                                                                    iconName="utility:right"
                                                                                                    alternativeText="Expand"
                                                                                                    size="x-small"
                                                                                                    title="xx-small size" />
                                                                                </div>
                                                                            </aura:set>
                                                                        </aura:if>
                                                                    </div>
                                                                    <div>
                                                                        Billing #
                                                                    </div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}" data-field="Name"
                                                                        data-id="Billing" data-type="String">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>Invoice Date</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}"
                                                                        data-field="AcctSeed__Date__c" data-id="Billing"
                                                                        data-type="Date">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>Due Date</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}"
                                                                        data-field="AcctSeed__Due_Date2__c"
                                                                        data-id="Billing" data-type="Date">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>Payment Type</div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="dflex gap">
                                                                    <div>Ending In...</div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="amountField dflexje dflex gap">
                                                                    <div>Total</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}"
                                                                        data-field="AcctSeed__Total__c"
                                                                        data-id="Billing" data-type="Decimal">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="amountField dflexje dflex gap">
                                                                    <div>Received</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}"
                                                                        data-field="AcctSeed__Received_Amount__c"
                                                                        data-id="Billing" data-type="Decimal">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell">
                                                                <div class="amountField dflexje dflex gap">
                                                                    <div>Balance</div>
                                                                    <div class="dflexcol dflexcolcen"
                                                                        onclick="{!c.handleSort}"
                                                                        data-field="AcctSeed__Balance__c"
                                                                        data-id="Billing" data-type="Decimal">
                                                                        <lightning:icon iconName="utility:sort"
                                                                            alternativeText="Sort" size="xx-small" />
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th class="tableHeadCell buttonCol"></th>
                                                        </tr>
                                                        <aura:if isTrue="{!v.isBillingExpended}">
                                                        	<aura:iteration items="{!v.payWrapper.billings}" var="item">
                                                            <aura:if isTrue="{!item.bill.AcctSeed__Balance__c == 0}">
                                                            	<tr>
                                                                <td valign="middle" class="tableDataCell head">
                                                                    <div class="dflexcol smallGap">
                                                                        {!item.bill.Name}
                                                                        <div class="smallText">
                                                                            {!item.bill.Billing_Description__c}
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td valign="middle" class="tableDataCell">
                                                                    <ui:outputDate
                                                                        value="{!item.bill.AcctSeed__Date__c}"
                                                                        format="MM/DD/YYYY" /><!--{!item.invoiceDate}-->
                                                                </td>
                                                                <td valign="middle" class="tableDataCell">
                                                                    <ui:outputDate
                                                                        value="{!item.bill.AcctSeed__Due_Date2__c}"
                                                                        format="MM/DD/YYYY" />
                                                                </td>
                                                                <td class="tableHeadCell">

                                                                    <aura:if
                                                                        isTrue="{!item.bill.Payment_Method__r.Type__c != null}">
                                                                        <aura:if
                                                                            isTrue="{!item.bill.Payment_Method__r.Type__c == 'Credit_Card'}">
                                                                            Credit Card
                                                                            <aura:set attribute="else">
                                                                                E-Check
                                                                            </aura:set>
                                                                        </aura:if>
                                                                    </aura:if>
                                                                    <!-- {!item.bill.Payment_Method__r.Type__c} -->
                                                                    <!-- {!item.bill.Payment_Method__r.Type__c != null} -->
                                                                </td>
                                                                <td style="text-align: right;" class="tableHeadCell">
                                                                    <!--{!item.bill.Payment_Method__r.AcctSeed__Account_Number__c}-->
                                                                    {!item.bill.Payment_Method__r.AcctSeed__Last_Four_Digits__c}
                                                                </td>
                                                                <td style="text-align: right;" class="tableHeadCell">
                                                                    <div class="amountField">
                                                                        <lightning:formattedNumber
                                                                            value="{!item.bill.AcctSeed__Total__c}"
                                                                            style="currency" currencyCode="USD" />
                                                                    </div>
                                                                </td>
                                                                <td style="text-align: right;" class="tableHeadCell">
                                                                    <div class="amountField">
                                                                        <lightning:formattedNumber
                                                                            value="{!item.bill.AcctSeed__Received_Amount__c}"
                                                                            style="currency" currencyCode="USD" />
                                                                    </div>
                                                                </td>
                                                                <td style="text-align: right;" align="right"
                                                                    valign="middle" class="ztableDataCell ">
                                                                    <div class="amountField">
                                                                        <lightning:formattedNumber
                                                                            value="{!item.bill.AcctSeed__Balance__c}"
                                                                            style="currency" currencyCode="USD" />
                                                                    </div>
                                                                </td>
                                                                <td valign="middle" class="tableDataCell actionCol">
                                                                    <div class="dflex smallGap buttonSection dflexjc">
                                                                        <aura:if
                                                                            isTrue="{!item.bill.AcctSeed__Balance__c == 0}">
                                                                            <div class="normalText billStatusText">
                                                                                Payment
                                                                                schedule is
                                                                                completed.
                                                                            </div>
                                                                            <aura:set attribute="else">
                                                                                <aura:if
                                                                                    isTrue="{!item.bill.Payment_Method__r.Type__c == null}">
                                                                                    <div class=" dflexfo listButton positiveBut payButt"
                                                                                        data-buttype="isPay"
                                                                                        data-billid="{!item.bill.Id}"
                                                                                        onclick="{!c.proceedToBilling}">
                                                                                        Pay
                                                                                    </div>
                                                                                    <aura:set attribute="else">
                                                                                        <div class="dflexfo  listButton positiveBut modiPayButt"
                                                                                            data-buttype="isModifyPayment"
                                                                                            data-billid="{!item.bill.Id}"
                                                                                            onclick="{!c.proceedToBilling}">
                                                                                            <!-- Modify Payment -->
                                                                                            Pay
                                                                                        </div>
                                                                                    </aura:set>
                                                                                </aura:if>
                                                                            </aura:set>
                                                                        </aura:if>
                                                                        <div class="popupCloseButton pdfIconImageParent dflexcen"
                                                                            style="padding: 0;"
                                                                            onclick="{!c.printBillingHandle}"
                                                                            data-from="deskview"
                                                                            data-pdflink="{!item.pdfUrl}">
                                                                            <img alt="paymentStatusImage"
                                                                                class="pdfIconImage"
                                                                                src="{!$Resource.pdfIcon}" />

                                                                            <!-- <lightning:icon iconName="utility:pdf_ext"
                                                                        size="x-small" alternativeText="PDF"
                                                                        title="PDF" /> -->
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            </aura:if>
                                                        </aura:iteration>
                                                        </aura:if>
                                                    </table>
                                                </div>
                                                <div style="padding-top: 1rem;"
                                                    class="rs_ListView rightBottomPanel dflexfo gap scrollableDiv">
                                                    <aura:iteration items="{!v.payWrapper.billings}" var="item"
                                                        indexVar="index">
                                                        <div class="listViewBox dflexcol dflexac">
                                                            <div class="box dflexcol">
                                                                <div class="pathLine">
                                                                    <img alt="pathLine" class="pathLineImg"
                                                                        src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/Line.png'}" />
                                                                </div>
                                                                <div class="boxCheckbox">
                                                                    <!-- checked="{!v.payWrapper.isAutoPay}"
                                                    name="creditcardAutoPay" onclick="{!c.isAutoPayCard}"
                                                    id="creditcardAutoPay" -->
                                                                    <input type="checkbox" data-index="{!index}"
                                                                        data-billid="{!item.bill.Id}"
                                                                        id="selectedListViewRow"
                                                                        onclick="{!c.selectBillingMethod}"
                                                                        checked="{!item.isSelected}" />
                                                                </div>
                                                                <div class="headerRow dflex dflexjspace mediumPadding">
                                                                    <div class="head">{!item.bill.Name}
                                                                        <div class="rs_SmallText">
                                                                            <aura:if
                                                                                isTrue="{!item.bill.Billing_Description__c == null}">
                                                                                --
                                                                                <aura:set attribute="else">
                                                                                    {!item.bill.Billing_Description__c}
                                                                                </aura:set>
                                                                            </aura:if>
                                                                        </div>
                                                                    </div>
                                                                    <div class="newStatusDiv ">
                                                                        <aura:if
                                                                            isTrue="{!item.bill.AcctSeed__Balance__c == 0}">
                                                                            <div class="newPaidStatus"> Paid </div>
                                                                            <aura:set attribute="else">
                                                                                <div class="newUnpaidStatus"> Unpaid
                                                                                </div>
                                                                            </aura:set>
                                                                        </aura:if>
                                                                    </div>
                                                                </div>
                                                                <div class="amountRow dflex">
                                                                    <div class="amountCol dflexfo">
                                                                        <div class="val">Total</div>
                                                                        <div class="head">
                                                                            <lightning:formattedNumber
                                                                                value="{!item.bill.AcctSeed__Total__c}"
                                                                                style="currency" currencyCode="USD" />
                                                                        </div>
                                                                    </div>
                                                                    <div class="hori_seperator"></div>
                                                                    <div class="amountCol dflexfo">
                                                                        <div class="val">Received</div>
                                                                        <div class="head">
                                                                            <lightning:formattedNumber
                                                                                value="{!item.bill.AcctSeed__Received_Amount__c}"
                                                                                style="currency" currencyCode="USD" />
                                                                        </div>
                                                                    </div>
                                                                    <div class="hori_seperator"></div>
                                                                    <div class="amountCol dflexfo">
                                                                        <div class="val">Balance</div>
                                                                        <div class="head">
                                                                            <lightning:formattedNumber
                                                                                value="{!item.bill.AcctSeed__Balance__c}"
                                                                                style="currency" currencyCode="USD" />
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="hiddenDetails" data-index="{!index}"
                                                                    aura:id="hiddenDetails">
                                                                    <div class="vert_seperator"></div>
                                                                    <div class="newHead">Billing Details</div>
                                                                    <table>
                                                                        <tr class="tableHeadRow">
                                                                            <td class="tableDataCell">Invoice Date</td>
                                                                            <td class="tableDataCell textRight">
                                                                                {!item.invoiceDate}
                                                                            </td>
                                                                        </tr>
                                                                        <tr class="tableHeadRow">
                                                                            <td class="tableDataCell">Type</td>
                                                                            <td class="tableDataCell textRight">
                                                                                <aura:if
                                                                                    isTrue="{!item.bill.Payment_Method__r.Type__c != null}">
                                                                                    <aura:if
                                                                                        isTrue="{!item.bill.Payment_Method__r.Type__c == 'Credit_Card'}">
                                                                                        Credit Card
                                                                                        <aura:set attribute="else">
                                                                                            E-Check
                                                                                        </aura:set>
                                                                                    </aura:if>
                                                                                </aura:if>
                                                                            </td>
                                                                        </tr>
                                                                        <tr class="tableHeadRow">
                                                                            <td class="tableDataCell">Ending in.....
                                                                            </td>
                                                                            <td class="tableDataCell textRight">
                                                                                <!--{!item.bill.Payment_Method__r.AcctSeed__Account_Number__c}-->
                                                                                {!item.bill.Payment_Method__r.AcctSeed__Last_Four_Digits__c}
                                                                            </td>
                                                                        </tr>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                            <aura:if isTrue="{!item.isExpended}">
                                                                <div class="expandButton" onclick="{!c.rs_expandRow}"
                                                                    data-index="{!index}">
                                                                    <lightning:icon iconName="utility:chevronup"
                                                                        size="x-small" alternativeText="contract"
                                                                        title="contract" />
                                                                </div>
                                                                <aura:set attribute="else">
                                                                    <div class="expandButton"
                                                                        onclick="{!c.rs_expandRow}"
                                                                        data-index="{!index}">
                                                                        <lightning:icon iconName="utility:chevrondown"
                                                                            size="x-small" alternativeText="expand"
                                                                            title="expand" />
                                                                    </div>
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </aura:iteration>

                                                    <div class="rs_buttons gap" aura:id="rs_buttons">
                                                        <aura:if isTrue="{!v.rs_isPaymentPaid}">
                                                            <div class="normalText billStatusText">Payment schedule is
                                                                completed.
                                                            </div>
                                                            <aura:set attribute="else">
                                                                <aura:if isTrue="{!v.rs_showPayButton}">
                                                                    <div class="listButton dflexft positiveBut payButt"
                                                                        data-buttype="isPayMobile"
                                                                        onclick="{!c.proceedToBilling}">
                                                                        Pay
                                                                    </div>
                                                                    <div class="popupCloseButton" data-from="mebview"
                                                                        onclick="{!c.printBillingHandle}">
                                                                        <lightning:icon iconName="utility:pdf_ext"
                                                                            size="x-large" alternativeText="PDF"
                                                                            title="PDF" />
                                                                    </div>
                                                                    <aura:set attribute="else">
                                                                        <div class="popupCloseButton rs_pdfIconImageParent dflexcen"
                                                                            data-from="mebview"
                                                                            onclick="{!c.printBillingHandle}">
                                                                            <!-- <lightning:icon iconName="utility:pdf_ext"
                                                                        size="x-large" alternativeText="PDF"
                                                                        title="PDF" /> -->
                                                                            <img alt="paymentStatusImage"
                                                                                class="pdfIconImage"
                                                                                src="{!$Resource.pdfIcon}" />
                                                                        </div>
                                                                        <div class="listButton dflexft positiveBut modiPayButt"
                                                                            data-buttype="isModifyPaymentMobile"
                                                                            onclick="{!c.proceedToBilling}">
                                                                            <!-- Modify Payment -->
                                                                            Pay
                                                                        </div>
                                                                    </aura:set>
                                                                </aura:if>
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                            </aura:if>
                                        </div>
                                        <aura:set attribute="else">
                                            <!--  <div class="rightTopPanel dflex largeGap">
                                   <aura:if isTrue="{!v.isPaymentFirstTime}">
                                            <div aura:id="payment-type" data-id="Full" onclick="{!c.paymentTypeHandle}"
                                                class="isActiveSpan itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                Full Payment
                                            </div>
                                            <div aura:id="payment-type" data-id="Quarter"
                                                onclick="{!c.paymentTypeHandle}"
                                                class="itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                Quarterly
                                            </div>
                                            <div aura:id="payment-type" data-id="Month" onclick="{!c.paymentTypeHandle}"
                                                class=" itemBox normalHeading mediumPadding dflexcen dflexfo">
                                                Monthly
                                            </div>
                                            <aura:set attribute="else">
                                                <div aura:id="payment-type" id="Full" data-id="Full"
                                                    onclick="{!c.paymentTypeHandle}"
                                                    class="itemBoxDisable normalHeading mediumPadding dflexcen dflexfo">
                                                    Full Payment
                                                </div>
                                                <div aura:id="payment-type" id="Quarter" data-id="Quarter"
                                                    onclick="{!c.paymentTypeHandle}"
                                                    class="itemBoxDisable normalHeading mediumPadding dflexcen dflexfo">
                                                    Quarterly
                                                </div>
                                                <div aura:id="payment-type" id="Month" data-id="Month"
                                                    onclick="{!c.paymentTypeHandle}"
                                                    class="itemBoxDisable normalHeading mediumPadding dflexcen dflexfo">
                                                    Monthly
                                                </div>

                                                <aura:if isTrue="{!v.isEditable}">
                                                    <div class="dflex smallGap">
                                                        <div class="buttonItemBox normalHeading mediumPadding dflexcen newButton close"
                                                            onclick="{!c.closeEdit}">
                                                            <lightning:icon iconName="utility:close" size="x-small"
                                                                alternativeText="close" title="close" />
                                                        </div>
                                                        <div class="buttonItemBox normalHeading mediumPadding dflexcen newButton save"
                                                            onclick="{!c.saveEdit}">
                                                            <lightning:icon iconName="utility:save" size="x-small"
                                                                alternativeText="save" title="save" />
                                                        </div>
                                                    </div>
                                                    <aura:set attribute="else">
                                                        <div title="Change Payment Method"
                                                            class="buttonItemBox normalHeading mediumPadding dflexcen newButton replace"
                                                            onclick="{!c.editPayMethod}">
                                                            <lightning:icon iconName="utility:replace" size="x-small"
                                                                alternativeText="replace" title="Change" />
                                                        </div>
                                                    </aura:set>
                                                </aura:if>
                                            </aura:set>
                                        </aura:if>
                                    </div> -->
                                            <div
                                                class="rightBottomPanel dflexfo largePadding gap dflexcol dflexjspace dflexac">
                                                <div class="dflex dflexfo gap borderBox mediumPadding responsiveBox scrollableDiv"
                                                    style="width: 100%;">
                                                    <div class="RadioOptions dflexcol dflexfo gap">
                                                        <aura:if isTrue="{!!v.payWrapper.isBillingFrequencyFullOnly}">
                                                            <p class="leftSection normalTextWithNormalHeadingBold"
                                                               style="font-size: 1.3em; font-weight: bold; color: black;">
                                                                PAYMENT OPTIONS:
                                                            </p>
                                                            <div>
                                                                <div class="zslds-grid zslds-wrap resInputs dflexcol"
                                                                     style="font-size: 16px;">
                                                                    <div class="dflex smallGap dflexac">
                                                                        <ui:inputRadio aura:id="Full" text="Full"
                                                                                       name="payment-type-radio" label=""
                                                                                       value="{!v.payWrapper.paymentScheduleVar == 'Full'}"
                                                                                       change="{!c.paymentTypeHandle}" />
                                                                        Full Payment
                                                                    </div>
                                                                    <div class="dflex smallGap dflexac">
                                                                        <ui:inputRadio aura:id="Quarter" text="Quarter"
                                                                                       name="payment-type-radio" label=""
                                                                                       change="{!c.paymentTypeHandle}"
                                                                                       value="{!v.payWrapper.paymentScheduleVar == 'Quarter'}" />
                                                                        Quarterly
                                                                        Payments
                                                                    </div>
                                                                    <div class="dflex smallGap dflexac">
                                                                        <ui:inputRadio aura:id="Month" text="Month"
                                                                                       name="payment-type-radio" label=""
                                                                                       change="{!c.paymentTypeHandle}"
                                                                                       value="{!v.payWrapper.paymentScheduleVar == 'Month'}" />
                                                                        Monthly Payments
                                                                    </div>
                                                                </div>
                                                                <br/>
                                                            </div>
                                                            <aura:set attribute="else">
                                                                <br/><br/><br/>
                                                            </aura:set>
                                                        </aura:if>
                                                        <p class="leftSection normalTextWithNormalHeadingBold"
                                                            style="width: 100%; background-color: lightblue; font-size: 1.3em; font-weight: bold; color: black;">
                                                        <table>
                                                            <tr>
                                                                <td>TOTAL DUE TODAY:&nbsp;&nbsp;</td>
                                                                <td align="right">
                                                                    <aura:if isTrue="{!v.wrapperLoad}">
                                                                        <aura:if isTrue="{!v.isCC}">
                                                                            <lightning:formattedNumber
                                                                                maximumFractionDigits="2"
                                                                                value="{!((v.payWrapper.totalAmountDue * (100 +  v.payWrapper.ccFeeRate))/100)}"
                                                                                style="currency" currencyCode="USD" />
                                                                            <aura:set attribute="else">
                                                                                <lightning:formattedNumber
                                                                                    value="{!v.payWrapper.totalAmountDue}"
                                                                                    style="currency"
                                                                                    currencyCode="USD" />
                                                                            </aura:set>
                                                                        </aura:if>
                                                                    </aura:if>
                                                                    <aura:set attribute="else">
                                                                        ----
                                                                    </aura:set>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                        </p>
                                                        <div
                                                            style="margin-top: 25px; border-top: 1px solid #e5e5e5; padding-top: 25px;">
                                                        </div>
                                                        <div class="zslds-grid zslds-wrap"
                                                            style="font-size: 16px;">
                                                            <p class="leftSection normalTextWithNormalHeadingBold"
                                                                style="padding-top: 10px; font-weight: bold; color: black;">
                                                                PAYMENT METHOD:
                                                            </p>
                                                            <div class="secline" style="color: gray; font-size: 0.8em;">
                                                                * a {!v.payWrapper.ccFeeRate}%
                                                                service
                                                                fee
                                                                will be added to Credit Card transactions</div>
                                                            
                                                            <div class="dflexcol">
                                                                <aura:if isTrue="{!v.savedCardList.length}">
                                                                    <aura:iteration items="{!v.savedCardList}"
                                                                        var="item" indexVar="index">
                                                                        <div class="dflex dflexac" style="gap: .3rem;">
                                                                            <aura:if
                                                                                isTrue="{!OR(item.isDefault == true, item.isSetToPay == true)}">
                                                                                <input class="resInputs" type="radio"
                                                                                    aura:id="picklistPaymentMethod"
                                                                                    name="paymentMethodRadioGroup"
                                                                                    data-id="{!item.paymentMethod.Id}"
                                                                                    onchange="{!c.picklistPaymentMethodChange}"
                                                                                    checked="checked" />
                                                                                <aura:set attribute="else">
                                                                                    <input class="resInputs"
                                                                                        type="radio"
                                                                                        aura:id="picklistPaymentMethod"
                                                                                        name="paymentMethodRadioGroup"
                                                                                        onchange="{!c.picklistPaymentMethodChange}"
                                                                                        data-id="{!item.paymentMethod.Id}" />
                                                                                </aura:set>
                                                                            </aura:if>
                                                                            <aura:if
                                                                                isTrue="{!item.cardTypeVar == 'amex'}">
                                                                                AMEX
                                                                            </aura:if>
                                                                            <aura:if
                                                                                isTrue="{!item.cardTypeVar == 'disc'}">
                                                                                DISC
                                                                            </aura:if>
                                                                            <aura:if
                                                                                isTrue="{!item.cardTypeVar == 'mc'}">
                                                                                MC
                                                                            </aura:if>
                                                                            <aura:if
                                                                                isTrue="{!item.cardTypeVar == 'visa'}">
                                                                                VISA
                                                                            </aura:if>
                                                                            ending in
                                                                            {!item.paymentMethod.Last_4_Account_Number__c}
                                                                        </div>
                                                                    </aura:iteration>
                                                                </aura:if>
                                                                <br />
                                                                <aura:if isTrue="{!v.savedEcheckList.length}">
                                                                    <aura:iteration items="{!v.savedEcheckList}"
                                                                        var="item" indexVar="index">
                                                                        <div class="dflex dflexac" style="gap: .3rem;">
                                                                            <aura:if
                                                                                isTrue="{!OR(item.isDefault == true, item.isSetToPay == true)}">
                                                                                <input class="resInputs" type="radio"
                                                                                    aura:id="picklistPaymentMethod"
                                                                                    name="paymentMethodRadioGroup"
                                                                                    data-id="{!item.paymentMethod.Id}"
                                                                                    checked="checked"
                                                                                    onchange="{!c.picklistPaymentMethodChange}" />
                                                                                <aura:set attribute="else">
                                                                                    <input class="resInputs"
                                                                                        type="radio"
                                                                                        aura:id="picklistPaymentMethod"
                                                                                        name="paymentMethodRadioGroup"
                                                                                        data-id="{!item.paymentMethod.Id}"
                                                                                        onchange="{!c.picklistPaymentMethodChange}" />
                                                                                </aura:set>
                                                                            </aura:if>
                                                                            eCheck ending in
                                                                            {!item.paymentMethod.Last_4_Account_Number__c}
                                                                            <!--AcctSeed__Account_Number__c-->
                                                                        </div>
                                                                    </aura:iteration>
                                                                </aura:if>
                                                            </div>
                                                            <div class="dflex">
                                                                <div class="myButton negativeButt redflexfo"
                                                                    style="margin-top: 1rem;" data-type="addBut"
                                                                    aura:id="addBut" onclick="{!c.billingPayOrAdd}">
                                                                    Add/Edit Payment Methods
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="detailsBox dflexfo dflexcol gap">
                                                        <aura:if isTrue="{!OR(v.payWrapper.paymentScheduleVar == 'Full',NOT(OR(v.payWrapper.billing.Policy_Endorsement__c != null, v.payWrapper.billing.Policy__c != null)))}">
                                                            <div class="leftSection normalTextWithNormalHeadingBold">
                                                                Payment Schedules 
                                                            </div>
                                                            <div class="dflexcol smallGap">
                                                                <aura:if isTrue="{!v.wrapperLoad}">
                                                                    <aura:if
                                                                             isTrue="{!v.payWrapper.paymentScheduleListToInsert.length > 0}">
                                                                        <div class="newItemBox">
                                                                            <div class="newPoints dflex gap">
                                                                                <div class="head dflexfo"
                                                                                     style="font-weight: bold;">
                                                                                    Date
                                                                                </div>
                                                                                <div class="value dflexfo"
                                                                                     style="font-weight: bold;">
                                                                                    Installment
                                                                                </div>
                                                                                <aura:if isTrue="{!v.isCC}">
                                                                                    <div class="value dflexfo"
                                                                                         style="font-weight: bold;">
                                                                                        Service Fee
                                                                                    </div>
                                                                                    <div class="value dflexfo"
                                                                                         style="font-weight: bold;">
                                                                                        Total
                                                                                    </div>
                                                                                </aura:if>
                                                                            </div>
                                                                        </div>
                                                                        <div class="leftBorder dflexcol smallGap">
                                                                            <aura:iteration
                                                                                            items="{!v.payWrapper.paymentScheduleListToInsert}"
                                                                                            var="item">
                                                                                <div class="newItemBox">
                                                                                    <div class="leftLine"></div>
                                                                                    <div class="newPoints dflex gap">
                                                                                        <div class="head dflexfo" style="font-weight: bold;">
                                                                                            <ui:outputDate
                                                                                                           value="{!item.Due_Date__c}"
                                                                                                           format="MM/DD/YYYY" />
                                                                                        </div>
                                                                                        <div class="value dflexfo">
                                                                                            <lightning:formattedNumber
                                                                                                                       value="{!item.Amount__c}"
                                                                                                                       style="currency"
                                                                                                                       currencyCode="USD" />
                                                                                        </div>
                                                                                        <aura:if isTrue="{!v.isCC}">
                                                                                            <div class="value dflexfo"
                                                                                                 style="font-style: italic;">
                                                                                                <lightning:formattedNumber
                                                                                                                           maximumFractionDigits="2"
                                                                                                                           value="{!(item.Amount__c * v.payWrapper.ccFeeRate)/100}"
                                                                                                                           style="currency"
                                                                                                                           currencyCode="USD" />
                                                                                            </div>
                                                                                            <div class="value dflexfo"
                                                                                                 style="font-style: italic;">
                                                                                                <lightning:formattedNumber
                                                                                                                           maximumFractionDigits="2"
                                                                                                                           value="{!((item.Amount__c * (100 + v.payWrapper.ccFeeRate)/100))}"
                                                                                                                           style="currency"
                                                                                                                           currencyCode="USD" />
                                                                                            </div>
                                                                                        </aura:if>
                                                                                    </div>
                                                                                </div>
                                                                            </aura:iteration>
                                                                        </div>
                                                                        <aura:set attribute="else">
                                                                            <div class="normalText textCenter">
                                                                                No Payment Schedule
                                                                            </div>
                                                                        </aura:set>
                                                                    </aura:if>
                                                                    <aura:set attribute="else">
                                                                        ----
                                                                    </aura:set>
                                                                </aura:if>
                                                            </div>
                                                            
                                                            <aura:set attribute="else">
                                                                <aura:if isTrue="{!v.payWrapper.duePaymentSchedules.length > 0}">
                                                                    <div class="leftSection  normalTextWithNormalHeadingBold">
                                                                        Past-Due Payment Dates:
                                                                    </div>
                                                                    <div class="newItemBox">
                                                                        <div class="newPoints dflex gap">
                                                                            <div class="head dflexfo" style="font-weight: bold;">
                                                                                Date
                                                                            </div>
                                                                            <div class="value dflexfo" style="font-weight: bold;">
                                                                                Installment
                                                                            </div>
                                                                            <aura:if isTrue="{!v.isCC}">
                                                                                <div class="value dflexfo" style="font-weight: bold;">
                                                                                    Service Fee
                                                                                </div>
                                                                                <div class="value dflexfo" style="font-weight: bold;">
                                                                                    Total
                                                                                </div>
                                                                            </aura:if>
                                                                        </div>
                                                                    </div>
                                                                    <div class="leftBorder dflexcol smallGap">
                                                                        <aura:iteration items="{!v.payWrapper.duePaymentSchedules}" var="item">
                                                                            <div class="newItemBox">
                                                                                <div class="leftLine"></div>
                                                                                <div class="newPoints dflex gap">
                                                                                    <div class="head dflexfo" style="font-weight: bold;">
                                                                                        {!item.dateStr}
                                                                                    </div>
                                                                                    <div class="value dflexfo" style="font-style: italic;">
                                                                                        <lightning:formattedNumber maximumFractionDigits="2" value="{!item.amount}" style="currency"
                                                                                                                   currencyCode="USD" />
                                                                                    </div>
                                                                                    <aura:if isTrue="{!v.isCC}">
                                                                                        <div class="value dflexfo" style="font-style: italic;">
                                                                                            <lightning:formattedNumber maximumFractionDigits="2"
                                                                                                                       value="{!(item.amount * v.payWrapper.ccFeeRate)/100}" style="currency"
                                                                                                                       currencyCode="USD" />
                                                                                        </div>
                                                                                        <div class="value dflexfo" style="font-style: italic;">
                                                                                            <lightning:formattedNumber maximumFractionDigits="2"
                                                                                                                       value="{!((item.amount * v.payWrapper.ccFeeRate)/100) + item.amount}" style="currency"
                                                                                                                       currencyCode="USD" />
                                                                                        </div>
                                                                                    </aura:if>
                                                                                </div>
                                                                            </div>
                                                                        </aura:iteration>
                                                                    </div>
                                                                </aura:if>
                                                                <div class="leftSection  normalTextWithNormalHeadingBold">
                                                                    Future Payment Schedule:
                                                                </div>
                                                                <div class="newItemBox">
                                                                    <div class="newPoints dflex gap">
                                                                        <div class="head dflexfo" style="font-weight: bold;">
                                                                            Date
                                                                        </div>
                                                                        <div class="value dflexfo" style="font-weight: bold;">
                                                                            Installment
                                                                        </div>
                                                                        <aura:if isTrue="{!v.isCC}">
                                                                            <div class="value dflexfo" style="font-weight: bold;">
                                                                                Service Fee
                                                                            </div>
                                                                            <div class="value dflexfo" style="font-weight: bold;">
                                                                                Total
                                                                            </div>
                                                                        </aura:if>
                                                                    </div>
                                                                </div>
                                                                <div class="leftBorder dflexcol smallGap">
                                                                    <aura:if isTrue="{!v.payWrapper.futurePaymentSchedules.length > 0}">
                                                                        <aura:iteration items="{!v.payWrapper.futurePaymentSchedules}" var="item">
                                                                            <div class="newItemBox">
                                                                                <div class="leftLine"></div>
                                                                                <div class="newPoints dflex gap">
                                                                                    <div class="head dflexfo" style="font-weight: bold;">
                                                                                        {!item.dateStr}
                                                                                    </div>
                                                                                    <div class="value dflexfo" style="font-style: italic;">
                                                                                        <lightning:formattedNumber maximumFractionDigits="2" value="{!item.amount}" style="currency"
                                                                                                                   currencyCode="USD" />
                                                                                    </div>
                                                                                    <aura:if isTrue="{!v.isCC}">
                                                                                        <div class="value dflexfo" style="font-style: italic;">
                                                                                            <lightning:formattedNumber maximumFractionDigits="2"
                                                                                                                       value="{!(item.amount * v.payWrapper.ccFeeRate)/100}" style="currency"
                                                                                                                       currencyCode="USD" />
                                                                                        </div>
                                                                                        <div class="value dflexfo" style="font-style: italic;">
                                                                                            <lightning:formattedNumber maximumFractionDigits="2"
                                                                                                                       value="{!((item.amount * v.payWrapper.ccFeeRate)/100) + item.amount}" style="currency"
                                                                                                                       currencyCode="USD" />
                                                                                        </div>
                                                                                    </aura:if>
                                                                                </div>
                                                                            </div>
                                                                        </aura:iteration>
                                                                        <aura:set attribute="else">
                                                                            <div class="normalText textCenter">
                                                                                No Payment Schedule.
                                                                            </div>
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </div>
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                                <div class="buttonBox dflexae dflexcol dflexjspace gap"
                                                    style="width: 100%;">
                                                    <!--<div class="myButton negativeButt redflexfo" data-type="addBut"
                                                aura:id="addBut" onclick="{!c.billingPayOrAdd}">
                                                Add/Edit Payment Methods
                                            </div>-->
                                                    <div class="dflex gap redflexfo">
                                                        <!--div class="picklistSelectPaymentMethod redflexfo fullHeightWidth">
                                                    <div class="dflexcen absoluteLabel">
                                                        <div class="head"
                                                            style="font-weight: bold; color:black; font-size: larger;">
                                                            Select Payment Type<br /></div>
                                                    </div>
                                                    <select name="Select Payment Method"
                                                        onchange="{!c.picklistPaymentMethodChange}"
                                                        id="picklistPaymentMethod">
                                                        <option value="none" style="color:gray !important;">
                                                            Please select Card/eCheck
                                                        </option>
                                                        <aura:if isTrue="{!v.savedCardList.length}">
                                                            <optgroup label="Cards">
                                                                <aura:iteration items="{!v.savedCardList}" var="item"
                                                                    indexVar="index">
                                                                    <option
                                                                        selected="{!OR(item.isDefault == true, item.isSetToPay == true)}"
                                                                        value="{!item.paymentMethod.Id}">
                                                                        <aura:if isTrue="{!item.cardTypeVar == 'amex'}">
                                                                            [AMEX]
                                                                        </aura:if>
                                                                        <aura:if isTrue="{!item.cardTypeVar == 'disc'}">
                                                                            [DISC]
                                                                        </aura:if>
                                                                        <aura:if isTrue="{!item.cardTypeVar == 'mc'}">
                                                                            [MAST]
                                                                        </aura:if>
                                                                        <aura:if isTrue="{!item.cardTypeVar == 'visa'}">
                                                                            [VISA]
                                                                        </aura:if>
                                                                        ending in
                                                                        <!-{!item.paymentMethod.AcctSeed__Account_Number__c}->
                                                                        {!item.paymentMethod.AcctSeed__Last_Four_Digits__c}
                                                                    </option>
                                                                </aura:iteration>
                                                            </optgroup>
                                                        </aura:if>
                                                        <aura:if isTrue="{!v.savedEcheckList.length}">
                                                            <optgroup label="eCheck">
                                                                <aura:iteration items="{!v.savedEcheckList}" var="item"
                                                                    indexVar="index">
                                                                    <option selected="{!item.isDefault == true}"
                                                                        value="{!item.paymentMethod.Id}">
                                                                        eCheck ending in
                                                                        <!-{!item.paymentMethod.AcctSeed__Account_Number__c}->
                                                                        {!item.paymentMethod.AcctSeed__Last_Four_Digits__c}
                                                                    </option>
                                                                </aura:iteration>
                                                            </optgroup>
                                                        </aura:if>
                                                    </select>
                                                </div-->

                                                        <!--aura:if isTrue="{!v.payWrapper.enablePaymentDate}">
                                                    <div class="effectiveDateRightBottom">
                                                        <div class="dflexcen absoluteLabel">
                                                            <div class="head"
                                                                style="font-weight: bold; color:black; font-size: larger; z-index: 10;">
                                                                Payment Date</div>
                                                        </div>
                                                        <lightning:input type="date" name="input1"
                                                            value="{!v.payWrapper.firstInstallmentDate}"
                                                            variant="label-hidden"
                                                            onchange="{!c.handleChangeDueDate}" dateStyle="short"/>
                                                    </div>
                                                </aura:if-->

                                                        <div class="myButton positiveBut redflexfo" data-type="payBut"
                                                            aura:id="payBut" onclick="{!c.billingPayOrAdd}">
                                                            <aura:if isTrue="{!v.payWrapper.totalAmountDue == 0}">
                                                                Confirm &amp; Save
                                                                <aura:set attribute="else">
                                                                    Confirm &amp; Pay
                                                                </aura:set>
                                                            </aura:if>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </aura:set>
                                    </aura:if>
                                </div>
                                <aura:set attribute="else">
                                    <aura:if isTrue="{!v.isPaymentSuccess}">
                                        <div class="container dflex dflexfo largeGap scrollableDiv">
                                            <div class="successScreenhelp"></div>
                                            <div class="dflexfo smallPopupModal dflexcol gap largePadding"
                                                style="width:55rem ; flex: 2;">
                                                <div class="dflex gap dflexfo">
                                                    <div class="dflexcol largeGap dflexfo">
                                                        <div class="paymentStatus normalHeading textCenter"></div>
                                                        <div class="dflexfo smallPopupModal dflexcol gap">
                                                            <div style="text-align:center ;">
                                                                <img alt="logo"
                                                                    src="{!$Resource.PaymentGatewayResource + '/PaymentGatewayResource/img/ISBALogo.png'}" />
                                                            </div>
                                                            <br />
                                                            <aura:if
                                                                isTrue="{!v.payWrapper.billing.Policy__r.Application_Type__c == 'Renewal'}">
                                                                <p class="paymentStatus normalHeading textJus">
                                                                    Thank you for choosing ISBA Mutual to protect you
                                                                    and
                                                                    your
                                                                    firm. Your Policy {!v.payWrapper.invoiceId} has been
                                                                    renewed. Your Policy Documents will be sent to you
                                                                    under
                                                                    separate cover.
                                                                </p>
                                                            </aura:if>
                                                            <aura:if
                                                                isTrue="{!v.payWrapper.billing.Policy__r.Application_Type__c == 'New Business'}">
                                                                <p class="paymentStatus normalHeading textJus">
                                                                    Thank you for choosing ISBA Mutual to protect you
                                                                    and
                                                                    your
                                                                    firm. Your Policy {!v.payWrapper.invoiceId} has been
                                                                    issued.
                                                                    Your Policy Documents will be sent to you under
                                                                    separate
                                                                    cover.
                                                                </p>
                                                            </aura:if>
                                                            <br />
                                                            <div style="font-size 1.2em;">
                                                                <p class="isbam_primary_red"
                                                                    style="text-align: center; font-size: 1.4em; font-weight: bold;">
                                                                    Comprehensive Cyber Liability Insurance Program
                                                                </p>
                                                                <p class="isbam_primary_red"
                                                                    style="padding-top: 10px; text-align: center; font-size: 1.4em; font-weight: bold;">
                                                                    EXCLUSIVELY FOR ISBA MUTUAL POLICYHOLDERS
                                                                </p>
                                                                <p class="paymentStatus normalHeading textJus"
                                                                    style="padding-top: 10px;">
                                                                    Ransomware, funds transfer fraud and business email
                                                                    compromise crimes are on the rise and
                                                                    targeting small businesses. These Cyber-attacks
                                                                    threaten
                                                                    to
                                                                    expose your firm and your clients to
                                                                    financial loss. Without adequate coverage, a
                                                                    negative
                                                                    result
                                                                    could be significant for your firm.
                                                                </p>
                                                                <p class="paymentStatus normalHeading textJus"
                                                                    style="padding-top: 10px;">
                                                                    To provide our policyholders with the security your
                                                                    firm
                                                                    needs, we are pleased to make available
                                                                    a CYBER LIABILITY INSURANCE PROGRAM in partnership
                                                                    with
                                                                    <b>SIDEBAR INSURANCE
                                                                        SOLUTIONS, INC.</b> This program is designed to
                                                                    provide
                                                                    your firm with a comprehensive Cyber
                                                                    Insurance Policy that also delivers a risk
                                                                    management
                                                                    suite
                                                                    empowering you to prevent, protect
                                                                    against, and respond to cyber risks.
                                                                </p>
                                                                <ul
                                                                    style="font-size: 1.2em !important; list-style-type: circle; padding-top: 25px; padding-left: 40px;">
                                                                    <li>
                                                                        Best-in-class cyber insurance (provided by
                                                                        Coalition,
                                                                        Inc.)
                                                                    </li>
                                                                    <li>
                                                                        One of the most comprehensive cyber insurance
                                                                        policies
                                                                        available
                                                                    </li>
                                                                    <li>
                                                                        Optional Funds Transfer Fraud coverage for your
                                                                        firm’s
                                                                        accounts <b>(strongly recommended!)</b>
                                                                    </li>
                                                                    <li>
                                                                        Constant monitoring to alert you of any
                                                                        vulnerabilities
                                                                        (before damage is done)
                                                                    </li>
                                                                    <li>
                                                                        24 / 7 / 365 Helpline tended by a dedicated team
                                                                        of
                                                                        cybersecurity experts
                                                                    </li>
                                                                </ul>
                                                                <div style="padding-top: 20px;" class="">
                                                                    <p class="paymentStatus normalHeading textCenter">
                                                                        Visit our website at <span
                                                                            class="isbam_primary_red">ISBAMutual.com/cyber</span>
                                                                        to find more information
                                                                    </p>
                                                                    <p class="paymentStatus normalHeading textCenter"
                                                                        style="padding-top: 10px;">
                                                                        OR
                                                                    </p>
                                                                    <p class="paymentStatus normalHeading textCenter"
                                                                        style="padding-top: 10px;">
                                                                        <b>
                                                                            Contact Adam for a personal consultation
                                                                            and<br />
                                                                            a cyber risk assessment provided by
                                                                            Coalition:
                                                                        </b>
                                                                    </p>
                                                                    <p class="isbam_primary_red paymentStatus normalHeading textCenter"
                                                                        style="font-weight: bold; padding-top: 10px;">
                                                                        Adam Czerwinski
                                                                    </p>
                                                                    <p class="isbam_primary_red paymentStatus normalHeading textCenter"
                                                                        style="font-weight: bold; padding-top: 10px;">
                                                                        Sidebar Insurance Solutions, Inc.<br />
                                                                        708.942.5150
                                                                    </p>
                                                                    <p class="paymentStatus normalHeading textCenter"
                                                                        style="padding-top: 20px;">
                                                                        Also ask Adam about other insurance solutions
                                                                        for
                                                                        your
                                                                        firm exclusively for ISBA Mutual Insureds.
                                                                    </p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div>
                                                    <input type="button"
                                                        value="Click for more information on Cyber Liability"
                                                        style="font-weight: bold; font-size: 1.2em; padding:10px; width:100%;"
                                                        onclick="{!c.pageCyberPop}" />

                                                    <br /><br />
                                                </div>
                                            </div>
                                            <div class="successScreenhelp"></div>
                                        </div>
                                    </aura:if>
                                    <aura:if isTrue="{!!v.isPaymentLoad}">
                                        <div
                                            class="paymentMessageOnLoad dflex dflexfo dflexcen largePadding normalHeading">
                                            {!v.paymentMessageOnLoad}
                                        </div>
                                    </aura:if>
                                </aura:set>
                            </aura:if>
                        </aura:set>
                    </aura:if>
                </div>
            </aura:set>

        </aura:if>
    </div>

</aura:component>