                                                        Billing/Policy
                                                        Contact Details:
                                                    </div>
                                                    <aura:if
                                                        isTrue="{!v.payWrapper.accRecord.AcctSeed__Billing_Contact__r.Email != null}">
                                                        <div class="verticalDetailLine  dflexcol smallPadding">
