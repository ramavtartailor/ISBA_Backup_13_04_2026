                            </div>
                        </div>

                    </aura:if>

                    <aura:if isTrue="{!v.showCancelPolicyModal}">
                        <div style="width: 100%;">
                            <lightning:input type="date" name="Effective Date" label="Effective Date" required="true"
                                value="{!v.endorsementEffectiveDate}" dateStyle="short" />
                        </div>
                    </aura:if>
                    <aura:if isTrue="{!v.ShowBillingPs}">
                        <div class="normalText rs_tableView" style="width: 100%; min-width: 40rem;">
                            <table class="myTable">
                                <tr class="tableHeadRow">
                                    <th class="tableHeadCell">
                                        Due Date
                                    </th>
                                    <th class="tableHeadCell">
                                        Status
                                    </th>
                                    <th class="tableHeadCell">
                                        <div class="amountField">
                                            Amount
                                        </div>
                                    </th>
                                </tr>
                                <aura:if isTrue="{!v.BillingPaymentSchedules}">
                                    <aura:iteration items="{!v.BillingPaymentSchedules}" var="item" indexVar="idx">
                                        <tr>
                                            <td valign="middle" class="tableDataCell">
                                                <ui:outputDate value="{!item.Due_Date__c}" format="MM/DD/YYYY" />
                                            </td>
                                            <td valign="middle" class="tableDataCell">
                                                {!item.Status__c}
                                            </td>
                                            <td valign="middle" class="tableDataCell">
                                                <div  class="amountField">
                                                    <lightning:formattedNumber value="{!item.Amount__c}" style="currency" currencyCode="USD" />
                                                </div>
                                            </td>
                                        </tr>
                                    </aura:iteration>
                                </aura:if>
                            </table>
                        </div>
                    </aura:if>
                </div>
                <aura:if isTrue="{!!v.ShowBillingPs}">
                	<aura:if isTrue="{!!AND(v.isAddScreen ,AND(NOT(v.isSavedScreen), NOT(v.isAddPaymentMethod)))}"> 
                	<div class="popupFooter mediumPadding dflex dflexac dflexjspace gap">
                    <!-- Saved Cards and Echeck List Screen Footer -->
                    <aura:if isTrue="{!v.isSavedScreen}">
                        <div class="modalButton negativeBut " onclick="{!c.closePopUpBut}">
                            Cancel
                        </div>
                        <div class="modalButton positiveBut" onclick="{!c.addCardCheckBut}">
                            Add Payment Method
                        </div>
                    </aura:if>
                    <!-- Add new Cards and Echeck Screen Footer -->
                    <aura:if isTrue="{!v.isAddScreen}">

                        <aura:if isTrue="{!v.isAddPaymentMethod}">
                            <div class="modalButton negativeBut " onclick="{!c.backToHomeScreenHandle}">
                                Back
                            </div>
                            <aura:set attribute="else">
                                <div class="modalButton negativeBut " onclick="{!c.backToSavedBut}">
                                    Back
                                </div>
                            </aura:set>
                        </aura:if>
                        <div class="totalAmountInModal dflex dflexjspace mediumPadding dflexac">
                            <div class="normalText">Total:</div>
                            <div class="normalHeading">
                                <aura:if isTrue="{!v.payWrapper.balanceDue != null}">
                                    <lightning:formattedNumber value="{!v.payWrapper.totalAmountDue}" style="currency"
                                        currencyCode="USD" />
                                    <aura:set attribute="else">
                                        ---
                                    </aura:set>
                                </aura:if>
                            </div>
                        </div>
                        <div class="dflex gap">
                            <aura:if isTrue="{!v.isAddPaymentMethod}">
                                <div class="modalButton positiveBut" data-type="payMethod" onclick="{!c.PayNowBut}">
                                    Confirm
                                </div>
                                <aura:set attribute="else">
                                    <aura:if isTrue="{!v.savedClick}">
                                        <div class="modalButton negativeBut" data-type="updatePaymentMethod"
                                            onclick="{!c.PayNowBut}">
                                            Update Card / eCheck
                                        </div>
                                        <div class="modalButton negativeBut" data-type="setPaymentMethod"
                                            onclick="{!c.PayNowBut}">
                                            Set to Pay
                                        </div>
                                        <aura:set attribute="else">
                                            <div class="modalButton negativeBut" data-type="savePaymentMethod"
                                                onclick="{!c.PayNowBut}">
                                                Save Card / eCheck
                                            </div>
                                        </aura:set>
                                    </aura:if>

                                </aura:set>
                            </aura:if>
                        </div>
                    </aura:if>

                    <aura:if isTrue="{!v.showDeleteLawyerModal}">
                        <div class="modalButton negativeBut" onclick="{!c.closePopUpBut}">
                            Cancel
                        </div>
                        <div class="modalButton positiveBut" onclick="{!c.handleSaveDeleteLawyer}">
                            Submit
                        </div>
                    </aura:if>
                    <aura:if isTrue="{!v.showAddLawyerModal}">
                        <div class="modalButton negativeBut" onclick="{!c.closePopUpBut}">
                            Cancel
                        </div>
                        <div class="modalButton positiveBut" onclick="{!c.handleSaveAddLawyer}">
                            Submit
                        </div>
                    </aura:if>
                    <aura:if isTrue="{!v.showCancelPolicyModal}">
                        <div class="modalButton negativeBut" onclick="{!c.closePopUpBut}">
                            Cancel
                        </div>
                        <div class="modalButton positiveBut" onclick="{!c.handleSaveCancelPolicy}">
                            Submit
                        </div>
                    </aura:if>
                </div>
                </aura:if>
                </aura:if>
