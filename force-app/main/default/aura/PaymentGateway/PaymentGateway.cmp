                                            <td class="tableDataCell amountField"><lightning:formattedNumber value="{!item.Rate_At__c}" style="percent-fixed"/></td>
                                            <td class="tableDataCell">{!item.Step__c}</td-->
                                        </tr>
                                    </aura:iteration>
                                </table>
                            </div>
                        </div>
