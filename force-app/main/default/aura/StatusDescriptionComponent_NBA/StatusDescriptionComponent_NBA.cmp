<aura:component
    implements="flexipage:availableForAllPageTypes,force:lightningQuickAction,flexipage:availableForRecordHome,force:hasRecordId"
    controller="StatusDescriptionCompCtrl"
    access="global" >

    <aura:attribute name="pol" type="Customer_Application__c" />
    <aura:attribute name="editable" type="boolean" default="false"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="spinner" type="Boolean" default="false" />

    <aura:method name="editMethod" action="{!c.editable}" />

    <article onclick="{!c.handleEdit}" class="slds-card" style="cursor: pointer;">
        <div class="slds-card__header slds-grid">
            <header class="slds-media slds-media_center slds-has-flexi-truncate">
                <div class="slds-media__figure">
                    <span class="slds-icon_container slds-icon-standard-account">
                        <lightning:icon iconName="custom:custom3" size="small"/>
                        <span class="slds-assistive-text">Status Description</span>
                    </span>
                </div>
                <div class="slds-media__body">
                    <h2 class="slds-card__header-title">
                        <a href="javascript:void(0);" class="slds-card__header-link slds-truncate">
                            <span>Status Description</span>
                        </a>
                    </h2>
                </div>
            </header>
        </div>

        <div onkeypress="{!c.keyCheck}"
             class="slds-card__body slds-card__body_inner"
             style="font-size: 12px; cursor: pointer;">

            <aura:if isTrue="{!not(v.editable)}">
                <lightning:recordViewForm objectApiName="Customer_Application__c">
                    <div class="slds-col slds-size_1-of-1" style="border-bottom: 1px solid #D6D2D2;">
                        <table width="100%">
                            <tr>
                                <td width="100%">
                                    <p>
                                        &nbsp;
                                        <lightning:formattedText
                                            linkify="true"
                                            value="{!v.pol.Status_Description__c}" />
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </div>
                </lightning:recordViewForm>
            </aura:if>

            <aura:if isTrue="{!v.editable}">
                <lightning:recordEditForm objectApiName="Customer_Application__c">
                    <lightning:messages />
                    <div class="slds-grid slds-wrap">
                        <div class="slds-col slds-size_1-of-1" style="padding-left: 5px; padding-right: 5px;">
                            <lightning:input
                                aura:id="isbam_status_description"
                                type="text"
                                value="{!v.pol.Status_Description__c}"/>
                        </div>
                    </div>
                </lightning:recordEditForm>

                <aura:if isTrue="{!v.spinner}">
                    <div class="slds-spinner_container">
                        <div class="slds-spinner slds-spinner--brand slds-spinner--large slds-is-relative">
                            <span class="slds-assistive-text">Loading...</span>
                            <div class="slds-spinner__dot-a"></div>
                            <div class="slds-spinner__dot-b"></div>
                        </div>
                    </div>
                </aura:if>

                <center>
                    <br/>
                    <button class="slds-button slds-button_neutral" onclick="{!c.handleCancel}">
                        Cancel
                    </button>
                    <button class="slds-button slds-button_brand" onclick="{!c.doSave}">
                        Save
                    </button>
                </center>
            </aura:if>
        </div>
    </article>
</aura:component>