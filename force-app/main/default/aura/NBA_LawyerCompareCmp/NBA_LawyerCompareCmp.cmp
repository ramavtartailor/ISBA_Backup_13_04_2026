                                        <div>{!item.lawyer.Personal_Email_Address__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!item.lawyer.Personal_Email_Address__c != item.con.Personal_Email__c}">
                                            <div data-index="{!index}" data-lwField="Personal_Email_Address__c" data-conField="Personal_Email__c" onclick="{!c.handleUpdateData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td class="rightBottom">
                                        <div>{!item.con.Personal_Email__c}</div>
                                    </td>
                                </tr>
                                <tr style="{!item.lawyer.Designation__c != item.policyLawyer.Contact_Role__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                    <th class="leftBottom"><div>Designation</div></th>
                                    <td>
                                        <div>{!item.lawyer.Designation__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!item.lawyer.Designation__c != item.policyLawyer.Contact_Role__c}">
                                            <div data-index="{!index}" data-lwField="Designation__c" data-conField="Contact_Role__c" onclick="{!c.handleUpdatePolicyLawyerData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td class="rightBottom">
                                        <div>{!item.policyLawyer.Contact_Role__c}</div>
                                    </td>
                                </tr>
                                <tr style="{!item.lawyer.Average_Number_of_Hours_Worked__c != item.policyLawyer.Average_Hours_Per_Week__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                    <th class="leftBottom"><div>Avg Hours/week</div></th>
                                    <td>
                                        <div>{!item.lawyer.Average_Number_of_Hours_Worked__c}</div>
                                    </td>
