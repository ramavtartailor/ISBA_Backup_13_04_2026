                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!item.con.ARDC_Number__c}</div>
                                    </td>
                                </tr>
                                <tr style="{!item.lawyer.Cell_Phone__c != item.con.MobilePhone ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                    <th><div>Cell Phone</div></th>
                                    <td>
                                        <div>
                                            <lightning:formattedPhone value="{!item.lawyer.Cell_Phone__c}"/>
                                        </div>
                                    </td>
