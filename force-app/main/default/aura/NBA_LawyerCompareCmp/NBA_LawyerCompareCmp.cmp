                                                    Unlink
                                                </a>
                                                <aura:set attribute="else">
                                                    <a href="javascript:void(0)" data-index="{!index}" onclick="{!c.openLinkContact}">
                                                        Link
                                                    </a>
                                                    &nbsp;|&nbsp;
                                                    <a href="javascript:void(0)" data-index="{!index}" onclick="{!c.openCreateContact}"> Create </a>
                                                </aura:set>
                                            </aura:if>
                                            ]
                                        </th>
                                    </tr>
                                    
                                    <tr style="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Name != item.lawyer.Contact__r.FirstName) ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
