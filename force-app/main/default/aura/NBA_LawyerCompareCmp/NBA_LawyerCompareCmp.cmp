                                        <th><div>ISBA #</div></th>
                                        <td><div>{!item.lawyer.ISBA_Number__c}</div></td>
                                        <td>
                                            <aura:if isTrue="{!AND(item.lawyer.Contact__c != null ,item.lawyer.ISBA_Number__c != item.lawyer.Contact__r.ISBA__c)}">
                                                <div data-index="{!index}" data-accField="ISBA_Number__c" data-nbaField="ISBA__c" onclick="{!c.handleUpdateContactData}">
                                                    <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                                </div>
                                            </aura:if>
                                        </td>
                                        <td>                                             
                                            {!item.lawyer.Contact__r.ISBA__c} 
                                        </td>
                                    </tr>-->
                                    
                                    <tr style="{!AND(item.lawyer.Contact__c != null ,item.lawyer.ARDC_Number__c != item.lawyer.Contact__r.ARDC_Number__c) ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                        <th><div>ARDC Number</div></th>
                                        <td><div>{!item.lawyer.ARDC_Number__c}</div></td>
                                        <td>
                                            <aura:if isTrue="{!AND(item.lawyer.Contact__c != null ,item.lawyer.ARDC_Number__c != item.lawyer.Contact__r.ARDC_Number__c)}">
                                                <div  data-index="{!index}" data-accField="ARDC_Number__c" data-nbaField="ARDC_Number__c" onclick="{!c.handleUpdateContactData}">
                                                    <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                                </div>
                                            </aura:if>
                                        </td>
                                        <td>                                             
                                            {!item.lawyer.Contact__r.ARDC_Number__c}                                         
                                        </td>
                                    </tr>
                                    
                                    <tr style="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Cell_Phone__c != item.lawyer.Contact__r.MobilePhone) ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                        <th><div>Cell Phone</div></th>
                                        <td>
                                            <lightning:formattedPhone value="{!item.lawyer.Cell_Phone__c}"/>
                                        </td>
                                        <td>
                                            <aura:if isTrue="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Cell_Phone__c != item.lawyer.Contact__r.MobilePhone)}">
                                                <div data-index="{!index}" data-accField="Cell_Phone__c" data-nbaField="MobilePhone" onclick="{!c.handleUpdateContactData}">
                                                    <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                                </div>
                                            </aura:if>
                                        </td>
                                        <td>                                             
                                            {!item.lawyer.Contact__r.MobilePhone}                                         
                                        </td>
                                    </tr>
                                    
                                    <tr style="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Birthday__c != item.lawyer.Contact__r.Birthdate) ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                        <th><div>Birthdate</div></th>
                                        <td>
                                            <lightning:formattedDateTime value="{!item.lawyer.Birthday__c}" year="numeric" month="2-digit" day="2-digit"/>
                                        </td>
                                        <td>
                                            <aura:if isTrue="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Birthday__c != item.lawyer.Contact__r.Birthdate)}">
                                                <div data-index="{!index}" data-accField="Birthday__c" data-nbaField="Birthdate" onclick="{!c.handleUpdateContactData}">
                                                    <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                                </div>
                                            </aura:if>
                                        </td>
                                        <td> 
                                            <lightning:formattedDateTime value="{!item.lawyer.Contact__r.Birthdate}" year="numeric" month="2-digit" day="2-digit"/>                                                                           
                                        </td>
                                    </tr>
                                    
                                    <tr style="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Firm_Email_Address__c != item.lawyer.Contact__r.Email) ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                        <th><div>Firm Email</div></th>
                                        <td><div>{!item.lawyer.Firm_Email_Address__c}</div></td>
                                        <td>
                                            <aura:if isTrue="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Firm_Email_Address__c != item.lawyer.Contact__r.Email)}">
                                                <div data-index="{!index}" data-accField="Firm_Email_Address__c" data-nbaField="Email" onclick="{!c.handleUpdateContactData}">
                                                    <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                                </div>
                                            </aura:if>
                                        </td>
                                        <td>                                             
                                            {!item.lawyer.Contact__r.Email}                                         
                                        </td>
                                    </tr>
                                    
                                    <tr style="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Personal_Email_Address__c != item.lawyer.Contact__r.Personal_Email__c) ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                        <th><div>Personal Email</div></th>
                                        <td><div>{!item.lawyer.Personal_Email_Address__c}</div></td>
                                        <td>
                                            <aura:if isTrue="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Personal_Email_Address__c != item.lawyer.Contact__r.Personal_Email__c)}">
                                                <div data-index="{!index}" data-accField="Personal_Email_Address__c" data-nbaField="Personal_Email__c" onclick="{!c.handleUpdateContactData}">
                                                    <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                                </div>
                                            </aura:if>
                                        </td>
                                        <td>                                             
                                            {!item.lawyer.Contact__r.Personal_Email__c}
                                        </td>
                                    </tr>
                                    
                                    <tr>
                                        <th><div>Designation</div></th>
                                        <td><div>{!item.lawyer.Designation__c}</div></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <th><div>Avg Hours/week</div></th>
                                        <td><div>{!item.lawyer.Average_Number_of_Hours_Worked__c}</div></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    
                                    <tr>
                                        <th class=""><div>Hire Date</div></th>
                                        <td>
                                            <lightning:formattedDateTime
                                                                         value="{!item.lawyer.Date_of_Hire__c}"
                                                                         year="numeric"
                                                                         month="2-digit"
                                                                         day="2-digit"/>
                                        </td>
                                        <td></td>
                                        <td class=""></td>
                                    </tr>
                                    <tr>
                                        <th class="leftBottom"><div>Created Date</div></th>
                                        <td>
                                            <lightning:formattedDateTime value="{!item.lawyer.CreatedDate}" year="numeric" month="numeric" day="numeric" hour="2-digit"
                                                                         minute="2-digit" hour12="true"/>
                                        </td>
                                        <td></td>
                                        <td class="rightBottom">
                                            <lightning:formattedDateTime value="{!item.lawyer.Contact__r.CreatedDate}" year="numeric" month="numeric" day="numeric" hour="2-digit"
                                                                         minute="2-digit" hour12="true"/>
                                        </td>
                                    </tr>
                                </table>
                                
                            </div>
                        </aura:if>
                        
                    </div>
                </aura:iteration>
                <!-- <div style="overflow-y: scroll;">
                    <table class="slds-table_cell-buffer">
                        <thead>
                            <tr>
                                <th class="leftTop rightTop" style="text-align: center;" colspan="9">
                                    Customer Application Lawyer
                                </th>
                            </tr>
                            <tr>
                                <th class="slds-truncate" width="10%">FirstName</th>
                                <th class="slds-truncate" width="10%">MiddleName</th>
                                <th class="slds-truncate" width="10%">LastName</th>
                                <th class="slds-truncate" width="10%">ISBA #</th>
                                <th class="slds-truncate" width="10%">ARDC Number</th>
                                <th class="slds-truncate" width="10%">Cell Phone</th>
                                <th class="slds-truncate" width="10%">Birthdate</th>
                                <th class="slds-truncate" width="15%">Firm Email</th>
                                <th class="slds-truncate" width="15%">Personal Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            <aura:iteration items="{!v.wrapper.unMatchedLawyers}" var="item">
                                <tr>
                                    <td class="leftBottom">{!item.Name}</td>
                                    <td>{!item.Middle_Initial__c}</td>
                                    <td>{!item.Last_Name__c}</td>
                                    <td>{!item.ISBA_Number__c}</td>
                                    <td>{!item.ARDC_Number__c}</td>
                                    <td>{!item.Cell_Phone__c}</td>
                                    <td>{!item.Birthday__c}</td>
                                    <td>{!item.Firm_Email_Address__c}</td>
                                    <td class="rightBottom">{!item.Personal_Email_Address__c}</td>
                                </tr>
                            </aura:iteration>
                        </tbody>
                    </table>
                </div> -->
            </aura:if>
            
            <aura:if isTrue="{!v.wrapper.unMatchedContact.length > 0}">
                <div style="overflow-y: scroll;">
                    <table class="nbaTable slds-table_cell-buffer" style="margin: 0;">
                        <thead>
                            <tr>
                                <th class="leftTop rightTop" style="background-color: red;color:white;" colspan="10">
                                    Remove Lawyer Requests
                                </th>
                            </tr>
                            <tr>
                                <th class="slds-truncate" width="10%">FirstName</th>
                                <th class="slds-truncate" width="10%">MiddleName</th>
                                <th class="slds-truncate" width="10%">LastName</th>
                                <th class="slds-truncate" width="10%">ISBA #</th>
                                <th class="slds-truncate" width="10%">ARDC Number</th>
                                <th class="slds-truncate" width="10%">Cell Phone</th>
                                <th class="slds-truncate" width="10%">Birthdate</th>
                                <th class="slds-truncate" width="15%">Firm Email</th>
                                <th class="slds-truncate" width="15%">Personal Email</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <aura:iteration items="{!v.wrapper.unMatchedContact}" var="item">
                                <tr>
                                    <td class="leftBottom">{!item.FirstName}</td>
                                    <td>{!item.Middle_Name__c}</td>
                                    <td>{!item.LastName}</td>
                                    <td>{!item.ISBA__c}</td>
                                    <td>{!item.ARDC_Number__c}</td>
                                    <td>{!item.MobilePhone}</td>
                                    <td>{!item.Birthdate}</td>
                                    <td>{!item.Email}</td>
                                    <td class="rightBottom">{!item.Personal_Email__c}</td>
                                    <td>
                                        <div data-row="{!item.Id}"  onclick="{!c.handleDeletePolicyLawyer}">
                                            <lightning:icon iconName="utility:delete" size="x-small" class="icon"/>
                                        </div>
                                    </td>
                                </tr>
                            </aura:iteration>
                        </tbody>
                    </table>
                </div>
            </aura:if>
        </div>
        <aura:set attribute="else">
            <div>
                No records found.
            </div>
        </aura:set>
    </aura:if>
    
    <aura:if isTrue="{!v.isModalOpen}">
        <!-- Modal/Popup Box starts here-->
        <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open slds-modal_small">
            <aura:if isTrue="{!v.showSpinner}">
                <lightning:spinner alternativeText="Loading" size="medium" />
            </aura:if>
            <div class="slds-modal__container ">
                <!-- Modal/Popup Box Header Starts here-->
                <header class="slds-modal__header">
                    <lightning:buttonIcon iconName="utility:close"
                                          onclick="{! c.closeModal }"
                                          alternativeText="close"
                                          
                                          class="slds-modal__close"/>
                    <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">Create Account</h2>
                </header>
                
                <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                    Are you sure you want to create account: {!v.wrapper.onlineNBA.Full_Legal_Name_of_the_Firm__c}
                </div>
                
                <footer class="slds-modal__footer">
                    <lightning:button variant="neutral" label="Cancel" title="Cancel" onclick="{! c.closeModal }"/>
                    <lightning:button variant="brand" label="Create" title="Create" onclick="{!c.saveAcc}"/>
                </footer>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
    
    <aura:if isTrue="{!v.isLinkModalOpen}">
        <c:LinkAccount recordId="{!v.recordId}" searchTerm="{!v.searchTerm}"/>
    </aura:if>
    
    <aura:if isTrue="{!v.isLinkContactModalOpen}">
        <section role="dialog" class="slds-modal slds-fade-in-open slds-modal_large">
            <aura:if isTrue="{!v.showSpinner}">
                <lightning:spinner alternativeText="Loading" size="medium" />
            </aura:if>
            <div class="slds-modal__container">
                <header class="slds-modal__header">
                    <lightning:buttonIcon iconName="utility:close" onclick="{!c.closeContactModal}" class="slds-modal__close"/>
                    <div class="header" style="margin: 1rem">
                    <div class="leftHeadSection">
                        <div><b>Name: &nbsp;</b> {!v.selectedLawyer.Name}&nbsp; {!v.selectedLawyer.Last_Name__c}</div>
                        <div><b>Email: &nbsp;</b> {!v.selectedLawyer.Firm_Email_Address__c}</div>
                        <div><b>ARDC #: &nbsp;</b> {!v.selectedLawyer.ARDC_Number__c}</div>
                        <div><b>Birthday: &nbsp;</b> <lightning:formattedDateTime
                                                     value="{!v.selectedLawyer.Birthday__c}"
                                                     year="numeric"
                                                     month="2-digit"
                                                     day="2-digit"/></div>
                    </div>
                    <h2 class="heading slds-text-heading_medium slds-hyphenate slds-align_absolute-center">
                        Link Existing Contact
                    </h2>
                </div>
                   

                </header>
                
                <div class="slds-modal__content slds-p-around_medium" style="overflow:hidden;">
                    
                    <lightning:input label="Search Contact" value="{!v.contactSearchKey}" onchange="{!c.searchContact}"/>
                    <div style="max-height: 300px; overflow-y:auto;">
                    	<table class="nbaTable slds-table_cell-buffer">
                        <thead>
                            <tr>
                                <th width="10%"> </th>
                                <th>Contact Name</th>
                                <th>ARDC #</th>
                                <th>ISBA #</th>
                                <th>Email</th>
                                <th>Birthday</th>
                            </tr>
                        </thead>
                        <tbody>
                            <aura:iteration items="{!v.contactList}" var="con">
                                <tr>
                                    <td>
                                        <a href="javascript:void(0);" class="slds-text-link" data-id="{!con.Id}" onclick="{!c.handleLinkContact}">
                                            Select
                                        </a>
                                    </td>
                                    <td>
                                        <a href="{!'/'+con.Id}"
                                           target="_blank">
                                            {!con.Contact_Full_Name__c}
                                        </a>                                     
                                    </td>
                                    <td>{!con.ARDC_Number__c}</td>
                                    <td>{!con.ISBA__c}</td>
                                    <td>{!con.Email}</td>
                                    <td>
                                        <lightning:formattedDateTime
                                                                     value="{!con.Birthdate}"
                                                                     year="numeric"
                                                                     month="2-digit"
                                                                     day="2-digit"/>
                                    </td>
                                </tr>
                            </aura:iteration>
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </section>
        
        <div class="slds-backdrop slds-backdrop_open"></div>  
    </aura:if>
    
    <aura:if isTrue="{!v.isCreateContactModalOpen}">
        <section role="dialog" class="slds-modal slds-fade-in-open slds-modal_small">
            <aura:if isTrue="{!v.showSpinner}">
                <lightning:spinner alternativeText="Loading" size="medium" />
            </aura:if>
            <div class="slds-modal__container">
                
                <header class="slds-modal__header">
                    <lightning:buttonIcon iconName="utility:close" onclick="{!c.closeCreateContactModal}" class="slds-modal__close"/>
                    <h2 class="slds-text-heading_medium">
                        Create Contact
                    </h2>
                </header>
                
                <div class="slds-modal__content slds-p-around_medium">
                    Are you sure you want to create contact:
                    <b>{!v.selectedLawyerName}</b>
                </div>
                
                <footer class="slds-modal__footer">
                    <lightning:button variant="neutral" label="Cancel" onclick="{!c.closeCreateContactModal}"/>
                    <lightning:button variant="brand" label="Create" onclick="{!c.confirmCreateContact}"/>
                </footer>
                
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
    
    <aura:if isTrue="{!v.showAccountUnlinkModal}">
        <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
            <aura:if isTrue="{!v.showSpinner}">
                <lightning:spinner alternativeText="Loading" size="medium" />
            </aura:if>
            <div class="slds-modal__container" style="width: 50% !important;">
                <header class="slds-modal__header">
                    <lightning:buttonIcon iconName="utility:close"
                                          onclick="{! c.closeModal }"
                                          alternativeText="close"
                                          class="slds-modal__close"/>
                    <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">Unlink Account</h2>
                </header>
                
                <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                    <div style="width: 100%; text-align: center;">
                        Are you sure you want to unlink the Account.
                    </div>  
                </div>
                <footer class="slds-modal__footer">
                    <lightning:button variant="neutral"
                                      label="No"
                                      title="No"
                                      onclick="{! c.closeModal }"/>
                    <lightning:button variant="brand"
                                      label="Yes"
                                      title="Yes"
                                      onclick="{!c.unLinkAccount}" aura:id = "policyContact"/>
                    
                </footer>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
    
    <aura:if isTrue="{!v.showContactUnlinkModal}">
        <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
            <aura:if isTrue="{!v.showSpinner}">
                <lightning:spinner alternativeText="Loading" size="medium" />
            </aura:if>
            <div class="slds-modal__container" style="width: 50% !important;">
                <header class="slds-modal__header">
                    <lightning:buttonIcon iconName="utility:close"
                                          onclick="{! c.closeModal }"
                                          alternativeText="close"
                                          class="slds-modal__close"/>
                    <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">Unlink Contact</h2>
                </header>
                
                <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                    <div style="width: 100%; text-align: center;">
                        Are you sure you want to unlink the Contact.
                    </div>  
                </div>
                <footer class="slds-modal__footer">
                    <lightning:button variant="neutral"
                                      label="No"
                                      title="No"
                                      onclick="{! c.closeModal }"/>
                    <lightning:button variant="brand"
                                      label="Yes"
                                      title="Yes"
                                      onclick="{!c.unLinkContact}" aura:id = "policyContact"/>
                    
                </footer>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
</aura:component>