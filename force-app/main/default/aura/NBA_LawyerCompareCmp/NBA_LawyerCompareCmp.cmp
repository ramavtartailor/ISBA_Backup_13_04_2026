                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>
                                            <lightning:formattedDateTime  value="{!item.policyLawyer.Hire_Date__c}" year="numeric"
