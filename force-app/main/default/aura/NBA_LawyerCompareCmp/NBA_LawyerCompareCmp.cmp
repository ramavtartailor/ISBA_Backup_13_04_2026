                                        <td><div>{!item.lawyer.Name}</div></td>
                                        <td>
                                            <aura:if isTrue="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Name != item.lawyer.Contact__r.FirstName)}">
                                                <div data-index="{!index}" data-accField="Name" data-nbaField="FirstName" onclick="{!c.handleUpdateContactData}">
                                                    <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                                </div>
                                            </aura:if>
                                        </td>
                                        <td>
                                            {!item.lawyer.Contact__r.FirstName}
                                        </td>
                                    </tr>
                                    
                                    <tr style="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Middle_Initial__c != item.lawyer.Contact__r.Middle_Name__c) ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                        <th><div>Middle Name</div></th>
                                        <td><div>{!item.lawyer.Middle_Initial__c}</div></td>
                                        <td>
                                            <aura:if isTrue="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Middle_Initial__c != item.lawyer.Contact__r.Middle_Name__c)}">
                                                <div data-index="{!index}" data-accField="Middle_Initial__c" data-nbaField="Middle_Name__c" onclick="{!c.handleUpdateContactData}">
                                                    <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                                </div>
                                            </aura:if>
                                        </td>
                                        <td>
                                            {!item.lawyer.Contact__r.Middle_Name__c}
                                        </td>
                                    </tr>
                                    
                                    <tr style="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Last_Name__c != item.lawyer.Contact__r.LastName) ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                        <th><div>Last Name</div></th>
                                        <td><div>{!item.lawyer.Last_Name__c}</div></td>
                                        <td>
                                            <aura:if isTrue="{!AND(item.lawyer.Contact__c != null ,item.lawyer.Last_Name__c != item.lawyer.Contact__r.LastName)}">
                                                <div data-index="{!index}" data-accField="Last_Name__c" data-nbaField="lastName" onclick="{!c.handleUpdateContactData}">
                                                    <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                                </div>
                                            </aura:if>
                                        </td>
