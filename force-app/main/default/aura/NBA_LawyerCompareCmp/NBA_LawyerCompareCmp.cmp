                                        <aura:if isTrue="{!item.lawyer.Average_Number_of_Hours_Worked__c != item.policyLawyer.Average_Hours_Per_Week__c}">
                                            <div data-index="{!index}" data-lwField="Average_Number_of_Hours_Worked__c" data-conField="Average_Hours_Per_Week__c" onclick="{!c.handleUpdatePolicyLawyerData}">
