<aura:component controller="NBA_LawyerCompareCtrl" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction" access="global" >
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="wrapper" type="Object"/> 
    <aura:attribute name="searchTerm" type="String"/> 
    
    <aura:attribute name="isModalOpen" type="Boolean" default="false"/>
    <aura:attribute name="isLawyer" type="Boolean" default="false"/>

    <aura:attribute name="isLinkContactModalOpen" type="Boolean" default="false"/>
    <aura:attribute name="contactList" type="Contact[]"/>
    <aura:attribute name="contactSearchKey" type="String"/>
    
    <aura:attribute name="isCreateContactModalOpen" type="Boolean" default="false"/>
    <aura:attribute name="showAccountUnlinkModal" type="boolean" default="false"/>
    <aura:attribute name="showContactUnlinkModal" type="boolean" default="false"/>
    <aura:attribute name="selectedLawyerId" type="Id"/>
    <aura:attribute name="selectedLawyerName" type="String"/>
    <aura:attribute name="baseURL" type="String"/>
    
    <aura:attribute name="showSpinner" type="Boolean" default="false"/>
    
    <aura:attribute name="isLinkModalOpen" type="boolean" default="false"/>
    <aura:handler event="c:closeLinkAccountModalEvt" action="{!c.closeModalLinkAccount}"/>
    <aura:attribute name="selectedLawyer" type="Object"/>
    
    <aura:if isTrue="{!v.wrapper}" >
        <div class="body">
            
            <div class="Section">
                <div class="{!(v.wrapper.onlineNBA.Account__c != null) ? 'sectionHeader greenBox' : 'sectionHeader blueBox'}">Account</div>
                <div class="sectionBody" style="overflow-y: scroll;">
                    <aura:if isTrue="{!v.wrapper.onlineNBA.RecordType.Name != 'New Business'}">
                        <table class="nbaTable slds-table_cell-buffer">
                            <tr>
                                <th class="leftTop"></th>
                                <th>Customer Application</th>
                                <th></th>
                                <th class="rightTop">Policy</th>
                            </tr>
                            <tr style="{!v.wrapper.acc.Name != v.wrapper.onlineNBA.Full_Legal_Name_of_the_Firm__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                <th><div>Name</div></th>
                                <td>
                                    <div>{!v.wrapper.onlineNBA.Full_Legal_Name_of_the_Firm__c}</div>
                                </td>
                                <td>
                                    <aura:if isTrue="{!v.wrapper.acc.Name != v.wrapper.onlineNBA.Full_Legal_Name_of_the_Firm__c}">
                                        <div data-accField="Name" data-nbaField="Full_Legal_Name_of_the_Firm__c" onclick="{!c.handleUpdateAccData}">
                                            <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                        </div>
                                    </aura:if>
                                </td>
                                <td>
                                    <div>{!v.wrapper.acc.Name}</div>
                                </td>
                            </tr>
                            <tr style="{!v.wrapper.acc.Trade_Name_or_D_B_A__c != v.wrapper.onlineNBA.Trade_Name_or_D_B_A__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                <th><div>Trade Name or D/B/A</div></th>
                                <td>
                                    <div>{!v.wrapper.onlineNBA.Trade_Name_or_D_B_A__c}</div>
                                </td>
                                <td>
                                    <aura:if isTrue="{!v.wrapper.acc.Trade_Name_or_D_B_A__c != v.wrapper.onlineNBA.Trade_Name_or_D_B_A__c}">
                                        <div data-accField="Trade_Name_or_D_B_A__c" data-nbaField="Trade_Name_or_D_B_A__c" onclick="{!c.handleUpdateAccData}">
                                            <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                        </div>
                                    </aura:if>
                                </td>
                                <td>
                                    <div>{!v.wrapper.acc.Trade_Name_or_D_B_A__c}</div>
                                </td>
                            </tr>
                            <tr style="{!v.wrapper.acc.BillingStreet != v.wrapper.onlineNBA.Street__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                <th><div>Principal Street Address</div></th>
                                <td>
                                    <div>{!v.wrapper.onlineNBA.Street__c}</div>
                                </td>
                                <td>
                                    <aura:if isTrue="{!v.wrapper.acc.BillingStreet != v.wrapper.onlineNBA.Street__c}">
                                        <div data-accField="BillingStreet" data-nbaField="Street__c" onclick="{!c.handleUpdateAccData}">
                                            <lightning:icon class="icon" iconName="utility:forward" size="x-small"/>
                                        </div>
                                    </aura:if>
                                </td>
                                <td>
                                    <div>{!v.wrapper.acc.BillingStreet}</div>
                                </td>
                            </tr>
                            <tr style="{!v.wrapper.acc.BillingCity != v.wrapper.onlineNBA.City__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                <th><div>City</div></th>
                                <td>
                                    <div>{!v.wrapper.onlineNBA.City__c}</div>
                                </td>
                                <td>
                                    <aura:if isTrue="{!v.wrapper.acc.BillingCity != v.wrapper.onlineNBA.City__c}">
                                        <div data-accField="BillingCity" data-nbaField="City__c" onclick="{!c.handleUpdateAccData}">
                                            <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                        </div>
                                    </aura:if>
                                </td>
                                <td>
                                    <div>{!v.wrapper.acc.BillingCity}</div>
                                </td>
                            </tr>
                            <tr style="{!v.wrapper.acc.BillingState != v.wrapper.onlineNBA.State__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                <th><div>State</div></th>
                                <td>
                                    <div>{!v.wrapper.onlineNBA.State__c}</div>
                                </td>
                                <td>
                                    <aura:if isTrue="{!v.wrapper.acc.BillingState != v.wrapper.onlineNBA.State__c}">
                                        <div data-accField="BillingState" data-nbaField="State__c" onclick="{!c.handleUpdateAccData}">
                                            <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                        </div>
                                    </aura:if>
                                </td>
                                <td>
                                    <div>{!v.wrapper.acc.BillingState}</div>
                                </td>
                            </tr>
                            <tr style="{!v.wrapper.acc.BillingPostalCode != v.wrapper.onlineNBA.Zip_Code__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                <th><div>Zip Code</div></th>
                                <td>
                                    <div>
                                        {!v.wrapper.onlineNBA.Zip_Code__c}
                                    </div>
                                </td>
                                <td>
                                    <aura:if isTrue="{!v.wrapper.acc.BillingPostalCode != v.wrapper.onlineNBA.Zip_Code__c}">
                                        <div data-accField="BillingPostalCode" data-nbaField="Zip_Code__c" onclick="{!c.handleUpdateAccData}">
                                            <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                        </div>
                                    </aura:if>
                                </td>
                                <td>
                                    <div>
                                        {!v.wrapper.acc.BillingPostalCode}
                                    </div>
                                </td>
                            </tr>
                            <tr style="{!v.wrapper.acc.Billing_Address_County__c != v.wrapper.onlineNBA.County__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                <th><div>County</div></th>
                                <td>
                                    <div>
                                        {!v.wrapper.onlineNBA.County__r.Name}
                                    </div>                                                                  
                                </td>
                                <td>
                                    <aura:if isTrue="{!v.wrapper.acc.Billing_Address_County__c != v.wrapper.onlineNBA.County__c}">
                                        <div data-accField="Billing_Address_County__c" data-nbaField="County__c" onclick="{!c.handleUpdateAccData}">
                                            <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                        </div>
                                    </aura:if>
                                </td>
                                <td>
                                    <div>
                                        {!v.wrapper.acc.Billing_Address_County__r.Name}
                                    </div>
                                </td>
                            </tr>
                            <tr style="{!v.wrapper.acc.Phone != v.wrapper.onlineNBA.Firm_Phone_Number__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                <th><div>Firm Phone Number</div></th>
                                <td>
                                    <div><lightning:formattedPhone value="{!v.wrapper.onlineNBA.Firm_Phone_Number__c}"/></div>
                                </td>
                                <td>
                                    <aura:if isTrue="{!v.wrapper.acc.Phone != v.wrapper.onlineNBA.Firm_Phone_Number__c}">
                                        <div data-accField="Phone" data-nbaField="Firm_Phone_Number__c" onclick="{!c.handleUpdateAccData}">
                                            <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                        </div>
                                    </aura:if>
                                </td>
                                <td>
                                    <div><lightning:formattedPhone value="{!v.wrapper.acc.Phone}"/></div>
                                </td>
                            </tr>
                            <tr style="{!v.wrapper.acc.Establish_Date__c != v.wrapper.onlineNBA.Date_Firm_Established__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                <th class=""><div>Date Firm Established</div></th>
                                <td>
                                    <div><lightning:formattedDateTime  value="{!v.wrapper.onlineNBA.Date_Firm_Established__c}" year="numeric"
                                                                      month="2-digit" day="2-digit" /></div>
                                </td>
                                <td>
                                    <aura:if isTrue="{!v.wrapper.acc.Establish_Date__c != v.wrapper.onlineNBA.Date_Firm_Established__c}">
                                        <div data-accField="Establish_Date__c" data-nbaField="Date_Firm_Established__c" onclick="{!c.handleUpdateAccData}">
                                            <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                        </div>
                                    </aura:if>
                                </td>
                                <td class="">
                                    <div><lightning:formattedDateTime  value="{!v.wrapper.acc.Establish_Date__c}" year="numeric"
                                                                      month="2-digit" day="2-digit" /></div>
                                </td>
                            </tr>
                            <tr style="{!v.wrapper.acc.Website__c != v.wrapper.onlineNBA.Website__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                <th class="leftBottom"><div>Website</div></th>
                                <td>
                                    <div>{!v.wrapper.onlineNBA.Website__c}</div>
                                </td>
                                <td>
                                    <aura:if isTrue="{!v.wrapper.acc.Website__c != v.wrapper.onlineNBA.Website__c}">
                                        <div data-accField="Website__c" data-nbaField="Website__c" onclick="{!c.handleUpdateAccData}">
                                            <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                        </div>
                                    </aura:if>
                                </td>
                                <td class="rightBottom">
                                    <div>{!v.wrapper.acc.Website__c}</div>
                                </td>
                            </tr>
                        </table>
                        <aura:set attribute="else">
                            <table class="nbaTable slds-table_cell-buffer">
                                <tr>
                                    <th class="leftTop"></th>
                                    <th>
                                        Application Account [<a href="{!v.baseURL+'/c/SearchApp.app?search='+v.wrapper.onlineNBA.Full_Legal_Name_of_the_Firm__c}"
                                           target="_blank">Search</a>]
                                    </th>
                                    <th></th>
                                    <th class="rightTop">Existing Account  
                                        <aura:if isTrue="{!!v.wrapper.onlineNBA.PolicyId__c}">[
                                            <aura:if isTrue="{!(v.wrapper.onlineNBA.Account__c != null)}">
                                                <a href="javascript:void(0)" onclick="{!c.openUnLinkModel}" >Unlink</a>
                                                <aura:set attribute="else">
                                                    <a href="javascript:void(0)" onclick="{!c.openLinkModel}" >Link</a>
                                                    &nbsp;|&nbsp;
                                                    <a href="javascript:void(0)" onclick="{!c.openCreateModel}" >Create</a>
                                                </aura:set>
                                            </aura:if>]
                                        </aura:if>
                                    </th>
                                </tr>
                                <tr style="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Name != v.wrapper.onlineNBA.Full_Legal_Name_of_the_Firm__c ? 'background: rgba(235, 51, 16, 0.12);' : '')}">
                                    <th><div>Name</div></th>
                                    <td>
                                        <div>{!v.wrapper.onlineNBA.Full_Legal_Name_of_the_Firm__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Name != v.wrapper.onlineNBA.Full_Legal_Name_of_the_Firm__c)}">
                                            <div data-accField="Name" data-nbaField="Full_Legal_Name_of_the_Firm__c" onclick="{!c.handleUpdateAccData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!v.wrapper.acc.Name}</div>
                                    </td>
                                </tr>
                                <tr style="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Trade_Name_or_D_B_A__c != v.wrapper.onlineNBA.Trade_Name_or_D_B_A__c ? 'background: rgba(235, 51, 16, 0.12);' : '')}">
                                    <th><div>Trade Name or D/B/A</div></th>
                                    <td>
                                        <div>{!v.wrapper.onlineNBA.Trade_Name_or_D_B_A__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Trade_Name_or_D_B_A__c != v.wrapper.onlineNBA.Trade_Name_or_D_B_A__c)}">
                                            <div data-accField="Trade_Name_or_D_B_A__c" data-nbaField="Trade_Name_or_D_B_A__c" onclick="{!c.handleUpdateAccData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!v.wrapper.acc.Trade_Name_or_D_B_A__c}</div>
                                    </td>
                                </tr>
                                <tr style="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.BillingStreet != v.wrapper.onlineNBA.Street__c ? 'background: rgba(235, 51, 16, 0.12);' : '')}">
                                    <th><div>Principal Street Address</div></th>
                                    <td>
                                        <div>{!v.wrapper.onlineNBA.Street__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.BillingStreet != v.wrapper.onlineNBA.Street__c)}">
                                            <div data-accField="BillingStreet" data-nbaField="Street__c" onclick="{!c.handleUpdateAccData}">
                                                <lightning:icon class="icon" iconName="utility:forward" size="x-small"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!v.wrapper.acc.BillingStreet}</div>
                                    </td>
                                </tr>
                                <tr style="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.BillingCity != v.wrapper.onlineNBA.City__c ? 'background: rgba(235, 51, 16, 0.12);' : '')}">
                                    <th><div>City</div></th>
                                    <td>
                                        <div>{!v.wrapper.onlineNBA.City__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.BillingCity != v.wrapper.onlineNBA.City__c)}">
                                            <div data-accField="BillingCity" data-nbaField="City__c" onclick="{!c.handleUpdateAccData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!v.wrapper.acc.BillingCity}</div>
                                    </td>
                                </tr>
                                <tr style="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.BillingState != v.wrapper.onlineNBA.State__c ? 'background: rgba(235, 51, 16, 0.12);' : '')}">
                                    <th><div>State</div></th>
                                    <td>
                                        <div>{!v.wrapper.onlineNBA.State__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.BillingState != v.wrapper.onlineNBA.State__c)}">
                                            <div data-accField="BillingState" data-nbaField="State__c" onclick="{!c.handleUpdateAccData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!v.wrapper.acc.BillingState}</div>
                                    </td>
                                </tr>
                                <tr style="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.BillingPostalCode != v.wrapper.onlineNBA.Zip_Code__c ? 'background: rgba(235, 51, 16, 0.12);' : '')}">
                                    <th><div>Zip Code</div></th>
                                    <td>
                                        <div>
                                            {!v.wrapper.onlineNBA.Zip_Code__c}
                                        </div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.BillingPostalCode != v.wrapper.onlineNBA.Zip_Code__c)}">
                                            <div data-accField="BillingPostalCode" data-nbaField="Zip_Code__c" onclick="{!c.handleUpdateAccData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>
                                            {!v.wrapper.acc.BillingPostalCode}
                                        </div>
                                    </td>
                                </tr>
                                <tr style="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Billing_Address_County__c != v.wrapper.onlineNBA.County__c ? 'background: rgba(235, 51, 16, 0.12);' : '')}">
                                    <th><div>County</div></th>
                                    <td>
                                        <div>
                                            {!v.wrapper.onlineNBA.County__r.Name}
                                        </div>                                                                  
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Billing_Address_County__c != v.wrapper.onlineNBA.County__c)}">
                                            <div data-accField="Billing_Address_County__c" data-nbaField="County__c" onclick="{!c.handleUpdateAccData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>
                                            {!v.wrapper.acc.Billing_Address_County__r.Name}
                                        </div>
                                    </td>
                                </tr>
                                <tr style="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Phone != v.wrapper.onlineNBA.Firm_Phone_Number__c ? 'background: rgba(235, 51, 16, 0.12);' : '')}">
                                    <th><div>Firm Phone Number</div></th>
                                    <td>
                                        <div><lightning:formattedPhone value="{!v.wrapper.onlineNBA.Firm_Phone_Number__c}"/></div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Phone != v.wrapper.onlineNBA.Firm_Phone_Number__c)}">
                                            <div data-accField="Phone" data-nbaField="Firm_Phone_Number__c" onclick="{!c.handleUpdateAccData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div><lightning:formattedPhone value="{!v.wrapper.acc.Phone}"/></div>
                                    </td>
                                </tr>
                                <tr style="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Establish_Date__c != v.wrapper.onlineNBA.Date_Firm_Established__c) ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                    <th class=""><div>Date Firm Established</div></th>
                                    <td>
                                        <div><lightning:formattedDateTime  value="{!v.wrapper.onlineNBA.Date_Firm_Established__c}" year="numeric"
                                                                          month="2-digit" day="2-digit" /></div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Establish_Date__c != v.wrapper.onlineNBA.Date_Firm_Established__c)}">
                                            <div data-accField="Establish_Date__c" data-nbaField="Date_Firm_Established__c" onclick="{!c.handleUpdateAccData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td class="">
                                        <div><lightning:formattedDateTime  value="{!v.wrapper.acc.Establish_Date__c}" year="numeric"
                                                                          month="2-digit" day="2-digit" /></div>
                                    </td>
                                </tr>
                                <tr style="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Website__c != v.wrapper.onlineNBA.Website__c) ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                    <th class=""><div>Website</div></th>
                                    <td>
                                        <div>{!v.wrapper.onlineNBA.Website__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!AND(v.wrapper.onlineNBA.Account__c != null ,v.wrapper.acc.Website__c != v.wrapper.onlineNBA.Website__c)}">
                                            <div data-accField="Website__c" data-nbaField="Website__c" onclick="{!c.handleUpdateAccData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td class="">
                                        <div>{!v.wrapper.acc.Website__c}</div>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="leftBottom"><div>Created Date</div></th>
                                    <td>
                                        <div>
                                            <lightning:formattedDateTime value="{!v.wrapper.onlineNBA.CreatedDate}" year="numeric" month="numeric" day="numeric" hour="2-digit"
                                                                         minute="2-digit" hour12="true"/>
                                        </div>
                                    </td>
                                    <td>
                     
                                    </td>
                                    <td class="rightBottom">
                                        <div>
                                            <lightning:formattedDateTime value="{!v.wrapper.acc.CreatedDate}" year="numeric" month="numeric" day="numeric" hour="2-digit"
                                                                         minute="2-digit" hour12="true"/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </aura:set>
                    </aura:if>
                </div>
            </div>
            
            
            <!-- CONTACT SECTION -->
            <div class="Section">
                
                <div class="sectionHeader greenBox">
                    Contact <aura:if isTrue="{!!v.wrapper.showLinkContact}">(Matched with Lawyer)</aura:if>
                </div>
                
                <div class="sectionBody">
                    <table class="nbaTable slds-table_cell-buffer">
                        
                        <tr>
                            <th class="leftTop"></th>
                            <th>
                                Application Contact [<a href="{!v.baseURL+'/c/SearchApp.app?search='+v.wrapper.onlineNBA.Contact_Name__c+' '+v.wrapper.onlineNBA.Contact_Last_Name__c}"
                                   target="_blank">Search</a>]
                            </th>
                            <th></th>
                            <!--<th class="rightTop">Existing Contact</th>-->
                            <th class="rightTop">
                                Existing Contact
                                <aura:if isTrue="{!v.wrapper.showLinkContact}">
                                    &nbsp;[
                                    <a href="javascript:void(0)"
                                       onclick="{!c.openLinkContactApp}">
                                        Link
                                    </a>
                                    &nbsp;|&nbsp;
                                    <a href="javascript:void(0)"
                                       onclick="{!c.openCreateContactApp}"> 
                                        Create
                                    </a>
                                    ]
                                </aura:if>
                            </th>
                        </tr>
                        
                        <!-- NAME -->
                        <tr style="{!AND(v.wrapper.appContact, v.wrapper.appContact.FirstName != v.wrapper.onlineNBA.Contact_Name__c) ?
                                   'background: rgba(235, 51, 16, 0.12);' : ''}">
                            <th>FirstName</th>
                            
                            <td>{!v.wrapper.onlineNBA.Contact_Name__c}</td>
                            
                            <td>
                                <aura:if isTrue="{!AND(v.wrapper.appContact, v.wrapper.appContact.FirstName != v.wrapper.onlineNBA.Contact_Name__c)}">
                                    <div data-field="FirstName" data-nbaField="Contact_Name__c" onclick="{!c.handleUpdateContactField}">
                                        <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                    </div>
                                </aura:if>
                            </td>
                            
                            <td>{!v.wrapper.appContact.FirstName}</td>
                        </tr>
                        <tr style="{!AND(v.wrapper.appContact, v.wrapper.appContact.LastName != v.wrapper.onlineNBA.Contact_Last_Name__c) ?
                                   'background: rgba(235, 51, 16, 0.12);' : ''}">
                            <th>LastName</th>
                            
                            <td>{!v.wrapper.onlineNBA.Contact_Last_Name__c}</td>
                            
                            <td>
                                <aura:if isTrue="{!AND(v.wrapper.appContact, v.wrapper.appContact.LastName != v.wrapper.onlineNBA.Contact_Last_Name__c)}">
                                    <div data-field="LastName" data-nbaField="Contact_Last_Name__c" onclick="{!c.handleUpdateContactField}">
                                        <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                    </div>
                                </aura:if>
                            </td>
                            
                            <td>{!v.wrapper.appContact.LastName}</td>
                        </tr>
                        
                        <!-- EMAIL -->
                        <tr style="{!AND(v.wrapper.appContact, v.wrapper.appContact.Email != v.wrapper.onlineNBA.Contact_E_mail_Address__c) ?
                                   'background: rgba(235, 51, 16, 0.12);' : ''}">
                            <th>Email</th>
                            
                            <td>{!v.wrapper.onlineNBA.Contact_E_mail_Address__c}</td>
                            
                            <td>
                                <aura:if isTrue="{!AND(v.wrapper.appContact, v.wrapper.appContact.Email != v.wrapper.onlineNBA.Contact_E_mail_Address__c)}">
                                    <div data-field="Email" data-nbaField="Contact_E_mail_Address__c" onclick="{!c.handleUpdateContactField}">
                                        <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                    </div>
                                </aura:if>
                            </td>
                            
                            <td>{!v.wrapper.appContact.Email}</td>
                        </tr>
                        
                        <!-- PHONE -->
                        <tr style="{!AND(v.wrapper.appContact, v.wrapper.appContact.Phone != v.wrapper.onlineNBA.Contact_Phone_Number__c) ?
                                   'background: rgba(235, 51, 16, 0.12);' : ''}">
                            <th class="">Phone</th>
                            
                            <td>
                                <lightning:formattedPhone value="{!v.wrapper.onlineNBA.Contact_Phone_Number__c}" />
                            </td>
                            
                            <td>
                                <aura:if isTrue="{!AND(v.wrapper.appContact, v.wrapper.appContact.Phone != v.wrapper.onlineNBA.Contact_Phone_Number__c)}">
                                    <div data-field="Phone" data-nbaField="Contact_Phone_Number__c" onclick="{!c.handleUpdateContactField}">
                                        <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                    </div>
                                </aura:if>
                            </td>
                            
                            <td class="">
                                <lightning:formattedPhone value="{!v.wrapper.appContact.Phone}" />
                            </td>
                        </tr>
                        <tr>
                            <th class="leftBottom">Created Date</th>                            
                            <td>
                                <lightning:formattedDateTime value="{!v.wrapper.onlineNBA.CreatedDate}" year="numeric" month="numeric" day="numeric" hour="2-digit"
                                 minute="2-digit" hour12="true"/>
                            </td>
                            <td></td>
                            <td class="rightBottom">
                                <lightning:formattedDateTime value="{!v.wrapper.appContact.CreatedDate}" year="numeric" month="numeric" day="numeric" hour="2-digit"
                                 minute="2-digit" hour12="true"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            
            <aura:iteration items="{!v.wrapper.lawyers}" var="item" indexVar="index">
                <div class="Section">
                    <div class="sectionHeader greenBox"> 
                        <!--class="{!item.diffFieldsCount ? 'sectionHeader' : 'sectionHeader allMatched'}"-->
                        <aura:if isTrue="{!item.isExpended}">
                            <div data-val="false" data-index="{!index}" onclick="{!c.handleExpand}">
                                <lightning:icon variant="inverse" class="icon" iconName="utility:chevrondown" alternativeText="Expand" size="x-small"/>
                            </div><!--{!item.diffFieldsCount ? 'inverse' :''}-->
                            <aura:set attribute="else">
                                <div data-val="true" data-index="{!index}" onclick="{!c.handleExpand}">
                                    <lightning:icon variant="inverse" class="icon" iconName="utility:chevronright" alternativeText="Collapse" size="x-small"/>
                                </div>
                            </aura:set>
                        </aura:if>
                        <div>
                            {!item.con.ARDC_Number__c} &nbsp; - &nbsp; {!item.fullName}
                        </div>
                    </div>
                    <aura:if isTrue="{!item.isExpended}">
                        <div aura:id="bodySections" class="sectionBody">
                            
                            
                            <table class="nbaTable slds-table_cell-buffer">
                                <tr>
                                    <th class="leftTop"></th>
                                    <th>User Data</th>
                                    <th></th>
                                    <th class="rightTop">Contact Data</th>
                                </tr>
                                <tr style="{!item.lawyer.Name != item.con.FirstName ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                    <th><div>First Name</div></th>
                                    <td>
                                        <div>{!item.lawyer.Name}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!item.lawyer.Name != item.con.FirstName}">
                                            <div data-index="{!index}" data-lwField="Name" data-conField="FirstName" onclick="{!c.handleUpdateData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!item.con.FirstName}</div>
                                    </td>
                                </tr>
                                <tr style="{!item.lawyer.Middle_Initial__c != item.con.Middle_Name__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                    <th><div>Middle Name</div></th>
                                    <td>
                                        <div>{!item.lawyer.Middle_Initial__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!item.lawyer.Middle_Initial__c != item.con.Middle_Name__c}">
                                            <div data-index="{!index}" data-lwField="Middle_Initial__c" data-conField="Middle_Name__c" onclick="{!c.handleUpdateData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!item.con.Middle_Name__c}</div>
                                    </td>
                                </tr>
                                <tr style="{!item.lawyer.Last_Name__c != item.con.LastName ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                    <th><div>Last Name</div></th>
                                    <td>
                                        <div>{!item.lawyer.Last_Name__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!item.lawyer.Last_Name__c != item.con.LastName}">
                                            <div data-index="{!index}" data-lwField="Last_Name__c" data-conField="LastName" onclick="{!c.handleUpdateData}">
                                                <lightning:icon class="icon" iconName="utility:forward" size="x-small"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!item.con.LastName}</div>
                                    </td>
                                </tr>
                                <!--<tr style="{!item.lawyer.ISBA_Number__c != item.con.ISBA__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                    <th><div>ISBA #</div></th>
                                    <td>
                                        <div>{!item.lawyer.ISBA_Number__c}</div>
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!item.lawyer.ISBA_Number__c != item.con.ISBA__c}">
                                            <div data-index="{!index}" data-lwField="ISBA_Number__c" data-conField="ISBA__c" onclick="{!c.handleUpdateData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!item.con.ISBA__c}</div>
                                    </td>
                                </tr>-->
