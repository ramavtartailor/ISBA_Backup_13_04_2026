                                            <div data-index="{!index}" data-lwField="Cell_Phone__c" data-conField="MobilePhone" onclick="{!c.handleUpdateData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
