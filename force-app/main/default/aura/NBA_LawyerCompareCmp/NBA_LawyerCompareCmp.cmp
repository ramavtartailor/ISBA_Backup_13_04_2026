                                    <td>
                                        <div>
                                            <lightning:formattedPhone value="{!item.con.MobilePhone}"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr style="{!item.lawyer.Birthday__c != item.con.Birthdate ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
                                    <th><div>Birthdate</div></th>
                                    <td>
                                        <div>
                                            <lightning:formattedDateTime  value="{!item.lawyer.Birthday__c}" year="numeric"
                                                                         month="2-digit" day="2-digit" />
                                        </div>                                                                   
                                    </td>
                                    <td>
                                        <aura:if isTrue="{!item.lawyer.Birthday__c != item.con.Birthdate}">
                                            <div data-index="{!index}" data-lwField="Birthday__c" data-conField="Birthdate" onclick="{!c.handleUpdateData}">
                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>
                                            <lightning:formattedDateTime  value="{!item.con.Birthdate}" year="numeric"
                                                                         month="2-digit" day="2-digit" />
                                        </div>
                                    </td>
                                </tr>
                                <tr style="{!item.lawyer.Firm_Email_Address__c != item.con.Email ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
