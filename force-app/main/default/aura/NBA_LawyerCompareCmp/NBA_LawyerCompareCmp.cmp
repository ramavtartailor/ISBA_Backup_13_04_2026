                                                                         minute="2-digit" hour12="true"/>
                                    </td>
                                    <td>
                                    </td>
                                    <td class="rightBottom">
                                        <lightning:formattedDateTime value="{!item.con.CreatedDate}" year="numeric" month="numeric" day="numeric" hour="2-digit"
                                                                         minute="2-digit" hour12="true"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </aura:if>
                    
                </div>
            </aura:iteration>
            
            <aura:if isTrue="{!v.wrapper.unMatchedLawyers.length > 0}">
                <aura:iteration items="{!v.wrapper.unMatchedLawyers}" var="item" indexVar="index">
                    <div class="Section">
                        <div class="{!(item.lawyer.Contact__c != null) ? 'sectionHeader greenBox' : 'sectionHeader blueBox'}" ><!--class="sectionHeader newLawyer"-->
                            <aura:if isTrue="{!item.isExpended}">
                                <div data-val="false" data-index="{!index}" onclick="{!c.handleExpandUnMatched}">
                                    <lightning:icon variant="inverse" class="icon" iconName="utility:chevrondown" alternativeText="Expand" size="x-small"/>
                                </div>
                                <aura:set attribute="else">
                                    <div data-val="true" data-index="{!index}" onclick="{!c.handleExpandUnMatched}">
                                        <lightning:icon variant="inverse" class="icon" iconName="utility:chevronright" alternativeText="Collapse" size="x-small"/>
                                    </div>
                                </aura:set>
                            </aura:if>
                            <div>
                                {!item.lawyer.ARDC_Number__c} &nbsp; - &nbsp; {!item.fullName}
                            </div>
                        </div>
                        <aura:if isTrue="{!item.isExpended}">
                            <div aura:id="bodySections" class="sectionBody">
                                
                                <table class="nbaTable slds-table_cell-buffer">
                                    <tr>
                                        <th class="leftTop"></th>
                                        <th>
