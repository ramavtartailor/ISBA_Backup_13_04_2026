                                                <lightning:icon iconName="utility:forward" size="x-small" class="icon"/>
                                            </div>
                                        </aura:if>
                                    </td>
                                    <td>
                                        <div>{!item.con.Email}</div>
                                    </td>
                                </tr>
                                <tr style="{!item.lawyer.Personal_Email_Address__c != item.con.Personal_Email__c ? 'background: rgba(235, 51, 16, 0.12);' : ''}">
