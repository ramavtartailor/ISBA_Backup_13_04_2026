<aura:component controller="RetryMatchCtrl"
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader"
    access="global">

    <aura:html tag="style">
        .cuf-content {
        padding: 0 0rem !important;
        }
        .slds-modal__content{
        overflow-y:hidden !important;
        height:unset !important;
        max-height:unset !important;
        }
        .slds-modal__container{
        margin: 0 auto !important;
        width: -webkit-fill-available !important;
        max-width: 30rem !important;
        padding: 0 !important;
        }
    </aura:html>

    <div class="slds-modal__container">
        <div class="slds-modal__header">
            <button class="slds-button slds-button--icon-inverse slds-modal__close" onclick="{!c.closeModal}">
                <lightning:icon iconName="utility:close" size="medium" variant="bare" />
                <span class="slds-assistive-text">Close</span>
            </button>
            <h1 class="slds-text-heading--medium ">Retry Match</h1>
        </div>
        <div class="slds-modal__content body">
            <div style="padding: 1rem;">
                Are You sure you want to Retry Match?
            </div>
        </div>
        <div class="slds-modal__footer foot">
            <lightning:button class="btn" variant="neutral" onclick="{!c.closeModal}" label="Cancel" title="Cancel" />
            <lightning:button class="btn" variant="brand" onclick="{!c.handleSave}" label="Save" title="Save" />
        </div>
    </div>

</aura:component>