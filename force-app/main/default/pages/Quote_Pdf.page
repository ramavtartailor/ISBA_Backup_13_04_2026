<apex:page standardController="Policy_Quote__c" applyBodyTag="false" readOnly="true" renderAs="pdf">
    <apex:stylesheet value="{!$Resource.PolicyDocumentsCSS}" />
    
    <head>
        
        <style type="text/css">
            .table_border { border-collapse: collapse; width: 100%; }
                .table_border, .table_border th, .table_border td { border: 1px solid #ededed; }
                .table_spacing td {
                  padding-left: 7px;
                  padding-top: 3px;
                  padding-bottom: 3px;
            }
            .table_title { 
                    background-color: #89001b;
                    color: white;
                    font-weight: bold;
                    font-size: 12pt;
                    padding-top: 2px !important;
                    padding-bottom: 2px !important;
            }
            .table_head tr th {
                    text-align: center;
                }
          
                .quote_table_head tr th {
                    text-align: left;
                    padding-left: 5px;
                    padding-right: 5px;
                }
          
                #quote_table {
                    font-size: 10pt;
                }
                #quote_table td {
                    padding: 6px;
                }
                #quote_table td:nth-child(1) {
                  text-align: center;
            }
            .cb {
                    height: 9px;
                    width: 9px;
                    border: 1px solid black;
                    float: left;
                    margin-top: 2px;
                    margin-right: 4px;
             }
        </style>

    </head> 
    
    
    <body>
        
        <div class="header">
          <c:Application_Header />    
        </div>
        
        <div class="footer" style="width:100%">
            <div style="width:80%;float:left">
                <div style="display: none; width:45%; float:left">
                    <p class=" normalParagraph">
                        ISBA Mutual Insurance Company<br/>
                        20 S Clark St, Suite 800<br/>
                        Chicago IL 60603-1826
                    </p>
                </div>
            </div>
            <div style="width:20%;float:right">
                <p style="text-align:right;" class="normalParagraph">
                    Page&nbsp;<span class="pagenumber" />&nbsp;of&nbsp;<span class="pagecount" />
                </p>
            </div>
        </div>  
        <div class="content">
            <c:Quote_Template recordIdParam="{!Policy_Quote__c.id}"/>
        </div>
    </body>
</apex:page>