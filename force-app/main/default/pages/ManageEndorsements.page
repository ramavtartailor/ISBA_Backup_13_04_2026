<apex:page standardController="Policy_Endorsement__c" extensions="ManageEndorsementsExt" sidebar="false" showHeader="false" id="pg">
    <apex:slds />
    <html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" lang="en">
        <head>
            <script src="{!URLFOR($Resource.LightningPlugin, '/jquery.min.js')}">
            </script>
            <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css"/>
            <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js">
            </script>
            <script>
            function showError(error){
                $(".slds-notify_container h2").each(function() {
                    $(this).text(error);
                });
                $(".slds-notify_container").removeClass('slds-hide');
                setTimeout(function() {
                    $(".slds-notify_container").addClass('slds-hide');
                }, 5000);
            }
            function  removeEndorsement(index,endorsementId){
                $('[id$=spinner]').css('display','block');
                removeEndorsements(index,endorsementId);
            }
            function removeEndorsementFromList(index){
                var $carousel = $('#myCarousel');
                var ActiveElement = $carousel.find('.item.active');
                ActiveElement.remove();
                var NextElement = $carousel.find('.item').first();
                NextElement.addClass('active');
                ActiveElement = $carousel.find('.listIndicator.active');
                ActiveElement.remove();
                NextElement = $carousel.find('.listIndicator').first();
                NextElement.addClass('active');
                $('[id$=spinner]').css('display','none');
            }    
            </script>
            <style>
                .slds-scope .slds-grid--pull-padded {
                margin-right:0px !important;
                margin-left:0px !important;
                }
                .slds-scope .slds-form--horizontal {
                margin-top: 1%;
                }
                .dateFormat {
                padding: 0 2px;
                display: none;
                }
                .slds-scope .slds-page-header {
                padding: 1rem .75rem;
                border-bottom: 1px solid #d8dde6 !important;
                background-color: #337AB7 !important;
                color: white;
                }
                .slds-box{
                }
                .slds-scope .slds-medium-size--12-of-12 {
                margin-bottom: 10px;
                }
                .slds-scope .slds-medium-size--6-of-12 {
                margin-bottom: 10px;
                }
                .accountRequired{
                border-left: 4px solid red !important;
                }
                .slds-scope .slds-table td, .slds-scope .slds-table th {
                white-space: normal !important;
                }
                .slds-scope .slds-text-heading--label {
                text-transform: capitalize !important; 
                }
                .policy_required{
                border-left: 4px solid red !important;
                }
                .ContactRequired{
                border-left: 4px solid red !important;
                }
                .endorsementRequired{
                border-left: 4px solid red !important;
                }            
                .application_required{
                border-left: 4px solid red !important;
                }
                .slds-scope a:focus, .slds-scope a:hover{
                display: initial !important;
                }
                .lookupInput .slds-input{
                //border:none !important;
                }
                .slds-scope .slds-input:read-only:focus, .slds-scope .slds-input:read-only:hover{
                background-color: #fff; 
                }
                .lookupInput input[readonly] {
                cursor: default;
                color: #333;
                background-color: #fff !important;
                border: 1px solid #d8dde6 !important;
                }
                .datePicker{
                z-index: 99999 ;
                }
                input[class*="lookupFieldIcon"] {
                border: 1px solid rgb(221, 219, 218);
                border-radius: .25rem;
                display: inline-block;
                padding: 0 1rem 0 .75rem;
                min-height: calc(1.875rem + (1px * 2));
                }
                .carousel-indicators {
                top: 20px;
                z-index:0!important;
                width:auto !important;
                position: static !important;
                }
                
                .carousel-indicators-numbers .active {
                color: white;
                font-weight: bold;
                border-color: white;
                box-shadow: rgba(0, 137, 207, 1) 0px 0px 0px 50px inset;
                }
                
                .carousel-indicators-numbers li {
                text-indent: 0;
                margin: 0 2px;
                width: 70px;
                height: 30px;
                border: none;
                border-radius: 100%;
                line-height: 30px;
                font-weight: bold;
                color: #fff;
                background-color: #999;
                transition: all 0.25s ease;
                }
                .carousel-indicators-numbers li.active, .carousel-indicators-numbers li:hover {
                margin: 0 2px;
                width: 70px;
                height: 30px;
                background-color: rgba(0, 137, 207, 1);
                }
                .neutralButton{
                padding-left: 1rem;
                padding-right: 1rem;
                text-align: center;
                vertical-align: middle;
                justify-content: center;
                border: 1px solid rgb(221, 219, 218);
                transition: border .15s linear;
                border-color: rgb(221, 219, 218);
                background-color: rgb(255, 255, 255);
                }
                .normalButton{
                position: relative;
                display: inline-flex;
                align-items: center;
                padding: 0;
                background: transparent;
                background-clip: border-box;
                border: 1px solid transparent;
                border-radius: .25rem;
                line-height: 1.875rem;
                text-decoration: none;
                color: rgba(27, 82, 151, 1);
                -webkit-appearance: none;
                white-space: normal;
                user-select: none;
                }
            </style>
        </head>
        <body style="font-size: 16px !important;">
        <apex:form >
            <apex:actionFunction name="addEndorsement" action="{!addEndorsementFunc}" oncomplete="addNewEndorsement();" reRender="scriptPanel"/>
            <apex:actionFunction name="removeEndorsements" action="{!removeEndorsementFunc}" oncomplete="removeAddedEndorsement();" reRender="scriptPanel">
                <apex:param assignTo="{!index}" name="indexEndorsement" value=""/>
                <apex:param assignTo="{!endorsementId}" name="idEndorsement" value=""/>
            </apex:actionFunction>
            <apex:outputPanel id="scriptPanel">
                <script>
                	function addNewEndorsement(){
                        if('{!error}' != '' && '{!error}' != null && '{!error}' != 'undefined'){
                            showError('{!error}');
                        } else if('{!newURL}' != '' && '{!newURL}' != null && '{!newURL}' != 'undefined'){
                            var items = document.getElementsByClassName('item');
                            var indicators = document.getElementsByClassName('listIndicator');
                            for (i = 0; i < items.length; i++) {
                                items[i].classList.remove('active');
                            }    
                            for (i = 0; i < indicators.length; i++) {
                                indicators[i].classList.remove('active');
                            }  
                            document.getElementById('orderedList').innerHTML =  document.getElementById('orderedList').innerHTML + '<li data-target="#myCarousel" data-slide-to="{!currentNumber}" class="listIndicator active">&nbsp;{!newName}&nbsp;</li>';
                            document.getElementById('itemListDiv').innerHTML =  document.getElementById('itemListDiv').innerHTML + '<div class="item active"><apex:iframe scrolling="true" src="{!newURL}"/></div>';
                        }    
                        $('[id$=spinner]').css('display','none');
                    } 
                    function removeAddedEndorsement(){
                        if('{!error}' != '' && '{!error}' != null && '{!error}' != 'undefined'){
                            showError('{!error}');
                            $('[id$=spinner]').css('display','none');
                        }else{
                            removeEndorsementFromList('{!index}');
                        }
                    }    
                </script>
            </apex:outputPanel>
            <div class="slds-page-header" role="banner">
                <div class="slds-media">
                    <div class="slds-media__body">
                        <p class="slds-page-header__title slds-truncate" title="Application And Policy" style="font-size: 20px !important;">
                            {!currentApplication.Account__r.Name} - {!currentApplication.Name} - <apex:outputText value="{0,date, MM/dd/yyyy}"> <apex:param value="{!currentApplication.Expiration_Date__c}" /> </apex:outputText>
                        </p>
                        <p class="slds-text-body--small"></p>
                    </div>
                    <ul class="slds-global-header__item slds-grid slds-grid--vertical-align-center">
                        <li class="slds-dropdown-trigger slds-dropdown-trigger--click slds-p-horizontal--xxx-small">
                            <!--<a href="javascript:void(0);" class="slds-has-blur-focus">Home</a>-->
                        </li>
                    </ul>
                </div>
            </div>
            <div class="slds-spinner_container" id="spinner" style="display:none;position: fixed;">
                <div class="slds-spinner--brand slds-spinner slds-spinner--medium" aria-hidden="false" role="alert" style="    position: fixed;">
                    <div class="slds-spinner__dot-a"></div>
                    <div class="slds-spinner__dot-b"></div>
                </div>
            </div>
            <div class="slds-notify_container slds-hide">
                <div class="slds-notify slds-notify--toast slds-theme--error" role="alert">
                    <span class="slds-assistive-text">Warning</span>
                    <button class="slds-button slds-notify__close slds-button--icon-inverse" title="Close">
                        <svg class="slds-button__icon slds-button__icon--large" aria-hidden="true" onclick="return false;" data="msg">
                            <use xlink:href="{!URLFOR($Asset.SLDS,'/assets/icons/utility-sprite/svg/symbols.svg#close')}"></use>
                        </svg>
                        <span class="slds-assistive-text">Close</span>
                    </button>
                    <div class="slds-notify__content">
                        <h2 class="slds-text-heading--small"></h2>
                    </div>
                </div>
            </div>
            <fieldset class="slds-box slds-theme--default  slds-m-around--small" style="margin-bottom: 55px;">
                <legend id="" class="slds-text-heading--small legend"></legend>
                <div class="slds-grid slds-wrap slds-grid--pull-padded filter" id="endorsementInfoDiv">
                    <div class="slds-p-horizontal--small slds-size--1-of-1 slds-medium-size--12-of-12 slds-large-size--12-of-12 slds-box" style="padding:0px;">
                        <div class="slds-grid slds-wrap slds-grid--pull-padded">
                            <div class="slds-size--12-of-12  slds-theme--shade">
                                <h2 style="background-color: #337AB7;color:white;font-size: 18px;" class="slds-section-title slds-theme--shade slds-p-left--small">Add Endorsement</h2>
                            </div>
                            <div class="slds-p-horizontal--small slds-size--1-of-1 slds-medium-size--12-of-12 slds-large-size--12-of-12">
                                <br/>
                                <div class="form-group">
                                    <label for="sel1">Select Endorsement Type:</label>
                                    <apex:selectList label="Record Type of new record" value="{!recordTypeId}" multiselect="false" size="1" styleClass="form-control">
                                        <div class="requiredInput">
                                            <div class="requiredBlock requiredLine"></div>
                                        </div>
                                        <apex:selectOptions value="{!recordTypeNames}"/>  
                                    </apex:selectList>
                                </div>
                                <div style="display: flex;align-items: center;justify-content: center;">
                                    <button type="button" class="slds-button slds-button--brand" onclick="$('[id$=spinner]').css('display','block');addEndorsement();return false;" style="padding-left: 2rem;padding-right: 2rem;padding-top: 5px;padding-bottom: 5px;">Add Endorsement</button>
                                    <button type="button" class="slds-button slds-button--neutral" onclick="$('[id$=spinner]').css('display','block');window.location.href='{!returnURL}'" style="padding-left: 2rem;padding-right: 2rem;padding-top: 5px;padding-bottom: 5px;">Close</button>
                                </div>
                            </div>
                            <div class="slds-size--12-of-12  slds-theme--shade">
                                <h2 style="background-color: #337AB7;color:white;font-size: 18px;min-height: 3px;" class="slds-section-title slds-theme--shade slds-p-left--small"></h2>
                            </div>
                            <div class="slds-p-horizontal--small slds-size--1-of-1 slds-medium-size--12-of-12 slds-large-size--12-of-12">
                                <div id="myCarousel" class="carousel slide" style="padding: 30px;padding-top: 10px !important;">
                                    <!-- Indicators -->
                                    <br/>
                                    <ol class="carousel-indicators carousel-indicators-numbers" id="orderedList">
                                        <apex:variable value="{!0}" var="index"/>
                                        <apex:repeat value="{!endorsementWrapper}" var="endorsement">
                                            <li data-target="#myCarousel" data-slide-to="{!index}" class="listIndicator {!if(index == 0 ,'active','')}" >&nbsp;{!endorsement.endorsementNumber}&nbsp;</li>
                                            <apex:variable value="{!index+1}" var="index"/>
                                        </apex:repeat>
                                        
                                    </ol>
                                    <br/>
                                    <!-- Wrapper for slides -->
                                    <div class="carousel-inner" role="listbox" style="border: #337AB7;border-style: solid;" id="itemListDiv">
                                        
                                        <apex:variable value="{!0}" var="index"/>
                                        <apex:repeat value="{!endorsementWrapper}" var="endorsement">
                                            <div class="item {!if(index == 0 ,'active','')}">
                                                <apex:iframe scrolling="true" src="{!endorsement.url}"/>
                                            </div>
                                            <apex:variable value="{!index+1}" var="index"/>
                                        </apex:repeat>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
            <!--<div class="slds-docked-form-footer">
                <button type="button" class="slds-button slds-button--neutral" onclick="window.location.href='{!returnURL}'">Close</button>
            </div>-->
        </apex:form>
        </body>
    </html>
</apex:page>