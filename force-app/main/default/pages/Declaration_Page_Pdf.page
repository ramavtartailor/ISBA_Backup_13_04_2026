<apex:page standardController="Policy__c" applyBodyTag="false" readOnly="true" renderAs="pdf">
    <apex:stylesheet value="{!$Resource.PolicyDocumentsCSS}" />
    <body>
        <div class="header" style="margin-top:50px;">
            <c:PolicyHeader recordIdParam="{!Policy__c.id}"/>
        </div>
        <div class="footer" style="width:100%">
            <div style="width:50%;float:left">
                <p class="normalParagraph">
                    <apex:outputPanel rendered="{!IF($CurrentPage.parameters.version == '1/15',true,false)}">
                        Dec 10/2015
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!IF($CurrentPage.parameters.version == '1/23',true,false)}">
                        ISBAMIC Dec 01 2023
                    </apex:outputPanel>
                    
                </p>
            </div>
            <div style="width:50%;float:right">
                <p style="text-align:right;" class="normalParagraph">
                    Page&nbsp;<span class="pagenumber" />&nbsp;of&nbsp;<span class="pagecount" />
                </p>
            </div>
        </div>  
        <div class="content">
            <apex:outputPanel rendered="{!IF($CurrentPage.parameters.version == '1/15',true,false)}">
                <c:Declaration_Page_Template recordIdParam="{!Policy__c.id}"/>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!IF($CurrentPage.parameters.version == '1/18',true,false)}">
                <c:Declaration_Page_Template_1_18 recordIdParam="{!Policy__c.id}"/>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!IF(OR($CurrentPage.parameters.version == '1/23',$CurrentPage.parameters.version == '4/26'),true,false)}">
                <c:Declaration_Page_Template_1_23 recordIdParam="{!Policy__c.id}"/>
            </apex:outputPanel>
        </div>
    </body>
</apex:page>