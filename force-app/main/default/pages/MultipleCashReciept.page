                                                                        <apex:param value="{!bill.billingDate}" /> 
                                                                    </apex:outputText>
                                                                </center>
                                                            </div>
                                                        </td>
                                                        <td scope="row" data-label="ASTransactionDescription" width="25%" align="center">
                                                            <div class="slds-form-element__control">
                                                                <center> <apex:outputText id="ASTransactionDescription" value="{!bill.ASTransactionDescription}"></apex:outputText></center>
                                                            </div>
                                                        </td>
                                                        <td scope="row" data-label="policyNumber"  align="center">
                                                            <div class="slds-form-element__control">
                                                                <center> <apex:outputText id="policyNumber" value="{!bill.policyNumber}"></apex:outputText></center>
                                                            </div>
                                                        </td>
                                                        <td scope="row" data-label="claimNumber"  align="center">
                                                            <div class="slds-form-element__control">
                                                                <center> <apex:outputText id="claimNumber" value="{!bill.claimNumber}"></apex:outputText></center>
                                                            </div>
                                                        </td>
                                                        <td scope="row" data-label="Customer" align="center" padding-left="">
                                                            <div class="slds-form-element__control">
                                                                <center> $<apex:outputText id="balanceOriginal" value="{!bill.balanceOriginal}"></apex:outputText></center>
                                                            </div>
                                                        </td>
                                                        <td scope="row" data-label="Customer"  align="center" padding-left="">
                                                            <div class="slds-form-element__control">
                                                                <center> <apex:inputText id="balance" value="{!bill.Balance}" styleclass="slds-input required-symbol balance{!bill.billName}{!rownum} {!if(wrp.billingList.size == 1,'balanceChecked','')}{!rownum}" onchange="balanceChange({!bill.balanceOriginal},$(this).val(),{!bill.billName});selectedCheck({!rownum});"></apex:inputText></center>
                                                                <span class="slds-hide errorBalance{!bill.billName} " style="padding: 20px;color: red;"><b>Applied Amount must be less than or equal to balance.</b></span>
                                                
                                                            </div>
                                                        </td>
                                                        </tr>
                                                        </apex:repeat>
                                                        <tr>
                                                            <td></td>
                                                            <td></td>
                                                            <td><div class="slds-form-element__control"><b>Total Selected Amount</b></div></td>
                                                            <td colspan = "5">
                                                                <div class="slds-form-element__control">
                                                                    <b>$<span class="totalSelectedAmount{!rownum}">{!if(wrp.billingList.size == 1,wrp.amount,'0')}</span></b>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                                </apex:outputPanel>
                                                
                                                <apex:outputPanel rendered="{!wrp.ServiceFee != ''}" style="width:100%;padding: 20px;"><b>Service Fee: </b>{!wrp.ServiceFee}<br/></apex:outputPanel>
                                                
                                            </div>
                                            <footer class="slds-modal__footer">
                                                <button type="button" class="slds-button slds-button_neutral slds-grow disableButtons" onclick="closeApplyCR('{!rownum}');">Cancel</button>
                                                <button type="button" class="slds-button slds-button_brand slds-grow disableButtons" onclick="SaveApplyCR('{!rownum}');">Save</button>
                                            </footer>
                                        </div>
                                    </section>
                                    <div class="slds-backdrop slds-backdrop_open"></div>
                                </div>
                                </td>
                                
                            </tr>
                        </apex:repeat>  
                    </tbody>
                </table>  
                
                <br/>
                <center>
                    <button type="button" class="slds-button slds-button--neutral slds-grow" id="submitButtonId" onclick="checkRequiredFields()">Submit</button>
                    <button type="button" class="slds-button slds-button--neutral slds-grow" id="cancelButtonId" onclick="redirectToHome();">Cancel</button>
                </center>
                   <apex:outputPanel rendered="{!!isManualEntry}">
                       <b>Rows already processed : </b> {!alreadyProcessed}<br/>
                       <b>Rows shows : </b> {!totalShows}<br/>
                       <b>Rows left to process :  </b> {!leftToProcess}<br/>
                   </apex:outputPanel>
               </apex:outputPanel>
               
               
                <apex:actionStatus id="spinner">
                    <apex:facet name="start">
                        <div id="assign-action-spinner-main">
                            <div id="assign-action-spinner-content">
                                <img src="/img/analytics/reportbuilder/icons/spinner32.gif" 
                                     alt="Processing..." title="Processing..." /> 
                                <p>Processing...</p>
                            </div>
                        </div>
                    </apex:facet>
                </apex:actionStatus>
                
              <!--  <apex:actionRegion >-->
                <apex:actionFunction name="callAddRow" action="{!addRow}" rerender="mainForm" status="spinner">
                    <apex:param value="" name="rowno"/>
                </apex:actionFunction>
                <apex:actionFunction name="callSubmit" action="{!submit}" rerender="errorPanel" status="spinner" />
                <apex:actionFunction name="removeRowMethod" action="{!removeRow}" rerender="mainForm" status="spinner">
                    <apex:param value="" name="listIndex"/>
                </apex:actionFunction>
                
                <apex:actionFunction name="ProcessedFile" action="{!ProcessFile}" rerender="mainForm" status="spinner" >
                    <apex:param value="" name="file"/>
                </apex:actionFunction>
                
                <apex:actionFunction name="ChangeAccount" action="{!onChangeAccount}" reRender="mainForm,balance,amount,innerTable,errorPanel" status="spinner">
                    <apex:param value="" name="rowno"/>
                    <apex:param value="" name="AccountId"/>
                </apex:actionFunction>
                
                <apex:actionFunction name="ChangeCrRef" action="{!crReference}" rerender="mainForm" status="spinner">
                    <apex:param value="" name="listIndex"/>
                </apex:actionFunction>
                
          <!--      </apex:actionRegion>-->
            </body></apex:form>
        
    </apex:page>