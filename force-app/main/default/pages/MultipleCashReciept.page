<script>
    function check(lookup){
    
    $('input[id$=' + lookup + ']').val('');
    $('.' + lookup + 'Value').val('');
    $('input[class$=' + lookup + 'Name]').val('');
    $('[id$=' + lookup + 'Label]').text('');
    $('[id$=' + lookup + 'Search]').removeClass('slds-hide');
    $('[id$=' + lookup + 'LabelDiv]').addClass('slds-hide');
    
    
    
}


$('body').click(function(evt) {
    $(".closeDiv :visible").each(function() {
        $('.closeDiv').hide();
    });
});

function search(lookName,listIndex) {
    try {
        $('input[id$=' + lookName + ']').css('background', 'url("http://www.hsi.com.hk/HSI-Net/pages/images/en/share/ajax-loader.gif") no-repeat right center');
        var key = $('input[id$=' + lookName + ']').val();
        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.MultipleCashRecieptExt.getLookupRecord}',
            key,
            function(result, event) {
                if (result != null) {
                    if (event.status) {
                        var tables = "<ul class='slds-lookup__list' role='listbox'>  ";
                        var check = true;
                        
                        for (var i = 0; i < result.length; i++) {
                            //alert(result[i].Name);
                            tables += "<li role='presentation' onclick=\"fillRecord( '" + lookName + "','" + result[i].Id + "','" + result[i].Name.replace("&#39;", "\\'") +  "','"+ listIndex  +  "','"+ result[i].AccountNumber + "')\"><span class='slds-lookup__item-action slds-media' id='lookup-option-483' role='option'><div class='slds-media__body'><div class='slds-lookup__result-text'>" +  result[i].AccountNumber+ ' - ' + result[i].Name + "</div></div></span></li>";
                        }
                        tables += "</ul>";
                        if (result.length > 0) {
                            
                            tables = "<div class='slds-lookup__item--label slds-text-body--small'></div>" + tables;
                        } else {
                            check = false;
                            tables = "<div class='slds-lookup__item--label slds-text-body--small'>No record found .</div>";
                        }
                        document.getElementById(lookName + "SrchDrpDwn").innerHTML = tables;
                        $('[id$=' + lookName + 'SrchDrpDwn]').show();
                        
                        if(check){
                            $('[id$=' + lookName + 'SrchDrpDwn]').focus();
                        }
                        
                    } else if (event.type === 'exception') {
                        
                    } else {
                        
                    }
                    $('input[id$=' + lookName + ']').css('background', 'none');
                } else {
                    $('input[id$=' + lookName + ']').css('background', 'none');
                }
            }, {
                escape: true
            }
        );
    } catch (e) {
        alert('An Error has Occured. Error:' + e);
    }
    
}

function fillRecord(lookup, id, name,listIndex,AccNum) {

    ChangeAccount(listIndex,id);
    $('[id$=' + lookup + 'SrchDrpDwn]').hide();
    $('.' + lookup + 'Value').val(id);
    
    $('input[class$=' + lookup + 'Name]').val(AccNum+' - '+name);
   // $('.' + lookup + 'Value').change();
    
    $('[id$=' + lookup + 'Label]').text(AccNum+' - '+name);
    $('[id$=' + lookup + 'Search]').addClass('slds-hide');
    $('[id$=' + lookup + 'LabelDiv]').removeClass('slds-hide');
    
    }


function checkRequiredFields() {
    var requiredItems = document.getElementsByClassName('required-symbol');
    var showError = false;
    for(var i = 0; i < requiredItems.length; i++){
        if(!requiredItems[i].value){
            showError = true;
            break;
        }
    }
    if(showError == false){
        var requiredItem = document.getElementsByClassName('amountf');
        if(!requiredItem[0].value || requiredItem[0].value == 0){
            showError = true;
        }
    }
    if(showError){
        document.getElementById("errorMsg").style.display = "block";
        document.getElementById("dynamicError").innerHTML = 'Please Fill all Required Fields.';
    }else if(!showError){
        document.getElementById("errorMsg").style.display = "none";
        
        callSubmit();
    }
}

function redirectToHome(){
    window.location.href = '/home/home.jsp';
}

function DynamicDatePicker(d_id)

{
    
    DatePicker.pickDate(false,d_id.id,false);
    
}

function ApplyCR(indx){
    $('.apply'+indx).removeClass('slds-hide');
}
function closeApplyCR(indx){
    $('.apply'+indx).addClass('slds-hide');
}
function SaveApplyCR(indx){
    var bal = 0;
    var isNotError = true;
    $('.balanceChecked'+indx).each(function(i,e){
        bal += Number($(e).val());
    });
    $('.errorBal'+indx).each(function(i,e){
        isNotError = false;
    });
    if(Number($('.amount'+indx).val()) == bal && isNotError == true){
        $('.apply'+indx).addClass('slds-hide');
        $('.error'+indx).addClass('slds-hide');
        $('.rwClass'+indx).addClass('highlightBlueClass');
        $('.rwClass'+indx).removeClass('highlightOrangeClass');
    }else{
        $('.error'+indx).removeClass('slds-hide');        
    }
}

function balanceChange(total,balance,indx){
    if(Number(total)-Number(balance) >= 0){
        $('.errorBalance'+indx).addClass('slds-hide');
        $('.errorBalance'+indx).removeClass('errorBal'+indx);
    }else{
        $('.errorBalance'+indx).removeClass('slds-hide');
        $('.errorBalance'+indx).addClass('errorBal'+indx);
    }
}

function selectedCheck(indx){
   var bal = 0;
   $('.balanceChecked'+indx).each(function(i,e){
        bal += Number($(e).val());
    });
    $('.totalSelectedAmount'+indx).html(bal);
    
    if(bal == Number($('.amount'+indx).val())){
        $('.rwClass'+indx).removeClass('highlightClass');
    }else{
        $('.rwClass'+indx).addClass('highlightClass');
    }
}


function ProcessFile(){
    var readFile= document.getElementById("fileId").files[0];
    
    console.log(readFile);
    var reader = new FileReader();
    if(readFile == undefined){
        return ;
    }else{
        reader.readAsText(readFile);
        reader.onload = attLoaded;
    }
}
function attLoaded(evt) {  
    var fileString = evt.target.result;
    var extension;
    var input = document.getElementById("fileId");
    filename= input.value;
    extension = filename.substring(filename.lastIndexOf(".") + 1, filename.length).toLowerCase();
    if(extension !='csv'){
        document.getElementById("errorMsg").style.display = "block";
        document.getElementById("dynamicError").innerHTML = 'File can only be csv format.';        
    }else{
        document.getElementById("errorMsg").style.display = "none";
        ProcessedFile(fileString);
   }
} 
 
