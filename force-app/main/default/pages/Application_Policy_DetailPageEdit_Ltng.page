                </apex:outputPanel>
                <apex:actionFunction name="saveApplication_Policy" action="{!saveApplication_Policy}" reRender="renderError" oncomplete="$('[id$=spinner]').css('display','none');"/>
                <apex:actionFunction name="saveAndNextApplication_Policy" action="{!saveAndNextApplication_Policy}" reRender="renderError" oncomplete="$('[id$=spinner]').css('display','none');"/>
                
               
