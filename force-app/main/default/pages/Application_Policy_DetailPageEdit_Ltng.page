                                                <apex:panelGroup rendered="{!IF(AND(!application_policy[modVar.fsmOverride.fieldPath],!CONTAINS($User.Id,'005G00000083Xpu'),!CONTAINS($User.Id,'005A0000000QvuP')), true,false)}">
                                                    <apex:inputField rendered="{!IF(AND(!application_policy[modVar.fsmOverride.fieldPath],!CONTAINS($User.Id,'005G00000083Xpu'),!CONTAINS($User.Id,'005A0000000QvuP')), true,false)}" required="false" onchange="setCommentVal(this,'{!index}-commentGM')" value="{!application_policy[modVar.fsmComment.fieldPath]}" style="width:100%;height:20px;" styleClass="slds-input slds-size_1-of-1 comment" html-placeholder="Add Comment" html-min="-5" html-max="10" />                                               
                                                </apex:panelGroup>
                                                <apex:panelGroup rendered="{!IF(AND(application_policy[modVar.fsmOverride.fieldPath],!CONTAINS($User.Id,'005G00000083Xpu'),!CONTAINS($User.Id,'005A0000000QvuP')), true,false)}">
                                                    <apex:inputField html-disabled="true" rendered="{!IF(OR(CONTAINS($User.Id,'005G00000083Xpu'),CONTAINS($User.Id,'005A0000000QvuP')),false, true)}" value="{!application_policy[modVar.fsmComment.fieldPath]}" style="width:100%;height:20px;" styleClass="slds-input slds-size_1-of-1 comment" html-placeholder="Add Comment" html-min="-5" html-max="10" />                                               
                                                </apex:panelGroup>
                                                <apex:panelGroup rendered="{!IF(OR(CONTAINS($User.Id,'005G00000083Xpu'),CONTAINS($User.Id,'005A0000000QvuP')),true,false)}">
                                                    <apex:inputField required="false" rendered="{!IF(OR(CONTAINS($User.Id,'005G00000083Xpu'),CONTAINS($User.Id,'005A0000000QvuP')),true,false)}" onchange="setCommentVal(this,'{!index}-commentGM')" value="{!application_policy[modVar.fsmComment.fieldPath]}" style="width:100%;height:20px;" styleClass="slds-input slds-size_1-of-1 comment" html-placeholder="Add Comment" html-min="-5" html-max="10" />   
                                                </apex:panelGroup>
                                                <apex:inputField styleClass="comment" value="{!application_policy[modVar.fsmComment.fieldPath]}" style="display:none;" />
                                            </div>                   
                                        </div>
                                        <apex:variable value="{!index + 1}" var="index"/>
                                        <br/>
