                                <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="/assets/icons/utility-sprite/svg/symbols.svg#switch" />
                                </svg>
                                <span class="slds-truncate" title="Section Title">Schedule Modifiers - Override (needs Approval):</span>
                                </p>
                                </h3>
                            </div>
                            
                            <div class="slds-form slds-form_horizontal">
                                <div class="slds-form-element">
                                    <apex:variable value="{!0}" var="index"/>
                                    
                                    <apex:repeat value="{!allModFieldsOver}" var="modVar">
                                    
                                        <label class="slds-form-element__label">
                                            <apex:outputLabel value="{!modVar.label}" style="font-weight:bold;font-size:13px;" />
                                        </label>
                                        <div class="slds-form-element__control">
                                            <div id="{!index}-actualModOver" >
                                                <apex:panelGroup rendered="{!IF(modVar.label == 'General Override', true,false)}">
                                                    <apex:inputField html-disabled="{!IF(OR(CONTAINS($User.Id,'005G00000083Xpu'),CONTAINS($User.Id,'005A0000000QvuP')),false,true)}" rendered="{!IF(AND(!CONTAINS($User.Id,'005G00000083Xpu'),!CONTAINS($User.Id,'005A0000000QvuP')), true,false)}" value="{!application_policy[modVar.fsmModVal.fieldPath]}" styleClass="slds-input slds-size_1-of-6 actualMod"  />
                                                    <apex:inputField rendered="{!IF(OR(CONTAINS($User.Id,'005G00000083Xpu'),CONTAINS($User.Id,'005A0000000QvuP')), true,false)}" required="false" value="{!application_policy[modVar.fsmModVal.fieldPath]}" onchange="displayComment(this, '{!index}-actualModOver', '{!index}-commentOver', '{!index}-checkOver', '{!modVar.label}')" styleClass="slds-input slds-size_1-of-6 actualMod" html-min="-5" html-max="10" />
                                                </apex:panelGroup>
                                                <apex:panelGroup rendered="{!IF(AND(modVar.label != 'General Override', OR(CONTAINS($User.Id,'005G00000083Xpu'),CONTAINS($User.Id,'005A0000000QvuP'))), true,false)}">
                                                    <apex:inputField required="false" value="{!application_policy[modVar.fsmModVal.fieldPath]}" onchange="displayComment(this, '{!index}-actualModOver', '{!index}-commentOver', '{!index}-checkOver', '{!modVar.label}')" styleClass="slds-input slds-size_1-of-6 actualMod" html-min="-5" html-max="10" />                                                
                                                </apex:panelGroup>
                                                <apex:panelGroup rendered="{!IF(AND(modVar.label != 'General Override', !CONTAINS($User.Id,'005G00000083Xpu'),!CONTAINS($User.Id,'005A0000000QvuP')), true,false)}">
                                                    <apex:inputField html-disabled="true" rendered="{!application_policy[modVar.fsmOverride.fieldPath]}" value="{!application_policy[modVar.fsmModVal.fieldPath]}" styleClass="slds-input slds-size_1-of-6 actualMod"  />
                                                    <apex:inputField required="false" rendered="{!!application_policy[modVar.fsmOverride.fieldPath]}" value="{!application_policy[modVar.fsmModVal.fieldPath]}" onchange="displayComment(this, '{!index}-actualModOver', '{!index}-commentOver', '{!index}-checkOver', '{!modVar.label}')" styleClass="slds-input slds-size_1-of-6 actualMod" html-min="-5" html-max="10" />                                                
                                                </apex:panelGroup>
                                            </div>
                                            <div id="{!index}-checkOver" >
                                                <apex:inputCheckbox disabled="{!IF(OR(CONTAINS($User.Id,'005G00000083Xpu'),CONTAINS($User.Id,'005A0000000QvuP')), false,true)}"  label="override" value="{!application_policy[modVar.fsmOverride.fieldPath]}" onchange="overrideMods(this, '{!index}-actualModOver', '{!index}-commentOver', '{!index}-checkOver', '{!modVar.label}')" style="position: absolute;width: 1.5%;margin-left:12%;margin-right: 10%;margin-top: -30px;" styleClass="slds-input slds-size_1-of-4 isModOverride" />  
                                                <apex:inputField styleClass="overrider" value="{!application_policy[modVar.fsmOverride.fieldPath]}" style="display:none;" />
                                            </div>
                                            <div id="{!index}-commentOver" style="{!IF(application_policy[modVar.fsmComment.fieldPath] != null,'width:43%;position: absolute;margin-left: 15%;margin-top: -30px;' ,'display:none;width:43%;position: absolute;margin-left: 15%;margin-top: -30px;')}">
                                                <apex:panelGroup rendered="{!IF(AND(!application_policy[modVar.fsmOverride.fieldPath],!CONTAINS($User.Id,'005G00000083Xpu'),!CONTAINS($User.Id,'005A0000000QvuP')), true,false)}">
                                                    <apex:inputField rendered="{!IF(AND(!application_policy[modVar.fsmOverride.fieldPath],!CONTAINS($User.Id,'005G00000083Xpu'),!CONTAINS($User.Id,'005A0000000QvuP')), true,false)}" required="false" onchange="setCommentVal(this,'{!index}-commentOver')" value="{!application_policy[modVar.fsmComment.fieldPath]}" style="width:100%;height:20px;" styleClass="slds-input slds-size_1-of-1 comment" html-placeholder="Add Comment" html-min="-5" html-max="10" />                                               
                                                </apex:panelGroup>
                                                <apex:panelGroup rendered="{!IF(AND(application_policy[modVar.fsmOverride.fieldPath],!CONTAINS($User.Id,'005G00000083Xpu'),!CONTAINS($User.Id,'005A0000000QvuP')), true,false)}">
                                                    <apex:inputField html-disabled="true" value="{!application_policy[modVar.fsmComment.fieldPath]}" style="width:100%;height:20px;" styleClass="slds-input slds-size_1-of-1 comment" html-placeholder="Add Comment" html-min="-5" html-max="10" />                                               
                                                </apex:panelGroup>
                                                <apex:panelGroup rendered="{!IF(OR(CONTAINS($User.Id,'005G00000083Xpu'),CONTAINS($User.Id,'005A0000000QvuP')),true,false)}">
                                                    <apex:inputField required="false" rendered="{!IF(OR(CONTAINS($User.Id,'005G00000083Xpu'),CONTAINS($User.Id,'005A0000000QvuP')),true,false)}" onchange="setCommentVal(this,'{!index}-commentOver')" value="{!application_policy[modVar.fsmComment.fieldPath]}" style="width:100%;height:20px;" styleClass="slds-input slds-size_1-of-1 comment" html-placeholder="Add Comment" html-min="-5" html-max="10" />   
                                                </apex:panelGroup>
                                                <apex:inputField styleClass="comment" value="{!application_policy[modVar.fsmComment.fieldPath]}" style="display:none;" />
                                            </div>                   
                                        </div>
                                        <apex:variable value="{!index + 1}" var="index"/>
                                        <br/>
                                    </apex:repeat>
                                </div>
                            </div>
                            <!-- End Override Mods -->
                            
                        </p>
                      </div>
                      <footer class="slds-modal__footer slds-modal__footer_directional">
                          <button type="button" class="slds-button slds-button--neutral" onclick="clearModal()">Clear</button>
                          <button type="button" class="slds-button slds-button--neutral" onclick="toggleModal()">Cancel</button>
                          <button id="saveSCH" type="button" class="slds-button slds-button_brand" onclick="toggleModalOk()">Save</button>
                          <!--<apex:commandButton styleClass="slds-button slds-button_brand" value="Save" onclick="toggleModalOk()" reRender="null"/>-->
                      </footer>
                    </div>
                  </section>
                  <div id="backdrop" class="slds-backdrop slds-backdrop_close"></div>
                </div>
                <!--- End Modal ---->               
            </apex:form>
        </body>
