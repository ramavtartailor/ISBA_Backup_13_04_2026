            <script>
                function setCommentVal(thisVal, comment){
                    $('#'+comment+'> .comment').val(thisVal.value);
                }
                
                function clearModal(){
                    var usr = '{!$User.Id}'; 
                   
                    $('#templateModal').find('input:text').val('0');
                    
                    if(usr.includes('005G00000083Xpu')  ||  usr.includes('005A0000000QvuP')){
                        $('#templateModal :checkbox').each(function () { 
                   
                            if ($(this).is(':checked'))
                            {
                            $(this).click();   
                            }
                        }); 
                    }
                    else{
                        var checks = document.getElementById("templateModal").querySelectorAll(' input[type="checkbox"]');
                        for(var i =0; i< checks.length;i++){
                            var check = checks[i];
                            if(check.checked){
                                console.log(check.checked);
                                check.removeAttribute("disabled");
                                check.click();
                                check.disabled = true;
                                
                            }
                        }
                        
                    }
                    $('#templateModal').find('textarea').val('');
                    document.getElementById('pg:frm:SCHModApp').value = 0; 
                }
                
                function handleBack(){
                    if({!isSaErp}){
                        history.back();
                    }
                    else{
                        window.location.href='apex/ApplicationAndPolicy?id={!application_policy.Account__C}&returnURL=/apex/firmSearch'
                    }
                }
                function displayComment(thisVal, elementMod, elementComment, elementCheck, label){
                   
                   var usr = '{!$User.Id}'; 
                   
                   if(thisVal != 'NaN'  && thisVal != '' && thisVal != null && thisVal.value != 0 && thisVal != undefined && !isNaN(thisVal.value)){
                       if(usr.includes('005G00000083Xpu')  ||  usr.includes('005A0000000QvuP')){
                           //document.getElementById(elementComment).style.display='inline-block';
                           //$('#'+elementCheck).children().attr('checked',true);
                           
                           if($('#'+elementCheck).children().prop('checked') == true){
                               document.getElementById(elementComment).style.display='inline-block';
                           }
                           else{
                               validateMods(thisVal, elementMod, elementComment, elementCheck, label);
                           }
                       }
                       else{
                           validateMods(thisVal, elementMod, elementComment, elementCheck, label);   
                       }
                   }
                   else{
                       document.getElementById(elementComment).style.display='none';
                       thisVal.value = 0;
                       if(thisVal.value == 0){
                           $("#"+elementComment+" > .comment").val('');
                       }
                       
                       if($("#"+elementMod+" > .actualMod").hasClass('errorMod')){
                           $("#"+elementMod+" > .actualMod").removeClass('errorMod');
                       }
                   }
                   
                }
                
                function validateMods(thisVal, elementMod, elementComment, elementCheck, label){
                    console.log('thisVal----'+thisVal);
                    console.log('$("#"+elementMod+" > .actualMod").val()----'+$("#"+elementMod+" > .actualMod").val());
                    console.log('label----'+label);
                    var isWrong = false;
                   if(label == 'Size of Firm (1% credit/attorney after 1st attorney – up to 10% credit allowed)'){
                       if(($("#"+elementMod+" > .actualMod").val() < -10) || ($("#"+elementMod+" > .actualMod").val() > 10)){
                           isWrong = true;
                       }
                       else if(($("#"+elementMod+" > .actualMod").val() >= -10) && ($("#"+elementMod+" > .actualMod").val() <= 10)){
                           isWrong = false;
                       }
                   }
                   else if(label == 'AOP Adjustment (Debit only allowed)'){
                       if(($("#"+elementMod+" > .actualMod").val() < 1) || ($("#"+elementMod+" > .actualMod").val() > 10)){
                           isWrong = true;
                       }
                       else if(($("#"+elementMod+" > .actualMod").val() >= 1) && ($("#"+elementMod+" > .actualMod").val() <= 10)){
                           isWrong = false;
                       }
                   }
                   else{
                       if(($("#"+elementMod+" > .actualMod").val() < -5) || ($("#"+elementMod+" > .actualMod").val() > 10)){
                           isWrong = true;
                       }
                       else if(($("#"+elementMod+" > .actualMod").val() >= -5) && ($("#"+elementMod+" > .actualMod").val() <= 10)){
                           isWrong = false;
                       }
                   
                   }
                   
                   console.log('isWrong----'+isWrong);
                   if(isWrong && label != 'General Override'){
                       console.log($('#'+elementCheck).children().prop('checked'));
                       if($('#'+elementCheck).children().prop('checked') == false){
                           $("#"+elementMod+" > .actualMod").addClass('errorMod');
                           document.getElementById(elementComment).style.display='none';
                           $("#"+elementComment+" > .comment").val('');
                       }
                   }
                   
                   if(!isWrong){
                       $("#"+elementMod+" > .actualMod").removeClass('errorMod');
                       document.getElementById(elementComment).style.display='inline-block';                       
                   }
                }
                
                function overrideMods(thisVal, elementMod, elementComment, elementCheck,label){
                    console.log('elementCheck---'+elementCheck);
                   if(thisVal.checked){   
                       $("#"+elementCheck+" > .overrider").click();
                                       
                       if($("#"+elementMod+" > .actualMod").hasClass('errorMod')){
                           $("#"+elementMod+" > .actualMod").removeClass('errorMod');
                           document.getElementById(elementComment).style.display='inline-block';               
                       }
                       
                   }
                   else{
                       $("#"+elementCheck+" > .overrider").checked = false;
                       validateMods( $("#"+elementMod+" > .actualMod"), elementMod, elementComment, elementCheck, label);
                   }
               }
                   
                function toggleModal(){
                        
                    var modalElementClasses = document.getElementById('templateModal').classList;
                    var backdropElementClasses = document.getElementById('backdrop').classList;
                    
                    if(modalElementClasses.contains('slds-fade-in-open')){
                        modalElementClasses.remove('slds-fade-in-open');
                        modalElementClasses.add('slds-fade-in-close');
                        
                        backdropElementClasses.remove('slds-backdrop_open');
                        backdropElementClasses.add('slds-backdrop_close');
                    }
                    else{
                        modalElementClasses.remove('slds-fade-in-close');
                        modalElementClasses.add('slds-fade-in-open');
                        
                        backdropElementClasses.remove('slds-backdrop_close');
                        backdropElementClasses.add('slds-backdrop_open');
                        
                    }
                }
                
                function toggleModalOk(){
                    if($('#templateModal').find('input:text').hasClass('errorMod')){
                        console.log('error');
                        $('.slds-m-top_x-small').show();
                    }
                    else{
                        $('.slds-m-top_x-small').hide();
                        var sum = 0;
                        $(".actualMod").each(function(){
                            if($(this).val() != 'NaN' && $(this).val() != '' && $(this).val()  != null && $(this).val() != undefined){
                                console.log('$(this).val()-----:'+$(this).val());
                                sum += parseInt($(this).val(), 10);
                            }
                        });
                        
                        console.log('sum-----:'+sum);
                        if(sum == -100){
                             sum = 0;
                         } 
                         else{
                             if(sum < 0){
                                 sum = sum / 100 + 1;
                             }
                             else if(sum == 0){
                                 sum = 0
                             }
                             else{
                                 sum = sum / 100 + 1;
                             }
                        } 
                         
                        if(sum > 1.25 || sum < 0.75){
                           showError('** SCH Mod value should be between 0.75 and 1.25');
                        }else{
                            document.getElementById('pg:frm:SCHModApp').value = sum;
                            toggleModal();
                        }    
                        
                    }
                }
            
                $('body').click(function(evt) {
                    $(".closeDiv :visible").each(function() {
                        $('.closeDiv').hide();
                    });
                });
                
                function search(lookName, ObjectName, label) {
                    try {
                        $('input[id$=' + lookName + ']').css('background', 'url("http://www.hsi.com.hk/HSI-Net/pages/images/en/share/ajax-loader.gif") no-repeat right center');
                        var key = $('input[id$=' + lookName + ']').val();
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.App_Policy_DetailPageEdit_LtngCtrl.getLookupRecord}',
                            key,
                            ObjectName,
                            function(result, event) {
                                if (result != null) {
                                    if (event.status) {
                                        var tables = "<ul class='slds-lookup__list' role='listbox'>  ";
                                        var check = true;
                                        
                                        for (var i = 0; i < result.length; i++) {
                                            tables += "<li role='presentation' onclick=\"fillRecord( '" + lookName + "','" + result[i].Id + "','" + result[i].Name + "' )\"><span class='slds-lookup__item-action slds-media' id='lookup-option-483' role='option'><div class='slds-media__body'><div class='slds-lookup__result-text'>" + result[i].Name + "</div></div></span></li>";
                                        }
                                        tables += "</ul>";
                                        if (result.length > 0) {
                                            
                                            tables = "<div class='slds-lookup__item--label slds-text-body--small'>" + label + "</div>" + tables;
                                        } else {
                                            check = false;
                                            tables = "<div class='slds-lookup__item--label slds-text-body--small'>No record found .</div>";
                                        }
                                        document.getElementById(lookName + "SrchDrpDwn").innerHTML = tables;
                                        $('[id$=' + lookName + 'SrchDrpDwn]').show();
                                        
                                        if(check){
                                            $('[id$=' + lookName + 'SrchDrpDwn]').focus();
                                        }
                                        
                                    } else if (event.type === 'exception') {
                
                                    } else {
                
                                    }
                                    $('input[id$=' + lookName + ']').css('background', 'none');
                                } else {
                                    $('input[id$=' + lookName + ']').css('background', 'none');
                                }
                            }, {
                                escape: true
                            }
                        );
                    } catch (e) {
                        alert('An Error has Occured. Error:' + e);
                    }
                
                }
                
                function fillRecord(lookup, id, name) {
                    $('[id$=' + lookup + 'SrchDrpDwn]').hide();
                    $('input[id$=' + lookup + 'Value]').val(id);
                
                    $('[id$=' + lookup + 'Label]').text(name);
                    $('[id$=' + lookup + 'Search]').addClass('slds-hide');
                    $('[id$=' + lookup + 'LabelDiv]').removeClass('slds-hide');
                }
                
                function showError(error) {
                    $(".slds-notify_container h2").each(function() {
                        $(this).text(error);
                    });
                    $(".slds-notify_container").removeClass('slds-hide');
                    setTimeout(function() {
                        $(".slds-notify_container").addClass('slds-hide');
                    }, 5000);
                }
                $(document).ready(function() {
                    $("svg").on("click", function() {
                        if ($(this).attr('data') == 'msg') {
                            $(".slds-notify_container").addClass('slds-hide');
                        }
                    });
                    $('svg').click(function (){
                        var lookup = $(this).attr('data');
                        if($(this).attr('data')=='toggle'){
                            $(this).parent().parent().parent().find('.slds-p-horizontal--small').each(function (){
                                if($(this).css('display') == 'none'){
                                    $(this).removeClass('slds-hide');
                                    //$(this).slideDown("slow");
                                }else{
                                    $(this).addClass('slds-hide');
                                    //$(this).slideUp("slow");
                                }
                            });
                        }else if (lookup  != '' && lookup  != null && lookup  != 'undefined' && lookup.indexOf('Lookup') != -1){
                            
                            $('input[id$=' + lookup + ']').val('');
                            $('input[id$=' + lookup + 'Value]').val('');
                            
                            $('[id$=' + lookup + 'Label]').text('');
                            $('[id$=' + lookup + 'Search]').removeClass('slds-hide');
                            $('[id$=' + lookup + 'LabelDiv]').addClass('slds-hide');
                        }
                    });
                    var startYear=1940; 
                    var endYear=2034; 
                    var optionsString='';
                    if(startYear<endYear){
                        for(i=startYear;i<endYear+1;i++){
                            optionsString += "<option value=\""+i+"\">"+i+"</option>";
                        }
                        $('#calYearPicker').html(optionsString);
                    }
                });
                
                function validateAndSave_Application_Policy(nextOrSave){
                    var saveFlag = true ;
                    var save = false;
                    var type = $('[id$=rType]').text();
                    if(type.includes('Application')){
                        save = true;
                        $('.application_required').each(function (){
                          if($(this).val() == '' || $(this).val() == null || $(this).val() == 'undefined'){
                            $(this).css('border','1px solid red');
                            saveFlag = false;
                          }
                        });
                        
                        if('{!$CurrentPage.parameters.save_new}' == '1'){
                            if('{!hasAccount}'== 'false' &&( $('[id$=FirmLookupValue]').val() == '' || $('[id$=FirmLookupValue]').val() == null || $('[id$=FirmLookupValue]').val() == 'undefined')){
                              $('[id$=FirmLookup]').css('border','1px solid red');
                              saveFlag = false;
                            }
                        }
                    }else if(type == 'Policy'){
                        save = true;
                        $('.policy_required').each(function (){
                          if($(this).val() == '' || $(this).val() == null || $(this).val() == 'undefined'){
                            $(this).css('border','1px solid red');
                            saveFlag = false;
                          }
                        });
                        if($('[id$=FirmLookupAppValue]').val() == '' || $('[id$=FirmLookupAppValue]').val() == null || $('[id$=FirmLookupAppValue]').val() == 'undefined'){
                          $('[id$=FirmLookupApp]').css('border','1px solid red');
                          saveFlag = false;
                        }
                    }
                    if( saveFlag && save ){
                        if($('.schMod').val() > 1.25 || $('.schMod').val() < 0.75){
                           showError('** SCH Mod value should be between 0.75 and 1.25');
                            $('[id$=spinner]').css('display','none');
                        }else{
                           if(nextOrSave == "save"){
                               unsaved=false;
                            saveApplication_Policy();
                            }else if(nextOrSave == "next"){
                                unsaved=false;
                                saveAndNextApplication_Policy();
                            }
                        }    
                    }else{
                        showError('** Required field missing . ');
                        $('[id$=spinner]').css('display','none');
                    }
                }
            
            	function checkNumber(e,value){
                    var unicode=e.charCode? e.charCode : e.keyCode;
                    if((unicode >=48 && unicode <= 57 ) || unicode ==8 ||  unicode==9 || unicode==97 ){
                        return true;
                    }
                    return false;
                }
            </script>
        
        </head>
        
        <body>
            <apex:form id="frm">
                
