                                                        <use xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="{!URLFOR($Asset.SLDS,'/assets/icons/utility-sprite/svg/symbols.svg#chevrondown')}" class="down"></use>
                                                        <use xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="{!URLFOR($Asset.SLDS,'/assets/icons/utility-sprite/svg/symbols.svg#chevronup')}"  class="up" style="display:none"></use>
                                                    </svg>
                                                    <span class="slds-assistive-text"></span>
                                                </button>
                                                <h2 class="slds-section-title slds-theme--shade slds-p-left--small">Marketing Section</h2>
                                            </div>
                                            
                                            <!-- 1 row -->
                                            <div class="slds-p-horizontal--small slds-size--1-of-1 slds-medium-size--6-of-12 slds-large-size--6-of-12 slds-hide">
                                                <div class="slds-form--horizontal">
                                                    <div class="slds-form-element">
                                                        <label class="slds-form-element__label" for="Street">Lead Week</label>
                                                        <div class="slds-form-element__control">
                                                            <apex:inputField html-placeholder="Slect Lead Week" required="false" styleClass="slds-input" value="{!contactRecord.Lead_Week__c}"  />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- 2 row -->
                                            <div class="slds-p-horizontal--small slds-size--1-of-1 slds-medium-size--6-of-12 slds-large-size--6-of-12 slds-hide">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="slds-modal__footer slds-grid slds-grid--align-spread">
                                <button class="slds-button slds-button--neutral slds-order--1" onclick="$('[id$=contactLookupModal]').addClass('slds-hide');return false;">Cancel</button>
                                <button class="slds-button slds-button--brand slds-order--3" onclick="$('[id$=spinner]').css('display','block');validateAndSaveContact(); return false;">Save</button>
                            </div>
                        </div>
                    </div>
                    <div class="slds-backdrop slds-backdrop--open"></div>
                </div>
                <!-- end contact lookup -->
            </apex:outputPanel>
        </apex:form>
    </body>
</apex:page>