                                <h2 class="slds-section-title slds-theme--shade slds-p-left--small">Billing Information</h2>
                            </div>
                            
                            <!-- 1 row -->
                            <div class="slds-p-horizontal--small slds-size--1-of-1 slds-medium-size--6-of-12 slds-large-size--6-of-12">
                                
                                <div class="slds-form--horizontal">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="accountField">Bill To</label>
                                        <div class="slds-form-element__control">
                                            <!--<apex:inputField html-placeholder="Enter Date Signed" styleClass="slds-input" id="SignedApp" value="{!Policy__c.Date_Signed__c}" />-->
                                            <apex:inputField value="{!Billing.AcctSeed__Customer__c}" onchange="updateAddressFunction2(this.id);" id="accountField" />
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="slds-form--horizontal">
