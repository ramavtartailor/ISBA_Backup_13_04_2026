 <script src="{!URLFOR($Resource.LightningPlugin, '/jquery.min.js')}"></script>  
<!--<apex:styleSheet value="{!URLFOR($Resource.LightningPlugin, '/jquery.dataTables.min.css')}" />
<script src="{!URLFOR($Resource.LightningPlugin, '/jquery.dataTables.min.js')}"></script> -->
 <apex:styleSheet value="https://cdn.datatables.net/1.10.13/css/jquery.dataTables.min.css" />
 <script src="https://cdn.datatables.net/1.10.13/js/jquery.dataTables.min.js"></script>
      <script>
                $('body').click(function(evt) {
        $(".closeDiv :visible").each(function() {
            $('.closeDiv').hide();
        });
    });
    
    $(document).ready(function() {
    
                $("input").addClass('slds-input');
                            
                $("svg").on("click", function() {
                    if ($(this).attr('data') == 'msg') {
                        $(".slds-notify_container").addClass('slds-hide');
                    }
                });
                $('svg').click(function (){
                        var lookup = $(this).attr('data');
                        if($(this).attr('data')=='toggle'){
                            $(this).parent().parent().parent().find('.slds-p-horizontal--small').each(function (){
                                if($(this).css('display') == 'none'){
                                    //$(this).removeClass('slds-hide');
                                    $(this).slideDown("slow");
                                }else{
                                    //$(this).addClass('slds-hide');
                                    $(this).slideUp("slow");
                                }
                            });
                            
                            $(this).parent().parent().parent().find('.tbtest').each(function (){
                                if($(this).css('display') == 'none'){
                                    //$(this).removeClass('slds-hide');
                                    $(this).slideDown("slow");
                                }else{
                                    //$(this).addClass('slds-hide');
                                    $(this).slideUp("slow");
                                }
                            });
                            
                        }else if (lookup  != '' && lookup  != null && lookup  != 'undefined' && lookup.indexOf('Lookup') != -1){
                            
                            $('input[id$=' + lookup + ']').val('');
                            $('input[id$=' + lookup + 'Value]').val('');
                            
                            $('[id$=' + lookup + 'Label]').text('');
                            $('[id$=' + lookup + 'Search]').removeClass('slds-hide');
                            $('[id$=' + lookup + 'LabelDiv]').addClass('slds-hide');
                            
                        }
                    });
            });
                function updateAddressFunction2(path){
                    var accountId = document.getElementById(path+'_lkid').value;
                    
                    console.log(accountId);
                    rerenderAction(accountId);
                }
                
                
                function calculateAmount(a){
                    console.log('--a'+a);
                    var qty = 1;
                    var price = document.getElementsByClassName('price'+a)[0].value.replace(/\,/g,"");
                    console.log('---'+qty + price);
                    document.getElementsByClassName("total"+a)[0].innerHTML = (qty*price).toFixed(2);
                    totalAmount();
                }
                
                function totalAmount(){
                    var totalAmount = 0.00;
                    $('.totalEnd').each(function(){
                        console.log(this);
                        console.log($(this).html());
                        totalAmount  += parseFloat($(this).html());
                    });
                    totalAmount = totalAmount.toFixed(2);
                    console.log(totalAmount);
                    $('.totalClassAmount').html(totalAmount);
                    
                    
                }   
          function colorPageBlock(pageblock, color) {
              if (pageblock != null){
                  pageblock.firstChild.style.cssText = "background-color: " + color + ";";
              }    
              
          }
            </script> 
          <style>
     
