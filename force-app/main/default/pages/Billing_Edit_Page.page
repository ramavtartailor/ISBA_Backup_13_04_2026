                                            <apeX:inputField value="{!Billing.AcctSeed__Billing_Terms_Name__c}" id="Terms"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
            <apex:pageblock id="pbBlock2Id">
            <apex:pageblockSection id="pbSecLineId" title="Billing Lines" columns="1" collapsible="true">
                <script>
                $("input").addClass('slds-input');
                colorPageBlock(document.getElementById("{!$Component.pbSecLineId}"), "#337AB7");</script>
            
            <apex:variable var="index" value="{!0}"   /> 
            <apex:pageblocktable value="{!BillingLineWrapperList}" var="li" id="table_trans">
                <apex:column headerValue="Action">
                    <apex:image width="17" height="17" value="{!$Resource.removeImage}">
                        <apex:actionSupport event="onclick" 
                                               action="{!removeRow}" 
                                               status="counterStatus"
                                               rerender="pbBlock2Id" >
                               <apex:param value="{!index}" name="testparam1" assignTo="{!indexOfLineItemToBeRemoved}" />
                           </apex:actionSupport>
                    </apex:image>
                </apex:column>
                <apex:column headerValue="GL Account">
                    <apex:inputField value="{!li.BillingLine.AcctSeed__Revenue_GL_Account__c}" style="width:80%"/>
                </apex:column>
                <apex:column headervalue="Unit Price" >
                    <apex:inputField value="{!li.BillingLine.AcctSeed__Rate__c}" id="unitPriceField" styleClass="price{!index}" onkeyup="calculateAmount({!index});" />
                </apex:column>
                <apex:column headervalue="Total" width="25%">
                    <apex:outputText id="total" styleclass="total{!index} totalEnd" value="{!li.BillingLine.AcctSeed__Total__c}" >
                    </apex:outputText>
                     <!--increment -->
                     <script>
                        calculateAmount('{!index}');
                    </script>
                    <apex:variable value="{!index+1}" var="index"/>
                </apex:column>
                
            </apex:pageblocktable>
                </apex:pageblockSection> 
            <br/><br/>
                <apex:commandlink value="Add New Line Items" 
                                      action="{!addNewLine}" 
                                      rerender="pbBlock2Id,msgId" 
                                      immediate="true"
                                      status="counterStatus"  />
            <apex:outputPanel id="TotalAmountPanel" style="float: right; font-size: 1em; margin-right: 21%; color: #000; font-weight: bold; padding: 5px 2px 4px;">
                <apex:outputLabel value="Total Amount: " />
                <apex:outputText id="totalAmountField" value="{0, number, 0.00}" styleclass="totalClassAmount" style="float: right; width: 36px;">
                    <apex:param id="totalAmountFieldParam" value=""/>
                </apex:outputText>  
            </apex:outputPanel>
            
        </apex:pageblock>
        </fieldset>
        <div class="slds-docked-form-footer">
        <button type="button" class="slds-button slds-button--neutral" onclick="cancel()">Cancel</button> &nbsp;
        <button type="button" class="slds-button slds-button--brand" onClick="$('[id$=spinner]').css('display','block');save(); return false;">save</button>
        
       </div>
       
        <apex:actionFunction name="rerenderAction" rerender="addressPanel2,addressPanel,billingContactId" action="{!onAccountSelect}">
            <apex:param value="" name="asd" assignTo="{!accountId}" />
        </apex:actionFunction>
        
    </apex:form>
      <script>
        function onPageLoad(){
             var totalAmount = 0.00;
            $('.totalEnd').each(function(){
                console.log(this);
                console.log($(this).html());
                totalAmount  += parseFloat($(this).html());
            });
            totalAmount = totalAmount .toFixed(2);
            console.log(totalAmount);
            $('.totalClassAmount').html(totalAmount);
        }
        onPageLoad();
      </script>
