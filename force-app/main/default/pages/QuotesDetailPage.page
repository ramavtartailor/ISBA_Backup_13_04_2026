                        }
                    }); 
                }
                else{
                    var checks = document.getElementById("templateModal").querySelectorAll(' input[type="checkbox"]');
                    for(var i =0; i< checks.length;i++){
                        var check = checks[i];
                        if(check.checked){
                            console.log(check.checked);
                            check.removeAttribute("disabled");
                            check.click();
