            $( document ).ready(function() {
                
                var fixHelperModified = function(e, tr) {
                    var $originals = tr.children();
                    var $helper = tr.clone();
                    $helper.children().each(function(index) {
                        $(this).width($originals.eq(index).width());                        
                    });
                    return $helper;
                },
                    updateIndex = function(e, ui) {
                        var draggedValue;
                        $('input[class=sqnc]', ui.item).each(function (i) {
                            draggedValue = $(this).val();
                        });
                        var currentVal = 1;
                        $('input[class=sqnc]', ui.item.parent()).each(function (i) {
                            $(this).val(currentVal++); 
                            console.log($(this).val());
                        });
                        $('[id$=spinner]').css('display','block');
                        updatePolicyQuoteFun();
                    };
                $(document.getElementById("tableScrollId")).find("tbody").sortable({
                    helper: fixHelperModified,
                    stop: updateIndex
                }).disableSelection();
                
                $(document.getElementById("tableScrollId")).find("tbody").sortable({
                    distance: 5,
                    delay: 100,
                    opacity: 0.6,
                    cursor: 'move',
                    update: function() {}
                });
            });
            
