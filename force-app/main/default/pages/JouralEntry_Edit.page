<apex:page id="pageId"
           standardController="AcctSeed__Journal_Entry__c" 
           tabStyle="AcctSeed__Journal_Entry__c" 
           extensions="CM_JournalEntry_edit_controller" sidebar="false" showHeader="false"
           >
 <apex:slds />
    <html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" lang="en">
        <head>            
            <script src="{!URLFOR($Resource.LightningPlugin, '/jquery.min.js')}"></script>  
            <!--<apex:styleSheet value="{!URLFOR($Resource.LightningPlugin, '/jquery.dataTables.min.css')}" />
                <script src="{!URLFOR($Resource.LightningPlugin, '/jquery.dataTables.min.js')}"></script> -->
            <apex:styleSheet value="https://cdn.datatables.net/1.10.13/css/jquery.dataTables.min.css" />
            <script src="https://cdn.datatables.net/1.10.13/js/jquery.dataTables.min.js"></script>
            <script>
                $('body').click(function(evt) {
                $(".closeDiv :visible").each(function() {
                    $('.closeDiv').hide();
                });
            });
            
            $(document).ready(function() {
                
                $("input").addClass('slds-input');
                
                $("svg").on("click", function() {
                    if ($(this).attr('data') == 'msg') {
                        $(".slds-notify_container").addClass('slds-hide');
                    }
                });
                $('svg').click(function (){
                    var lookup = $(this).attr('data');
                    if($(this).attr('data')=='toggle'){
                        $(this).parent().parent().parent().find('.slds-p-horizontal--small').each(function (){
                            if($(this).css('display') == 'none'){
                                //$(this).removeClass('slds-hide');
                                $(this).slideDown("slow");
                            }else{
                                //$(this).addClass('slds-hide');
                                $(this).slideUp("slow");
                            }
                        });
                        
                        $(this).parent().parent().parent().find('.tbtest').each(function (){
                            if($(this).css('display') == 'none'){
                                //$(this).removeClass('slds-hide');
                                $(this).slideDown("slow");
                            }else{
                                //$(this).addClass('slds-hide');
                                $(this).slideUp("slow");
                            }
                        });
                        
                    }else if (lookup  != '' && lookup  != null && lookup  != 'undefined' && lookup.indexOf('Lookup') != -1){
                        
                        $('input[id$=' + lookup + ']').val('');
                        $('input[id$=' + lookup + 'Value]').val('');
                        
                        $('[id$=' + lookup + 'Label]').text('');
                        $('[id$=' + lookup + 'Search]').removeClass('slds-hide');
                        $('[id$=' + lookup + 'LabelDiv]').addClass('slds-hide');
                        
                    }
                });
            });
            function calculateAmount(a){
                console.log('--a'+a);
                //var qty = document.getElementsByClassName('quantity'+a)[0].value;
                var price = document.getElementsByClassName('price'+a)[0].value.replace(/\,/g,"");
                var debit = document.getElementsByClassName('debit'+a)[0].value.replace(/\,/g,"");
                //console.log('---'+qty + price);
                
                if(price != '' && price != null){
                    document.getElementsByClassName('debit'+a)[0].disabled = 'true';
                    document.getElementsByClassName("total"+a)[0].innerHTML = (1*price).toFixed(2);
                }else if(debit != '' && debit != null){
                    document.getElementsByClassName('price'+a)[0].disabled = 'true';
                    document.getElementsByClassName("total"+a)[0].innerHTML = (1*debit).toFixed(2);
                }else{
                    document.getElementsByClassName('debit'+a)[0].disabled = '';
                    document.getElementsByClassName('price'+a)[0].disabled = '';
                    document.getElementsByClassName("total"+a)[0].innerHTML = 0.0;
                }
                
                //var totalAmt = getTotal(a);
                //var old = document.getElementById("pageId:formId:pbBlock2Id:totalAmountField").innerHTML;
                //document.getElementById("pageId:formId:pbBlock2Id:totalAmountField").innerHTML = old+totalAmt;
                
                
                var totalAmount = 0.00;
                $('.totalEnd').each(function(){
                    console.log(this);
                    console.log($(this).html());
                    if($(this).html()!=''){
                        totalAmount  += parseFloat($(this).html());
                    }
                    else{
                        totalAmount  = parseFloat($(this).html());
                    }
                    
                });
                totalAmount = totalAmount .toFixed(2);
                console.log(totalAmount);
                $('.totalClassAmount').html(totalAmount); 
            }   
            function colorPageBlock(pageblock, color) {
                if (pageblock != null){
                    pageblock.firstChild.style.cssText = "background-color: " + color + ";";
                }    
                
            }
            </script>
            <style>
                
                .detailList tr th{
                border :none !important;
                }
                .detailList tr{
                border :none !important;
                }
                .detailList tr td{
                border :none !important;
                }
                .apexp .detailList .list .headerRow th {
                color: #4a4a56;
                font-weight: bold;
                }
                th.labelCol.vfLabelColTextWrap{
                float: left;
                min-width: 150px;
                }
                
                .classNameForPageBlockSection
                {
                bgcolor: blue !important;
                }
                
            </style>
            <style>
                .slds-scope .slds-grid--pull-padded {
                margin-right:0px !important;
                margin-left:0px !important;
                }
                .slds-scope .slds-form--horizontal {
                margin-top: 1%;
                }
                .dateFormat {
                padding: 0 2px;
                display: none;
                }
                .slds-scope .slds-page-header {
                padding: 1rem .75rem;
                border-bottom: 1px solid #d8dde6 !important;
                background-color: #337AB7 !important;
                color: white;
                }
                .slds-box{
                }
                .slds-scope .slds-medium-size--12-of-12 {
                margin-bottom: 10px;
                }
                .slds-scope .slds-medium-size--6-of-12 {
                margin-bottom: 10px;
                }
                .accountRequired{
                border-left: 4px solid red !important;
                }
                
                .accountRequired1{
                border-left: 4px solid red !important;
                }
                
                .slds-scope .slds-table td, .slds-scope .slds-table th {
                white-space: normal !important;
                }
                .slds-scope .slds-text-heading--label {
                text-transform: capitalize !important; 
                }
                .ContactRequired{
                border-left: 4px solid red !important;
                }
                .slds-scope a:focus, .slds-scope a:hover{
                display: initial !important;
                }
                .lookupInput .slds-input{
                //border:none !important;
                }
                .slds-scope .slds-input:read-only:focus, .slds-scope .slds-input:read-only:hover{
                background-color: #fff; 
                }
                .lookupInput input[readonly] {
                cursor: default;
                color: #333;
                background-color: #fff !important;
                border: 1px solid #d8dde6 !important;
                }
                .lookupInput a{
                position: absolute;
                width: 33px !important; 
                margin-left: 5px;
                background-image: url(/img/setup/search-icon.png) !important;
                background-repeat: no-repeat !important;
                background-position: center !important;
                display: inline-flex !important;
                }
                .lookupInput input{
                width:91% !important;
                }
                .lookupInput a img{
                display:none !important;
                }
                .datePicker{
                z-index: 99999 ;
                }
            </style>
        </head>    
    <apex:form id="formId"> 
            <apex:actionStatus id="counterStatus" startStyle="">
                <apex:facet name="start" >
                    <div class="waitingSearchDiv" id="el_loading" style="background-color: #DCD6D6; height: 100%;opacity:0.2;padding-top:20%;width:100%;zoom:0.25;">
                        <div class="waitingHolder" style="top: 74.2px; width: 91px;">
                            <img class="waitingImage" src="{!$Resource.loadingGif}" />
                            
                        </div>
                    </div>
                    
                </apex:facet>
            </apex:actionStatus>
            <div class="slds-page-header" role="banner" style="position: fixed;width: 100%;top: 0;z-index: 1;">
                <div class="slds-media">
                    <div class="slds-media__body">
                        <p class="slds-page-header__title slds-truncate" title="New Journal Entry">
                            
                            New Journal Entry
                            
                        </p>
                        <p class="slds-text-body--small"></p>
                    </div>
                    <ul class="slds-global-header__item slds-grid slds-grid--vertical-align-center">
                        <li class="slds-dropdown-trigger slds-dropdown-trigger--click slds-p-horizontal--xxx-small">
                            <!--<a href="javascript:void(0);" class="slds-has-blur-focus">Home</a>-->
                        </li>
                    </ul>
                </div>
            </div> 
            <div class="slds-spinner_container" id="spinner" style="display:none;position: fixed;">
                <div class="slds-spinner--brand slds-spinner slds-spinner--medium" aria-hidden="false" role="alert" style="    position: fixed;">
                    <div class="slds-spinner__dot-a"></div>
                    <div class="slds-spinner__dot-b"></div>
                </div>
            </div>
            <div class="slds-notify_container slds-hide">
                <div class="slds-notify slds-notify--toast slds-theme--error" role="alert">
                    <span class="slds-assistive-text">Warning</span>
                    <button class="slds-button slds-notify__close slds-button--icon-inverse" title="Close">
                        <svg class="slds-button__icon slds-button__icon--large" aria-hidden="true" onclick="return false;" data="msg">
                            <use xlink:href="{!URLFOR($Asset.SLDS,'/assets/icons/utility-sprite/svg/symbols.svg#close')}"></use>
                        </svg>
                        <span class="slds-assistive-text">Close</span>
                    </button>
                    <div class="slds-notify__content">
                        <h2 class="slds-text-heading--small"></h2>
                    </div>
                </div>
            </div>
            <fieldset class="slds-box slds-theme--default  slds-m-around--small" style="margin-bottom: 55px;margin-top: 85px;">
                <apex:PageMessages id="msgId" escape="false" />
                <apex:actionFunction name="cancel" action="{!cancel}" />
                <apex:actionFunction name="save" action="{!onSaveClick}" reRender="msgId" oncomplete="$('[id$=spinner]').css('display','none');" />
                <div class="slds-grid slds-wrap slds-grid--pull-padded filter">
                    
                    
                    <div class="slds-p-horizontal--small slds-size--1-of-1 slds-medium-size--12-of-12 slds-large-size--12-of-12 slds-box" style="padding:0px;">
                        <div class="slds-grid slds-wrap slds-grid--pull-padded">
                            <div class="slds-size--12-of-12  slds-theme--shade">
                                <button class="slds-button slds-button--icon" title="Toggle" style="float:right;padding-right: 15px;padding-top: 4px;" onclick="return false;">
                                    <svg class="slds-button__icon" aria-hidden="true" data="toggle" onclick="console.log($(this).find('.down').toggle(0 , $(this).find('.up').toggle() )); ">
                                        <use xlink:href="{!URLFOR($Asset.SLDS,'/assets/icons/utility-sprite/svg/symbols.svg#chevrondown')}" class="down" style="display:none"></use>
                                        <use xlink:href="{!URLFOR($Asset.SLDS,'/assets/icons/utility-sprite/svg/symbols.svg#chevronup')}"  class="up"></use>
                                    </svg>
                                    <span class="slds-assistive-text"></span>
                                </button>
                                <h2 class="slds-section-title slds-theme--shade slds-p-left--small">Information</h2>
                            </div>
                            <div class="slds-p-horizontal--small slds-size--1-of-1 slds-medium-size--6-of-12 slds-large-size--6-of-12">
                                <div class="slds-form--horizontal">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="entryName">Journal Entry Name</label>
                                        <div class="slds-form-element__control">
                                            <!--<apex:inputField html-placeholder="Enter Date Signed" styleClass="slds-input" id="SignedApp" value="{!Policy__c.Date_Signed__c}" />-->
                                            <apex:inputField value="{!AcctSeed__Journal_Entry__c.Name}" id="entryName" styleClass="slds-input"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="slds-form--horizontal">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="entryStatus">Posting Status</label>
                                        <div class="slds-form-element__control">
                                            <!--<apex:inputField html-placeholder="Enter Date Signed" styleClass="slds-input" id="SignedApp" value="{!Policy__c.Date_Signed__c}" />-->
                                            <apex:inputField value="{!AcctSeed__Journal_Entry__c.AcctSeed__Status__c}" id="entryStatus" styleClass="slds-input"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="slds-p-horizontal--small slds-size--1-of-1 slds-medium-size--6-of-12 slds-large-size--6-of-12">
                                <div class="slds-form--horizontal">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="journalDate">Journal Date</label>
                                        <div class="slds-form-element__control">
                                            <!--<apex:inputField html-placeholder="Enter Date Signed" styleClass="slds-input" id="SignedApp" value="{!Policy__c.Date_Signed__c}" />-->
                                            <apex:inputField value="{!AcctSeed__Journal_Entry__c.AcctSeed__Journal_Date__c}" id="journalDate" styleClass="slds-input"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="slds-form--horizontal">
                                    <div class="slds-form-element">
                                        <label class="slds-form-element__label" for="entryPeriod">Accounting Period</label>
                                        <div class="slds-form-element__control">
                                            <!--<apex:inputField html-placeholder="Enter Date Signed" styleClass="slds-input" id="SignedApp" value="{!Policy__c.Date_Signed__c}" />-->
                                            <apex:inputField value="{!AcctSeed__Journal_Entry__c.AcctSeed__Accounting_Period__c}" id="entryPeriod"  style="width:95%" styleClass="slds-input"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <apex:PageBlock id="pbBlock2Id">
                    <apex:PageBlockSection id="pbSecLineId"   columns="1" title="Journal Entry Lines" collapsible="true">
                        <script>
                        $("input").addClass('slds-input');
                        colorPageBlock(document.getElementById("{!$Component.pbSecLineId}"), "#337AB7");</script>
                        <apex:variable var="index" value="{!0}"   />
                        <apex:PageBlockTable value="{!journalEntryLineWrapList}" var="journalLineWrapObj" >
                            <apex:column headerValue="Action">
                                <apex:image width="17" height="17" value="{!$Resource.removeImage}">
                                    <apex:actionSupport event="onclick" 
                                                        action="{!removeLineItemRow}" 
                                                        immediate="true"
                                                        rerender="pbBlock2Id" >
                                        <apex:param value="{!index}" name="testparam1" assignTo="{!indexOfLineItemToBeRemoved}" />
                                    </apex:actionSupport>
                                </apex:image>
                            </apex:column>
                            <apex:column headerValue="GL Account">                            
                                <apex:inputField value="{!journalLineWrapObj.accSeedJournalLineObj.AcctSeed__GL_Account__c}" style="width:80%" styleclass="slds-input"/>
                            </apex:column>                        
                            <apex:column headerValue="Credit">                            
                                <apex:inputField value="{!journalLineWrapObj.accSeedJournalLineObj.AcctSeed__Credit__c}"
                                                 styleClass="price{!index} slds-input"
                                                 onkeyup="calculateAmount({!index});"  />
                            </apex:column>
                            <apex:column headerValue="Debit">        
                                <apex:inputField value="{!journalLineWrapObj.accSeedJournalLineObj.AcctSeed__Debit__c}"
                                                 styleClass="debit{!index} slds-input"
                                                 onkeyup="calculateAmount({!index});"  />
                            </apex:column>
                            <apex:column headerValue="Total" id="totalId" width="16%">                            
                                <apex:outputText id="total" styleclass="total{!index} totalEnd">
                                </apex:outputText>
                                <!--increment -->
                                <script>
                                calculateAmount('{!index}');
                                
                                </script>
                                <apex:variable value="{!index+1}" var="index"/>
                            </apex:column>
                            
                        </apex:PageBlockTable>
                    </apex:PageBlockSection>  
                    <apex:commandlink value="Add New Line Items"
                                      action="{!addAccPayNewLine}" 
                                      immediate="true"
                                      rerender="pbBlock2Id" status="counterStatus"  />     
                    <apex:outputPanel id="TotalAmountPanel" style="float: right; font-size: 1em; margin-right:12%; color: #000; font-weight: bold;">
                        <apex:outputLabel value="Total Amount:  " />
                        <apex:outputText styleclass="totalClassAmount" style="float: right; width: 36px;" id="totalAmountField" value="{0, number, 0.00}">
                            <apex:param id="totalAmountFieldParam" value=""/>
                        </apex:outputText>  
                    </apex:outputPanel>
                    
                </apex:PageBlock>
            </fieldset>
            <div class="slds-docked-form-footer">
                <button type="button" class="slds-button slds-button--neutral" onclick="cancel()">Cancel</button> &nbsp;
                <button type="button" class="slds-button slds-button--brand" onClick="$('[id$=spinner]').css('display','block');save(); return false;">save</button>
                
            </div>
        </apex:form>
    </html>
</apex:page>