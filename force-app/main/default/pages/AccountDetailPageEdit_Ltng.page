            <script>
                $('body').click(function(evt) {
                    $(".closeDiv :visible").each(function() {
                        $('.closeDiv').hide();
                    });
                });
                function search( lookName ,ObjectName,label){
                    try{ 
                        $('input[id$='+lookName+']').css('background', 'url("http://www.hsi.com.hk/HSI-Net/pages/images/en/share/ajax-loader.gif") no-repeat right center');
                        var key=$('input[id$='+lookName+']').val();
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.AccountDetailPageEdit_LtngController.getLookupRecord}',
                            key, 
                            ObjectName,
                            function(result, event){
                                if(result != null){
                                    if (event.status) {
                                        var  tables ="<ul class='slds-lookup__list' role='listbox'>  ";
                                        for(var i=0;i<result.length;i++){ 
                                            tables += "<li role='presentation' onclick=\"fillRecord( '" +lookName+"','" +result[i].Id+"','"+result[i].Name+"' )\"><span class='slds-lookup__item-action slds-media' id='lookup-option-483' role='option'><div class='slds-media__body'><div class='slds-lookup__result-text'>"+result[i].Name+"</div></div></span></li>"; 
                                        } 
                                        tables +="</ul>";
                                        if(result.length > 0){
                                            tables = "<div class='slds-lookup__item--label slds-text-body--small'>"+label+"</div>"+tables; 
                                        }else{
                                            tables = "<div class='slds-lookup__item--label slds-text-body--small'>No record found .</div>"; 
                                        }
                                        document.getElementById(lookName+"SrchDrpDwn").innerHTML =tables;
                                        $('[id$='+lookName+'SrchDrpDwn]').show(); 
                                    } else if (event.type === 'exception') {
                                        
                                    } else {
                                        
                                    }
                                    $('input[id$='+lookName+']').css('background', 'none'); 
                                }else{
                                    $('input[id$='+lookName+']').css('background', 'none');
                                }
                            }, 
                            {escape: true}
                        );
                    }catch(e){ 
                        alert('An Error has Occured. Error:' +e); 
                    }
                    
                }
                function fillRecord(lookup,id,name){
                    $('[id$='+lookup+'SrchDrpDwn]').hide();
                    $('input[id$='+lookup+'Value]').val(id);
                    
                    $('[id$='+lookup+'Label]').text(name);
                    $('[id$='+lookup+'Search]').addClass('slds-hide');
                    $('[id$='+lookup+'LabelDiv]').removeClass('slds-hide');
                } 
                
                function showError(error){
                    $(".slds-notify_container h2").each(function() {
                        $(this).text(error);
                    });
                    $(".slds-notify_container").removeClass('slds-hide');
                    setTimeout(function() {
                        $(".slds-notify_container").addClass('slds-hide');
                    }, 5000);
                }
            function searchValidate(){
                $('[id$=spinner]').css('display','block');
                var flag = false;
                $('.search').each(function (){
                    if($(this).val() != '' && $(this).val() != null && $(this).val() != 'undefined'){
                        flag = true;
                    }
                });
                if(flag){
                    searchContacts();
                }else{
                    showError('Search text empty . ');
                    $('[id$=spinner]').css('display','none');
                }
            } 
            function cancel(){
                $('[id$=spinner]').css('display','block');
                cancelMethod();
            }
            function selectContacts(){
                var str='';
                $("input:checkbox[name=options]:checked").each(function(){
                    if(str==''){
                        str = $(this).attr("data-id") ;
                    }else{
                        str= str + ',' + $(this).attr("data-id"); 
                    }    
                });
                if(str==''){
                    showError('Select atleast one contact.');
                    $('[id$=spinner]').css('display','none');
                }else{
                    associateContacts(str);
                }    
                
            }
                 /*$.aljsInit({
                    assetsLocation: assetsLocation,
                    scoped: true,
                    scopingClass: 'slds-scope'
                });*/
                $(document).ready(function() {
                    
                    //$('#date').datepicker();
                    $('#radio-24').prop('checked','checked');
                    fltrContact('All');
                    $('table ,td,img').removeClass('slds-input');
                    $('a').each(function(){
                        $(this).removeClass('slds-input');
                        $(this).removeClass('ContactRequired');
                    });
                    $('.lookupInput input').each(function(){
                        //$(this).attr('readonly', true);
                    });
                    $('#radio-26').change(function (){
                        var type = $(this).attr('data');
                        if(type != null && type != '' && type != 'undefined'){
                            $('[id$=spinner]').css('display','block');
                            fltrContact(type);
                        }
                    });
                    $('#radio-25').change(function (){
                        var type = $(this).attr('data');
                        if(type != null && type != '' && type != 'undefined'){
                            $('[id$=spinner]').css('display','block');
                            fltrContact(type);
                        }
                    });
                    $('#radio-24').change(function (){
                        var type = $(this).attr('data');
                        if(type != null && type != '' && type != 'undefined'){
                            $('[id$=spinner]').css('display','block');
                            fltrContact(type);
                        }
                    });
                    $('[id$=spinner]').css('height',$(document).height());
                    $("svg").on("click", function() {
                        if ($(this).attr('data') == 'msg') {
                            $(".slds-notify_container").addClass('slds-hide');
                        }
                    });
                    $("svg").on("click", function() {
                        var lookup = $(this).attr('data');
                        if($(this).attr('data')=='toggle'){
                            $(this).parent().parent().parent().find('.slds-p-horizontal--small').each(function (){
                                if($(this).css('display') == 'none'){
                                    //$(this).removeClass('slds-hide');
                                    $(this).slideDown("slow");
                                }else{
                                    //$(this).addClass('slds-hide');
                                    $(this).slideUp("slow");
                                }
                            });
                        }else if (lookup  != '' && lookup  != null && lookup  != 'undefined' && lookup.indexOf('Lookup') != -1) {
                            $('input[id$=' + lookup + ']').val('');
                            $('input[id$=' + lookup + 'Value]').val('');
                            
                            $('[id$=' + lookup + 'Label]').text('');
                            $('[id$=' + lookup + 'Search]').removeClass('slds-hide');
                            $('[id$=' + lookup + 'LabelDiv]').addClass('slds-hide');
                        }
                    });
                    
                    $('svg').click(function (){
                        if($(this).attr('data')=='toggle'){
                            $(this).parent().parent().parent().find('.slds-p-horizontal--small').each(function (){
                                if($(this).css('display') == 'none'){
                                    //$(this).removeClass('slds-hide');
                                    $(this).slideDown("slow");
                                }
                            });
                        }
                    });
                    datatableReinit();
                    datatableReinitContactSearch();
                    var startYear=1940; 
                    var endYear=2034; 
                    var optionsString='';
                    if(startYear<endYear){
                        for(i=startYear;i<endYear+1;i++){
                            optionsString += "<option value=\""+i+"\">"+i+"</option>";
                        }
                        $('#calYearPicker').html(optionsString);
                    }
                });
                function openContactModal(){
                    $('#contactLookupModal input').each(function (){
                        $(this).val('');
                    });
                    openModal();
                }
                function openContactSearchModal(){
                    openContactSearchModalFunction();
                }
                function validateAndSaveContact(){
                    $('#contactLookupModal input').each(function (){
                         $(this).css('border','1px solid #d8dde6');
                    });
                    var flagSave = true;
                    var contactType  = $('[id$=contactType]').val();
                    var ardcNumber  = $('[id$=ardcNumber]').val();
                    /*if(contactType!='' && contactType!=null && contactType!='undefined' && contactType=='Lawyer' && !(ardcNumber && trim(ardcNumber))){
                        $('[id$=ardcNumber]').css('border','1px solid red ');
                        showError('** ARDC Number is required when Contact type is Lawer.');
                        flagSave = false;
                        $('[id$=spinner]').css('display','none');
                        return false;
                    }*/
                    var sEmail  = $('[id$=vEmail]').val();
                    var filter = /^([\w-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
                    if (!filter.test(sEmail) && sEmail  != '' && sEmail  != null && sEmail  !=  'undefined') {
                        $('[id$=vEmail]').css('border','1px solid red ');
                        showError('** Email is not valid . ');
                        flagSave = false;
                        $('[id$=spinner]').css('display','none');
                        return false;
                    }else{
                        $('[id$=vEmail]').css('border','1px solid #d8dde6');
                    }
                    $('.ContactRequired').each(function (){
                        if($(this).val() == '' || $(this).val() == null || $(this).val() == 'undefined'){
                            $(this).css('border','1px solid red ');
                            showError('** Required fields missing . ');
                            $('[id$=spinner]').css('display','none');
                            flagSave = false;
                        }else if($('[id$=ContactType]').val() == ''){
                            $('[id$=ContactType]').css('border','1px solid red ');
                            showError('** Required fields missing . ');
                            $('[id$=spinner]').css('display','none');
                            flagSave = false;
                        }
                    });
                    if(flagSave){
                        newContact();
                    }else{
                        showError('** Required fields missing . ');
                        $('[id$=spinner]').css('display','none');
                    }
                }
                function validateAndSaveAccount(){
                    $('#contactLookupModal input').each(function (){
                         $(this).css('border','1px solid #d8dde6');
                    });
                    var sEmail  = $('[id$=aEmail]').val();
                    var filter = /^([\w-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
                    if (!filter.test(sEmail) && sEmail  != '' && sEmail  != null && sEmail  !=  'undefined') {
                        $('[id$=aEmail]').css('border','1px solid red ');
                        showError('** Email is not valid . ');
                        flagSave = false;
                        $('[id$=spinner]').css('display','none');
                        return false;
                    }else{
                        $('[id$=aEmail]').css('border','1px solid #d8dde6');
                    }
                    var flagSave = true;
                    $('.accountRequired').each(function (){
                        if($(this).val() == '' || $(this).val() == null || $(this).val() == 'undefined'){
                            $(this).css('border','1px solid red ');
                            showError('** Required fields missing . ');
                            $('[id$=spinner]').css('display','none');
                            flagSave = false;
                        }
                    });
                    if(flagSave){
                        saveAccRecord();
                    }
                }
                function datatableReinit(){
                    // Setup - add a text input to each footer cell
                    $('#example tfoot th').each( function (i) {
                        var title = $('#example thead th').eq( $(this).index() ).text();
                        $(this).html( '<input type="text" placeholder="Search '+title+'" data-index="'+i+'" />' );
                    } );
                  
                    // DataTable
                    var table = $('#example').DataTable( {
                        /*scrollY:        "300px",
                        scrollX:        true,
                        scrollCollapse: true,
                        paging:         true,
                        fixedColumns:   false*/
                    } );
                 
                    // Filter event handler
                    $( table.table().container() ).on( 'keyup', 'tfoot input', function () {
                        table
                            .column( $(this).data('index') )
                            .search( this.value )
                            .draw();
                    } );
                    $('tfoot').css('display','none');
                    $('.dataTables_length select,input').addClass('slds-input');
                }
            function datatableReinitContactSearch(){
                    // Setup - add a text input to each footer cell
                    $('#contactSearchTable tfoot th').each( function (i) {
                        var title = $('#contactSearchTable thead th').eq( $(this).index() ).text();
                        $(this).html( '<input type="text" placeholder="Search '+title+'" data-index="'+i+'" />' );
                    } );
                  
                    // DataTable
                    var table = $('#contactSearchTable').DataTable( {
                        scrollY:        "400px",
                        scrollX:        true,
                        scrollCollapse: true,
                        paging:         true,
                        fixedColumns:   false
                    } );
                 
                    // Filter event handler
                    $( table.table().container() ).on( 'keyup', 'tfoot input', function () {
                        table
                            .column( $(this).data('index') )
                            .search( this.value )
                            .draw();
                    } );
                    $('tfoot').css('display','none');
                    $('.dataTables_length select,input').addClass('slds-input');
                }
                function renderAfterDeletion(){
                    showErrorOnComplete();
                    datatableReinit();
                }
                function showErrorOnComplete(){
                    var error = document.getElementById('{!$Component.frm.hiddenElement}').value;
                    if(error != '' && error != null && error != 'undefined'){
                        showError(error);
                    }
                }    
            </script>
        </head>
        <body>
            <apex:form id="frm">
            <apex:outputPanel id="renderError">
                <apex:inputHidden value="{!error}" id="hiddenElement"/>
            </apex:outputPanel>
            <apex:actionFunction name="fltrContact" action="{!filterContactByType}" reRender="table" oncomplete="datatableReinit();$('[id$=contactLookupModal]').addClass('slds-hide');$('[id$=spinner]').css('display','none');">
            </apex:actionFunction>
            <apex:actionFunction name="editContact" action="{!editRecordModalContact}" reRender="contactpnl" oncomplete="openModal();">
                <apex:param name="index" value="" assignTo="{!edIndex}"/>
            </apex:actionFunction>
            <apex:actionFunction name="deleteContact" action="{!deleteRecordContact}" reRender="renderError,table" oncomplete="renderAfterDeletion();$('[id$=spinner]').css('display','none');return false;">
                <apex:param name="index2" value="" assignTo="{!edIndex}"/>
            </apex:actionFunction>
            <apex:actionFunction name="newContact" action="{!createContact}" reRender="table" oncomplete="datatableReinit();$('[id$=contactLookupModal]').addClass('slds-hide');$('[id$=spinner]').css('display','none');"/>
            <apex:actionFunction name="saveAccRecord" action="{!saveAccount}" reRender="pMesg,renderError" oncomplete="$('[id$=spinner]').css('display','none');showErrorOnComplete();"/>
            <apex:actionFunction name="openModal" reRender="contactpnl" oncomplete="$('[id$=contactLookupModal]').removeClass('slds-hide');$('[id$=spinner]').css('display','none');"/>
            <apex:actionFunction name="openContactSearchModalFunction" reRender="contactSearch" oncomplete="$('[id$=contactSearchModal]').removeClass('slds-hide');datatableReinitContactSearch();$('[id$=spinner]').css('display','none');"/>
            <apex:actionFunction name="searchContacts" action="{!searchContact}" reRender="contactSearch" oncomplete="$('[id$=contactSearchModal]').removeClass('slds-hide');datatableReinitContactSearch();$('[id$=spinner]').css('display','none');"/>
            <apex:actionFunction name="cancelMethod" action="{!cancelMethod}" reRender="table,contactSearch" oncomplete="datatableReinit();$('[id$=contactSearchModal]').addClass('slds-hide');$('[id$=spinner]').css('display','none');"/>
            <apex:actionFunction name="associateContacts" action="{!associateContacts}" reRender="table,contactSearch" oncomplete="datatableReinit();$('[id$=contactSearchModal]').removeClass('slds-hide');$('[id$=spinner]').css('display','none');">
                <apex:param name="selectedContactsVar" value="" assignTo="{!selectedContacts}"/>
            </apex:actionFunction>    
