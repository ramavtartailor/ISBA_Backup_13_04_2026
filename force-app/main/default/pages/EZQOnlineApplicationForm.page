        <apex:outputPanel id="dynamicJS">
            
            <script>
            
            
            function setCurrentStep(activeId){
            	console.log("setCurrentStep: ", activeId);
            	$('.f1-step').removeClass('active');
                $(activeId).addClass('active');
            }
         
            
        
            function handlePath(inactiveStage, activeStage ){
                
             	console.log("handlePath activeStage: ", activeStage);
            	console.log("handlePath inactiveStage: ", inactiveStage);
            
                var activeId = '#'+ activeStage;
                var inactiveId = '#'+ inactiveStage;
                var stepBeforeClick = '#'+'{!stepBeforeClicked}';
                var responseMessage = '{!responseMessage}';
               
                if(responseMessage !== 'success'){
                    $('.slds-notify_container').removeClass('slds-hide');
                    $('#notifyError').text('{!responseMessage}');
                }
                else{
                    $('.slds-notify_container').addClass('slds-hide');
                    //setCurrentStep(activeId);
                    
                    
                    $(`${activeId}`).addClass('active');
                    $(`${inactiveId}`).removeClass('active');
                    $(`${stepBeforeClick}`).removeClass('active');
                    $('.f1-progress-line').css('width','{!width}');
                    
                }
            }
        
            function handlePreviousPath(inactiveStage, activeStage){
                
                console.log("handlePreviousPath activeStage: ", activeStage);
            	console.log("handlePreviousPath inactiveStage: ", inactiveStage);
                
                var activeId = '#'+ activeStage;
                var inactiveId = '#'+ inactiveStage;
                var responseMessage = '{!responseMessage}';
               
                if(responseMessage !== 'success'){
                    $('.slds-notify_container').removeClass('slds-hide');
                    $('#notifyError').text('{!responseMessage}');
                }
                else{
                    $('.slds-notify_container').addClass('slds-hide');
                    $(`${activeId}`).addClass('active');
                    $(`${inactiveId}`).removeClass('active');
                    $('.f1-progress-line').css('width','{!width}');
                }
            }
        
        
            function handleSubmit(){
                var responseMessage = '{!responseMessage}';
				                
                if(responseMessage !== 'success'){
                    $('.slds-notify_container').removeClass('slds-hide');
                    $('#notifyError').text('{!responseMessage}');
                }
                else if(responseMessage == 'success'){
                    console.log('ssdddd', responseMessage);
                    $('.slds-notify_container').addClass('slds-hide');
                     rerenderMain();
                }
            }
            
            function handleContinueJs(nextStage,width){
                
                if(nextStage == 'firmRenewal'){
                    $("input[name=quoteInfo][value=" + '{!policy.Stage_Quote_change__c}' + "]").prop('checked', true);
                }
                else if(nextStage == 'firmInfo'){
                    $("input[name=info][value=" + '{!policy.Stage_Firm_Info_change__c}' + "]").prop('checked', true);
                }
                 else if(nextStage == 'listOfLawyers'){
                    $("input[name=lawyerInfo][value=" + '{!policy.Stage_Lawyers_change__c}' + "]").prop('checked', true);
                }
                 else if(nextStage == 'addFirmInfo'){
                    $("input[name=additionalInfo][value=" + '{!policy.Stage_Additional_Info_change__c}' + "]").prop('checked', true);
                }
                
                
                $('#spinnerCommon').css('display','');
                var currentId = '#'+ '{!currentStage}';
                var nextId = '#'+ nextStage;
                //var previousStage = '{!currentStage}';
                
                
                if(nextStage =='quoteAcceptance'){
                    if(handleAddFirmValidation()=== 0){
                        handleContinue(nextStage,width); 
                        
                    }
                    else{
                        $('.slds-notify_container').removeClass('slds-hide');
                        $('#notifyError').text('Please check error!');
                    }
                } else if(nextStage == 'firmInfo'){
                 if( $('.looped:checked').length>0){
                      handleContinue(nextStage,width);
                    
                 }
                 else{
                     $('.slds-notify_container').removeClass('slds-hide');
                     $('#notifyError').text('Please select one quote.');
                 }     
                }
                else{
                    handleContinue(nextStage,width);
                    
                }
                
            } 
            
           
            
            function handleDisplayPanel(action){
                var stepBeforeClicked = '#'+'{!stepBeforeClicked}'+'Tab';
                var previousId = '#'+'{!previousStage}'+'Tab';
                var currentId = '#'+'{!currentStage}'+'Tab';
                $(`${stepBeforeClicked}`).fadeOut();
                $(`${stepBeforeClicked}`).removeClass('activePanel');
                $(`${currentId}`).removeClass('activePanel');
                $(`${previousId}`).fadeOut(400,function(){
                    if(action == 'continue'){
                     handlePath('{!previousStage}','{!currentStage}');
					}
                    else if(action == 'previous'){
                        handlePreviousPath('{!previousStage}','{!currentStage}');
                    }
                     $(`${currentId}`).fadeIn();
                    
                });
                //$(`${nextId}`).removeClass('inactivePanel')
                //$(`${nextId}`).addClass('activePanel');
                
               
            }
            
            function handlePreviousJS(previousStage,width){
                
                var currentId = '#'+ '{!currentStage}';
                var previousId = '#'+ previousStage;
                //$(`${currentId}`).removeClass('active');
                //$(`${previousId}`).addClass('active');
                //$('.f1-progress-line').css('width',width);
                handlePrevious(width); 
                $('.slds-notify_container').addClass('slds-hide');
            }
            
            function submitForm(){
                callApexSubmit(); 
            }
            
            
            function handleAddFirmValidation(){
                var componentId = '{!$Component.frm}';
                console.log(componentId);
                var requiredElement =[];
                var errorList = [];
                $(".required").each(function(){
                    requiredElement.push($(this)); 
                });
                
                $(".radioReq").each(function(){
                    requiredElement.push($(this)); 
                });
                
                
                requiredElement.forEach(function(ele){
                    var dataId = ele.attr('data-id');
                    var elementError = '#'+dataId+'Error';
                    var Name = componentId+':'+dataId;
                    
                    if(ele.attr('class').includes('required')){
                        if(ele.val().toString().trim()== ''){
                            $(`[data-id ="${dataId}"]`).addClass('has-error');
                            $(`${elementError}`).css('display','inline-block');
                            errorList.push(dataId); 
                        }
                        else{
                            $(`[data-id ="${dataId}"]`).removeClass('has-error');
                            $(`${elementError}`).css('display','none');
                        }
                    }
                    else if(ele.attr('class').includes('radioReq')){
                        if($(`input[name='${Name}']:checked`).length < 1){
                            $(`[data-id ="${dataId}"]`).addClass('radioError');
                            errorList.push(dataId); 
                        }
                        else{
                            $(`[data-id ="${dataId}"]`).removeClass('radioError');
                        }
                    }
                });
                
                
                
                
                /*
                $(".radioRequired").each(function(){
                    requiredElement.push($(this)); // This is the jquery object of the input, do what you will
                });
               */
                return errorList.length;
            }
            
