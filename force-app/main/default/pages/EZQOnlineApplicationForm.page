            function handleDisciplinaryYes(){
                console.log('test');
                var arrNo = [];
                $(".discRadio input[type=radio]:checked").each(function() {
                    if( this.value == 'Yes'){
                        $('#discplinaryYes').css('display','');
                        arrNo.push(this.value);
                        return false;
                    }
                });
                console.log(arrNo)
                var allNo = arrNo.every( (val, i, arr) => val === 'No' );
                
                if(allNo){
                    $('#discplinaryYes').css('display','none');
                }
                
            }
            
