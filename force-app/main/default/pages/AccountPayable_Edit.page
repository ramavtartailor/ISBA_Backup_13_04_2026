    function calculateAmount(a){
        console.log('--a'+a);
        //var qty = document.getElementsByClassName('quantity'+a)[0].value;
        var price = document.getElementsByClassName('price'+a)[0].value.replace(/\,/g,"");
        console.log('-price--'+price);
        document.getElementsByClassName("total"+a)[0].innerHTML = (1*price).toFixed(2);
        //var totalAmt = getTotal(a);
        //var old = document.getElementById("pageId:formId:pbBlock2Id:totalAmountField").innerHTML;
        //document.getElementById("pageId:formId:pbBlock2Id:totalAmountField").innerHTML = old+totalAmt;
        
        
        var totalAmount = 0.00;
        $('.totalEnd').each(function(){
            console.log(this);
            console.log($(this).html());
            totalAmount  += parseFloat($(this).html());
        });
        totalAmount = totalAmount .toFixed(2);
        console.log(totalAmount);
        $('.totalClassAmount').html(totalAmount);
        
        
        
    }   
    function totalAmount(){
    
        var td = document.querySelectorAll('#pageId:formId:pbBlock2Id:pbBlockTableId:tb > tbody > tr > td:last-child');
        var total = 0;
       for (var i = 0; i < td.length; i++)
       {
           total += parseFloat(td[i].innerText);
       }
        console.log('--total is '+total);
       document.getElementById('pageId:formid:totalAmountField').innerText = total;
        console.log('--total is '+total);
        
    }   
    function getTotal(a){
        var idField= '#pageId:formId:pbBlock2Id:pbBlockTableId:'+a+':totalId';
        console.log('**************idField***************');
        console.log(idField);
        var elem = document.getElementById(idField).innerHTML;
        console.log('**************elem***************');
        console.log(elem);
        return elem;
    }
 </script>
 
