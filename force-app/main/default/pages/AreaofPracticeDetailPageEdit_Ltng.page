            <script>
            
                $( document ).ready(function() {
                totalOfPer();
                isReadOnly();
                if({! $User.UIThemeDisplayed == 'Theme3' }){
                    parent.adjustHeight(numberOfRows);
                }
                });
                function isReadOnly(){
                   $( ".isReadOnly" ).each(function( index ) {
                        if($(this).val().trim()!=''){
                            $(this).closest('.slds-form-element__control').find('.AOPMode').attr('readonly', true);
                        
                        }
                    });
                }
                function search( lookName ,ObjectName,label){
                    try{ 
                        $('input[id$='+lookName+']').css('background', 'url("http://www.hsi.com.hk/HSI-Net/pages/images/en/share/ajax-loader.gif") no-repeat right center');
                        var key=$('input[id$='+lookName+']').val();
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.AOPDetailPageEdit_LtngController.getLookupRecord}',
                            key, 
                            ObjectName,
                            function(result, event){
                                if(result != null){
                                    if (event.status) {
                                        var  tables ="<ul class='slds-lookup__list' role='listbox'>  ";
                                        for(var i=0;i<result.length;i++){ 
                                            tables += "<li role='presentation' onclick=\"fillRecord( '" +lookName+"','" +result[i].Id+"','"+result[i].Name+"' )\"><span class='slds-lookup__item-action slds-media' id='lookup-option-483' role='option'><div class='slds-media__body'><div class='slds-lookup__result-text'>"+result[i].Name+"</div></div></span></li>"; 
                                        } 
                                        tables +="</ul>";
                                        if(result.length > 0){
                                            tables = "<div class='slds-lookup__item--label slds-text-body--small'>"+label+"</div>"+tables; 
                                        }else{
                                            tables = "<div class='slds-lookup__item--label slds-text-body--small'>No record found .</div>"; 
                                        }
                                        document.getElementById(lookName+"SrchDrpDwn").innerHTML =tables;
                                        $('[id$='+lookName+'SrchDrpDwn]').show(); 
                                    } else if (event.type === 'exception') {
                                        
                                    } else {
                                        
                                    }
                                    $('input[id$='+lookName+']').css('background', 'none'); 
                                }else{
                                    $('input[id$='+lookName+']').css('background', 'none');
                                }
                            }, 
                            {escape: true}
                        );
                    }catch(e){ 
                        alert('An Error has Occured. Error:' +e); 
                    }
                    
                }
            /*      function addRow(){
                    $('[id$=spinner]').css('display','block');
                    addAOPRow();
                }  */
                function removeAddRowCompletion(){
                    if({! $User.UIThemeDisplayed == 'Theme3' }){
                        parent.adjustHeight(numberOfRows);
                    }
                }
            	function handleBack(){
                    console.log('isSAErp => '+{!isSaErp});
                    if({!isSaErp}){
                        console.log('isSAErp => '+{!isSaErp});
                        history.back();
                    }
                    else{
                        window.location.href='/apex/PolicyLawyers?id={!appPolicy.Id}&showNext=true';
                    }
                }
                function cancel(){
                    location.href = '/{!$CurrentPage.parameters.id}';
                }
                function fillRecord(lookup,id,name){
                    $('[id$='+lookup+'SrchDrpDwn]').hide();
                    $('.' + lookup + 'Value' ).val(id);
                    $('.' + lookup + 'Name' ).val(name);
                    
                    $('[id$='+lookup+'Label]').text(name);
                    $('[id$='+lookup+'Search]').addClass('slds-hide');
                    $('[id$='+lookup+'LabelDiv]').removeClass('slds-hide');
                } 
                function renderSVG(){
                    $('.aopSvg').each(function(){
                        var imageURL = '{!URLFOR($Asset.SLDS, 'assets/icons/standard-sprite/svg/symbols.svg#reward')}';
                        var SVG = $('<svg/>', {
                            class: 'slds-icon slds-icon-standard-reward slds-icon--small slds-m-around--xx-small',
                        });
                        var SVGUse = $('<use/>');
                        SVGUse.attr('xlink:href',imageURL);
                        $( '#' + $(this).attr("id") ).prepend(SVG.append(SVGUse));
                        $( '#' + $(this).attr("id") ).html($('#' + $(this).attr("id")).html());
                    });
                    $('.closeSvg').each(function(){
                        var imageURL = '{!URLFOR($Asset.SLDS, '/assets/icons/utility-sprite/svg/symbols.svg#close')}';
                        var SVG = $('<svg/>', {
                            class: 'slds-icon slds-icon--x-small slds-icon-text-default slds-m-right--small',
                        });
                        var SVGUse = $('<use/>');
                        SVGUse.attr('xlink:href',imageURL);
                        $( '#' + $(this).attr("id") ).append(SVG.append(SVGUse));
                        $( '#' + $(this).attr("id") ).html($('#' + $(this).attr("id")).html());
                    });
                    
                }
                function showError(error){
                    $("#errorMsg h2").each(function() {
                        $(this).text(error);
                    });
                    $("#errorMsg").removeClass('slds-hide');
                    setTimeout(function() {
                        $("#errorMsg").addClass('slds-hide');
                    }, 5000);
                }
                function showSuccessMsg(Msg){
                    $("#successMsg h2").each(function() {
                        $(this).text(Msg);
                    });
                    $("#successMsg").removeClass('slds-hide');
                    setTimeout(function() {
                        $("#successMsg ").addClass('slds-hide');
                    }, 5000);
                }
                function totalOfPer(){
               
                   var total=0;
                     $( ".aopPre" ).each(function( index ) {
                        if($( this ).val().trim()!='' && $( this ).val()!=undefined){   
                            total+=parseInt($( this ).val());
                        }
                    });
                    if(total<100){
                        $("#TotalOfPerLess").html(total);
                        $("#TotalOfPerEqual").html('');
                        $("#TotalOfPerGreater").html('');
                    }else if(total==100){
                        $("#TotalOfPerLess").html('');
                        $("#TotalOfPerEqual").html(total);
                        $("#TotalOfPerGreater").html('');
                    }
                    else if(total>100){
                        $("#TotalOfPerLess").html('');
                        $("#TotalOfPerEqual").html('');
                        $("#TotalOfPerGreater").html(total);
                    } 
                }
                function checkNumber(e,value){
                    var unicode=e.charCode? e.charCode : e.keyCode;
                    if((unicode >=48 && unicode <= 57 ) || unicode ==8 ||  unicode==9 || unicode==97 ){
                        return true;
                    }
                    return false;
                }
                
               
            </script>
