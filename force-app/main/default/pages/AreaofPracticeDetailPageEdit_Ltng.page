            <apex:form id="frm">
                <apex:outputPanel id="renderError">
                    <script>
                        var numberOfRows = '{!aops.size}';
                        if('{!error}' != '' && '{!error}' != null && '{!error}' != 'undefined'){
                            showError('{!error}');
                        }
                        else if('{!success}' != '' && '{!success}' != null && '{!success}' != 'undefined'){
                            showSuccessMsg('Record saved sucessfully . ');
                        }
                    function redirect(nextOrSave){
                        if('{!success}' != '' && '{!success}' != null && '{!success}' != 'undefined'){
                            if(nextOrSave == "save"){
                                location.href = '/{!$CurrentPage.parameters.id}';
                            }else if(nextOrSave == "next"){
                                location.href = '/apex/FirmModDetailVF?id={!$CurrentPage.parameters.id}&showNext=true';
                            }
                        }
                    }
                    </script>
                </apex:outputPanel>
                <apex:actionFunction name="saveAOPRecord" action="{!saveAOP}" reRender="frm" oncomplete="$('[id$=spinner]').css('display','none');renderSVG();totalOfPer();isReadOnly();redirect('save');"/>
