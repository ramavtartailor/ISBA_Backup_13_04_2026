            <table style="width:100%;">
                <tr>
                    <td style="width:55%;" class="tableDataLeft">
                        <apex:image url="{!$Resource.ISBAM_info_logo}" width="293" height="75"/>
                    </td>
                </tr>
            </table>
        </div>
        
        <div class="footer">
            <!--<div>Page&nbsp;<span class="pagenumber" />&nbsp;of&nbsp;<span class="pagecount" />
            </div>-->
        </div>
        
        
        
        <div class="content" style="padding-right: 10px; padding-top: 135px;" >
            
            <table cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                    <th width="80%" style="color: #3c3c3c; border-bottom: 1px solid #787878;">
                        Description
                    </th>
                    <th width="20%" align="right" style="padding-bottom:2px; border-bottom: 1px solid #787878;">
                        Amount
                    </th>
                </tr>
                <apex:repeat value="{!billingLines}" var="item">
                        <tr style="font-size: 12pt;">
                            <td align="left" style="padding-top: 5px; padding-bottom: 5px;">
                                <apex:outputField value="{!item.AcctSeed__Comment__c}"/>
                            </td>
                            <td align="right" style="padding-top: 5px; padding-bottom: 5px;">
                                <span class="{!If(item.AcctSeed__Total__c > 0,'','isbam_red')}">
                                    <apex:outputField value="{!item.AcctSeed__Total__c}"/>
                                </span>
                            </td>
                        </tr>   
                </apex:repeat>
                
                <tr>
                   <td align="left" style="padding-top: 5px; border-top: 1px solid #787878;">
                       Balance
                   </td>
                   <td align="right" style="padding-top: 5px; border-top: 1px solid #787878;">
                       <b><apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Balance__c}"/></b>
                   </td>
                </tr>
                
            </table>
            
        </div>
        
        <div style="{!if(isCardKnox == true,'','display:none;')}">
            
            <p style="padding-top: 150px;">
                For any questions, please contact our accounting department at 
                (312) 379-2005 or <a href="mailto:accounting@isbamutual.com">accounting@isbamutual.com</a>.
            </p>
        </div>
            
        
        <div style="{!if(isCardKnox == false,'','display:none;')}">
            
            <div style="padding-top: 50px; font-size: 14pt;">
                <b>Please review the payment options below:</b>
            </div>
            
            
            <div style="padding-top: 30px; padding-left: 20px;">
                <div class="isbam_darkred" style="font-weight: bold;">
                	Option 1:
                </div>
                <div style="padding-top: 7px; padding-left: 20px;">
                    <span style="{!if($CurrentPage.parameters.IsPrint=='true','','display:none;')}">
                	    Pay online via ACH or credit card and select your payment plan option (full, quarterly, monthly).  Visit https://payments.isbamutual.com and enter the invoice number listed above along with your firm’s zip code.
                    </span>
                    <span style="{!if($CurrentPage.parameters.IsPrint=='true','display:none;','')}">
                        <a target="_blank" href="{!AcctSeed__Billing__c.Payment_Link__c}" style="text-decoration: none;{!if($CurrentPage.parameters.IsPrint=='true','display:none;','')}">
                            Click here to pay online 
                        </a>
                        via ACH or credit card and select your payment plan option (full, quarterly, monthly), or visit https://payments.isbamutual.com and enter the invoice number listed above along with your firm’s zip code.
                    </span>
                </div>
            </div>
            
            <div style="padding-top: 30px; padding-left: 20px;">
                <div class="isbam_darkred" style="font-weight: bold;">
                	Option 2:
                </div>
                <div style="padding-top: 7px; padding-left: 20px;">
                    Mail a check for full payment to:<br/><br/>

                    ISBA Mutual Insurance<br/>
					20 South Clark Street<br/>
					Suite 800<br/>
					Chicago, IL 60603<br/>
                    <br/>
					<span>Be sure to include the policy number on your check</span>

                </div>
            </div>
            
            <div style="padding-top: 30px; padding-left: 20px;">
                <div class="isbam_darkred" style="font-weight: bold;">
                	Option 3:
                </div>
                <div style="padding-top: 7px; padding-left: 20px;">
                    <span style="{!if($CurrentPage.parameters.IsPrint=='true','','display:none;')}">
                	    Contact our accounting department at (312) 379-2005 or accounting@isbamutual.com.
                    </span>
                    <span style="{!if($CurrentPage.parameters.IsPrint=='true','display:none;','')}">
                        Contact our accounting department at (312) 379-2005 or <a style="text-decoration:none;" href="mailto:accounting@isbamutual.com">accounting@isbamutual.com</a>.
                    </span>
                </div>
            </div>
            
        </div>

         
    </body>
</apex:page>