<apex:page standardController="AcctSeed__Billing__c" extensions="BillingPolicyPremiumPDFExt" applyBodyTag="false" renderAs="pdf">
    <head>
        <style>
            @import url('http://fonts.cdnfonts.com/css/lato');
        </style>                
        
        <style>
            body {
            	font-family: 'Arial', sans-serif !important;
        	}
        </style>
        
        <style type="text/css" media="print">
            @page:first {
                @top-right {
                    content: element(headerFirst);
                }
                @bottom-left {
                    content: element(footer);
                }
                margin-top:200px;
            }
            @page {
                @top-right {
                    content: element(header);
                }
                @bottom-left {
                    content: element(footer);
                }
                margin-top:200px;
            }
            div.headerFirst {
                position: running(headerFirst);
            }
            div.header {
                position: running(header);
                margin-bottom: -55px;
            }
            div.footer {
                display: block;
                padding: 5px;
                position: running(footer);
            }
            .pagenumber:before {
                content: counter(page);
            }
            .pagecount:before {
                content: counter(pages);
            }
            
            
            .columnHeader {
                text-align: right;
            }
                      
            .alignRight {
                text-align: right
            }
            .colorMaroon{
                color: #89001a;
            }
            .colorRed{
                color: #e64542;
            }
            .colorGray{
                color: #212121;
            }
            .colorDarkGray{
                color: #424242;
            }
            .fontCss{
                font-size:14px;
            }
            .fontCssSmall{
                font-size:13px;
            }
            .isbam_red { color: #FC282B; }
            .isbam_darkred { color: #740015; }
			
			.isbam_billing_td {
				padding-top: 5px;
            	padding-bottom: 5px;
			}            
        </style>
    </head>
    <body>
                
        
        <!------------  ADDRESS BLOCK  ------------>
        <div style="position: absolute; top: 0px; left: 55px; border: 1px solid white; width: 275px; font-size: 15px;">
                <apex:outputText value="{!AcctSeed__Billing__c.AcctSeed__Billing_Contact__r.Name}" rendered="{!!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_Contact__c)}"/>
                <apex:outputText value="{!AcctSeed__Billing__c.Policy__r.Firm_Contact__r.Name}" rendered="{!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_Contact__c)}"/>
                <br/>
                <apex:outputText value="{!AcctSeed__Billing__c.AcctSeed__Customer__r.Name}" />
            	<br/>
                <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Billing_Street__c}" rendered="{!!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_Street__c)}" />
                <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Customer__r.BillingStreet}" rendered="{!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_Street__c)}" />
                <br/>
                <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Billing_City__c}" rendered="{!!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_City__c)}" />
                <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Customer__r.BillingCity}" rendered="{!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_City__c)}" />
                 <apex:outputText value=",&nbsp;" escape="false" rendered="{!!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_City__c) || !ISBLANK(AcctSeed__Billing__c.AcctSeed__Customer__r.BillingCity)}" />
                <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Billing_State__c}" rendered="{!!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_State__c)}" />
                <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Customer__r.BillingState}" rendered="{!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_State__c)}" />
                  &nbsp;
                <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Billing_PostalCode__c}" rendered="{!!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_PostalCode__c)}" />
                <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Customer__r.BillingPostalCode}" rendered="{!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_PostalCode__c)}" />
              </div>
        
        
        <!------------  DATE/INVOICE BLOCK  ------------>
        <table cellspacing="0" cellpadding="0" style="position: absolute; top: 0px; left: 540px; width: 165px;">
            <tr>
                <td colspan="2" align="right">
                    <apex:outputText value="{0,date,MMMM d, yyyy}"><apex:param value="{!TODAY()}" /></apex:outputText>
                </td>
            </tr>
            
            <tr><td colspan="2">&nbsp;</td></tr>
            
            <tr>
                <td align="right">
                    Invoice #:
                </td>
                <td align="right">
                	&nbsp;&nbsp;<apex:outputField value="{!AcctSeed__Billing__c.Name}"/>
                </td>
            </tr>
            
            <tr style="font-weight: bold;">
                <td align="right">
                    Due Date:
                </td>
                <td align="right" class="isbam_red">
                	<apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Due_Date2__c }"/>
                </td>
            </tr>
        </table>
        
        
        
            
        
        <div class="headerFirst">
            
            <table style="width:100%;">
                <tr>
                    <td style="width:55%;" class="tableDataLeft">
                        <apex:image url="{!$Resource.ISBAM_info_logo}" width="293" height="75"/>
                    </td>
                    <td align="center" valign="center">
                    	<span class="isbam_red" style="font-size: 24pt; font-weight: bold;">INVOICE</span>
                    </td>
                </tr>
            </table>
            
            <!--<table style="width:100%">
                <tr>
                    <td style="vertical-align:top">
                        <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Billing_Format__r.AcctSeed__Image__c}" rendered="{!!ISBLANK(AcctSeed__Billing__c.AcctSeed__Billing_Format__r.AcctSeed__Image__c)}" />
                        
