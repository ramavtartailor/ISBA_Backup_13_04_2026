                        input.previousSibling.style.display = "block"; // Show $ if there's a value
                        let value = input.value.replace(/,/g, ''); // Remove existing commas
                        if (!isNaN(value) && value !== '') {
                            input.value = Number(value).toLocaleString(); // Format with commas
                        }
                    }
                }
                
                function toggleCurrencySymbolFocus(input) {                    
                    input.previousSibling.style.display = "none"; 
                    let value = input.value.replace(/,/g, ''); // Remove commas before saving
                    input.value = value;
                }
                
            </script>
