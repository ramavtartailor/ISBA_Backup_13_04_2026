                    //sforce.connection.sessionId = '{!$Api.Session_ID}';
                    var inputId = event.id;
                    var doc = document.getElementById(inputId);
                    file = doc.files[0];
                    var docType = event.dataset.row;
                    var name = file.name;
                    var reader = new FileReader();
                    reader.readAsDataURL(file);
                    reader.onload = function(evt) {  
                        var attachmentbodybase64 = evt.target.result;
                        var blobFile = attachmentbodybase64.split(',')[1];
                        console.log(blobFile);                       
                        //uploadFile(name, blobFile); 
                        var appId = '{!applicationId}';
                        CustomerApplication_Ctrl.uploadFileWithCallout(
                            name,
                            blobFile,docType,appId,
                            function(result, event) {
                                if (event.status) {
                                    console.log("File uploaded and callout response: " + result);
                                    uploadFile(); 
                                } else {
                                    console.log("Error: " + JSON.stringify(event.message));
                                }
                            },
                            { escape: true }
                        );
                    }                
                }
                
