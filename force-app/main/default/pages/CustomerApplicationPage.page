                function validateAndShowQuotes(event){
                    var checkedValueLimits = new Array(); 
                    var inputElements = document.getElementsByClassName('limits');
                    for(var i=0; inputElements[i]; ++i){
                        if(inputElements[i].checked){
                            const input = inputElements[i];
                            const label = input.nextElementSibling;
                            const labelText = label ? label.innerText : '';
                            const inputValue = input.value;
                            checkedValueLimits.push({
                                label: labelText,
                                value: inputValue
                            });
                        }
                    }
                    var checkedValueDeductibles = new Array(); 
                    inputElements = document.getElementsByClassName('deductibles');
                    for(var i=0; inputElements[i]; ++i){
                        if(inputElements[i].checked){
                            const input = inputElements[i];
                            const label = input.nextElementSibling;
                            const labelText = label ? label.innerText : '';
                            const inputValue = input.value;
                            checkedValueDeductibles.push({
                                label: labelText,
                                value: inputValue
                            });
                        }
                    }
                    console.log('checkedValueLimits => '+checkedValueLimits.length);
                    if(checkedValueLimits.length == 0){
                        showError('Please select atleast one limit.',event);
                        return;
                    }    
                    console.log('checkedValueDeductibles => '+checkedValueDeductibles.length);
                    if(checkedValueDeductibles.length == 0){
                        showError('Please select atleast one deductible.',event);
                        return;
                    }
                    showQuotesFunc(JSON.stringify(checkedValueLimits),JSON.stringify(checkedValueDeductibles));
                    return;
                }
                
