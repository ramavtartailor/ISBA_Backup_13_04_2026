                <script>
                
                let skipBeforeUnload = false;
                
                window.onbeforeunload = function (e) {
                    if (skipBeforeUnload) {
                        return undefined;                     
                    }
                    
                    e.preventDefault(); 
                    e.returnValue = ''; 
                    return '';
                };
                
                $(document).ready(function() {
                    if('{!callActivateSteps}' == 'true'){
                    	activateSteps();
                    }
                    
                    if(!{!setStageCalled} && {!callSetStage}){
                        setCurrentStage();                        
                    }                    
                });
                
                function back(previousButton){
                    var parent_fieldset = $(previousButton).parents('fieldset');
                    var current_active_step = $(previousButton).parents('.f1').find('.f1-step.active');
                    var progress_line = $(previousButton).parents('.f1').find('.f1-progress-line');
                    previousStageFunc();
                    parent_fieldset.fadeOut(400, function() {
                        // change icons
                        if('{!isRegularRenewal}' == 'false' && '{!currentStage}' == 'Prior Claims'){
                            current_active_step.removeClass('active').prev().children().removeClass('activated').addClass('active');
                        }
