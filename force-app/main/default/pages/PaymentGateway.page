        /*********************************************************        
     * LOGIC:  check ACH routing number ABA) 
     ********************************************************/
        function isValidRoutingNumber(routingNumber) {
            
            // check null/blank
            if (!routingNumber) {
                return false;
            }
            
            // pad 0's tp 9 digits
            var routing = routingNumber.toString();
            while (routing.length < 9) {
                routing = '0' + routing;
            }
            
            // varify length of 9 didgits
            var match = routing.match("^\\d{9}$");
            if (!match) {
                return false;
            }
            
            // https://en.wikipedia.org/wiki/Routing_transit_number
            // first two digits must be in the ranges;
            //    00 through 12, 
            //    21 through 32,
            //    61 through 72,
            //    or 80.
            // 
            const start = parseInt(routing.substring(0, 2));
            const valid_start =  (0 <= start && start <= 12)
            || (21 <= start && start <= 32)
            || (61 <= start && start <= 72)
            || start === 80;
            if (!valid_start) {
                return false;
            }
            
            // test checksum
            // http://www.siccolo.com/Articles/SQLScripts/how-to-create-sql-to-calculate-routing-check-digit.html
            const weights = [3, 7 ,1];
            var sum = 0;
            for (var i=0 ; i<8; i++) {
                sum += parseInt(routing[i]) * weights[i % 3];
            }
            
            return (10 - (sum % 10)) % 10 === parseInt(routing[8]);
        }
        
        
        
