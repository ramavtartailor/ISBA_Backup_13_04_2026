        function validateFields(nextStage,paymentTypeVar){
            if(nextStage == 'schedule'){
                
                // check invoice, policy and zipdoe
                if(document.getElementById('{!$Component.form1.policyInvoiceNumberId}').value!=''){
                    document.getElementById('policyInvoiceNumberDiv').className = 'field';
                    if(document.getElementById('{!$Component.form1.zipCodeId}').value!=''){
                        document.getElementById('zipCodeDiv').className = 'field';
                        next('schedule');
                    }else{
                        document.getElementById('zipCodeDiv').className = 'field error';                        
                    }    
                }else{
                    document.getElementById('policyInvoiceNumberDiv').className = 'field error';
                    if(document.getElementById('{!$Component.form1.zipCodeId}').value!=''){
                        document.getElementById('zipCodeDiv').className = 'field';
                    }else{
                        document.getElementById('zipCodeDiv').className = 'field error'; 
                    }    
                }    
                
            }else if(nextStage == 'processPayment'){
                
                // clear payment error
                let payment_error_div = document.getElementById('__paymentError');
                if (payment_error_div){
                    payment_error_div.innerHTML = "";
                }
                
                var error = false;
                
                // validate first name
                if (!validateFirstName()){
                    error = true;
                }
                
                // validate last name
                if (!validateLastName()){
                    error = true;
                }
                
                if(paymentTypeVar == 'check'){
                    
                    // validate ACH routing number (ABA)
                    if (!validateRoutingNumber()){
                        error = true;
                    }
                    
                    // validate ACH account number
                    if (!validateAccountNumber()){
                        error = true;
                    }
                    
                    // validate ACH account type
                    if (!validateAccountTypeACH()){
                        error = true;
                    }
                    
                    // validate ACH account holder
                    if (!validateAccountHolderACH()){
                        error = true;
                    }
                    
                    
                    // CREDIT CARD VALIDATION
                } else if(paymentTypeVar == 'creditCard'){
                    
                    // check if card type matches card
                    if (!compareCCType()){
                        error = true;
                    }
                    
                    // check if card type is valid
                    if (!validateCCType()){
                        error = true;   
                    }
                    
                    // validate credit card number
                    if (!validateCC()){
                        error = true;       
                    }
                    
                    // validate credit card CVV
                    if (!validateCVV()){
                        error = true;
                    }
                    
                    // validate credit card month
                    if (!validateExpireMonth()){
                        error = true;
                    }
                    
                    // validate credit card year
                    if (!validateExpireYear()){
                        error = true;
                    }
                    
                    // validate CC name on card
                    if (!validateNameOnCardCC()){
                        error = true;
                    }
                    
                }
                
                // validate CC name on card
                if (!validateConfirmationEmail()){
                    error = true;
                }
                
                if(!error){
                    next('processPayment');
                } 
            }    
        }
