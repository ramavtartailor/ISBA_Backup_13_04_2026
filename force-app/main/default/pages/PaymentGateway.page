     /*********************************************************        
     * LOGIC:  validate credit card number
     ********************************************************/         
        function isValidCC(cardNumber) {
            cardNumber = cardNumber.split(' ').join("");
            if (parseInt(cardNumber) <= 0 || (!/\d{15,16}(~\W[a-zA-Z])*$/.test(cardNumber)) || cardNumber.length > 16) {
                return false;
            }
            var carray = new Array();
            for (var i = 0; i < cardNumber.length; i++) {
                carray[carray.length] = cardNumber.charCodeAt(i) - 48;
            }
            carray.reverse();
            var sum = 0;
            for (var i = 0; i < carray.length; i++) {
                var tmp = carray[i];
                if ((i % 2) != 0) {
                    tmp *= 2;
                    if (tmp > 9) {
                        tmp -= 9;
                    }
                }
                sum += tmp;
            }
            return ((sum % 10) == 0);
        }
        
        
     /*********************************************************        
     * LOGIC:  validate CVV number
     ********************************************************/        
        function isValidCVV(cvvNumber, ccType){
            
            let obj = {
                valid: true,
                cvv: cvvNumber,
                cctype: ccType,
                error: '',
            }
            
            // check null/blank
            if (!cvvNumber || !ccType) {
                obj.valid = false;
                obj.error = 'CCV is empty';
            }
            
            let cvv = cvvNumber.toString();
            
            if (ccType === 'amex'){
                var match = cvv.match("^\\d{4}$");
                if (!match) {
                    obj.valid = false;
                    obj.error = "CVV must be 4 digits"
                }
            } else {
                var match = cvv.match("^\\d{3}$");
                if (!match) {
                    obj.valid = false;
                    obj.error = "CVV must be 3 digits"
                }
            }
            
            return obj;
        }
        
        
        
        /*********************************************************        
     * LOGIC:  determine credit card type by number         
     ********************************************************/
        function ccCardType(cardNumber) { // returns card type; should not rely on this for checking if a card is valid
            console.log("ccCardType");
            cardNumber = cardNumber.split(' ').join("");
            var o = {
                //electron: /^(4026|417500|4405|4508|4844|4913|4917)\d+$/,
                //maestro: /^(5018|5020|5038|5612|5893|6304|6759|6761|6762|6763|0604|6390)\d+$/,
                //dankort: /^(5019)\d+$/,
                //interpayment: /^(636)\d+$/,
                //unionpay: /^(62|88)\d+$/,
                visa: /^4[0-9]{12}(?:[0-9]{3})?$/,
                mastercard: /^5[1-5][0-9]{14}$/,
                amex: /^3[47][0-9]{13}$/,
                //diners: /^3(?:0[0-5]|[68][0-9])[0-9]{11}$/,
                discover: /^6(?:011|5[0-9]{2})[0-9]{12}$/,
                //jcb: /^(?:2131|1800|35\d{3})\d{11}$/
            }
            for(var k in o) {
                if(o[k].test(cardNumber)) {
                    console.log("ccCardType: ", k);
                    return k;
                }
            }
            return null;
        }
        
        
        
        
